# Mosh — environment configuration (the app + generative service read these).
# These are read from the process environment; run-mosh-pc.ps1 sets them for the
# CUDA Stable Audio 3 PC build. Copy/adapt as needed; nothing here is secret.

# ── Generative backend ─────────────────────────────────────────────────────────
# Which adapter the Python service loads. 'fake' = dependency-free deterministic
# stub (default; CI/tests). 'stable_audio_3' = the real CUDA model.
MOSH_ADAPTER=stable_audio_3

# The python executable used to launch service/server.py. For SA3 this MUST be the
# venv that has torch (CUDA) + the stable_audio_3 package. Unset → 'py -3.12'/'python'.
MOSH_SERVICE_PYTHON=C:\ComfyUI\venv\Scripts\python.exe

# Folder holding model_config.json + model.safetensors for Stable Audio 3 Medium.
MOSH_SA3_MODEL_DIR=E:/comfy4_models/unet

# Load the model in fp16 (required to fit a 12 GB GPU). '0' = fp32 (more VRAM).
MOSH_SA3_HALF=1

# OOM safety cap on render length, seconds (a 12 GB card is tight). Optional.
# MOSH_SA3_MAX_DURATION=12.0

# Diffusion sampler. 'pingpong' is recommended for the distilled SA3. Optional.
# MOSH_SA3_SAMPLER=pingpong

# ── Colors / steering (05 §6) ──────────────────────────────────────────────────
# Real activation-steering "colors" are ON when COLORRACK_DATA resolves. It defaults
# to service/colors/COLORRACK_DATA (bundled), so normally leave this unset.
# COLORRACK_DATA=C:/.../service/colors/COLORRACK_DATA
#
# Master switch for steering: '1' (default) applies the COLORRACK steering vectors;
# '0' ignores colors entirely (plain prompt-only generation).
# MOSH_SA3_STEERING=1
#
# Peak-normalize the output to this dBFS (SA3 routinely exceeds full scale; a hair
# below 0 avoids hard clipping). Default -0.5.
# MOSH_SA3_PEAK_DBFS=-0.5
#
# Init-latent cache capacity (entries); reused when only seed/colors/nl change.
# MOSH_SA3_LATENT_CACHE=8

# ── Judge / quality readout (05 §7) ────────────────────────────────────────────
# 'dsp' (default) = heuristic signal-hygiene readout (numpy/soundfile; pq + flags in
# the manifest). 'none' = skip. (A learned audiobox judge would live in a separate
# venv — not wired here.)
# MOSH_JUDGE=dsp

# ── App ────────────────────────────────────────────────────────────────────────
# Port for the in-process HTTP server (serves the UI bundle + /api/*).
MOSH_HTTP_PORT=8080

# UI shell: 'browser' (default on Windows — opens your default browser; reliable,
# the embedded WebView2 renders blank here) or 'webview' (in-app WebView2 window,
# opt-in for platforms where it renders, e.g. macOS WKWebView).
# MOSH_UI_MODE=browser

# Set to '1' to skip opening an audio output device (headless / no-audio runs).
# MOSH_NO_AUDIO=
