# Normalize line endings to LF in the repo (primary target is macOS arm64).
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wav binary
*.npz binary

# Unified-diff syntax uses a single space for blank context lines. Treat patch
# payloads as literal source so range-level `git diff --check` does not report
# the patch format itself as trailing whitespace.
*.patch -whitespace
