# Secrets — never commit API keys / brain provider creds.
# Precise patterns (NOT a broad .env.* glob) so .env.example stays committable
# as a template without needing a fragile negation.
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
*.secret

# Build output
build/
build-*/
cmake-build-*/

# Share-for-friend packaging artifacts (scripts/package-for-sharing.sh)
dist/
out/

# CPM / fetched deps cache (kept out of repo; pinned by commit in CMake)
.deps-inspect/
libs/_deps/
.cpm-cache/

# Node / Vite
node_modules/
ui/node_modules/
ui/dist/
ui/.vite/
ui/test-results/
ui/.tsbuild-node/
ui/*.tsbuildinfo

# Python service
service/.venv/
# machine-local SA3 paths written by setup-sa3.sh
service/.sa3.env
# Basic Pitch venv (100s of MB) + machine-local BASIC_PITCH_PY (setup-transcribe.sh)
service/transcribe/.venv/
service/transcribe/.transcribe.env
# Sketch (librosa) venv + machine-local SKETCH_PY (setup-sketch.sh)
service/sketch/.venv/
service/sketch/.sketch.env
service/__pycache__/
**/__pycache__/
*.pyc
service/scripts/_sa3_smoke_out/
service/scripts/_sa3_e2e_out/

# Runtime / data
*.tracktionedit
*.log
*.wav
*.aiff
*.aif
# …but the bundled default drum kit IS a committed app resource (DRM-001).
!resources/drumkits/mosh-kit/*.wav
# …and the Sketch Phase-0 test fixtures ARE committed (synthesised, not recordings;
# the build/selftest must not depend on Python to regenerate them).
!service/sketch/fixtures/*.wav
mosh-sessions/
service/jobs/
_preserved_artifacts/
assets/grit_demo/
midi_data/
midi_rag_database.pkl

# Headless/browser QA artifacts
.playwright-mcp/
test-results/
mosh-*.png
verify-artifacts/

# Local agent/runtime scratch
.gstack/
.refclone/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.xcodeproj
*.xcworkspace
compile_commands.json
ios/MoshCompanion/build/
!ios/MoshCompanion/MoshCompanion.xcodeproj/
!ios/MoshCompanion/MoshCompanion.xcodeproj/project.pbxproj
!ios/MoshCompanion/MoshCompanion.xcodeproj/xcshareddata/
!ios/MoshCompanion/MoshCompanion.xcodeproj/xcshareddata/xcschemes/
!ios/MoshCompanion/MoshCompanion.xcodeproj/xcshareddata/xcschemes/MoshCompanion.xcscheme
