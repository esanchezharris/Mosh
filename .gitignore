# Reference clones (read-only, for resolving // VERIFY items against pinned deps)
/.refclone/

# Build output
/build/
/cmake-build-*/
/out/

# CPM / dependency cache
/.cpm-cache/
/libs/_deps/

# JUCE / native build artifacts
*.o
*.obj
*.lib
*.a
*.exp
*.ilk
*.pdb
*.exe
*.dll
*.dylib
*.so

# UI (frontend manages its own; staged bundle is generated)
/ui/node_modules/
/ui/dist/

# Python service
__pycache__/
*.pyc
.venv/
service/.venv/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.user

# Local env / secrets (external model paths live here)
.env
.env.local

# Logs (the JSONL semantic log is written at runtime, not committed)
*.log
/sessions/

# Headless-browser QA artifacts (Playwright snapshots/screenshots; throwaway)
.playwright-mcp/
/mosh-*.png

# SA3 standalone smoke / e2e output (generated WAVs) + local env
service/scripts/_sa3_smoke_out/
service/scripts/_sa3_e2e_out/
.env
.gstack/
