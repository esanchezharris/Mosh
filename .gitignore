# Secrets — never commit API keys / brain provider creds.
# Precise patterns (NOT a broad .env.* glob) so .env.example stays committable
# as a template without needing a fragile negation.
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
*.secret

# Build output
build/
build-*/
cmake-build-*/

# Share-for-friend packaging artifacts (scripts/package-for-sharing.sh)
dist/
out/

# CPM / fetched deps cache (kept out of repo; pinned by commit in CMake)
.deps-inspect/
libs/_deps/
.cpm-cache/

# Node / Vite
node_modules/
ui/node_modules/
ui/dist/
ui/storybook-static/
ui/.vite/
ui/test-results/
ui/.tsbuild-node/
ui/*.tsbuildinfo

# Python service
service/.venv/
# machine-local SA3 paths written by setup-sa3.sh
service/.sa3.env
# Taste-eval lane: machine-local TASTE_PY/TUNEJURY_PY (setup-taste.sh). Internal
# eval only — service/taste is deliberately NOT in the deploy-bundle whitelist.
service/taste/.taste.env
# Basic Pitch venv (100s of MB) + machine-local BASIC_PITCH_PY (setup-transcribe.sh)
service/transcribe/.venv/
service/transcribe/.transcribe.env
# Sketch (librosa) venv + machine-local SKETCH_PY (setup-sketch.sh)
service/sketch/.venv/
service/sketch/.sketch.env
# Whisper word-ASR venv (torch, 100s of MB) + machine-local WHISPER_PY (setup-whisper.sh)
service/whisper/.venv/
service/whisper/.whisper.env
# Skeleton (FCPE F0) venv + machine-local SKELETON_PY (setup-skeleton.sh)
service/skeleton/.venv/
service/skeleton/.skeleton.env
# Phonology venv + machine-local PHONOLOGY_PY (setup-phonology.sh)
service/phonology/.venv/
service/phonology/.phonology.env
# PyFLP venv + machine-local FLP_PY (setup-flp.sh)
service/flp/.venv/
service/flp/.flp.env
# RAVE transform venv (torch, GBs) + machine-local TRANSFORM_PY/RAVE_MODEL_DIR (setup-transform.sh)
service/transform/.venv/
service/transform/.transform.env
# SFT lane: mlx-lm venv + machine-local SFT_PY + generated dataset/adapters (setup-sft.sh)
service/sft/.venv/
service/sft/.sft.env
service/lyrics/bench/.lyrics-bench.env
service/sft/.sft-data/
service/sft/.adapters/
service/sft/.fused/
service/sft/.artifacts/
service/__pycache__/
**/__pycache__/
*.pyc
service/scripts/_sa3_smoke_out/
service/scripts/_sa3_e2e_out/

# Runtime / data
*.tracktionedit
*.log
*.wav
*.aiff
*.aif
# …but the bundled default drum kit IS a committed app resource (DRM-001).
!resources/drumkits/mosh-kit/*.wav
# …and the Sketch Phase-0 test fixtures ARE committed (synthesised, not recordings;
# the build/selftest must not depend on Python to regenerate them).
!service/sketch/fixtures/*.wav
mosh-sessions/
service/jobs/
service/teardown/.venv/
service/teardown/*.sqlite
service/teardown/*.sqlite-*
service/teardown/teardown_jobs.jsonl
service/teardown/checkpoints/
_preserved_artifacts/
assets/grit_demo/
midi_data/
midi_rag_database.pkl

# Headless/browser QA artifacts
.playwright-mcp/
test-results/
mosh-*.png
verify-artifacts/
scripts/compiler-eval/artifacts/

# Local agent/runtime scratch
.gstack/
.omo/
.refclone/
.cache/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.xcodeproj
*.xcworkspace
compile_commands.json
ios/MoshCompanion/build/
!ios/MoshCompanion/MoshCompanion.xcodeproj/
!ios/MoshCompanion/MoshCompanion.xcodeproj/project.pbxproj
!ios/MoshCompanion/MoshCompanion.xcodeproj/xcshareddata/
!ios/MoshCompanion/MoshCompanion.xcodeproj/xcshareddata/xcschemes/
!ios/MoshCompanion/MoshCompanion.xcodeproj/xcshareddata/xcschemes/MoshCompanion.xcscheme

# Bundled Moshi brain key — only ever lives in the deployed .app, never in git.
brain.env
**/brain.env

# Vector sample palette artifact (owner-private library paths + resampled audio)
service/palette/palette/
service/teardown/probe/.assets/
