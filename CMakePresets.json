      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "MOSH_BUILD_APP": "ON",
        "MOSH_BUILD_TESTS": "ON",
        "MOSH_BUILD_UI": "ON",
        "MOSH_BUILD_PLUGIN_FIXTURES": "ON"
      }
    },
    {
