      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "MOSH_BUILD_APP": "ON",
        "MOSH_BUILD_TESTS": "ON",
        "MOSH_BUILD_UI": "ON",
        "MOSH_BUILD_PLUGIN_FIXTURES": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (NVIDIA/CUDA)",
