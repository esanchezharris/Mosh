# ── Mosh Designer Arena — model keys (COPY to .env.local, which is gitignored) ──
# Keys are read ONLY by the local proxy (server-side). The browser never sees them.
# Any provider whose KEY + MODEL are set shows up as an available "designer".
# Claude (Opus, in-session) seeds candidates with NO key at all.
# All providers use their OpenAI-compatible /chat/completions endpoint.

# ── Claude (Anthropic) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── GPT (OpenAI) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── Gemini (Google, OpenAI-compat endpoint) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ── Grok (xAI) ──
XAI_API_KEY=
XAI_MODEL=grok-4

# ── OpenRouter (one key, dozens of models; model ids are provider-prefixed) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ── DeepSeek ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Kimi (Moonshot) ──
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-32k

# ── Cost governance ── (hard per-session USD cap; generation HARD-STOPS here)
ARENA_SPEND_CAP_USD=12.00
