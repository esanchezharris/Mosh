  "source": "<div style=\"position:absolute;inset:0;background:var(--v2-bg);overflow:hidden;font-family:var(--font-body);\">\n  <!-- Stage ambient layer -->\n  <div id=\"stage\" style=\"position:absolute;inset:0;background:radial-gradient(ellipse 140% 120% at 30% 20%, rgba(204,255,54,0.08) 0%, transparent 60%), radial-gradient(ellipse 100% 100% at 70% 80%, rgba(204,255,54,0.04) 0%, transparent 50%), var(--v2-bg);transition:background 2s ease;\"></div>\n  \n  <!-- Generative ambient particles -->\n  <div id=\"particles\" style=\"position:absolute;inset:0;pointer-events:none;\">\n    <svg width=\"1440\" height=\"900\" style=\"position:absolute;width:100%;height:100%;opacity:0.4;\">\n      <defs>\n        <radialGradient id=\"pgrad\"><stop offset=\"0%\" stop-color=\"var(--v2-accent)\" stop-opacity=\"0.6\"/><stop offset=\"100%\" stop-color=\"var(--v2-accent)\" stop-opacity=\"0\"/></radialGradient>\n        <filter id=\"pblur\"><feGaussianBlur stdDeviation=\"3\"/></filter>\n      </defs>\n      <circle cx=\"200\" cy=\"150\" r=\"4\" fill=\"var(--v2-accent)\" filter=\"url(#pblur)\" opacity=\"0.5\"><animate attributeName=\"cy\" values=\"150;140;150\" dur=\"7s\" repeatCount=\"indefinite\"/><animate attributeName=\"opacity\" values=\"0.5;0.8;0.5\" dur=\"5s\" repeatCount=\"indefinite\"/></circle>\n      <circle cx=\"800\" cy=\"400\" r=\"3\" fill=\"var(--v2-accent)\" filter=\"url(#pblur)\" opacity=\"0.3\"><animate attributeName=\"cx\" values=\"800;810;800\" dur=\"9s\" repeatCount=\"indefinite\"/><animate attributeName=\"opacity\" values=\"0.3;0.6;0.3\" dur=\"6s\" repeatCount=\"indefinite\"/></circle>\n      <circle cx=\"1200\" cy=\"600\" r=\"5\" fill=\"var(--v2-accent)\" filter=\"url(#pblur)\" opacity=\"0.4\"><animate attributeName=\"cy\" values=\"600;585;600\" dur=\"8s\" repeatCount=\"indefinite\"/></circle>\n      <circle cx=\"400\" cy=\"700\" r=\"2\" fill=\"var(--v2-accent)\" filter=\"url(#pblur)\" opacity=\"0.2\"><animate attributeName=\"cx\" values=\"400;415;400\" dur=\"11s\" repeatCount=\"indefinite\"/></circle>\n      <circle cx=\"100\" cy=\"500\" r=\"3.5\" fill=\"var(--v2-accent)\" filter=\"url(#pblur)\" opacity=\"0.35\"><animate attributeName=\"cy\" values=\"500;490;500\" dur=\"6s\" repeatCount=\"indefinite\"/></circle>\n      <circle cx=\"1300\" cy=\"200\" r=\"2.5\" fill=\"var(--v2-accent)\" filter=\"url(#pblur)\" opacity=\"0.25\"><animate attributeName=\"cx\" values=\"1300;1290;1300\" dur=\"10s\" repeatCount=\"indefinite\"/></circle>\n      <circle cx=\"600\" cy=\"800\" r=\"3\" fill=\"var(--v2-accent)\" filter=\"url(#pblur)\" opacity=\"0.3\"><animate attributeName=\"cy\" values=\"800;790;800\" dur=\"12s\" repeatCount=\"indefinite\"/></circle>\n    </svg>\n  </div>\n\n  <!-- Song coat tint overlay -->\n  <div id=\"coat\" style=\"position:absolute;inset:0;background:linear-gradient(135deg, rgba(204,255,54,0.06) 0%, rgba(204,255,54,0.02) 50%, transparent 100%);mix-blend-mode:screen;pointer-events:none;transition:opacity 3s ease;\"></div>\n\n  <!-- Ambient intensity dial indicator -->\n  <div style=\"position:absolute;bottom:30px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:8px;background:rgba(11,11,11,0.7);backdrop-filter:blur(8px);border:1px solid var(--v2-line);border-radius:var(--v2-radius-pill);padding:6px 16px 6px 12px;z-index:10;\">\n    <span style=\"font-size:9px;font-weight:600;letter-spacing:0.12em;color:var(--v2-faint);text-transform:uppercase;\">Ambient</span>\n    <div style=\"width:80px;height:4px;background:var(--v2-surface-2);border-radius:2px;position:relative;\">\n      <div style=\"width:65%;height:100%;background:var(--v2-accent);border-radius:2px;transition:width 1s ease;\"></div>\n    </div>\n    <span style=\"font-size:9px;color:var(--v2-dim);font-family:var(--font-mono);\">65%</span>\n  </div>\n\n  <!-- Moshi host element -->\n  <div id=\"moshi-host\" style=\"position:absolute;bottom:80px;right:60px;width:160px;height:160px;z-index:20;filter:drop-shadow(0 0 30px rgba(204,255,54,0.3));\">\n    <!-- Moshi's stage frame -->\n    <div style=\"position:absolute;inset:0;border-radius:50%;background:radial-gradient(50% 50% at 50% 50%, rgba(204,255,54,0.08), transparent);\"></div>\n  </div>\n\n  <!-- Moshi caption -->\n  <div style=\"position:absolute;bottom:60px;right:60px;transform:translateY(100%);text-align:right;z-index:20;\">\n    <span style=\"font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--v2-accent);text-transform:uppercase;text-shadow:0 0 20px rgba(204,255,54,0.3);\">vibe</span>\n  </div>\n\n  <!-- Playhead line -->\n  <div id=\"playhead\" style=\"position:absolute;top:0;bottom:0;width:2px;background:var(--v2-accent);opacity:0.5;pointer-events:none;z-index:5;left:0;transition:left 0.1s linear;box-shadow:0 0 15px rgba(204,255,54,0.3);\"></div>\n\n  <!-- Minimal UI shell hint -->\n  <div style=\"position:absolute;top:30px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:16px;z-index:10;\">\n    <span style=\"font-size:22px;font-weight:900;letter-spacing:-0.02em;color:var(--v2-text);font-family:var(--font-display);text-shadow:0 0 40px rgba(204,255,54,0.15);\">MOSH</span>\n    <span style=\"width:1px;height:20px;background:var(--v2-line);\"></span>\n    <span style=\"font-size:11px;font-weight:600;letter-spacing:0.12em;color:var(--v2-dim);text-transform:uppercase;\">Ambient Stage</span>\n  </div>\n\n  <!-- Song info overlay -->\n  <div style=\"position:absolute;top:30px;right:40px;z-index:10;text-align:right;\">\n    <div style=\"font-size:10px;font-weight:600;letter-spacing:0.1em;color:var(--v2-faint);text-transform:uppercase;\">Coat Intensity</div>\n    <div style=\"font-size:13px;font-weight:500;color:var(--v2-accent);font-family:var(--font-mono);\">0.65</div>\n  </div>\n\n  <!-- Decorative splat mark -->\n  <div style=\"position:absolute;top:30px;left:40px;z-index:10;\">\n    <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\">\n      <path d=\"M15 2C8 2 2 8 2 15s6 13 13 13 13-6 13-13S22 2 15 2zm0 24c-6.075 0-11-4.925-11-11S8.925 4 15 4s11 4.925 11 11-4.925 11-11 11z\" fill=\"var(--v2-accent)\" opacity=\"0.6\"/>\n      <circle cx=\"15\" cy=\"15\" r=\"6\" fill=\"var(--v2-accent)\" opacity=\"0.8\"/>\n    </svg>\n  </div>\n</div>\n\n<script>\n(function() {\n  // Initialize Moshi\n  const host = document.getElementById('moshi-host');\n  if (window.Moshi) {\n    window.m = window.Moshi(host, {\n      personality: 'TAR',\n      seed: 0.5,\n      quality: 'ps2',\n      style: 'toon',\n      interactive: true,\n      room: false\n    });\n    window.m.setState('LISTENING');\n    window.m.set('mood', 0.7);\n    window.m.set('energy', 0.5);\n    window.m.set('heat', 0.2);\n  }\n\n  // Playhead tracking\n  const playhead = document.getElementById('playhead');\n  let lastLeft = 0;\n  function updatePlayhead() {\n    if (window.__mosh && window.__mosh.playhead !== undefined) {\n      const p = window.__mosh.playhead;\n      const left = p * 1440;\n      if (Math.abs(left - lastLeft) > 0.5) {\n        playhead.style.left = left + 'px';\n        lastLeft = left;\n      }\n    }\n    requestAnimationFrame(updatePlayhead);\n  }\n  updatePlayhead();\n\n  // Coat animation - subtle breathing\n  const coat = document.getElementById('coat');\n  let phase = 0;\n  function breatheCoat() {\n    phase += 0.01;\n    const breath = 0.5 + 0.5 * Math.sin(phase);\n    const intensity = 0.65; // matches dial\n    coat.style.opacity = 0.4 + intensity * 0.4 + 0.1 * breath;\n    requestAnimationFrame(breatheCoat);\n  }\n  breatheCoat();\n\n  // Stage glow pulse\n  const stage = document.getElementById('stage');\n  let glowPhase = 0;\n  function pulseStage() {\n    glowPhase += 0.005;\n    const pulse = 0.7 + 0.3 * Math.sin(glowPhase);\n    stage.style.background = `radial-gradient(ellipse 140% 120% at 30% 20%, rgba(204,255,54,${0.05 * pulse}) 0%, transparent 60%), radial-gradient(ellipse 100% 100% at 70% 80%, rgba(204,255,54,${0.03 * pulse}) 0%, transparent 50%), var(--v2-bg)`;\n    requestAnimationFrame(pulseStage);\n  }\n  pulseStage();\n})();\n</script>",
