  "source": "<div class=\"cr\">\n<style>\n/* CREAM REMOTE — the daylight companion: warm paper ground, dark ink ISLANDS floating on\n   it. The lime play key still fires on midnight (sacred contrast preserved inside a light\n   app). Moshi sits on the cream like a toon decal, stitched by a thread to the pairing. */\n.cr{position:absolute;inset:0;background:#f3efe6;font-family:var(--font-body);color:#26231d;overflow:hidden;-webkit-user-select:none;user-select:none}\n.cr *{box-sizing:border-box;margin:0}\n.cr .grain{position:absolute;inset:0;pointer-events:none;opacity:.5;background-image:radial-gradient(rgba(70,56,28,.05) .5px,transparent .6px);background-size:5px 5px}\n/* iOS chrome */\n.cr .status{position:absolute;top:0;left:0;right:0;height:47px;display:flex;align-items:center;justify-content:space-between;padding:12px 28px 0;font:600 13px var(--font-body)}\n.cr .home{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:130px;height:5px;border-radius:3px;background:rgba(38,35,29,.85)}\n/* large title */\n.cr .hdr{position:absolute;top:58px;left:22px;right:22px}\n.cr .hdr .ovr{font-family:var(--font-mono);font-size:9px;letter-spacing:.22em;color:#8d8574}\n.cr .hdr h1{font-family:var(--font-display);font-weight:800;font-size:32px;letter-spacing:-.01em;color:#1c1a15;margin-top:4px}\n.cr .pills{display:flex;gap:7px;margin-top:10px}\n.cr .pill{height:24px;padding:0 10px;display:flex;align-items:center;gap:5px;border-radius:12px;background:#e9e3d5;border:1px solid rgba(70,56,28,.10);font-family:var(--font-mono);font-size:10px;color:#5d574a;font-variant-numeric:tabular-nums}\n/* Moshi decal + stitched pairing thread */\n.cr .moshiZone{position:absolute;top:196px;left:0;right:0;height:150px}\n.cr .mhost{position:absolute;left:26px;top:2px;width:118px;height:112px}\n.cr .mfall{position:absolute;left:34px;top:12px;width:96px;height:84px;border-radius:46% 54% 52% 48%/58% 50% 50% 42%;background:#171613;display:none}\n.cr .mfall:after{content:\"> <\";position:absolute;top:36%;left:50%;transform:translateX(-50%);font:700 14px var(--font-mono);color:#ccff36;letter-spacing:3px}\n.cr .mshadow{position:absolute;left:44px;top:112px;width:80px;height:10px;border-radius:50%;background:rgba(70,56,28,.22);filter:blur(3px);animation:cr-br 4.2s ease-in-out infinite}\n@keyframes cr-br{50%{transform:scaleX(.9);opacity:.7}}\n.cr .thread{position:absolute;inset:0;pointer-events:none}\n.cr .pair{position:absolute;right:26px;top:56px;text-align:right}\n.cr .pair .l1{font-size:11.5px;font-weight:600;color:#3c3830}\n.cr .pair .l2{font-family:var(--font-mono);font-size:9.5px;color:#8d8574;margin-top:2px}\n.cr .pair .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#7cb518;margin-right:5px;animation:cr-pulse 2.4s ease-in-out infinite}\n@keyframes cr-pulse{50%{opacity:.4}}\n/* faders: debossed paper grooves, ink thumbs, one lime position line */\n.cr .mix{position:absolute;top:360px;left:22px;right:22px}\n.cr .mix h3{font-family:var(--font-mono);font-size:9px;letter-spacing:.2em;color:#8d8574;margin-bottom:12px}\n.cr .ch{display:flex;align-items:center;gap:12px;margin-bottom:16px}\n.cr .ch .nm{width:52px;font-size:12px;font-weight:600;color:#3c3830}\n.cr .groove{position:relative;flex:1;height:14px;border-radius:7px;background:#e7e1d2;box-shadow:inset 0 2px 3px rgba(70,56,28,.22),inset 0 -1px 0 rgba(255,255,255,.8)}\n.cr .groove .lime{position:absolute;left:8px;top:50%;height:2px;border-radius:1px;background:#9adf20;transform:translateY(-50%)}\n.cr .groove .thumb{position:absolute;top:50%;width:26px;height:26px;border-radius:50%;background:#211f1a;transform:translate(-50%,-50%);box-shadow:0 3px 8px rgba(70,56,28,.4),inset 0 1px 0 rgba(255,255,255,.12);cursor:grab}\n.cr .ch .ms{display:flex;gap:5px}\n.cr .ch .ms i{width:22px;height:20px;border-radius:5px;font:600 9px var(--font-mono);font-style:normal;display:flex;align-items:center;justify-content:center;color:#5d574a;background:#e9e3d5;border:1px solid rgba(70,56,28,.12);cursor:pointer}\n.cr .ch .ms i.on{background:#211f1a;color:#f3efe6}\n/* the ink island: transport docked above the home indicator */\n.cr .island{position:absolute;left:16px;right:16px;bottom:30px;height:172px;border-radius:26px;background:linear-gradient(180deg,#191813,#12110d);box-shadow:0 16px 34px rgba(70,56,28,.38),inset 0 1px 0 rgba(255,255,255,.07);transition:transform .18s ease,box-shadow .18s ease;padding:18px 22px}\n.cr .island.lift{transform:translateY(-2px);box-shadow:0 22px 42px rgba(70,56,28,.45),inset 0 1px 0 rgba(255,255,255,.07)}\n.cr .bbt{display:flex;align-items:baseline;gap:10px}\n.cr .bbt .n{font-family:var(--font-mono);font-size:30px;font-weight:600;color:#f2efe6;font-variant-numeric:tabular-nums}\n.cr .bbt .n b{font-weight:400;color:#57544a}\n.cr .bbt .bpm{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;color:#8d8878}\n.cr .scrub{position:relative;height:10px;border-radius:5px;background:#23211a;margin:14px 0 16px;box-shadow:inset 0 1px 3px rgba(0,0,0,.6)}\n.cr .scrub .fill{position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:linear-gradient(90deg,#5a6b15,#9adf20)}\n.cr .scrub .knob{position:absolute;top:50%;width:18px;height:18px;border-radius:50%;background:#f2efe6;transform:translate(-50%,-50%);box-shadow:0 2px 6px rgba(0,0,0,.5)}\n.cr .keys{display:flex;gap:12px;align-items:center;justify-content:center}\n.cr .key{height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .1s,box-shadow .1s}\n.cr .key:active{transform:translateY(1.5px)}\n.cr .key.side{width:64px;background:#211f18;border:1px solid rgba(255,255,255,.06);box-shadow:0 2px 0 rgba(0,0,0,.5)}\n.cr .key.play{width:104px;background:#ccff36;box-shadow:0 4px 0 #7f9c1c,0 6px 16px rgba(204,255,54,.35)}\n.cr .key.play:active{box-shadow:0 2px 0 #7f9c1c,0 3px 8px rgba(204,255,54,.3)}\n.cr .key.play.bloom{animation:cr-bloom .5s ease}\n@keyframes cr-bloom{30%{box-shadow:0 4px 0 #7f9c1c,0 0 34px rgba(204,255,54,.85)}}\n.cr .key.play svg path{fill:#141309}\n.cr .key .rec{width:13px;height:13px;border-radius:50%;background:#c8503c}\n</style>\n<div class=\"grain\"></div>\n<div class=\"status\"><span>9:41</span><span style=\"font-family:var(--font-mono);font-size:11px\">&#9679;&#9679;&#9679;&#9675; &nbsp;&#9889;</span></div>\n<header class=\"hdr\">\n  <div class=\"ovr\">MOSH · POCKET REMOTE</div>\n  <h1>nocturne_04</h1>\n  <div class=\"pills\">\n    <span class=\"pill\">128 BPM</span><span class=\"pill\">A&#9837; MIN</span><span class=\"pill\" id=\"cr-bars\">BAR 005</span>\n  </div>\n</header>\n<div class=\"moshiZone\">\n  <svg class=\"thread\" viewBox=\"0 0 390 150\">\n    <path d=\"M136 66 C 172 42, 198 76, 222 64\" fill=\"none\" stroke=\"#a49a83\" stroke-width=\"1.2\" stroke-dasharray=\"4 4\" stroke-linecap=\"round\"/>\n  </svg>\n  <div class=\"mhost\" id=\"cr-host\"></div>\n  <div class=\"mfall\" id=\"cr-fb\"></div>\n  <div class=\"mshadow\"></div>\n  <div class=\"pair\">\n    <div class=\"l1\"><span class=\"dot\"></span>paired to MacBook Pro</div>\n    <div class=\"l2\">12 ms · Wi-Fi · session live</div>\n  </div>\n</div>\n<section class=\"mix\">\n  <h3>MIX</h3>\n  <div class=\"ch\"><span class=\"nm\">Drums</span><div class=\"groove\"><span class=\"lime\" style=\"width:58%\"></span><span class=\"thumb\" style=\"left:60%\"></span></div><div class=\"ms\"><i>M</i><i class=\"on\">S</i></div></div>\n  <div class=\"ch\"><span class=\"nm\">Bass</span><div class=\"groove\"><span class=\"lime\" style=\"width:44%\"></span><span class=\"thumb\" style=\"left:46%\"></span></div><div class=\"ms\"><i>M</i><i>S</i></div></div>\n  <div class=\"ch\"><span class=\"nm\">Vox</span><div class=\"groove\"><span class=\"lime\" style=\"width:70%\"></span><span class=\"thumb\" style=\"left:72%\"></span></div><div class=\"ms\"><i>M</i><i>S</i></div></div>\n</section>\n<div class=\"island\" id=\"cr-island\">\n  <div class=\"bbt\"><span class=\"n\" id=\"cr-bbt\">005<b>·</b>2<b>·</b>04</span><span class=\"bpm\">128 · 4/4</span></div>\n  <div class=\"scrub\" id=\"cr-scrub\"><span class=\"fill\" id=\"cr-fill\" style=\"width:32%\"></span><span class=\"knob\" id=\"cr-knob\" style=\"left:32%\"></span></div>\n  <div class=\"keys\">\n    <div class=\"key side\" title=\"stop\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 13 13\"><rect width=\"13\" height=\"13\" rx=\"2.5\" fill=\"#b9b4a4\"/></svg></div>\n    <div class=\"key play\" id=\"cr-play\" title=\"play\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\"><path d=\"M4 2l11 6.5L4 15z\"/></svg></div>\n    <div class=\"key side\" title=\"record\"><span class=\"rec\"></span></div>\n  </div>\n</div>\n<div class=\"home\"></div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var m=null;\n  if(window.Moshi){ try{ m=window.Moshi(root.querySelector('#cr-host'),{personality:'BUBBLE',seed:.7,quality:'ps2',style:'toon',interactive:true,room:false}); }catch(e){} }\n  if(!m){ root.querySelector('#cr-fb').style.display='block'; }\n  var island=root.querySelector('#cr-island'),play=root.querySelector('#cr-play');\n  var playing=false;\n  play.addEventListener('click',function(){\n    playing=!playing;\n    island.classList.add('lift');play.classList.add('bloom');\n    setTimeout(function(){island.classList.remove('lift');play.classList.remove('bloom')},520);\n    if(m){try{m.setState(playing?'LISTENING':'IDLE');m.set('energy',playing?.75:.35)}catch(e){}}\n  });\n  var fill=root.querySelector('#cr-fill'),knob=root.querySelector('#cr-knob');\n  var bbt=root.querySelector('#cr-bbt'),bars=root.querySelector('#cr-bars');\n  var manual=null;\n  var scrub=root.querySelector('#cr-scrub');\n  function setFromEvent(e){var r=scrub.getBoundingClientRect();manual=Math.min(1,Math.max(0,((e.touches?e.touches[0].clientX:e.clientX)-r.left)/r.width))}\n  scrub.addEventListener('pointerdown',function(e){setFromEvent(e);var mv=function(e2){setFromEvent(e2)},up=function(){document.removeEventListener('pointermove',mv);document.removeEventListener('pointerup',up)};document.addEventListener('pointermove',mv);document.addEventListener('pointerup',up)});\n  function tick(ts){\n    var p=manual!==null?manual:((window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/16000)%1));\n    fill.style.width=(p*100)+'%';knob.style.left=(p*100)+'%';\n    var bar=1+Math.floor(p*16),beat=1+Math.floor((p*16%1)*4);\n    bbt.innerHTML=('00'+bar).slice(-3)+'<b>·</b>'+beat+'<b>·</b>'+('0'+Math.floor((p*64%1)*96)).slice(-2);\n    bars.textContent='BAR '+('00'+bar).slice(-3);\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
