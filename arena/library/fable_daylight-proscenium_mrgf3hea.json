  "source": "<div class=\"dp\" style=\"--amb:.45;--dens:.4\">\n<style>\n/* DAYLIGHT PROSCENIUM — the cream identity as a sun-lit stage. One volumetric window-\n   shaft in the session's coat hue rakes golden-hour across bone paper; letterpress cards\n   physically catch it. Moshi stays invariant — it is his SHADOW that morphs with the\n   song. The ink-stamped arc widens the shaft from a sliver to a full flood. */\n.dp{position:absolute;inset:0;background:#f4f0e7;font-family:var(--font-body);color:#2b2820;overflow:hidden}\n.dp *{box-sizing:border-box;margin:0}\n.dp .grain{position:absolute;inset:0;pointer-events:none;opacity:.55;background-image:radial-gradient(rgba(70,56,28,.05) .5px,transparent .6px);background-size:4.5px 4.5px}\n/* THE shaft — coat-hued golden hour, width driven by --amb */\n.dp .shaft{position:absolute;top:-20%;bottom:-10%;left:50%;width:calc(6% + var(--amb)*54%);transform:translateX(-62%) rotate(16deg);transform-origin:top center;pointer-events:none;transition:width .8s ease;\n background:linear-gradient(90deg,transparent,rgba(224,164,74,calc(.14 + var(--amb)*.22)) 30%,rgba(238,190,110,calc(.20 + var(--amb)*.26)) 50%,rgba(224,164,74,calc(.14 + var(--amb)*.22)) 70%,transparent);filter:blur(6px)}\n.dp .warm{position:absolute;inset:0;pointer-events:none;background:radial-gradient(60% 70% at 46% 40%,rgba(238,190,110,calc(var(--amb)*.13)),transparent 75%);transition:background .8s}\n/* silent chrome */\n.dp .mark{position:absolute;top:26px;left:30px;font-family:var(--font-display);font-weight:800;font-size:16px;letter-spacing:.2em;color:rgba(43,40,32,.16);text-shadow:0 1px 0 rgba(255,255,255,.85),0 -1px 0 rgba(70,56,28,.25)}\n.dp .sess{position:absolute;top:30px;right:30px;font-family:var(--font-mono);font-size:9px;letter-spacing:.2em;color:#98907c}\n/* letterpress work plane — cards catch the light */\n.dp .plane{position:absolute;left:14%;right:14%;top:19%;height:48%}\n.dp .card{position:absolute;left:0;right:0;height:22%;border-radius:10px;background:#efe9dc;\n box-shadow:inset 0 1.5px 0 rgba(255,255,255,.9),0 4px 10px rgba(70,56,28,.16),0 1px 0 rgba(70,56,28,.10);padding:0 16px;display:flex;align-items:center;gap:14px}\n.dp .card .nm{font-family:var(--font-mono);font-size:9px;letter-spacing:.16em;color:#7d7563;width:52px}\n.dp .card .clip{position:relative;height:56%;border-radius:6px;background:#e6dfcd;box-shadow:inset 0 1px 3px rgba(70,56,28,.22),inset 0 -1px 0 rgba(255,255,255,.7)}\n.dp .card .clip i{position:absolute;inset:5px 4px;background:repeating-linear-gradient(90deg,rgba(70,60,40,.4) 0 1.6px,transparent 1.6px 4.6px);mask-image:linear-gradient(180deg,transparent,#000 30%,#000 70%,transparent)}\n.dp .ph{position:absolute;top:-3%;bottom:-3%;width:1.5px;background:#8fbe14;box-shadow:0 0 6px rgba(160,210,30,.5);z-index:5}\n/* the arc dial — ink-stamped */\n.dp .arc{position:absolute;left:50%;transform:translateX(-50%);bottom:8%;width:190px;text-align:center}\n.dp .arc svg{display:block;margin:0 auto}\n.dp .arc .lab{font-family:var(--font-mono);font-size:8px;letter-spacing:.26em;color:#98907c;margin-top:6px}\n.dp .arc .stopdot{cursor:pointer}\n/* Moshi — invariant creature, morphing SHADOW */\n.dp .mz{position:absolute;left:9%;bottom:6%;width:460px;height:230px}\n.dp .shadow{position:absolute;left:86px;bottom:14px;width:340px;height:150px;pointer-events:none}\n.dp .shadow path{fill:rgba(70,56,28,calc(.16 + var(--amb)*.14));transition:d .9s ease}\n.dp .mhost{position:absolute;left:0;bottom:0;width:120px;height:112px}\n.dp .mfall{position:absolute;left:12px;bottom:12px;width:92px;height:82px;border-radius:46% 54% 52% 48%/58% 50% 50% 42%;background:#191712;display:none}\n.dp .mfall:after{content:\"> <\";position:absolute;top:36%;left:50%;transform:translateX(-50%);font:700 13px var(--font-mono);color:#ccff36;letter-spacing:2px}\n.dp .dens{position:absolute;right:8%;bottom:9%;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.18em;color:#98907c;text-align:right}\n.dp .dens b{color:#5d5644;font-weight:400}\n</style>\n<div class=\"shaft\"></div>\n<div class=\"warm\"></div>\n<div class=\"grain\"></div>\n<div class=\"mark\">MOSH</div>\n<div class=\"sess\">nocturne_04 · F&#9839; MIN · 82</div>\n<div class=\"plane\" id=\"dp-plane\">\n  <div class=\"card\" style=\"top:0\"><span class=\"nm\">DRUMS</span><span class=\"clip\" style=\"width:34%\"><i></i></span><span class=\"clip\" style=\"width:22%\"><i></i></span></div>\n  <div class=\"card\" style=\"top:26%\"><span class=\"nm\">BASS</span><span class=\"clip\" style=\"width:52%\"><i></i></span></div>\n  <div class=\"card\" style=\"top:52%\"><span class=\"nm\">KEYS</span><span class=\"clip\" style=\"width:40%;margin-left:10%\"><i></i></span></div>\n  <div class=\"card\" style=\"top:78%\"><span class=\"nm\">VOX</span><span class=\"clip\" style=\"width:48%;margin-left:16%\"><i></i></span></div>\n  <div class=\"ph\" id=\"dp-ph\"></div>\n</div>\n<div class=\"arc\">\n  <svg width=\"190\" height=\"64\" viewBox=\"0 0 190 64\">\n    <path d=\"M15 58 A 82 82 0 0 1 175 58\" fill=\"none\" stroke=\"rgba(70,56,28,.28)\" stroke-width=\"1.5\" stroke-dasharray=\"1 5\"/>\n    <g id=\"dp-stops\">\n      <circle class=\"stopdot\" data-a=\".12\" cx=\"30\" cy=\"46\" r=\"5\" fill=\"#e6dfcd\" stroke=\"rgba(70,56,28,.4)\"/>\n      <circle class=\"stopdot\" data-a=\".45\" cx=\"72\" cy=\"26\" r=\"5\" fill=\"#8fbe14\"/>\n      <circle class=\"stopdot\" data-a=\".75\" cx=\"118\" cy=\"26\" r=\"5\" fill=\"#e6dfcd\" stroke=\"rgba(70,56,28,.4)\"/>\n      <circle class=\"stopdot\" data-a=\"1\" cx=\"160\" cy=\"46\" r=\"5\" fill=\"#e6dfcd\" stroke=\"rgba(70,56,28,.4)\"/>\n    </g>\n  </svg>\n  <div class=\"lab\">LIGHT · SLIVER &#8594; FLOOD</div>\n</div>\n<div class=\"mz\">\n  <svg class=\"shadow\" viewBox=\"0 0 340 150\" preserveAspectRatio=\"none\">\n    <path id=\"dp-shpath\" d=\"M0 140 C 50 134, 90 118, 140 122 C 170 124, 180 100, 205 112 C 220 119, 241.3 122, 265 124.3 C 288.8 126.5, 315 128, 340 132 L 340 150 L 0 150 Z\" style=\"filter:blur(7px)\"/>\n  </svg>\n  <div class=\"mhost\" id=\"dp-host\"></div>\n  <div class=\"mfall\" id=\"dp-fb\"></div>\n</div>\n<div class=\"dens\">ARRANGEMENT DENSITY<br/><b id=\"dp-densv\">growing · the shadow knows</b></div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var m=null;\n  if(window.Moshi){try{m=window.Moshi(root.querySelector('#dp-host'),{personality:'SILK',seed:.6,quality:'ps2',style:'toon',interactive:true,room:false});}catch(e){}}\n  if(!m){root.querySelector('#dp-fb').style.display='block'}\n  root.querySelectorAll('.stopdot').forEach(function(s){\n    s.addEventListener('click',function(){\n      root.querySelectorAll('.stopdot').forEach(function(x){x.setAttribute('fill','#e6dfcd');x.setAttribute('stroke','rgba(70,56,28,.4)')});\n      s.setAttribute('fill','#8fbe14');s.removeAttribute('stroke');\n      root.style.setProperty('--amb',s.dataset.a);\n    });\n  });\n  // the shadow morphs with arrangement density; the creature never does.\n  var sh=root.querySelector('#dp-shpath'),densv=root.querySelector('#dp-densv');\n  var shapes=[ // calm → tendrils → full lobes (all 4 cubics so the d-transition interpolates)\n    'M0 140 C 30 139, 60 137, 90 134.8 C 120 132.5, 150 130, 180 128 C 210 126, 240 126, 267.5 127.3 C 295 128.5, 320 131, 340 134 L 340 150 L 0 150 Z',\n    'M0 140 C 50 134, 90 118, 140 122 C 170 124, 180 100, 205 112 C 220 119, 241.3 122, 265 124.3 C 288.8 126.5, 315 128, 340 132 L 340 150 L 0 150 Z',\n    'M0 140 C 40 128, 70 96, 110 108 C 130 114, 140 78, 165 92 C 185 102, 195 66, 220 84 C 250 104, 290 112, 340 128 L 340 150 L 0 150 Z'];\n  var labels=['sparse · a quiet shadow','growing · the shadow knows','dense · tendrils in the light'];\n  var di=1;\n  setInterval(function(){ di=(di+1)%3; sh.setAttribute('d',shapes[di]); densv.textContent=labels[di]; },5200);\n  var ph=root.querySelector('#dp-ph');\n  function tick(ts){\n    var p=(window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/17000)%1);\n    ph.style.left=(p*100)+'%';\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
