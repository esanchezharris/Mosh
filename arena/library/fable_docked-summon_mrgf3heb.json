  "source": "<div class=\"ds\">\n<style>\n/* DOCKED SUMMON — the composer where it actually lives: bottom-center of a dimmed,\n   blurred arrangement, captured SUMMONED. Intelligence is demonstrated, not asserted:\n   a receipt row shows the last executed action as an undoable chip; the chips carry\n   real session data. The agent glyph is Moshi's splat, breathing lime while listening. */\n.ds{position:absolute;inset:0;background:#0c0d10;font-family:var(--font-body);color:#d3d6dc;overflow:hidden}\n.ds *{box-sizing:border-box;margin:0}\n/* the arrangement behind, dimmed + blurred */\n.ds .bg{position:absolute;inset:0;filter:blur(5px) brightness(.5);pointer-events:none}\n.ds .bg .lane{position:absolute;left:0;right:0;height:21%;border-bottom:1px solid rgba(255,255,255,.05)}\n.ds .bg .clip{position:absolute;top:22%;height:56%;border-radius:8px;background:#191b20;border:1px solid rgba(255,255,255,.06)}\n.ds .bg .clip i{position:absolute;inset:7px 6px;background:repeating-linear-gradient(90deg,#3c404a 0 2px,transparent 2px 5px);mask-image:linear-gradient(180deg,transparent,#000 25%,#000 75%,transparent)}\n.ds .bg .ph{position:absolute;top:0;bottom:0;width:1px;background:rgba(204,255,54,.6)}\n.ds .scrim{position:absolute;inset:0;background:radial-gradient(90% 70% at 50% 88%,transparent 20%,rgba(6,7,9,.72) 78%)}\n/* the summoned panel */\n.ds .panel{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);width:600px;border-radius:15px;z-index:4;\n background:rgba(19,20,25,.88);backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.08);border-top-color:rgba(255,255,255,.14);\n box-shadow:0 30px 70px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.05);transition:transform .22s,box-shadow .22s;padding:12px 14px 13px}\n.ds .panel.lift{transform:translate(-50%,-2px)}\n.ds .panel .hair{position:absolute;top:-1px;left:14px;right:14px;height:1px;background:#ccff36;opacity:0;transition:opacity .3s;box-shadow:0 0 10px rgba(204,255,54,.6)}\n.ds .panel.lift .hair{opacity:.9}\n/* receipt row — the last action, undoable */\n.ds .receipt{display:flex;align-items:center;gap:8px;margin-bottom:11px}\n.ds .receipt .ok{width:14px;height:14px;border-radius:50%;background:rgba(154,223,32,.15);display:flex;align-items:center;justify-content:center}\n.ds .receipt .ok svg{display:block}\n.ds .receipt .txt{font-size:11px;color:#9da1ab}\n.ds .receipt .txt b{color:#d3d6dc;font-weight:600}\n.ds .receipt .undo{margin-left:auto;font-family:var(--font-mono);font-size:9px;letter-spacing:.06em;color:#84878f;border:1px solid rgba(255,255,255,.09);border-radius:6px;padding:3px 8px;cursor:pointer}\n.ds .receipt .undo:hover{color:#ccff36;border-color:rgba(204,255,54,.4)}\n/* input row */\n.ds .row{display:flex;align-items:center;gap:11px}\n.ds .splat{width:36px;height:32px;flex:none}\n.ds .splat path.body{fill:#1b1d22;stroke:rgba(204,255,54,.35);stroke-width:1;transition:stroke .4s}\n.ds .splat.listen path.body{animation:ds-breathe 2.2s ease-in-out infinite}\n@keyframes ds-breathe{50%{stroke:rgba(204,255,54,.9)}}\n.ds input{flex:1;background:none;border:none;outline:none;color:#e6e8ee;font-family:var(--font-body);font-size:13.5px}\n.ds input::placeholder{color:#585b63}\n.ds .mic,.ds .send{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#84878f;cursor:pointer;border:1px solid rgba(255,255,255,.07)}\n.ds .mic:hover,.ds .send:hover{color:#e6e8ee;border-color:rgba(255,255,255,.18)}\n.ds .mic.on{color:#ccff36;border-color:rgba(204,255,54,.45)}\n/* the listening EQ strip — real, driven by the transport clock */\n.ds .eq{height:0;overflow:hidden;transition:height .35s ease;display:flex;align-items:flex-end;gap:2.5px;padding:0 2px}\n.ds .eq.open{height:26px;margin-top:10px}\n.ds .eq b{flex:1;background:linear-gradient(180deg,#ccff36,rgba(204,255,54,.25));border-radius:1.5px 1.5px 0 0;height:20%}\n/* session-aware chips + data chips */\n.ds .chips{display:flex;gap:7px;margin-top:12px;align-items:center}\n.ds .chip{height:26px;padding:0 11px;display:flex;align-items:center;border-radius:13px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.07);font-size:10.5px;color:#b6b9c2;cursor:pointer;white-space:nowrap}\n.ds .chip:hover{border-color:rgba(204,255,54,.4);color:#e6e8ee}\n.ds .chip b{font-family:var(--font-mono);font-size:8.5px;color:#6e717a;font-weight:400;margin-left:6px}\n.ds .data{margin-left:auto;display:flex;gap:5px}\n.ds .datum{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.1em;color:#6e717a;border:1px solid rgba(255,255,255,.06);border-radius:5px;padding:3px 6px}\n</style>\n<div class=\"bg\" id=\"ds-bg\"></div>\n<div class=\"scrim\"></div>\n<div class=\"panel\" id=\"ds-panel\">\n  <span class=\"hair\"></span>\n  <div class=\"receipt\">\n    <span class=\"ok\"><svg width=\"8\" height=\"7\" viewBox=\"0 0 8 7\"><path d=\"M1 3.6L3 5.6L7 1\" fill=\"none\" stroke=\"#9adf20\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span>\n    <span class=\"txt\">Re-imagined <b>Drums</b> · 4 new bars landed</span>\n    <span class=\"undo\">&#8984;Z undo</span>\n  </div>\n  <div class=\"row\">\n    <svg class=\"splat\" id=\"ds-splat\" viewBox=\"0 0 36 32\">\n      <path class=\"body\" d=\"M18 3c6.5 0 12.6 4.2 12.6 11 0 3.4-1.6 6-4 7.7 1.2 1.9 3.1 3 3.1 3s-3.5-.1-6-1.5c-1.7.6-3.6.9-5.7.9C11.5 24.1 5.4 20 5.4 14S11.5 3 18 3z\"/>\n      <path d=\"M13 12.4l2.7 1.7-2.7 1.7\" fill=\"none\" stroke=\"#ccff36\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      <path d=\"M23 12.4l-2.7 1.7 2.7 1.7\" fill=\"none\" stroke=\"#ccff36\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </svg>\n    <input id=\"ds-input\" placeholder=\"Ask Mosh to…\"/>\n    <span class=\"mic\" id=\"ds-mic\" title=\"hold to talk\"><svg width=\"12\" height=\"14\" viewBox=\"0 0 13 15\"><rect x=\"4\" y=\"1\" width=\"5\" height=\"8\" rx=\"2.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M1.5 7.5a5 5 0 0 0 10 0M6.5 12.5V14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg></span>\n    <span class=\"send\" title=\"send\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\"><path d=\"M1 6h9M7 2.5L10.5 6L7 9.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/></svg></span>\n  </div>\n  <div class=\"eq\" id=\"ds-eq\"></div>\n  <div class=\"chips\">\n    <span class=\"chip\">Finish the bridge<b>bars 33–41</b></span>\n    <span class=\"chip\">Write a hook<b>A minor</b></span>\n    <span class=\"chip\">Re-imagine drums<b>grit 40</b></span>\n    <div class=\"data\"><span class=\"datum\">A MIN</span><span class=\"datum\">128</span><span class=\"datum\">4/4</span></div>\n  </div>\n</div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var bg=root.querySelector('#ds-bg'),bh='';\n  var rows=[[6,28,40,22],[6,50],[18,38],[28,44],[10,30]];\n  rows.forEach(function(r,i){\n    bh+='<div class=\"lane\" style=\"top:'+(i*21)+'%\">';\n    for(var c=0;c<r.length;c+=2)bh+='<span class=\"clip\" style=\"left:'+r[c]+'%;width:'+r[c+1]+'%\"><i></i></span>';\n    bh+='</div>';\n  });\n  bh+='<div class=\"ph\" id=\"ds-ph\"></div>';\n  bg.innerHTML=bh;\n  var eq=root.querySelector('#ds-eq');for(var i=0;i<40;i++)eq.insertAdjacentHTML('beforeend','<b></b>');\n  var panel=root.querySelector('#ds-panel'),input=root.querySelector('#ds-input'),mic=root.querySelector('#ds-mic'),splat=root.querySelector('#ds-splat');\n  input.addEventListener('focus',function(){panel.classList.add('lift')});\n  input.addEventListener('blur',function(){panel.classList.remove('lift')});\n  var listening=false;\n  function setListen(on){listening=on;mic.classList.toggle('on',on);eq.classList.toggle('open',on);splat.classList.toggle('listen',on)}\n  mic.addEventListener('pointerdown',function(e){try{mic.setPointerCapture(e.pointerId)}catch(err){}setListen(true)});\n  document.addEventListener('pointerup',function(){if(listening)setListen(false)});\n  document.addEventListener('pointercancel',function(){if(listening)setListen(false)});\n  mic.addEventListener('click',function(e){e.preventDefault()});\n  var bars=eq.children,ph=root.querySelector('#ds-ph');\n  function tick(ts){\n    var p=(window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/16000)%1);\n    if(ph)ph.style.left=(p*100)+'%';\n    if(listening){var t=(window.__mosh&&window.__mosh.time)||ts/1000;\n      for(var i=0;i<bars.length;i++){var v=.15+.85*Math.abs(Math.sin(t*3.1+i*.55))*Math.abs(Math.sin(t*1.3+i*.21));bars[i].style.height=(v*100)+'%'}}\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
