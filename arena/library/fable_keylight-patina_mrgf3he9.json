  "source": "<div class=\"klp\" style=\"--amb:.38\">\n<style>\n/* KEYLIGHT PATINA — the session's key derives the coat (F♯ min → dusk violet-blue).\n   One dial — OFF · BREATHE · LIVE · FULL — rebalances the whole frame through a single\n   CSS variable: the field blooms, the work-glass gains contrast, the vignette deepens.\n   Moshi never changes size; his AURA is what the dial scales. Lime = interactive only. */\n.klp{position:absolute;inset:0;background:#0a0b10;font-family:var(--font-body);color:#d6d9e0;overflow:hidden}\n.klp *{box-sizing:border-box;margin:0}\n/* the generative coat field — dusk violet-blue keylight, scaled by --amb */\n.klp .field{position:absolute;inset:-12%;pointer-events:none;opacity:calc(.18 + var(--amb)*.82);transition:opacity .6s}\n.klp .field .b1{position:absolute;width:56%;height:64%;left:8%;top:12%;border-radius:50%;filter:blur(90px);background:radial-gradient(circle,rgba(94,84,214,.5),transparent 70%);animation:klp-d1 26s ease-in-out infinite alternate}\n.klp .field .b2{position:absolute;width:48%;height:56%;right:4%;bottom:6%;border-radius:50%;filter:blur(100px);background:radial-gradient(circle,rgba(56,96,190,.42),transparent 70%);animation:klp-d2 31s ease-in-out infinite alternate}\n.klp .field .b3{position:absolute;width:30%;height:34%;left:44%;top:52%;border-radius:50%;filter:blur(80px);background:radial-gradient(circle,rgba(150,90,200,.25),transparent 70%);animation:klp-d1 22s ease-in-out infinite alternate-reverse}\n@keyframes klp-d1{to{transform:translate(6%,4%) scale(1.12)}}\n@keyframes klp-d2{to{transform:translate(-5%,-3%) scale(1.08)}}\n.klp .vig{position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 220px rgba(0,0,0,calc(.25 + var(--amb)*.55));transition:box-shadow .6s}\n/* identity line */\n.klp .id{position:absolute;top:0;left:0;right:0;height:52px;display:flex;align-items:center;gap:14px;padding:0 22px;z-index:5}\n.klp .id .mark{font-family:var(--font-display);font-weight:800;font-size:15px;letter-spacing:.15em;color:#e8eaf0}\n.klp .id .coat{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:9px;letter-spacing:.18em;color:#8b8fa0}\n.klp .id .sw{width:12px;height:12px;border-radius:4px;background:linear-gradient(135deg,#5e54d6,#3860be);box-shadow:0 0 10px rgba(94,84,214,.6)}\n.klp .chipR{margin-left:auto;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.14em;color:#6a6e7e;border:1px solid rgba(255,255,255,.08);border-radius:6px;padding:4px 8px}\n.klp .chipR b{color:#9adf20;font-weight:400}\n/* the work plane on frosted glass — contrast scales with --amb */\n.klp .plane{position:absolute;left:11%;right:11%;top:15%;height:52%;border-radius:16px;z-index:4;\n background:rgba(14,15,22,calc(.42 + var(--amb)*.34));backdrop-filter:blur(calc(10px + var(--amb)*12px));\n border:1px solid rgba(255,255,255,calc(.07 + var(--amb)*.08));box-shadow:0 30px 80px rgba(0,0,0,calc(.3 + var(--amb)*.35));transition:background .6s,border-color .6s;overflow:hidden}\n.klp .ruler{height:24px;border-bottom:1px solid rgba(255,255,255,.06);position:relative;font-family:var(--font-mono);font-size:8px;color:#666a7a}\n.klp .ruler i{position:absolute;top:7px;font-style:normal}\n.klp .lane{position:relative;height:calc((100% - 24px)/4);border-bottom:1px solid rgba(255,255,255,.045)}\n.klp .lane .nm{position:absolute;left:12px;top:8px;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.14em;color:#787c8c}\n.klp .clip{position:absolute;top:20%;height:60%;border-radius:7px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);overflow:hidden}\n.klp .clip .w{position:absolute;inset:6px 5px 5px;background:repeating-linear-gradient(90deg,rgba(214,217,228,.5) 0 2px,transparent 2px 5px);mask-image:linear-gradient(180deg,transparent,#000 25%,#000 75%,transparent)}\n.klp .ph{position:absolute;top:0;bottom:0;width:1px;background:#ccff36;box-shadow:0 0 8px rgba(204,255,54,.7);z-index:6}\n/* the dial — OFF · BREATHE · LIVE · FULL */\n.klp .dial{position:absolute;left:50%;transform:translateX(-50%);bottom:9%;z-index:6;display:flex;flex-direction:column;align-items:center;gap:10px}\n.klp .stops{display:flex;gap:4px;padding:5px;border-radius:12px;background:rgba(12,13,20,.7);border:1px solid rgba(255,255,255,.08)}\n.klp .stop{height:30px;padding:0 16px;border-radius:8px;display:flex;align-items:center;font-family:var(--font-mono);font-size:9.5px;letter-spacing:.18em;color:#7c8092;cursor:pointer;border:1px solid transparent}\n.klp .stop:hover{color:#c9cdda}\n.klp .stop.on{color:#ccff36;border-color:rgba(204,255,54,.4);background:rgba(204,255,54,.07)}\n.klp .dlab{font-family:var(--font-mono);font-size:8px;letter-spacing:.24em;color:#5c6070}\n/* Moshi bottom-right: constant size; the AURA scales */\n.klp .mz{position:absolute;right:5%;bottom:7%;width:150px;height:150px;z-index:6}\n.klp .aura{position:absolute;left:50%;top:58%;width:calc(90px + var(--amb)*260px);height:calc(90px + var(--amb)*260px);transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(94,84,214,calc(.20 + var(--amb)*.30)),transparent 68%);filter:blur(14px);transition:width .7s,height .7s;pointer-events:none}\n.klp .pool{position:absolute;left:50%;bottom:-8px;width:calc(70px + var(--amb)*160px);height:16px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,rgba(94,84,214,calc(.25 + var(--amb)*.3)),transparent 70%);filter:blur(6px);transition:width .7s;pointer-events:none}\n.klp .mhost{position:absolute;inset:10px}\n.klp .mfall{position:absolute;inset:22%;border-radius:46% 54% 52% 48%/58% 50% 50% 42%;background:#14151c;border:1px solid rgba(255,255,255,.1);display:none}\n.klp .mfall:after{content:\"> <\";position:absolute;top:36%;left:50%;transform:translateX(-50%);font:700 13px var(--font-mono);color:#ccff36;letter-spacing:2px}\n/* library strip — the coat as recognition */\n.klp .lib{position:absolute;left:22px;bottom:22px;z-index:6}\n.klp .lib h5{font-family:var(--font-mono);font-size:8px;letter-spacing:.22em;color:#5c6070;margin-bottom:8px}\n.klp .lib .row{display:flex;gap:8px}\n.klp .thumb{width:44px;height:44px;border-radius:10px;position:relative;border:1px solid rgba(255,255,255,.1);cursor:pointer}\n.klp .thumb.cur{border-color:rgba(204,255,54,.5)}\n.klp .thumb i{position:absolute;inset:0;border-radius:9px}\n.klp .thumb b{position:absolute;bottom:-16px;left:0;right:0;text-align:center;font:400 6.5px var(--font-mono);letter-spacing:.08em;color:#5c6070}\n</style>\n<div class=\"field\"><span class=\"b1\"></span><span class=\"b2\"></span><span class=\"b3\"></span></div>\n<div class=\"vig\"></div>\n<header class=\"id\">\n  <span class=\"mark\">MOSH</span>\n  <span class=\"coat\"><span class=\"sw\"></span>DUSKGLASS · grown from F&#9839; MIN · 128</span>\n  <span class=\"chipR\">reactive · <b id=\"klp-live\">on playback</b></span>\n</header>\n<div class=\"plane\">\n  <div class=\"ruler\" id=\"klp-ruler\"></div>\n  <div class=\"lane\"><span class=\"nm\">DRUMS</span><span class=\"clip\" style=\"left:4%;width:30%\"><span class=\"w\"></span></span><span class=\"clip\" style=\"left:40%;width:24%\"><span class=\"w\"></span></span></div>\n  <div class=\"lane\"><span class=\"nm\">BASS</span><span class=\"clip\" style=\"left:4%;width:44%\"><span class=\"w\"></span></span></div>\n  <div class=\"lane\"><span class=\"nm\">KEYS</span><span class=\"clip\" style=\"left:18%;width:38%\"><span class=\"w\"></span></span></div>\n  <div class=\"lane\"><span class=\"nm\">VOX</span><span class=\"clip\" style=\"left:28%;width:46%\"><span class=\"w\"></span></span></div>\n  <div class=\"ph\" id=\"klp-ph\"></div>\n</div>\n<div class=\"dial\">\n  <div class=\"stops\" id=\"klp-stops\">\n    <span class=\"stop\" data-a=\"0\">OFF</span>\n    <span class=\"stop on\" data-a=\".38\">BREATHE</span>\n    <span class=\"stop\" data-a=\".68\">LIVE</span>\n    <span class=\"stop\" data-a=\"1\">FULL</span>\n  </div>\n  <span class=\"dlab\">COAT INTENSITY</span>\n</div>\n<div class=\"mz\">\n  <div class=\"aura\"></div><div class=\"pool\"></div>\n  <div class=\"mhost\" id=\"klp-host\"></div>\n  <div class=\"mfall\" id=\"klp-fb\"></div>\n</div>\n<div class=\"lib\">\n  <h5>LIBRARY</h5>\n  <div class=\"row\">\n    <span class=\"thumb cur\"><i style=\"background:linear-gradient(135deg,#5e54d6,#3860be)\"></i><b>nocturne_04</b></span>\n    <span class=\"thumb\"><i style=\"background:linear-gradient(135deg,#c4552e,#8e2f22)\"></i><b>heat_02</b></span>\n    <span class=\"thumb\"><i style=\"background:linear-gradient(135deg,#2e8a6b,#1e5e50)\"></i><b>tides</b></span>\n  </div>\n</div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var rr='';for(var b=0;b<13;b++)rr+='<i style=\"left:'+(2+b/13*96)+'%\">'+(b+1)+'</i>';\n  root.querySelector('#klp-ruler').innerHTML=rr;\n  var m=null;\n  if(window.Moshi){try{m=window.Moshi(root.querySelector('#klp-host'),{personality:'GHOST',seed:.31,quality:'ps2',style:'ps2',interactive:true,room:false});}catch(e){}}\n  if(!m){root.querySelector('#klp-fb').style.display='block'}\n  var stops=root.querySelectorAll('.stop');\n  stops.forEach(function(s){s.addEventListener('click',function(){\n    stops.forEach(function(x){x.classList.remove('on')});s.classList.add('on');\n    root.style.setProperty('--amb',s.dataset.a);\n    if(m){try{m.set('energy',.25+ +s.dataset.a*.6)}catch(e){}}\n  })});\n  var ph=root.querySelector('#klp-ph'),live=root.querySelector('#klp-live');\n  var b1=root.querySelector('.b1'),b2=root.querySelector('.b2');\n  var lastP=0,still=0;\n  function tick(ts){\n    var p=(window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/18000)%1);\n    ph.style.left=(2+p*96)+'%';\n    var moving=Math.abs(p-lastP)>1e-5;lastP=p;\n    still=moving?0:still+1;\n    var playing=still<30;\n    live.textContent=playing?'on playback':'settled';\n    // reactive only while the playhead moves: the field ripples in tempo; settled = near-still drift\n    var amp=playing?1+Math.sin(ts/234)*0.06:1;\n    // individual scale property: composes with the animated transform (which would override style.transform)\n    b1.style.scale=''+amp;b2.style.scale=''+(2-amp);\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
