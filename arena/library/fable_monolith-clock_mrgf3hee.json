  "source": "<div class=\"mlc\">\n<style>\n/* MONOLITH CLOCK — typography IS the transport. A monumental BBT readout with a rolling\n   ticks column; beneath it, recessed keys in a carved well of sandblasted near-black.\n   The lime filament under the baseline fills once per bar and IS the scrub surface.\n   Play powers the monument on; stop freezes it to absolute stillness. */\n.mlc{position:absolute;inset:0;background:#0d0e10;font-family:var(--font-body);color:#d6d9de;display:flex;align-items:center;justify-content:center;overflow:hidden;--armed:0}\n.mlc *{box-sizing:border-box;margin:0}\n.mlc .mono{position:relative;width:740px}\n/* the monument */\n.mlc .clock{display:flex;align-items:baseline;justify-content:center;gap:18px;font-family:var(--font-mono);font-variant-numeric:tabular-nums;user-select:none}\n.mlc .seg{font-size:96px;font-weight:600;letter-spacing:.01em;color:#3a3d43;transition:color .6s;line-height:1}\n.mlc.on .seg{color:#e9ebf0}\n.mlc .dot{font-size:60px;color:#26282d;transition:color .6s}\n.mlc.on .dot{color:#ccff36}\n.mlc.armed .dot{color:#e0503c}\n/* rolling ticks column */\n.mlc .roll{display:inline-block;height:96px;overflow:hidden;vertical-align:baseline}\n.mlc .roll .col{display:block;transition:transform .1s linear}\n.mlc .roll .col div{height:96px;font-size:96px;font-weight:600;line-height:96px}\n/* filament: fills once per bar; doubles as the scrub */\n.mlc .filament{position:relative;height:22px;margin-top:12px;cursor:ew-resize}\n.mlc .filament .base{position:absolute;left:6%;right:6%;top:10px;height:1px;background:#222429}\n.mlc .filament .fill{position:absolute;left:6%;top:9.5px;height:2px;width:0%;background:#ccff36;box-shadow:0 0 9px rgba(204,255,54,.55);transition:background .5s,box-shadow .5s}\n.mlc.armed .filament .fill{background:#e0503c;box-shadow:0 0 9px rgba(224,80,60,.55)}\n.mlc .beats{position:absolute;left:6%;right:6%;top:16px;display:flex;justify-content:space-between}\n.mlc .beats i{width:1px;height:6px;background:#2c2e34;transition:background .18s,box-shadow .18s}\n.mlc .beats i.hot{background:#ccff36;box-shadow:0 0 7px rgba(204,255,54,.8)}\n/* the carved well */\n.mlc .well{margin:30px auto 0;width:420px;display:flex;gap:16px;justify-content:center;padding:16px 20px;border-radius:18px;background:#101114;\n box-shadow:inset 0 3px 9px rgba(0,0,0,.75),inset 0 -1px 0 rgba(255,255,255,.05);position:relative;overflow:hidden}\n.mlc .well .ember{position:absolute;inset:0;background:linear-gradient(90deg,rgba(224,80,60,.22),transparent 55%);opacity:var(--armed);transition:opacity .8s;pointer-events:none}\n.mlc .key{width:62px;height:50px;border-radius:11px;background:#15161a;border:1px solid rgba(255,255,255,.05);border-top-color:rgba(255,255,255,.1);\n box-shadow:0 2px 0 rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .07s,box-shadow .07s}\n.mlc .key:active,.mlc .key.down{transform:translateY(1.5px);box-shadow:none}\n.mlc .key.playk{background:#ccff36;border-color:#a5cc2c;box-shadow:0 2.5px 0 #74901a}\n.mlc .key.playk svg path{fill:#1a1d07}\n.mlc .key.playk.down{box-shadow:0 .5px 0 #74901a}\n.mlc .bpm{position:absolute;right:26px;bottom:26px;text-align:right;font-family:var(--font-mono);cursor:pointer}\n.mlc .bpm .v{font-size:19px;font-weight:600;color:#9a9da5;font-variant-numeric:tabular-nums}\n.mlc .bpm .t{font-size:7.5px;letter-spacing:.24em;color:#4c4e55;margin-top:3px}\n.mlc .bpm:hover .v{color:#e9ebf0}\n</style>\n<div class=\"mono\">\n  <div class=\"clock\">\n    <span class=\"seg\" id=\"mlc-bar\">005</span><span class=\"dot\">·</span>\n    <span class=\"seg\" id=\"mlc-beat\">2</span><span class=\"dot\">·</span>\n    <span class=\"seg roll\"><span class=\"col\" id=\"mlc-col\"></span></span>\n  </div>\n  <div class=\"filament\" id=\"mlc-fil\">\n    <span class=\"base\"></span><span class=\"fill\" id=\"mlc-fill\"></span>\n    <span class=\"beats\" id=\"mlc-beats\"><i></i><i></i><i></i><i></i><i></i></span>\n  </div>\n  <div class=\"well\">\n    <span class=\"ember\"></span>\n    <div class=\"key\" title=\"previous\"><svg width=\"15\" height=\"14\" viewBox=\"0 0 15 14\"><path d=\"M3 2v10H1.5V2zM13.5 2v10L5.5 7z\" fill=\"#8a8d95\"/></svg></div>\n    <div class=\"key playk\" id=\"mlc-play\" title=\"play — power the monument\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\"><path d=\"M4 2l10 5.5L4 13z\"/></svg></div>\n    <div class=\"key\" id=\"mlc-stop\" title=\"stop\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\"><rect width=\"12\" height=\"12\" rx=\"2\" fill=\"#8a8d95\"/></svg></div>\n    <div class=\"key\" id=\"mlc-rec\" title=\"arm record\"><span style=\"width:13px;height:13px;border-radius:50%;background:#8a3d34\"></span></div>\n  </div>\n</div>\n<div class=\"bpm\" id=\"mlc-bpm\"><div class=\"v\">128.0</div><div class=\"t\">BPM · TAP</div></div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var col=root.querySelector('#mlc-col'),colHtml='';\n  for(var i=0;i<10;i++)colHtml+='<div>'+i+'</div>';\n  col.innerHTML=colHtml+'<div>0</div>';\n  var playing=false,armed=false,scrub=null;\n  var play=root.querySelector('#mlc-play'),rec=root.querySelector('#mlc-rec');\n  play.addEventListener('click',function(){playing=!playing;play.classList.toggle('down',playing);root.classList.toggle('on',playing)});\n  rec.addEventListener('click',function(){armed=!armed;root.classList.toggle('armed',armed);root.style.setProperty('--armed',armed?1:0)});\n  root.querySelector('#mlc-stop').addEventListener('click',function(){playing=false;play.classList.remove('down');root.classList.remove('on')});\n  var fil=root.querySelector('#mlc-fil');\n  fil.addEventListener('pointerdown',function(e){\n    var set=function(e2){var r=fil.getBoundingClientRect();scrub=Math.min(1,Math.max(0,(e2.clientX-r.left-r.width*.06)/(r.width*.88)))};\n    set(e);var mv=function(e2){set(e2)},up=function(){document.removeEventListener('pointermove',mv);document.removeEventListener('pointerup',up);if(!playing&&scrub!==null)frozen=scrub;setTimeout(function(){scrub=null},800)};\n    document.addEventListener('pointermove',mv);document.addEventListener('pointerup',up);\n  });\n  var bar=root.querySelector('#mlc-bar'),beat=root.querySelector('#mlc-beat'),fill=root.querySelector('#mlc-fill');\n  var beats=root.querySelectorAll('#mlc-beats i');\n  var frozen=0.3125;\n  function tick(ts){\n    var live=(window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/15000)%1);\n    var p=scrub!==null?scrub:(playing?live:frozen);\n    var b=1+Math.floor(p*16),bt=Math.floor((p*16%1)*4),tks=(p*64%1)*96;\n    bar.textContent=('00'+b).slice(-3);\n    beat.textContent=bt+1;\n    // odometer: the tens digit column rolls continuously with the ticks value\n    var t10=(tks/10)%10;\n    col.style.transform='translateY('+(-t10*96)+'px)';\n    col.style.transition=playing||scrub!==null?'transform .09s linear':'none';\n    var barFrac=(p*16)%1;\n    fill.style.width=(playing||scrub!==null?barFrac*88:0)+'%';\n    for(var i=0;i<beats.length;i++){\n      beats[i].classList.toggle('hot',(playing||scrub!==null)&&bt>=i&&barFrac*4-i<1&&barFrac*4-i>=0);\n    }\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
