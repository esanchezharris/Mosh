  "source": "<div class=\"pc\">\n<style>\n/* PORCELAIN CONSOLE — the composer as a full-width tactile VOICE CONSOLE in daylight.\n   Debossed input well like a channel strip; lime as concentrated INK, never glow. The\n   mic is a wide HOLD key: live transcription types with per-word confidence fade while\n   a thin lime ink-level meter runs along the console's top edge. */\n.pc{position:absolute;inset:0;background:#f2eee5;font-family:var(--font-body);color:#2b2820;overflow:hidden}\n.pc *{box-sizing:border-box;margin:0}\n.pc .grain{position:absolute;inset:0;pointer-events:none;opacity:.5;background-image:radial-gradient(rgba(70,56,28,.045) .5px,transparent .6px);background-size:4.5px 4.5px}\n/* quiet page above: hint of the arrangement in daylight */\n.pc .page{position:absolute;top:6%;left:8%;right:8%;height:44%;opacity:.75}\n.pc .prow{position:relative;height:22%;margin-bottom:2%}\n.pc .pcard{position:absolute;top:0;bottom:0;border-radius:8px;background:#eae4d6;box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 2px 6px rgba(70,56,28,.12)}\n.pc .pcard i{position:absolute;inset:6px 5px;background:repeating-linear-gradient(90deg,rgba(70,60,40,.35) 0 1.6px,transparent 1.6px 4.4px);mask-image:linear-gradient(180deg,transparent,#000 30%,#000 70%,transparent)}\n/* THE CONSOLE */\n.pc .console{position:absolute;left:0;right:0;bottom:0;height:190px;background:linear-gradient(180deg,#faf7f0,#f0ebdf);border-top:1px solid rgba(70,56,28,.14);box-shadow:0 -12px 30px rgba(70,56,28,.10)}\n.pc .ink{position:absolute;top:-1px;left:0;height:1.5px;background:#9adf20;width:0%;transition:width .12s linear}\n.pc .inner{position:absolute;inset:20px 34px 18px}\n/* splat mark, ink-on-bone */\n.pc .splat{position:absolute;left:0;top:8px;width:40px;height:36px}\n.pc .splat path.b{fill:#211f18}\n.pc .splat .eye{stroke:#9adf20;stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}\n/* the debossed well */\n.pc .well{position:absolute;left:58px;right:210px;top:0;height:58px;border-radius:13px;background:#e9e3d4;\n box-shadow:inset 0 2px 5px rgba(70,56,28,.22),inset 0 -1px 0 rgba(255,255,255,.85);display:flex;align-items:center;padding:0 18px}\n.pc .well .txt{font-size:14.5px;color:#39362c;line-height:1.35}\n.pc .well .txt .ghost{color:#a29a86}\n.pc .well .txt .w{opacity:.35;transition:opacity .5s}\n.pc .well .txt .w.sure{opacity:1}\n.pc .caret{display:inline-block;width:2px;height:16px;background:#7fae10;vertical-align:-3px;margin-left:2px;animation:pc-blink 1.1s steps(1) infinite}\n@keyframes pc-blink{50%{opacity:0}}\n/* keys: HOLD mic (centerpiece) + lime send */\n.pc .keys{position:absolute;right:0;top:0;display:flex;gap:12px}\n.pc .key{height:58px;border-radius:13px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;user-select:none;transition:transform .08s,box-shadow .08s}\n.pc .hold{width:118px;background:#efe9db;border:1px solid rgba(70,56,28,.18);box-shadow:0 2.5px 0 rgba(70,56,28,.25),inset 0 1px 0 rgba(255,255,255,.9)}\n.pc .hold span{font-family:var(--font-mono);font-size:8px;letter-spacing:.2em;color:#7d7563}\n.pc .hold.on{transform:translateY(2px);box-shadow:0 .5px 0 rgba(70,56,28,.25),inset 0 2px 5px rgba(70,56,28,.18)}\n.pc .hold.on span{color:#4d7a08}\n.pc .send{width:58px;background:#bff02e;box-shadow:0 2.5px 0 #7f9c1c,inset 0 1px 0 rgba(255,255,255,.55)}\n.pc .send:active{transform:translateY(2px);box-shadow:0 .5px 0 #7f9c1c}\n/* typeset propositions */\n.pc .props{position:absolute;left:58px;right:0;bottom:6px;display:flex;gap:20px;align-items:baseline}\n.pc .prop{cursor:pointer;border-bottom:1px solid transparent;padding-bottom:3px}\n.pc .prop:hover{border-bottom-color:#9adf20}\n.pc .prop .t{font-family:var(--font-display);font-weight:700;font-size:14px;color:#33302a;letter-spacing:.01em}\n.pc .prop .m{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.1em;color:#98907c;margin-left:8px}\n.pc .rule{position:absolute;left:58px;right:0;bottom:44px;height:1px;background:rgba(154,223,32,.55)}\n</style>\n<div class=\"grain\"></div>\n<div class=\"page\">\n  <div class=\"prow\"><span class=\"pcard\" style=\"left:0;width:30%\"><i></i></span><span class=\"pcard\" style=\"left:34%;width:22%\"><i></i></span></div>\n  <div class=\"prow\"><span class=\"pcard\" style=\"left:0;width:48%\"><i></i></span></div>\n  <div class=\"prow\"><span class=\"pcard\" style=\"left:12%;width:38%\"><i></i></span></div>\n  <div class=\"prow\"><span class=\"pcard\" style=\"left:22%;width:44%\"><i></i></span></div>\n</div>\n<div class=\"console\">\n  <span class=\"ink\" id=\"pc-ink\"></span>\n  <div class=\"inner\">\n    <svg class=\"splat\" id=\"pc-splat\" viewBox=\"0 0 40 36\">\n      <path class=\"b\" d=\"M20 3c7.4 0 14.2 4.8 14.2 12.4 0 3.8-1.8 6.7-4.6 8.7 1.4 2.1 3.6 3.4 3.6 3.4s-4-.1-6.8-1.7c-1.9.7-4.1 1-6.4 1C12.6 26.8 5.8 22 5.8 15.4S12.6 3 20 3z\"/>\n      <path class=\"eye\" id=\"pc-eL\" d=\"M14.5 13.5l3 1.9-3 1.9\"/>\n      <path class=\"eye\" id=\"pc-eR\" d=\"M25.5 13.5l-3 1.9 3 1.9\"/>\n    </svg>\n    <div class=\"well\">\n      <div class=\"txt\" id=\"pc-txt\"><span class=\"ghost\">Hold to talk, or type — </span><span class=\"caret\"></span></div>\n    </div>\n    <div class=\"keys\">\n      <div class=\"key hold\" id=\"pc-hold\">\n        <svg width=\"13\" height=\"15\" viewBox=\"0 0 13 15\"><rect x=\"4\" y=\"1\" width=\"5\" height=\"8\" rx=\"2.5\" fill=\"none\" stroke=\"#4d4a3e\" stroke-width=\"1.3\"/><path d=\"M1.5 7.5a5 5 0 0 0 10 0M6.5 12.5V14\" fill=\"none\" stroke=\"#4d4a3e\" stroke-width=\"1.3\"/></svg>\n        <span>HOLD · TALK</span>\n      </div>\n      <div class=\"key send\" title=\"send\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\"><path d=\"M2 7.5h10M8.5 3L13 7.5L8.5 12\" fill=\"none\" stroke=\"#1c1a10\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></div>\n    </div>\n    <div class=\"rule\"></div>\n    <div class=\"props\">\n      <span class=\"prop\"><span class=\"t\">Write a hook</span><span class=\"m\">A MIN · 8 BARS</span></span>\n      <span class=\"prop\"><span class=\"t\">Finish the bridge</span><span class=\"m\">BARS 33–41</span></span>\n      <span class=\"prop\"><span class=\"t\">Re-imagine the drums</span><span class=\"m\">GRIT 40</span></span>\n    </div>\n  </div>\n</div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var hold=root.querySelector('#pc-hold'),txt=root.querySelector('#pc-txt'),ink=root.querySelector('#pc-ink');\n  var eL=root.querySelector('#pc-eL'),eR=root.querySelector('#pc-eR');\n  var words=[['make',1],['the',1],['chorus',1],['hit',1],['harder',.55],['like',1],['bigger',.5],['drums',1],['and',1],['a',1],['wider',.6],['hook',1]];\n  var holding=false,wi=0,typer=null;\n  function start(e){\n    if(e.button>0)return;\n    if(typer)clearInterval(typer);\n    if(e.pointerId!=null&&hold.setPointerCapture){try{hold.setPointerCapture(e.pointerId)}catch(_){}}\n    holding=true;hold.classList.add('on');wi=0;\n    txt.innerHTML='<span class=\"caret\"></span>';\n    typer=setInterval(function(){\n      if(wi>=words.length){clearInterval(typer);return}\n      var w=words[wi++];\n      var el=document.createElement('span');el.className='w';el.textContent=(wi>1?' ':'')+w[0];\n      txt.insertBefore(el,txt.lastElementChild);\n      // per-word confidence fade: unsure words resolve a beat later\n      setTimeout(function(){el.classList.add('sure')},w[1]===1?60:700);\n    },340);\n  }\n  function stop(){\n    holding=false;hold.classList.remove('on');clearInterval(typer);ink.style.width='0%';\n  }\n  hold.addEventListener('pointerdown',start);\n  document.addEventListener('pointerup',function(){if(holding)stop()});\n  document.addEventListener('pointercancel',function(){if(holding)stop()});\n  function tick(ts){\n    if(holding){var t=(window.__mosh&&window.__mosh.time)||ts/1000;\n      ink.style.width=(18+Math.abs(Math.sin(t*4.2))*46+Math.abs(Math.sin(t*9.1))*20)+'%'}\n    var bl=(ts%5200)<130; // occasional idle blink\n    eL.style.opacity=bl?.15:1;eR.style.opacity=bl?.15:1;\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
