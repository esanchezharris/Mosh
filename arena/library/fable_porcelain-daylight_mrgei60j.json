ton class=\"ms m\" data-l=\"1\" aria-label=\"Mute bass\">M</button><button class=\"ms s\" data-l=\"1\" aria-label=\"Solo bass\">S</button></span>\n      <span class=\"th-meter\" id=\"mt1\"><i></i><i></i></span>\n    </div>\n    <div class=\"th-row\">\n      <span class=\"th-glyph\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"currentColor\"><rect x=\"1.5\" y=\"2.5\" width=\"3\" height=\"9\" rx=\".8\"/><rect x=\"5.5\" y=\"2.5\" width=\"3\" height=\"9\" rx=\".8\"/><rect x=\"9.5\" y=\"2.5\" width=\"3\" height=\"9\" rx=\".8\"/></svg></span>\n      <span class=\"th-name\"><b>Keys</b><span>RHODES · JUNO → SPRING</span></span>\n      <span class=\"th-ms\"><button class=\"ms m\" data-l=\"2\" aria-label=\"Mute keys\">M</button><button class=\"ms s\" data-l=\"2\" aria-label=\"Solo keys\">S</button></span>\n      <span class=\"th-meter\" id=\"mt2\"><i></i><i></i></span>\n    </div>\n    <div class=\"th-row\">\n      <span class=\"th-glyph\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><rect x=\"5\" y=\"1.5\" width=\"4\" height=\"7\" rx=\"2\"/><path d=\"M3 7a4 4 0 0 0 8 0M7 11v2\"/></svg></span>\n      <span class=\"th-name\"><b>Vox</b><span>LEAD · U87 → 1176</span></span>\n      <span class=\"th-ms\"><button class=\"ms m\" data-l=\"3\" aria-label=\"Mute vox\">M</button><button class=\"ms s\" data-l=\"3\" aria-label=\"Solo vox\">S</button></span>\n      <span class=\"th-meter\" id=\"mt3\"><i></i><i></i></span>\n    </div>\n  </aside>\n\n  <!-- ── the ink plate ── -->\n  <section class=\"bi-plate\" aria-label=\"Arrangement\">\n    <div class=\"p-grid\" id=\"grid\">\n      <div class=\"p-ruler\" id=\"ruler\"></div>\n      <div class=\"p-loop\" style=\"left:50%;width:25%\"></div>\n      <div class=\"p-looptint\" style=\"left:50%;width:25%\"></div>\n\n      <div class=\"p-lane\" data-l=\"0\" style=\"top:28px\">\n        <div class=\"clip\" data-kind=\"drum\" data-seed=\"3\" 