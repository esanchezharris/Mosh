  "source": "<div class=\"m3\">\n<style>\n/* MONUMENT v3 — the professional re-cut. A field recorder, not a game controller:\n   machined graphite, hairline seams, 1px key travel, micro-caps labels. Hit areas stay\n   giant (hands-free is function); the CHUNK goes. Moshi remains the talk button, with a\n   live PS2 ⟷ REFINED register toggle so the owner judges the creature's style in place. */\n.m3{position:absolute;inset:0;background:#0a0b0d;font-family:var(--font-body);color:#dfe2e8;overflow:hidden}\n.m3 *{box-sizing:border-box;margin:0;-webkit-user-select:none;user-select:none}\n@media (prefers-reduced-motion: reduce){.m3 *{transition-duration:0ms!important;animation:none!important}}\n\n.m3 .brush{position:absolute;inset:0;pointer-events:none;opacity:.5;background:repeating-linear-gradient(90deg,rgba(255,255,255,.012) 0 1px,transparent 1px 3px)}\n.m3 .status{position:absolute;top:0;left:0;right:0;height:47px;display:flex;align-items:center;justify-content:space-between;padding:12px 26px 0;font:600 13px var(--font-body);color:#b9bcc4;z-index:5}\n.m3 .home{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:130px;height:5px;border-radius:3px;background:rgba(255,255,255,.25);z-index:9}\n/* glance — an instrument readout, not a poster */\n.m3 .glance{position:absolute;top:58px;left:24px;right:24px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,.08)}\n.m3 .glance .r1{display:flex;justify-content:space-between;align-items:baseline}\n.m3 .song{font-family:var(--font-mono);font-size:9px;letter-spacing:.22em;color:#5c5f66}\n.m3 .pair{font-family:var(--font-mono);font-size:8px;letter-spacing:.14em;color:#4a4d54}\n.m3 .pair i{display:inline-block;width:5px;height:5px;border-radius:50%;background:#7cb518;margin-right:5px;font-style:normal}\n.m3 .bbt{margin-top:8px;font-family:var(--font-mono);font-size:44px;font-weight:500;letter-spacing:.02em;color:#eef0f4;font-variant-numeric:tabular-nums;line-height:1}\n.m3 .bbt b{font-weight:400;color:#33363c}\n/* timeline: precise, thin, friends as fine beads */\n.m3 .tl{position:absolute;top:150px;left:24px;right:24px;touch-action:none}\n.m3 .tll{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:7.5px;letter-spacing:.2em;color:#4a4d54;margin-bottom:8px}\n.m3 .bar{position:relative;height:30px;border-radius:6px;background:#101114;box-shadow:inset 0 1px 3px rgba(0,0,0,.6),inset 0 -1px 0 rgba(255,255,255,.03);cursor:ew-resize}\n.m3 .bar .ticks{position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 1px,transparent 1px 25%)}\n.m3 .bar .fill{position:absolute;left:0;top:0;bottom:0;border-radius:6px 0 0 6px;background:linear-gradient(90deg,rgba(204,255,54,.14),rgba(204,255,54,.3));width:32%}\n.m3 .bar .cursor{position:absolute;top:-4px;bottom:-4px;width:2px;border-radius:1px;background:#ccff36;left:32%}\n.m3 .bar .bead{position:absolute;top:50%;width:22px;height:22px;border-radius:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;font:700 7.5px var(--font-mono);color:#0a0b0d;border:1.5px solid #0a0b0d}\n.m3 .frl{display:flex;justify-content:space-between;margin-top:7px;font-family:var(--font-mono);font-size:8px;letter-spacing:.1em;color:#5c5f66}\n/* MOSHI — the talk button, with the register toggle beside him */\n.m3 .mz{position:absolute;top:232px;left:0;right:0;height:150px}\n.m3 .mbtn{position:absolute;left:50%;top:0;transform:translateX(-50%);width:158px;height:112px;cursor:pointer;transition:transform .1s;touch-action:none}\n.m3 .mbtn:active,.m3 .mbtn.on{transform:translateX(-50%) scale(.95)}\n.m3 .mhost{position:absolute;inset:0;pointer-events:none}\n.m3 .mfall{position:absolute;inset:10% 18%;border-radius:46% 54% 52% 48%/58% 50% 50% 42%;background:#131418;border:1px solid rgba(204,255,54,.25);display:none}\n.m3 .mfall:after{content:\"> <\";position:absolute;top:36%;left:50%;transform:translateX(-50%);font:700 14px var(--font-mono);color:#ccff36;letter-spacing:3px}\n.m3 .mline{position:absolute;left:50%;top:116px;transform:translateX(-50%);width:210px;height:1px;background:rgba(255,255,255,.08)}\n.m3 .mline:after{content:\"\";position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(204,255,54,0),transparent);transition:background .3s}\n.m3 .mbtn.on~.mline:after{background:linear-gradient(90deg,transparent,rgba(204,255,54,.8),transparent)}\n.m3 .mcap{position:absolute;left:0;right:0;top:126px;text-align:center;font-family:var(--font-mono);font-size:8px;letter-spacing:.26em;color:#5c5f66;transition:color .3s}\n.m3 .mcap.hot{color:#ccff36}\n/* the register toggle — the side-by-side, in place */\n.m3 .reg{position:absolute;right:24px;top:6px;z-index:1;display:flex;border:1px solid rgba(255,255,255,.09);border-radius:7px;overflow:hidden}\n.m3 .reg span{padding:5px 9px;font:600 7.5px var(--font-mono);letter-spacing:.16em;color:#5c5f66;cursor:pointer;transition:background-color .18s cubic-bezier(.22,.61,.36,1),color .18s cubic-bezier(.22,.61,.36,1)}\n.m3 .reg span.on{color:#0a0b0d;background:#c9ccd3}\n.m3 .reglab{position:absolute;right:24px;top:34px;font-family:var(--font-mono);font-size:6.5px;letter-spacing:.18em;color:#3c3f45;text-align:right}\n/* take status */\n.m3 .take{position:absolute;left:24px;right:24px;top:392px;display:flex;justify-content:space-between;align-items:center;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.2em;color:#5c5f66;transition:color .3s}\n.m3 .take .st{transition:color .3s}\n.m3 .take .st.hot{color:#ccff36}.m3 .take .st.warm{color:#d4685a}\n/* THE DECK — same giant hit areas, machined surfaces, 1px travel */\n.m3 .deck{position:absolute;left:20px;right:20px;top:414px;bottom:52px;display:flex;flex-direction:column;gap:12px}\n.m3 .krow{display:flex;gap:10px;flex:none}\n.m3 .key{flex:1;border-radius:12px;background:linear-gradient(180deg,#14151a,#101114);border:1px solid rgba(255,255,255,.07);border-top-color:rgba(255,255,255,.12);box-shadow:0 1px 0 rgba(0,0,0,.6);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;cursor:pointer;transition:transform .06s,box-shadow .06s,background .2s}\n.m3 .key:active{transform:translateY(1px);box-shadow:inset 0 1px 3px rgba(0,0,0,.5)}\n.m3 .key .kl{font-family:var(--font-mono);font-size:9px;letter-spacing:.32em;color:#6a6d75}\n.m3 .row-verdict{height:112px}\n.m3 .key.keep svg{stroke:#9adf20}\n.m3 .key.keep.flash{background:linear-gradient(180deg,#161a0c,#12150a);border-color:rgba(204,255,54,.35)}\n.m3 .key.redo svg{stroke:#b9bcc4}\n.m3 .row-stop{height:66px}\n.m3 .key.stop{flex-direction:row;gap:12px}\n.m3 .key.stop .sq{width:18px;height:18px;border-radius:3.5px;background:#b9bcc4}\n.m3 .row-go{flex:1;min-height:150px}\n.m3 .key.rec .ring{width:38px;height:38px;border-radius:50%;border:2px solid #c8463a;display:flex;align-items:center;justify-content:center}\n.m3 .key.rec .ring i{width:16px;height:16px;border-radius:50%;background:#c8463a;transition:transform .2s}\n.m3 .key.rec.on{border-color:rgba(200,70,58,.45)}\n.m3 .key.rec.on .ring i{transform:scale(1.25);animation:m3-rec 1.2s cubic-bezier(.4,0,.2,1) infinite}\n@keyframes m3-rec{50%{box-shadow:0 0 10px rgba(200,70,58,.75)}}\n.m3 .key.rec.on .kl{color:#d4685a}\n.m3 .key.play{background:linear-gradient(180deg,#c9f746,#b8e532);border-color:#93b526;box-shadow:0 1px 0 #6d8a17}\n.m3 .key.play:active{box-shadow:inset 0 1px 3px rgba(0,0,0,.25)}\n.m3 .key.play svg path{fill:#161a06}\n.m3 .key.play .kl{color:#465511}\n</style>\n<div class=\"brush\"></div>\n<div class=\"status\"><span>9:41</span><span style=\"font-family:var(--font-mono);font-size:11px\">&#9679;&#9679;&#9679;&#9675;&nbsp;&#9889;</span></div>\n<div class=\"glance\">\n  <div class=\"r1\"><span class=\"song\">NOCTURNE_04 · 128 · A&#9837; MIN</span><span class=\"pair\"><i></i>MACBOOK PRO · 12MS</span></div>\n  <div class=\"bbt\" id=\"m3-bbt\">005<b>·</b>2<b>·</b>04</div>\n</div>\n<div class=\"tl\">\n  <div class=\"tll\"><span>POSITION · DRAG TO SCRUB</span><span id=\"m3-pct\">32%</span></div>\n  <div class=\"bar\" id=\"m3-bar\">\n    <span class=\"ticks\"></span>\n    <span class=\"fill\" id=\"m3-fill\"></span>\n    <span class=\"bead\" style=\"background:#d98d4f;left:58%\" id=\"m3-b1\">K</span>\n    <span class=\"bead\" style=\"background:#649fbd;left:81%\" id=\"m3-b2\">J</span>\n    <span class=\"cursor\" id=\"m3-cur\"></span>\n  </div>\n  <div class=\"frl\"><span style=\"color:#d98d4f\">KAI · COOKING</span><span style=\"color:#649fbd\">JUJU · LISTENING</span></div>\n</div>\n<div class=\"mz\">\n  <div class=\"reg\" id=\"m3-reg\"><span class=\"on\" data-s=\"ps2\">PS2</span><span data-s=\"baked\">REFINED</span></div>\n  <div class=\"reglab\">MOSHI RENDER<br/>REGISTER</div>\n  <div class=\"mbtn\" id=\"m3-mbtn\" title=\"hold Moshi to talk\">\n    <div class=\"mhost\" id=\"m3-mhost\"></div>\n    <div class=\"mfall\" id=\"m3-fb\"></div>\n  </div>\n  <span class=\"mline\"></span>\n  <span class=\"mcap\" id=\"m3-mcap\">HOLD MOSHI TO TALK</span>\n</div>\n<div class=\"take\"><span>TAKE STATUS</span><span class=\"st\" id=\"m3-take\">TAKE 3 · READY</span></div>\n<div class=\"deck\">\n  <div class=\"krow row-verdict\">\n    <div class=\"key keep\" id=\"m3-keep\"><svg width=\"28\" height=\"22\" viewBox=\"0 0 34 26\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 14l9 8L31 3\"/></svg><span class=\"kl\">KEEP</span></div>\n    <div class=\"key redo\" id=\"m3-redo\"><svg width=\"25\" height=\"23\" viewBox=\"0 0 30 28\" fill=\"none\" stroke-width=\"2.6\" stroke-linecap=\"round\"><path d=\"M25 6a12 10.5 0 1 0 3 8\"/><path d=\"M28 2v6h-6\" stroke-linejoin=\"round\"/></svg><span class=\"kl\">REDO</span></div>\n  </div>\n  <div class=\"krow row-stop\">\n    <div class=\"key stop\" id=\"m3-stop\"><span class=\"sq\"></span><span class=\"kl\">STOP</span></div>\n  </div>\n  <div class=\"krow row-go\">\n    <div class=\"key rec\" id=\"m3-rec\"><span class=\"ring\"><i></i></span><span class=\"kl\">RECORD</span></div>\n    <div class=\"key play\" id=\"m3-play\"><svg width=\"38\" height=\"38\" viewBox=\"0 0 46 46\"><path d=\"M14 8l24 15-24 15z\"/></svg><span class=\"kl\">PLAY</span></div>\n  </div>\n</div>\n<div class=\"home\"></div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var m=null;\n  if(window.Moshi){try{m=window.Moshi(root.querySelector('#m3-mhost'),{personality:'TAR',seed:.42,quality:'ps2',style:'ps2',interactive:false,room:false});}catch(e){}}\n  if(!m){root.querySelector('#m3-fb').style.display='block'}\n  // the register toggle: judge PS2 vs REFINED in place\n  root.querySelectorAll('#m3-reg span').forEach(function(s){\n    s.addEventListener('click',function(){\n      root.querySelectorAll('#m3-reg span').forEach(function(x){x.classList.remove('on')});\n      s.classList.add('on');\n      if(m){try{m.setStyle(s.dataset.s)}catch(e){}}\n    });\n  });\n  var playing=false,scrub=null,pos=.32,talking=false,recording=false,take=3;\n  var mbtn=root.querySelector('#m3-mbtn'),mcap=root.querySelector('#m3-mcap');\n  var keep=root.querySelector('#m3-keep'),redo=root.querySelector('#m3-redo'),stop=root.querySelector('#m3-stop');\n  var rec=root.querySelector('#m3-rec'),play=root.querySelector('#m3-play'),takeEl=root.querySelector('#m3-take');\n  function setTake(t,cls){takeEl.textContent=t;takeEl.className='st'+(cls?' '+cls:'')}\n  mbtn.addEventListener('pointerdown',function(e){\n    if(mbtn.setPointerCapture){try{mbtn.setPointerCapture(e.pointerId)}catch(_){}}\n    talking=true;mbtn.classList.add('on');mcap.textContent=\"HE'S LISTENING\";mcap.classList.add('hot');\n    if(m){try{m.setState('LISTENING');m.set('mood',.9)}catch(e){}}\n  });\n  var endTalk=function(){if(!talking)return;talking=false;mbtn.classList.remove('on');\n    mcap.textContent='HOLD MOSHI TO TALK';mcap.classList.remove('hot');\n    if(m){try{m.setState(recording?'RECORDING':'IDLE')}catch(e){}}};\n  mbtn.addEventListener('pointerup',endTalk);mbtn.addEventListener('pointercancel',endTalk);\n  rec.addEventListener('click',function(){\n    recording=!recording;rec.classList.toggle('on',recording);\n    if(recording){playing=true;setTake('TAKE '+take+' · RECORDING','warm');if(m){try{m.setState('RECORDING');m.set('heat',.85)}catch(e){}}}\n    else{playing=false;setTake('TAKE '+take+' · STOPPED — KEEP OR REDO?','');if(m){try{m.setState('IDLE');m.set('heat',.1)}catch(e){}}}\n  });\n  stop.addEventListener('click',function(){\n    playing=false;\n    if(recording){recording=false;rec.classList.remove('on');setTake('TAKE '+take+' · STOPPED — KEEP OR REDO?','');if(m){try{m.set('heat',.1)}catch(e){}}}\n    if(m){try{m.setState('IDLE')}catch(e){}}\n  });\n  keep.addEventListener('click',function(){\n    if(recording){recording=false;playing=false;rec.classList.remove('on');if(m){try{m.set('heat',.1)}catch(e){}}}\n    keep.classList.add('flash');setTake('TAKE '+take+' KEPT ✓','hot');\n    setTimeout(function(){keep.classList.remove('flash');take++;setTake('TAKE '+take+' · READY','')},1300);\n    if(m){try{m.setState('IDLE');m.set('mood',.95)}catch(e){}}\n  });\n  redo.addEventListener('click',function(){\n    if(recording){recording=false;playing=false;rec.classList.remove('on');if(m){try{m.set('heat',.1)}catch(e){}}}\n    setTake('TAKE '+take+' DISCARDED · RE-ARMED','warm');\n    setTimeout(function(){setTake('TAKE '+take+' · READY','')},1300);\n    pos=Math.max(0,pos-.1);\n    if(m){try{m.setState('IDLE')}catch(e){}}\n  });\n  play.addEventListener('click',function(){playing=!playing;if(m){try{m.setState(playing?'LISTENING':'IDLE')}catch(e){}}});\n  var bar=root.querySelector('#m3-bar');\n  bar.addEventListener('pointerdown',function(e){\n    if(bar.setPointerCapture){try{bar.setPointerCapture(e.pointerId)}catch(_){}}\n    var set=function(ev){var r=bar.getBoundingClientRect();scrub=Math.min(1,Math.max(0,(ev.clientX-r.left)/r.width))};\n    set(e);\n    var mv=function(ev){set(ev)};\n    var up=function(){if(scrub!==null)pos=scrub;scrub=null;bar.removeEventListener('pointermove',mv);bar.removeEventListener('pointerup',up);bar.removeEventListener('pointercancel',up)};\n    bar.addEventListener('pointermove',mv);bar.addEventListener('pointerup',up);bar.addEventListener('pointercancel',up);\n  });\n  var fill=root.querySelector('#m3-fill'),cur=root.querySelector('#m3-cur'),bbt=root.querySelector('#m3-bbt'),pct=root.querySelector('#m3-pct');\n  var b1=root.querySelector('#m3-b1'),b2=root.querySelector('#m3-b2');\n  var f1=.58,f2=.81,last=null;\n  function tick(ts){\n    if(last===null)last=ts;var dt=(ts-last)/1000;last=ts;\n    if((playing||recording)&&scrub===null)pos=(pos+dt/46)%1;\n    var p=scrub!==null?scrub:pos;\n    fill.style.width=(p*100)+'%';cur.style.left=(p*100)+'%';pct.textContent=Math.round(p*100)+'%';\n    var b=1+Math.floor(p*16),bt=1+Math.floor((p*16%1)*4);\n    bbt.innerHTML=('00'+b).slice(-3)+'<b>·</b>'+bt+'<b>·</b>'+('0'+Math.floor((p*64%1)*96)).slice(-2);\n    f1=(f1+dt/52)%1;f2=(f2+dt/49)%1;\n    b1.style.left=(f1*100)+'%';b2.style.left=(f2*100)+'%';\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
