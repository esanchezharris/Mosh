  "source": "<div class=\"olp\">\n<style>\n/* OPEN LANES PRO — the starred headerless shell, re-cut in the professional register:\n   brushed graphite, hairline seams, a precision ruler with beat subdivisions, a 1px\n   playhead (no glow blob), desaturated identity hues, micro-caps type. Same concept:\n   color IS the track; controls hover in and pin when toggled. */\n.olp{position:absolute;inset:0;background:#0b0c0e;font-family:var(--font-body);color:#dfe2e8;overflow:hidden}\n.olp *{box-sizing:border-box;margin:0}\n@media (prefers-reduced-motion: reduce){.olp *{transition-duration:0ms!important;animation:none!important}}\n\n.olp .brush{position:absolute;inset:0;pointer-events:none;opacity:.4;background:repeating-linear-gradient(90deg,rgba(255,255,255,.011) 0 1px,transparent 1px 3px)}\n.olp .top{position:absolute;inset:0 0 auto 0;height:52px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 44px;border-bottom:1px solid rgba(255,255,255,.06);background:rgba(13,14,17,.6)}\n.olp .brand{font-family:var(--font-display);font-weight:800;font-size:14px;letter-spacing:.18em;color:#eef0f4}\n.olp .brand i{font-style:normal;color:#4a4d54}\n.olp .tr{display:flex;align-items:center;gap:10px;justify-self:center}\n.olp .k{width:28px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:6px;background:#121316;border:1px solid rgba(255,255,255,.06);border-top-color:rgba(255,255,255,.1);cursor:pointer}\n.olp .k{transition:transform .15s cubic-bezier(.2,.7,.3,1),border-color .15s linear}.olp .k:hover{border-color:rgba(255,255,255,.14)}.olp .k:active{transform:translateY(1px)}\n.olp .k.play svg path{fill:#ccff36}\n.olp .rd{font-family:var(--font-mono);font-size:17px;font-weight:500;color:#eef0f4;font-variant-numeric:tabular-nums}\n.olp .rd b{font-weight:400;color:#3a3d43}\n.olp .rd .s{display:block;font-size:7px;letter-spacing:.24em;color:#4a4d54;margin-top:2px}\n.olp .sess{justify-self:end;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.18em;color:#4a4d54}\n/* precision ruler: bars + beat subdivisions */\n.olp .ruler{position:absolute;top:52px;left:44px;right:44px;height:26px;border-bottom:1px solid rgba(255,255,255,.055)}\n.olp .ruler .num{position:absolute;top:7px;font-family:var(--font-mono);font-size:6.5px;letter-spacing:.08em;color:#3c3f45}\n.olp .ruler .tk{position:absolute;bottom:0;width:1px;background:rgba(255,255,255,.1)}\n.olp .lanes{position:absolute;top:78px;left:44px;right:44px;bottom:92px}\n.olp .lane{position:absolute;left:0;right:0;height:25%;border-bottom:1px solid rgba(255,255,255,.04)}\n.olp .lane .edge{position:absolute;top:22%;bottom:22%;width:2px;border-radius:1px;background:var(--hue);opacity:.7}\n.olp .lane .edge.l{left:-16px}.olp .lane .edge.r{right:-16px}\n.olp .lane .tag{position:absolute;top:8px;left:10px;display:flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:7.5px;letter-spacing:.2em;color:#565961;opacity:.8;transition:color .25s;z-index:3}\n.olp .lane:hover .tag{color:var(--hue)}\n.olp .lane .tag svg{display:block;opacity:.85}\n.olp .ctl{position:absolute;top:7px;right:10px;display:flex;gap:6px;z-index:6;opacity:0;transform:translateY(-2px);transition:opacity .18s linear,transform .24s cubic-bezier(.22,.61,.36,1);pointer-events:none}\n.olp .lane:hover .ctl{opacity:1;transform:none;pointer-events:auto}\n.olp .cbtn{width:27px;height:23px;border-radius:6px;display:flex;align-items:center;justify-content:center;font:700 8.5px var(--font-mono);color:#7c7f87;background:rgba(16,17,20,.95);border:1px solid rgba(255,255,255,.08);cursor:pointer}\n.olp .cbtn:hover{color:#dfe2e8;border-color:rgba(255,255,255,.18)}\n.olp .cbtn.arm .dot{width:7px;height:7px;border-radius:50%;border:1.5px solid #a04a40}\n.olp .cbtn.on{opacity:1!important;pointer-events:auto}\n.olp .cbtn.m.on{color:#d98a7e;border-color:rgba(200,90,74,.45)}\n.olp .cbtn.s.on{color:#ccff36;border-color:rgba(204,255,54,.45)}\n.olp .cbtn.arm.on .dot{background:#c8463a;border-color:#c8463a}\n.olp .lane.has-pin .ctl{opacity:1;transform:none;pointer-events:auto}\n.olp .lane.has-pin .ctl .cbtn:not(.on){opacity:0;pointer-events:none;transition:opacity .2s}\n.olp .lane.has-pin:hover .ctl .cbtn:not(.on){opacity:1;pointer-events:auto}\n.olp .lane.muted .clip{filter:saturate(.15) brightness(.42)}\n.olp .clip{position:absolute;top:22%;height:58%;border-radius:7px;background:#101114;border:1px solid rgba(255,255,255,.05);border-top-color:rgba(255,255,255,.09);overflow:hidden;cursor:grab;transition:filter .4s,border-color .2s;box-shadow:0 1px 0 rgba(0,0,0,.5)}\n.olp .clip:hover{border-color:color-mix(in srgb,var(--hue) 40%,transparent)}\n.olp .clip canvas{position:absolute;inset:0;width:100%;height:100%}\n.olp .ph{position:absolute;top:0;bottom:0;width:1px;background:#ccff36;z-index:8}\n.olp .comp{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);width:480px;height:38px;border-radius:10px;background:#101114;border:1px solid rgba(255,255,255,.06);border-top-color:rgba(255,255,255,.1);box-shadow:0 1px 0 rgba(0,0,0,.5);display:flex;align-items:center;gap:10px;padding:0 14px}\n.olp .comp .caret{width:1.5px;height:13px;background:#ccff36;animation:olp-blink 1.2s cubic-bezier(.4,0,.2,1) infinite}\n@keyframes olp-blink{0%,55%{opacity:1}60%{opacity:.3}100%{opacity:1}}\n.olp .comp .ph-t{font-size:12px;color:#4a4d54}\n.olp .comp .mic{margin-left:auto;color:#565961;cursor:pointer}.olp .comp .mic:hover{color:#b9bcc4}\n</style>\n<div class=\"brush\"></div>\n<header class=\"top\">\n  <div class=\"brand\">MOSH<i>·</i></div>\n  <div class=\"tr\">\n    <div class=\"k play\" title=\"play\"><svg width=\"9\" height=\"9\" viewBox=\"0 0 10 10\"><path d=\"M2 1l7 4-7 4z\"/></svg></div>\n    <div class=\"k\" title=\"stop\"><svg width=\"7\" height=\"7\" viewBox=\"0 0 8 8\"><rect width=\"8\" height=\"8\" rx=\"1.5\" fill=\"#8c8f98\"/></svg></div>\n    <div class=\"k\" title=\"record\"><span style=\"width:8px;height:8px;border-radius:50%;border:1.5px solid #a04a40\"></span></div>\n    <div class=\"rd\"><span id=\"olp-pos\">005<b>·</b>2<b>·</b>04</span><span class=\"s\">128 · A&#9837; MIN · 4/4</span></div>\n  </div>\n  <span class=\"sess\">NOCTURNE_04</span>\n</header>\n<div class=\"ruler\" id=\"olp-ruler\"></div>\n<main class=\"lanes\" id=\"olp-lanes\"></main>\n<div class=\"comp\">\n  <span class=\"caret\"></span><span class=\"ph-t\">Ask Mosh to…</span>\n  <svg class=\"mic\" width=\"11\" height=\"13\" viewBox=\"0 0 13 15\"><rect x=\"4\" y=\"1\" width=\"5\" height=\"8\" rx=\"2.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M1.5 7.5a5 5 0 0 0 10 0M6.5 12.5V14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg>\n</div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  function rng(s){return function(){s|=0;s=s+0x6D2B79F5|0;var t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}\n  var ruler=root.querySelector('#olp-ruler'),rr='';\n  for(var b=0;b<16;b++){\n    rr+='<span class=\"num\" style=\"left:'+(b/16*100)+'%\">'+(b+1<10?'0':'')+(b+1)+'</span>';\n    for(var q=0;q<4;q++){var x=(b+q/4)/16*100;rr+='<span class=\"tk\" style=\"left:'+x+'%;height:'+(q===0?9:4)+'px\"></span>'}\n  }\n  ruler.innerHTML=rr;\n  var G={\n    drum:'<svg width=\"10\" height=\"10\" viewBox=\"0 0 11 11\"><circle cx=\"5.5\" cy=\"5.5\" r=\"4.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/><circle cx=\"5.5\" cy=\"5.5\" r=\"1.3\" fill=\"currentColor\"/></svg>',\n    bass:'<svg width=\"11\" height=\"10\" viewBox=\"0 0 12 11\"><path d=\"M1 8c2-6 4 3 6-3s4 1 4 1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/></svg>',\n    keys:'<svg width=\"11\" height=\"10\" viewBox=\"0 0 12 11\"><rect x=\"1\" y=\"2\" width=\"10\" height=\"7\" rx=\"1.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/><path d=\"M4.3 2v4.4M7.6 2v4.4\" stroke=\"currentColor\" stroke-width=\"1.1\"/></svg>',\n    vox:'<svg width=\"9\" height=\"11\" viewBox=\"0 0 10 12\"><rect x=\"3\" y=\"1\" width=\"4\" height=\"6\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/><path d=\"M1.5 6a3.5 3.5 0 0 0 7 0M5 9.5V11\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/></svg>'};\n  // pro register: hues desaturated a step — identity whispers, never neon\n  var lanes=[\n    {hue:'#d89e4f',g:'drum',n:'DRUMS',k:'drum',clips:[[2,26],[34,28]]},\n    {hue:'#9684e8',g:'bass',n:'BASS', k:'bass',clips:[[2,44]]},\n    {hue:'#58c2a9',g:'keys',n:'KEYS', k:'midi',clips:[[16,36]],muted:true},\n    {hue:'#e28aa1',g:'vox', n:'VOX',  k:'vox', clips:[[26,46]]}];\n  var el=root.querySelector('#olp-lanes'),html='';\n  lanes.forEach(function(l,i){\n    html+='<div class=\"lane'+(l.muted?' muted has-pin':'')+'\" style=\"--hue:'+l.hue+';top:'+(i*25)+'%\">'\n      +'<span class=\"edge l\"></span><span class=\"edge r\"></span>'\n      +'<span class=\"tag\">'+G[l.g]+l.n+'</span>'\n      +'<span class=\"ctl\"><span class=\"cbtn arm\" title=\"arm\"><span class=\"dot\"></span></span><span class=\"cbtn m'+(l.muted?' on':'')+'\" title=\"mute\">M</span><span class=\"cbtn s\" title=\"solo\">S</span></span>';\n    l.clips.forEach(function(c){html+='<div class=\"clip\" style=\"left:'+c[0]+'%;width:'+c[1]+'%\"><canvas></canvas></div>'});\n    html+='</div>';\n  });\n  el.innerHTML=html;\n  el.insertAdjacentHTML('beforeend','<div class=\"ph\" id=\"olp-ph\"></div>');\n  function draw(){\n    var retry=false;\n    root.querySelectorAll('.lane').forEach(function(lane,li){\n      var hue=lanes[li].hue,k=lanes[li].k;\n      lane.querySelectorAll('canvas').forEach(function(cv){\n        var w=cv.parentElement.offsetWidth,h=cv.parentElement.offsetHeight;\n        if(w<8){retry=true;return}\n        if(cv.dataset.done)return;\n        cv.dataset.done='1';\n        cv.width=w*2;cv.height=h*2;var g=cv.getContext('2d');g.scale(2,2);\n        var r=rng(li*997+w|0);\n        g.fillStyle=hue;\n        if(k==='midi'){for(var n=0;n<12;n++){var x=6+n*(w-16)/12,y=8+r()*(h-22);g.globalAlpha=.45+r()*.45;g.beginPath();g.roundRect(x,y,10+r()*26,5.5,2.75);g.fill()}}\n        else if(k==='drum'){for(var K=0;K<Math.floor(w/9);K++){var v=(K%4===0)?1:(K%2===0?.6:.26+r()*.2);g.globalAlpha=.3+v*.55;var bh=Math.max(2,v*h*.6);g.fillRect(4+K*9,(h-bh)/2,3,bh)}}\n        else{var N=Math.floor(w/3);for(var q=0;q<N;q++){var t=q/N,e=(Math.sin(t*19+r()*7)*.5+.5)*(.35+.65*Math.pow(Math.sin(t*3.1),2))*(k==='bass'?.9:1)*(.5+r()*.5);g.globalAlpha=.35+e*.55;var hh=Math.max(1.5,e*h*.6);g.fillRect(q*3,(h-hh)/2,1.8,hh)}}\n      });\n    });\n    if(retry)requestAnimationFrame(draw);\n  }\n  requestAnimationFrame(draw);\n  root.querySelectorAll('.lane').forEach(function(lane){\n    lane.querySelectorAll('.cbtn').forEach(function(btn){\n      btn.addEventListener('click',function(){\n        var on=btn.classList.toggle('on');\n        if(btn.classList.contains('m'))lane.classList.toggle('muted',on);\n        lane.classList.toggle('has-pin',lane.querySelectorAll('.cbtn.on').length>0);\n      });\n    });\n  });\n  var ph=root.querySelector('#olp-ph'),pos=root.querySelector('#olp-pos');\n  function tick(ts){\n    var p=(window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/15000)%1);\n    ph.style.left=(p*100)+'%';\n    var b=1+Math.floor(p*16),bt=1+Math.floor((p*16%1)*4);\n    pos.innerHTML=('00'+b).slice(-3)+'<b>·</b>'+bt+'<b>·</b>'+('0'+Math.floor((p*64%1)*96)).slice(-2);\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
