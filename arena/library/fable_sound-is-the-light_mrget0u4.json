  "source": "<div class=\"sil\">\n<style>\n/* SOUND IS THE LIGHT — the chrome recedes to unlit ink; the only luminous objects in the\n   frame are the clips' CONTENTS. The playhead ignites each clip as it passes, and a lit\n   clip casts a real glow (a blurred duplicate of its own wave) onto the lane beneath. */\n.sil{position:absolute;inset:0;background:#0b0b0b;font-family:var(--font-body);color:#c9ccd1;overflow:hidden}\n.sil *{box-sizing:border-box;margin:0}\n.sil .top{position:absolute;inset:0 0 auto 0;height:54px;display:flex;align-items:center;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.04)}\n.sil .brand{font-family:var(--font-display);font-weight:800;font-size:16px;letter-spacing:.15em;color:#8e9196}\n.sil .brand i{font-style:normal;color:#3c3e42}\n.sil .tr{position:absolute;left:50%;top:8px;transform:translateX(-50%);height:38px;display:flex;align-items:center;gap:12px;padding:0 14px;border-radius:9px;border:1px solid rgba(255,255,255,.05)}\n.sil .k{width:28px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:6px;background:#111;border:1px solid rgba(255,255,255,.045);cursor:pointer}\n.sil .k:active{transform:translateY(1px)}\n.sil .k.play svg path{fill:#ccff36}\n.sil .rd{font-family:var(--font-mono);font-size:17px;color:#b9bcc2;font-variant-numeric:tabular-nums}\n.sil .rd b{font-weight:400;color:#43454a}\n.sil .rd .sub{font-size:8px;letter-spacing:.2em;color:#55575c;display:block;margin-top:1px}\n.sil .rail{position:absolute;top:54px;bottom:0;left:0;width:46px;border-right:1px solid rgba(255,255,255,.035);display:flex;flex-direction:column;align-items:center;padding-top:14px;gap:8px}\n.sil .tool{width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#4a4c51;cursor:pointer}\n.sil .tool.on{color:#a9acb2;background:#121212;border:1px solid rgba(255,255,255,.05)}\n.sil .tool:hover{color:#8e9196}\n.sil .stage{position:absolute;top:54px;left:46px;right:0;bottom:0}\n.sil .ruler{position:absolute;top:0;left:190px;right:16px;height:24px;font-family:var(--font-mono);font-size:8px;color:#3c3e42;border-bottom:1px solid rgba(255,255,255,.03)}\n.sil .ruler i{position:absolute;top:7px;font-style:normal}\n.sil .lanes{position:absolute;top:24px;left:0;right:16px;bottom:70px}\n.sil .lane{position:absolute;left:0;right:0;height:25%;border-bottom:1px solid rgba(255,255,255,.028)}\n.sil .head{position:absolute;top:0;bottom:0;left:0;width:190px;padding:12px 14px;border-right:1px solid rgba(255,255,255,.035)}\n.sil .head .nm{font-size:12px;font-weight:600;color:#8e9196;letter-spacing:.02em}\n.sil .head .ch{font-family:var(--font-mono);font-size:8px;letter-spacing:.12em;color:#44464b;display:block;margin-top:4px}\n.sil .head .ms{position:absolute;bottom:10px;left:14px;display:flex;gap:5px}\n.sil .head .ms i{width:17px;height:15px;border-radius:4px;font-family:var(--font-mono);font-size:8px;font-style:normal;display:flex;align-items:center;justify-content:center;color:#55575c;border:1px solid rgba(255,255,255,.05);cursor:pointer}\n.sil .area{position:absolute;top:0;bottom:0;left:190px;right:0}\n.sil .clip{position:absolute;top:11%;height:78%;border-radius:8px;border:1px solid rgba(255,255,255,.04);background:#0d0d0d;cursor:grab}\n.sil .clip .nm{position:absolute;top:5px;left:8px;font-family:var(--font-mono);font-size:7.5px;letter-spacing:.1em;color:#5a5c61;z-index:3}\n.sil .clip canvas{position:absolute;inset:0;width:100%;height:100%;transition:filter .45s ease,opacity .45s ease;filter:saturate(.25) brightness(.42);z-index:2}\n.sil .clip canvas.glow{z-index:1;inset:auto -6% -34% -6%;width:112%;height:64%;filter:blur(14px) saturate(.3) brightness(.35);opacity:.0;transition:opacity .5s,filter .5s}\n.sil .clip.lit canvas{filter:none}\n.sil .clip.lit canvas.glow{opacity:.5;filter:blur(14px)}\n.sil .ph{position:absolute;top:0;bottom:0;width:1px;background:linear-gradient(180deg,rgba(204,255,54,.85),rgba(204,255,54,.5));z-index:6;box-shadow:0 0 8px rgba(204,255,54,.5)}\n.sil .comp{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);width:540px;height:42px;border-radius:11px;background:#0e0e0e;border:1px solid rgba(255,255,255,.05);box-shadow:inset 0 2px 6px rgba(0,0,0,.7);display:flex;align-items:center;gap:10px;padding:0 14px}\n.sil .comp .slit{position:absolute;top:-1px;left:12%;right:12%;height:1px;background:#ccff36;opacity:.12;transition:opacity .35s,box-shadow .35s}\n.sil .comp:hover .slit,.sil .comp.on .slit{opacity:.95;box-shadow:0 0 12px rgba(204,255,54,.6)}\n.sil .comp input{flex:1;background:none;border:none;outline:none;color:#c9ccd1;font-family:var(--font-body);font-size:12.5px}\n.sil .comp input::placeholder{color:#4a4c51}\n.sil .comp .mic{color:#55575c;cursor:pointer}.sil .comp .mic:hover{color:#a9acb2}\n.sil .splat{position:absolute;right:22px;bottom:16px;width:52px;height:44px;cursor:pointer}\n</style>\n<header class=\"top\">\n  <div class=\"brand\">MOSH<i>·</i></div>\n  <div class=\"tr\">\n    <div class=\"k play\" title=\"play\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\"><path d=\"M2 1l7 4-7 4z\"/></svg></div>\n    <div class=\"k\" title=\"stop\"><svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\"><rect width=\"8\" height=\"8\" rx=\"1\" fill=\"#6a6d72\"/></svg></div>\n    <div class=\"k\" title=\"record\"><span style=\"width:8px;height:8px;border-radius:50%;background:#7a3a3a\"></span></div>\n    <div class=\"rd\"><span id=\"sil-pos\">005<b>·</b>2<b>·</b>04</span><span class=\"sub\">128 BPM · A&#9837; MIN</span></div>\n  </div>\n</header>\n<nav class=\"rail\">\n  <div class=\"tool on\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 13 13\"><path d=\"M2 1l9 5-4 1 2.5 4-1.8.9L5.3 8 2 10.5z\" fill=\"currentColor\"/></svg></div>\n  <div class=\"tool\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 13 13\"><path d=\"M1.5 11.5l1-3.4 6.8-6.8 2.4 2.4-6.8 6.8z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg></div>\n  <div class=\"tool\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 13 13\"><path d=\"M6.5 0v13\" stroke=\"currentColor\" stroke-width=\"1.1\" stroke-dasharray=\"2 2\"/></svg></div>\n</nav>\n<main class=\"stage\">\n  <div class=\"ruler\" id=\"sil-ruler\"></div>\n  <div class=\"lanes\" id=\"sil-lanes\"></div>\n  <div class=\"comp\" id=\"sil-comp\"><span class=\"slit\"></span>\n    <input placeholder=\"Ask Mosh to…\"/>\n    <svg class=\"mic\" width=\"12\" height=\"14\" viewBox=\"0 0 13 15\"><rect x=\"4\" y=\"1\" width=\"5\" height=\"8\" rx=\"2.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M1.5 7.5a5 5 0 0 0 10 0M6.5 12.5V14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg>\n  </div>\n  <svg class=\"splat\" viewBox=\"0 0 52 44\" title=\"Moshi\">\n    <path d=\"M26 4c9 0 18 6 18 16 0 5-2.4 8.6-6 11 1.8 2.6 4.4 4.2 4.4 4.2s-5-.2-8.6-2.2c-2.4.8-5 1.2-7.8 1.2C16 34.2 8 29 8 20S15 4 26 4z\" fill=\"#141414\" stroke=\"rgba(204,255,54,.25)\" stroke-width=\"1\"/>\n    <path id=\"sil-eL\" d=\"M19 17l3.6 2.2L19 21.4\" fill=\"none\" stroke=\"#ccff36\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <path id=\"sil-eR\" d=\"M33 17l-3.6 2.2 3.6 2.2\" fill=\"none\" stroke=\"#ccff36\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  </svg>\n</main>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  function rng(s){return function(){s|=0;s=s+0x6D2B79F5|0;var t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}\n  var ruler=root.querySelector('#sil-ruler'),rr='';\n  for(var b=0;b<17;b++)rr+='<i style=\"left:'+(b/17*100)+'%\">'+(b+1)+'</i>';\n  ruler.innerHTML=rr;\n  var lanes=[{n:'Drums',ch:'KIT · SAT',k:'drum',clips:[[2,26,'BREAK_A'],[34,30,'BREAK_B']]},\n             {n:'Bass',ch:'SUB · COMP',k:'bass',clips:[[2,44,'SUB_ROLL']]},\n             {n:'Keys',ch:'GLASS KEYS',k:'midi',clips:[[16,36,'CHORDS_4']]},\n             {n:'Vox',ch:'OTT · VERB',k:'vox',clips:[[26,46,'HOOK_T3']]}];\n  var lanesEl=root.querySelector('#sil-lanes'),html='';\n  lanes.forEach(function(l,i){\n    html+='<div class=\"lane\" style=\"top:'+(i*25)+'%\"><div class=\"head\"><span class=\"nm\">'+l.n+'</span><span class=\"ch\">'+l.ch+'</span><div class=\"ms\"><i>M</i><i>S</i></div></div><div class=\"area\">';\n    l.clips.forEach(function(c){html+='<div class=\"clip\" data-k=\"'+l.k+'\" data-a=\"'+c[0]+'\" data-b=\"'+(c[0]+c[1])+'\" style=\"left:'+c[0]+'%;width:'+c[1]+'%\"><span class=\"nm\">'+c[2]+'</span><canvas class=\"glow\"></canvas><canvas class=\"main\"></canvas></div>'});\n    html+='</div></div>';\n  });\n  lanesEl.innerHTML=html;\n  lanesEl.insertAdjacentHTML('beforeend','<div class=\"ph\" id=\"sil-ph\"></div>');\n  // the spectral bodies — lime-graded luminance, drawn once, shown lit/unlit by CSS\n  function drawInto(cv,k,w,h){\n    cv.width=w*2;cv.height=h*2;var g=cv.getContext('2d');g.scale(2,2);\n    var r=rng(k.length*991+w|0);\n    if(k==='midi'){\n      g.shadowColor='rgba(204,255,54,.8)';g.shadowBlur=7;\n      for(var n=0;n<12;n++){var x=6+n*(w-16)/12,y=10+r()*(h-30),ww=12+r()*30,hue=120+r()*40;\n        g.fillStyle='hsl('+(68+r()*14)+',95%,'+(55+r()*18)+'%)';\n        g.beginPath();g.roundRect(x,y,ww,8,4);g.fill();\n        if(r()>.55){g.beginPath();g.roundRect(x+ww*.4,y-6,ww*.5,8,4);g.fill()}}\n    } else if(k==='drum'){\n      for(var K=0;K<Math.floor(w/10);K++){var v=(K%4===0)?1:(K%2===0?.62:.28+r()*.2);\n        var grd=g.createRadialGradient(6+K*10,h/2,0,6+K*10,h/2,5+v*9);\n        grd.addColorStop(0,'rgba(224,255,120,'+(.5+v*.5)+')');grd.addColorStop(1,'rgba(160,220,40,0)');\n        g.fillStyle=grd;g.beginPath();g.arc(6+K*10,h/2,5+v*9,0,7);g.fill()}\n    } else {\n      var N=Math.floor(w/2.6);\n      for(var q=0;q<N;q++){var t=q/N,e=(Math.sin(t*19+r()*7)*.5+.5)*(.35+.65*Math.pow(Math.sin(t*3.1),2))*(k==='bass'?.92:1)*(.5+r()*.5);\n        var lum=35+e*45;\n        g.fillStyle='hsl('+(70+e*12)+',95%,'+lum+'%)';\n        var bh=Math.max(2,e*h*.76);g.fillRect(q*2.6,(h-bh)/2,1.7,bh)}\n    }\n  }\n  // Sandboxed (opaque-origin) iframes may run this script BEFORE layout exists —\n  // offsetWidth reads 2 (borders only) and the ||300 fallback never fires. Paint\n  // lazily: try now, then retry from the tick loop until the clips measure real.\n  var painted=false;\n  function paintClips(){\n    var first=root.querySelector('.clip');\n    if(!first||first.offsetWidth<40)return false;\n    root.querySelectorAll('.clip').forEach(function(cl){\n      var w=cl.offsetWidth||300,h=cl.offsetHeight||90,k=cl.dataset.k;\n      drawInto(cl.querySelector('.main'),k,w,h);\n      drawInto(cl.querySelector('.glow'),k,w,Math.max(30,h*.6));\n    });\n    return true;\n  }\n  painted=paintClips();\n  var ph=root.querySelector('#sil-ph'),pos=root.querySelector('#sil-pos');\n  var clips=root.querySelectorAll('.clip');\n  var comp=root.querySelector('#sil-comp');\n  comp.querySelector('input').addEventListener('focus',function(){comp.classList.add('on')});\n  comp.querySelector('input').addEventListener('blur',function(){comp.classList.remove('on')});\n  var eL=root.querySelector('#sil-eL'),eR=root.querySelector('#sil-eR');\n  function tick(ts){\n    if(!painted)painted=paintClips();\n    var p=(window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/15000)%1);\n    var aw=lanesEl.offsetWidth-190;\n    ph.style.left=(190+p*aw)+'px';\n    var pct=p*100;\n    clips.forEach(function(c){ c.classList.toggle('lit', pct>=+c.dataset.a-1); });\n    var bar=1+Math.floor(p*16),beat=1+Math.floor((p*16%1)*4);\n    pos.innerHTML=('00'+bar).slice(-3)+'<b>·</b>'+beat+'<b>·</b>'+('0'+Math.floor((p*64%1)*96)).slice(-2);\n    var bl=(ts%4600)<130;\n    eL.setAttribute('stroke-width',bl?.4:1.8);eR.setAttribute('stroke-width',bl?.4:1.8);\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
