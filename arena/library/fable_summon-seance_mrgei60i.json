window.__mosh.playhead:((performance.now()/1000)%24)/24}\nfunction clockT(){return window.__mosh?window.__mosh.time:performance.now()/1000}\nvar playBtn=$(\"#play\"),stopBtn=$(\"#stop\"),recBtn=$(\"#rec\"),prevBtn=$(\"#prev\");\nplayBtn.addEventListener(\"click\",function(){\n  if(playing)return;\n  playing=true;phOff=(clockPh()-phHold+1)%1;\n  playBtn.classList.add(\"on\");\n  if(SM)SM.set(\"energy\",.5)});\nstopBtn.addEventListener(\"click\",function(){\n  playing=false;playBtn.classList.remove(\"on\");\n  if(SM)SM.set(\"energy\",.22)});\nprevBtn.addEventListener(\"click\",function(){\n  phHold=0;if(playing)phOff=clockPh()});\nvar recOn=false;\nrecBtn.addEventListener(\"click\",function(){\n  recOn=!recOn;recBtn.classList.toggle(\"on\",recOn);frame.classList.toggle(\"recording\",recOn);\n  if(SM){SM.setState(recOn?\"RECORDING\":\"IDLE\");SM.set(\"heat\",recOn?.9:.05)}});\n\n/* ── the séance ─────────────────────────────────────────────── */\nvar holding=false,answering=false,holdAt=0,typeTimer=null,summonN=0;\nvar PHRASE=\"make the hook darker — stack my voice in thirds, keep the 808s rolling\";\nfunction startHold(){\n  if(holding||answering)return;\n  holding=true;holdAt=performance.now();\n  frame.classList.add(\"seance\");mic.classList.add(\"holding\");\n  ensureBig();\n  if(BM){BM.setState(\"LISTENING\");BM.set(\"energy\",.55);BM.set(\"mood\",.7);BM.lookAt(0,.08)}\n  if(SM)SM.setState(\"LISTENING\");\n  caption.textContent=\"MOSHI IS LISTENING\";caption.classList.remove(\"ans\");\n  pour.classList.remove(\"run\",\"back\");void pour.offsetWidth;pour.classList.add(\"run\");\n  hint.classList.add(\"used\");hint.classList.remove(\"nudge\");\n  input.value=\"\";var i=0;clearInterval(typeTimer);\n  typeTimer=setInterval(function(){\n    if(!holding){clearInterval(typeTimer);return}\n    if(i<PHRASE.length)input.value=PHRASE.slice(0,++i);\n    else clearInterval(typeTimer)},26)}\nfunction endHold(){\n  if(!holding)return;\n  holding=false;mic.classList.remove(\"hold