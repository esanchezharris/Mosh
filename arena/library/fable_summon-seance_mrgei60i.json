{
  "id": "fable_summon-seance_mrgei60i",
  "title": "Moshi ✦ The Séance",
  "target": "moshi",
  "pass": "bolder",
  "kind": "html",
  "model": "fable-insession",
  "source": "<style>\n/* ============================================================\n   MOSHI — THE SÉANCE\n   At rest he lives at 64px inside the composer's left slot.\n   Hold the mic (or hold M) and the room changes: the arrangement\n   tips back 8° like a stage floor, the song's coat floods the air,\n   and he pours upward into a 380px presence above his own\n   reflection. His answer lands as a ghost clip on the timeline.\n   Release: one squash-and-stretch collapse back into the slot.\n   The hold gesture IS the intensity dial. No pills. No sliders.\n   ============================================================ */\n\n#frame{position:absolute;inset:0;overflow:hidden;font-family:var(--font-body);\n  color:var(--v2-text);background:var(--v2-bg)}\n\n/* ── vignette depth ─────────────────────────────────────────── */\n#vig{position:absolute;inset:0;z-index:3;pointer-events:none;\n  background:radial-gradient(120% 90% at 50% 30%,transparent 55%,rgba(0,0,0,.38) 100%)}\n\n/* ── topbar ─────────────────────────────────────────────────── */\n#topbar{position:absolute;top:0;left:0;right:0;height:var(--v2-topbar-h);z-index:8;\n  display:flex;align-items:center;padding:0 20px;gap:16px;\n  background:linear-gradient(180deg,rgba(18,18,19,.86),rgba(14,14,15,.62));\n  border-bottom:1px solid var(--v2-line);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.04);\n  backdrop-filter:blur(14px);transition:filter .3s ease}\n.seance #topbar{filter:brightness(.55);transition:filter .62s ease}\n#brand{display:flex;align-items:center;gap:10px}\n#brand svg{display:block}\n#brand .wm{font-family:var(--font-display);font-size:17px;letter-spacing:.10em;color:var(--v2-text)}\n#brand .proj{font:500 var(--v2-fs-2xs)/1 var(--font-mono);letter-spacing:var(--v2-tracking-caps);\n  color:var(--v2-faint);margin-left:6px;padding-left:14px;border-left:1px solid var(--v2-line)}\n\n#transport{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);\n  display:flex;align-items:center;gap:8px}\n.tbtn{width:34px;height:34px;border-radius:50%;border:1px solid var(--v2-line);\n  background:var(--v2-surface);color:var(--v2-dim);display:grid;place-items:center;\n  cursor:pointer;transition:background .15s ease,color .15s ease,border-color .15s ease,transform .1s ease}\n.tbtn:hover{background:var(--v2-surface-2);color:var(--v2-text);border-color:var(--v2-line-strong)}\n.tbtn:active{transform:scale(.94)}\n.tbtn:focus-visible{outline:2px solid var(--v2-accent);outline-offset:2px}\n.tbtn svg{display:block}\n#play{width:40px;height:40px}\n#play.on{background:var(--v2-accent);border-color:var(--v2-accent);color:var(--v2-accent-ink);\n  box-shadow:0 0 20px rgba(204,255,54,.28)}\n#rec.on{background:rgba(255,59,92,.16);border-color:rgba(255,59,92,.6);color:var(--v2-rec);\n  box-shadow:0 0 16px rgba(255,59,92,.25)}\n#ro{margin-left:12px;padding:7px 14px;border-radius:var(--v2-radius-sm);\n  background:var(--v2-surface-sunken);border:1px solid var(--v2-line);\n  font:600 12px/1 var(--font-mono);letter-spacing:.08em;color:var(--v2-text);\n  font-variant-numeric:tabular-nums;min-width:104px;text-align:center}\n#ro .u{color:var(--v2-faint)}\n\n#sess{margin-left:auto;display:flex;align-items:center;gap:10px;\n  font:500 var(--v2-fs-2xs)/1 var(--font-mono);letter-spacing:var(--v2-tracking-caps);color:var(--v2-dim)}\n#sess .dot{width:6px;height:6px;border-radius:50%;background:var(--v2-accent);\n  box-shadow:0 0 8px rgba(204,255,54,.55)}\n#sess .recdot{display:none;width:6px;height:6px;border-radius:50%;background:var(--v2-rec);\n  box-shadow:0 0 8px rgba(255,59,92,.6);animation:blinkrec 1s steps(2,jump-none) infinite}\n.recording #sess .recdot{display:block}\n@keyframes blinkrec{50%{opacity:.25}}\n\n/* ── left tool rail ─────────────────────────────────────────── */\n#rail{position:absolute;top:var(--v2-topbar-h);left:0;bottom:0;width:var(--v2-tab-w);z-index:2;\n  display:flex;flex-direction:column;align-items:center;gap:6px;padding-top:16px;\n  background:rgba(14,14,15,.5);border-right:1px solid var(--v2-line);transition:filter .3s ease}\n.seance #rail{filter:brightness(.55);transition:filter .62s ease}\n.tool{width:32px;height:32px;border-radius:var(--v2-radius-md);border:1px solid transparent;\n  background:transparent;color:var(--v2-faint);display:grid;place-items:center;cursor:pointer;\n  transition:color .15s,background .15s}\n.tool:hover{color:var(--v2-dim);background:var(--v2-surface)}\n.tool.on{color:var(--v2-accent);background:var(--v2-accent-soft);border-color:rgba(204,255,54,.22)}\n.tool:focus-visible{outline:2px solid var(--v2-accent);outline-offset:2px}\n\n/* ── the stage (tilts back during the séance) ───────────────── */\n#stagewrap{position:absolute;top:var(--v2-topbar-h);left:var(--v2-tab-w);right:0;bottom:0;z-index:1;\n  perspective:1150px;perspective-origin:50% 26%;overflow:hidden}\n#arr{max-width:1160px;margin:26px auto 0;padding:0 22px;\n  transition:transform .3s ease,filter .3s ease;transform-origin:50% 100%}\n.seance #arr{transform:rotateX(8deg) translateY(-16px) scale(.945);\n  filter:brightness(.5) saturate(.85);\n  transition:transform .62s cubic-bezier(.3,.9,.2,1),filter .62s ease}\n\n#gridWrap{position:relative}\n.grow{display:grid;grid-template-columns:168px 1fr;align-items:stretch}\n\n/* song sections */\n#sections{height:20px;margin-bottom:6px}\n#sections .cells{position:relative}\n.sect{position:absolute;top:0;bottom:0;display:flex;align-items:center;padding-left:8px;\n  font:600 var(--v2-fs-2xs)/1 var(--font-mono);letter-spacing:var(--v2-tracking-caps);\n  color:var(--v2-faint);border-left:1px solid var(--v2-line)}\n.sect.hook{color:rgba(204,255,54,.6)}\n#corner{display:flex;align-items:center;font:500 var(--v2-fs-2xs)/1 var(--font-mono);\n  letter-spacing:var(--v2-tracking-caps);color:var(--v2-faint);padding-left:2px}\n\n/* ruler */\n#ruler{height:var(--v2-ruler-h);margin-bottom:8px}\n#ruler .cells{position:relative;border-bottom:1px solid var(--v2-line);\n  background:linear-gradient(90deg,var(--v2-line) 1px,transparent 1px);\n  background-size:calc(100%/32) 100%}\n.rnum{position:absolute;top:4px;font:500 var(--v2-fs-2xs)/1 var(--font-mono);color:var(--v2-faint);\n  transform:translateX(4px)}\n#loopBrace{position:absolute;top:0;height:3px;border-radius:2px;background:var(--v2-accent);\n  opacity:.7;box-shadow:0 0 8px rgba(204,255,54,.4)}\n\n/* lanes */\n.row{margin-bottom:5px}\n.rhead{height:66px;display:grid;grid-template-columns:26px 1fr auto;align-items:center;gap:8px;\n  padding:0 10px 0 8px;background:var(--v2-surface);border:1px solid var(--v2-line);\n  border-right:none;border-radius:var(--v2-radius-sm) 0 0 var(--v2-radius-sm);\n  box-shadow:var(--v2-glow)}\n.ticon{width:26px;height:26px;border-radius:var(--v2-radius-xs);display:grid;place-items:center;\n  color:var(--v2-dim);background:var(--v2-surface-sunken)}\n.ticon svg{width:13px;height:13px;fill:currentColor}\n.tname{min-width:0}\n.tname b{display:block;font-size:var(--v2-fs-sm);font-weight:700;letter-spacing:.04em}\n.tname i{display:block;font:500 var(--v2-fs-2xs)/1.5 var(--font-mono);font-style:normal;\n  letter-spacing:.08em;color:var(--v2-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.tside{display:flex;align-items:center;gap:7px}\n.lvl{width:3px;height:26px;border-radius:2px;background:var(--v2-surface-sunken);\n  position:relative;overflow:hidden}\n.lvl i{position:absolute;left:0;right:0;bottom:0;height:0;border-radius:2px;\n  background:linear-gradient(180deg,var(--v2-accent),rgba(204,255,54,.35));\n  transition:height .09s linear}\n.ms{display:flex;flex-direction:column;gap:3px}\n.msb{width:17px;height:15px;border-radius:4px;border:1px solid var(--v2-line);\n  background:transparent;color:var(--v2-faint);font:700 8px/1 var(--font-mono);\n  display:grid;place-items:center;cursor:pointer;transition:all .12s ease}\n.msb:hover{color:var(--v2-dim);border-color:var(--v2-line-strong)}\n.msb:focus-visible{outline:2px solid var(--v2-accent);outline-offset:1px}\n.msb.m.on{background:rgba(255,212,92,.14);border-color:rgba(255,212,92,.5);color:var(--status-warn)}\n.msb.s.on{background:var(--v2-accent);border-color:var(--v2-accent);color:var(--v2-accent-ink)}\n.cliprow{height:66px;position:relative;background:var(--v2-surface-sunken);\n  border:1px solid var(--v2-line);border-radius:0 var(--v2-radius-sm) var(--v2-radius-sm) 0;\n  background-image:linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px),\n                   linear-gradient(90deg,rgba(255,255,255,.028) 1px,transparent 1px);\n  background-size:calc(100%/8) 100%,calc(100%/32) 100%;\n  transition:box-shadow .5s ease,background-color .5s ease}\n.row.muted .cliprow>.clip{opacity:.28;filter:saturate(.4)}\n.row.lit .cliprow{box-shadow:inset 0 0 0 1px rgba(204,255,54,.35),0 0 28px rgba(204,255,54,.14);\n  background-color:rgba(204,255,54,.04)}\n\n/* clips */\n.clip{position:absolute;top:5px;bottom:5px;border-radius:var(--v2-radius-md);\n  border:1px solid rgba(255,255,255,.11);overflow:hidden;cursor:grab;\n  transition:filter .15s ease,transform .15s ease,border-color .15s ease,opacity .4s ease}\n.clip:hover{filter:brightness(1.18);border-color:var(--v2-line-strong);transform:translateY(-1px)}\n.clip .cl{position:absolute;top:4px;left:8px;font:600 var(--v2-fs-xs)/1 var(--font-body);\n  letter-spacing:.03em;color:rgba(237,237,238,.82);pointer-events:none;white-space:nowrap}\n.clip svg{position:absolute;left:4px;right:4px;bottom:3px;width:calc(100% - 8px);height:34px}\n.clip.wave{background:var(--v2-clip-wave)}\n.clip.midi{background:rgba(196,202,220,.10)}\n.clip.midi .cl{color:var(--v2-clip-midi)}\n.clip.drum{background:rgba(204,255,54,.08)}\n.clip.drum .cl{color:rgba(204,255,54,.75)}\n\n/* the ghost clip — the séance's residue */\n#ghost{opacity:0;transform:scaleX(.55);transform-origin:left center;pointer-events:none;\n  border:1.5px dashed rgba(204,255,54,.85);background:rgba(204,255,54,.06);cursor:pointer;\n  transition:opacity .5s ease,transform .55s cubic-bezier(.2,1.25,.3,1)}\n#ghost .cl{color:var(--v2-accent)}\n#ghost.show{opacity:1;transform:none;pointer-events:auto;\n  animation:ghostPulse 1.7s ease-in-out infinite}\n#ghost.show:hover{filter:brightness(1.25)}\n#ghost.kept{animation:none;border:1px solid rgba(204,255,54,.55);background:rgba(204,255,54,.11);\n  box-shadow:0 0 14px rgba(204,255,54,.12)}\n@keyframes ghostPulse{0%,100%{box-shadow:0 0 0 0 rgba(204,255,54,0)}\n  50%{box-shadow:0 0 18px 1px rgba(204,255,54,.28)}}\n\n/* playhead */\n#playhead{position:absolute;top:26px;bottom:0;width:2px;z-index:2;pointer-events:none;\n  background:var(--v2-playhead);box-shadow:0 0 10px rgba(204,255,54,.5);will-change:transform}\n#playhead::before{content:\"\";position:absolute;top:-6px;left:-4px;border:5px solid transparent;\n  border-top-color:var(--v2-playhead)}\n\n/* ── the séance coat — the song floods the air ──────────────── */\n#coat{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:0;transition:opacity .3s ease;\n  background:\n    radial-gradient(90% 70% at 28% -6%,rgba(124,92,255,.22),transparent 60%),\n    radial-gradient(80% 60% at 82% 14%,rgba(38,196,190,.13),transparent 62%),\n    radial-gradient(70% 46% at 50% 104%,rgba(204,255,54,.15),transparent 68%),\n    linear-gradient(180deg,rgba(5,5,6,.25),rgba(5,5,6,.5))}\n.seance #coat{opacity:1;transition:opacity .62s ease}\n\n/* ── séance layer: the big presence ─────────────────────────── */\n#seanceLayer{position:absolute;inset:0;z-index:6;pointer-events:none}\n#floorGlow{position:absolute;left:50%;bottom:122px;width:480px;height:88px;transform:translateX(-50%);\n  background:radial-gradient(50% 50% at 50% 50%,rgba(204,255,54,.26),transparent 70%);\n  filter:blur(10px);opacity:0;transition:opacity .5s ease .15s}\n.seance #floorGlow{opacity:1}\n#bigWrap{position:absolute;left:50%;bottom:150px;width:380px;height:380px;\n  transform:translate(-50%,0);transform-origin:50% 100%;opacity:0;visibility:hidden}\n.seance #bigWrap{opacity:1;visibility:visible;pointer-events:auto;\n  animation:rise .52s cubic-bezier(.22,1.35,.32,1) both}\n.seance #bigWrap.collapse{animation:slurp .3s cubic-bezier(.55,0,.8,.4) both}\n#bigHost{width:100%;height:100%;\n  -webkit-box-reflect:below -72px linear-gradient(to bottom,transparent 58%,rgba(255,255,255,.2))}\n@keyframes rise{\n  0%{transform:translate(-50%,30%) scale(.14,.05);opacity:0}\n  40%{opacity:1}\n  62%{transform:translate(-50%,-2.5%) scale(.93,1.12)}\n  82%{transform:translate(-50%,1%) scale(1.05,.95)}\n  100%{transform:translate(-50%,0) scale(1,1);opacity:1}}\n@keyframes slurp{\n  0%{transform:translate(-50%,0) scale(1,1);opacity:1}\n  32%{transform:translate(-50%,-5%) scale(.88,1.16)}\n  100%{transform:translate(-50%,32%) scale(1.45,.04);opacity:0}}\n\n#seanceCap{position:absolute;left:50%;bottom:112px;transform:translateX(-50%);\n  font:600 10px/1 var(--font-mono);letter-spacing:.3em;color:rgba(204,255,54,.72);\n  opacity:0;transition:opacity .4s ease .22s;white-space:nowrap}\n.seance #seanceCap{opacity:1}\n#seanceCap.ans{color:#d9ff4c;text-shadow:0 0 14px rgba(204,255,54,.35)}\n#seanceCap::after{content:\"\";display:inline-block;width:1.3em;text-align:left;\n  animation:dots 1.4s steps(4,jump-none) infinite}\n#seanceCap.ans::after{content:\"\";animation:none}\n@keyframes dots{0%{content:\"\"}25%{content:\"·\"}50%{content:\"··\"}75%{content:\"···\"}}\n\n/* earcon glyphs — notes sung in the song's key */\n#earcons{position:absolute;inset:0;pointer-events:none}\n.earcon{position:absolute;bottom:400px;font-size:22px;line-height:1;\n  color:var(--v2-accent);text-shadow:0 0 12px rgba(204,255,54,.6);\n  animation:earc 1.35s cubic-bezier(.2,.6,.4,1) forwards}\n@keyframes earc{\n  0%{transform:translate(0,0) rotate(0deg) scale(.55);opacity:0}\n  14%{opacity:1}\n  100%{transform:translate(var(--dx),-128px) rotate(var(--dr)) scale(1.2);opacity:0}}\n\n/* the pour — he travels between his two sizes as goo */\n#pour{position:absolute;top:0;left:0;width:30px;height:16px;z-index:11;pointer-events:none;\n  border-radius:50%;opacity:0;\n  background:radial-gradient(closest-side,#d9ff4c,rgba(204,255,54,.55) 55%,transparent 72%);\n  filter:blur(1px) drop-shadow(0 0 10px rgba(204,255,54,.65));\n  offset-path:path('M322 734 C 360 640, 500 540, 640 470');offset-rotate:auto}\n#pour.run{animation:pourGo .42s cubic-bezier(.35,.05,.3,1) forwards}\n#pour.back{animation:pourBack .28s cubic-bezier(.5,0,.8,.5) forwards}\n@keyframes pourGo{0%{offset-distance:0%;opacity:0;transform:scale(.5,.9)}\n  12%{opacity:1}70%{transform:scale(1.6,.75)}\n  100%{offset-distance:100%;opacity:0;transform:scale(.9,1.3)}}\n@keyframes pourBack{0%{offset-distance:100%;opacity:1;transform:scale(1.4,.7)}\n  100%{offset-distance:0%;opacity:0;transform:scale(.5,1)}}\n\n/* ── composer — where he lives ──────────────────────────────── */\n#composer{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);z-index:10;\n  width:720px;height:80px;display:flex;align-items:center;gap:12px;padding:0 12px 0 10px;\n  background:linear-gradient(180deg,rgba(26,26,28,.88),rgba(18,18,20,.82));\n  border:1px solid var(--v2-line-strong);border-radius:22px;\n  box-shadow:var(--v2-shadow),inset 0 1px 0 rgba(255,255,255,.05);\n  backdrop-filter:blur(16px);transition:border-color .5s ease,box-shadow .5s ease}\n.seance #composer{border-color:rgba(204,255,54,.38);\n  box-shadow:0 12px 60px rgba(204,255,54,.10),var(--v2-shadow),inset 0 1px 0 rgba(255,255,255,.05)}\n\n#slot{position:relative;width:64px;height:64px;flex:none}\n#slot::before{content:\"\";position:absolute;inset:2px;border-radius:16px;\n  background:var(--v2-surface-sunken);border:1px solid var(--v2-line);\n  box-shadow:inset 0 2px 8px rgba(0,0,0,.5)}\n#avatarHost{position:absolute;inset:0;transition:transform .25s ease-in,opacity .18s ease .06s;\n  transform-origin:50% 88%}\n.seance #avatarHost{transform:scale(1.4,.1) translateY(8px);opacity:0}\n#avatarHost.pop{animation:pop .5s cubic-bezier(.3,1.3,.4,1) both}\n@keyframes pop{0%{transform:scale(1.5,.2)}45%{transform:scale(.86,1.16)}\n  72%{transform:scale(1.07,.95)}100%{transform:scale(1,1)}}\n#slot .splat{position:absolute;inset:16px;color:rgba(204,255,54,.35);display:none}\n#slot.nomoshi .splat{display:block}\n\n#ask{flex:1;min-width:0;height:44px;background:transparent;border:none;color:var(--v2-text);\n  font:400 var(--v2-fs-md)/44px var(--font-body);letter-spacing:.01em;caret-color:var(--v2-accent)}\n#ask::placeholder{color:var(--v2-faint)}\n#ask:focus{outline:none}\n#askline{flex:1;min-width:0;position:relative;display:flex;align-items:center}\n#askline::after{content:\"\";position:absolute;left:0;right:0;bottom:6px;height:1px;\n  background:var(--v2-line);transition:background .3s ease}\n#askline:focus-within::after{background:rgba(204,255,54,.4)}\n\n#micwrap{position:relative;width:46px;height:46px;flex:none}\n#mic{position:absolute;inset:1px;border-radius:50%;border:1px solid var(--v2-line-strong);\n  background:var(--v2-surface-2);color:var(--v2-dim);display:grid;place-items:center;cursor:pointer;\n  transition:all .15s ease;touch-action:none;-webkit-user-select:none;user-select:none}\n#mic:hover{color:var(--v2-text);border-color:rgba(204,255,54,.4);\n  box-shadow:0 0 14px rgba(204,255,54,.12)}\n#mic:focus-visible{outline:2px solid var(--v2-accent);outline-offset:2px}\n#mic.holding{background:var(--v2-accent);border-color:var(--v2-accent);color:var(--v2-accent-ink);\n  box-shadow:0 0 24px rgba(204,255,54,.4)}\n#micring{position:absolute;inset:-3px;pointer-events:none;transform:rotate(-90deg)}\n#micring circle{fill:none;stroke:var(--v2-accent);stroke-width:2;stroke-linecap:round;\n  stroke-dasharray:163;stroke-dashoffset:163;opacity:0}\n#mic.holding+#micring circle{opacity:1;animation:ringfill .9s linear forwards}\n@keyframes ringfill{to{stroke-dashoffset:0}}\n\n#send{width:46px;height:46px;flex:none;border-radius:50%;border:none;cursor:pointer;\n  background:var(--v2-accent);color:var(--v2-accent-ink);display:grid;place-items:center;\n  transition:transform .12s ease,box-shadow .2s ease,filter .15s ease}\n#send:hover{filter:brightness(1.08);box-shadow:0 0 18px rgba(204,255,54,.35)}\n#send:active{transform:scale(.93)}\n#send:focus-visible{outline:2px solid var(--v2-accent);outline-offset:3px}\n\n#toast{position:absolute;right:74px;top:-26px;font:500 var(--v2-fs-2xs)/1 var(--font-mono);\n  letter-spacing:.14em;color:rgba(204,255,54,.85);opacity:0;transform:translateY(4px);\n  transition:opacity .35s ease,transform .35s ease;pointer-events:none;white-space:nowrap}\n#toast.show{opacity:1;transform:none}\n\n#hint{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);z-index:10;\n  font:500 var(--v2-fs-2xs)/1 var(--font-mono);letter-spacing:.16em;color:var(--v2-faint);\n  transition:opacity .6s ease;white-space:nowrap}\n#hint kbd{display:inline-block;padding:2px 5px;margin:0 2px;border-radius:4px;\n  border:1px solid var(--v2-line-strong);background:var(--v2-surface);color:var(--v2-dim);\n  font:600 9px/1 var(--font-mono)}\n#hint.used{opacity:.32}\n#hint.nudge{color:rgba(204,255,54,.8);opacity:1}\n</style>\n\n<div id=\"frame\">\n  <!-- stage: the arrangement plane that tips back -->\n  <div id=\"stagewrap\">\n    <div id=\"arr\">\n      <div id=\"gridWrap\">\n        <div class=\"grow\" id=\"sections\">\n          <div id=\"corner\">A♭m &nbsp;·&nbsp; 134</div>\n          <div class=\"cells\" id=\"sectCells\"></div>\n        </div>\n        <div class=\"grow\" id=\"ruler\">\n          <div></div>\n          <div class=\"cells\" id=\"rulerCells\"></div>\n        </div>\n        <div id=\"lanes\"></div>\n        <div id=\"playhead\"></div>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"vig\"></div>\n  <div id=\"coat\"></div>\n\n  <!-- séance layer -->\n  <div id=\"seanceLayer\">\n    <div id=\"floorGlow\"></div>\n    <div id=\"bigWrap\"><div id=\"bigHost\"></div></div>\n    <div id=\"seanceCap\">MOSHI IS LISTENING</div>\n    <div id=\"earcons\"></div>\n  </div>\n  <div id=\"pour\"></div>\n\n  <!-- topbar -->\n