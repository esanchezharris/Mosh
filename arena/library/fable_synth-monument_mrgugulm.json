  "source": "<div class=\"smr\">\n<style>\n/* DIRECTION A — MONUMENT REMOTE. A universal remote, not a mini-DAW: four giant keys you\n   can hit without looking (distinct corners, distinct shapes), one unmistakable full-width\n   TALK key, and a thick fill-up timeline you scrub with your thumb — friends riding it. */\n.smr{position:absolute;inset:0;background:#0b0c0e;font-family:var(--font-body);color:#e6e8ee;overflow:hidden}\n.smr *{box-sizing:border-box;margin:0;-webkit-user-select:none;user-select:none}\n.smr .status{position:absolute;top:0;left:0;right:0;height:47px;display:flex;align-items:center;justify-content:space-between;padding:12px 26px 0;font:600 13px var(--font-body);color:#c9ccd3}\n.smr .home{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:130px;height:5px;border-radius:3px;background:rgba(255,255,255,.28);z-index:9}\n/* glance: readable across the room */\n.smr .glance{position:absolute;top:64px;left:24px;right:24px}\n.smr .glance .song{font-family:var(--font-mono);font-size:10px;letter-spacing:.22em;color:#6a6d75}\n.smr .bbt{font-family:var(--font-mono);font-size:64px;font-weight:600;line-height:1.05;color:#eef0f4;font-variant-numeric:tabular-nums;margin-top:6px}\n.smr .bbt b{font-weight:400;color:#3a3d43}\n.smr .sub{font-family:var(--font-mono);font-size:9px;letter-spacing:.2em;color:#54575e;margin-top:4px}\n/* THE TIMELINE — a thick fill bar with your friends on it */\n.smr .tl{position:absolute;top:238px;left:20px;right:20px;height:96px;touch-action:none}\n.smr .tl .lab{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.2em;color:#54575e;margin-bottom:10px;display:flex;justify-content:space-between}\n.smr .bar{position:relative;height:44px;border-radius:12px;background:#14151a;box-shadow:inset 0 2px 8px rgba(0,0,0,.7),inset 0 -1px 0 rgba(255,255,255,.04);cursor:ew-resize}\n.smr .bar .fill{position:absolute;left:0;top:0;bottom:0;border-radius:12px 0 0 12px;background:linear-gradient(90deg,#3d4d10,#8fb61e 88%,#ccff36);width:32%}\n.smr .bar .cursor{position:absolute;top:-6px;bottom:-6px;width:3px;border-radius:2px;background:#ccff36;box-shadow:0 0 12px rgba(204,255,54,.8);left:32%}\n.smr .bar .bead{position:absolute;top:50%;width:30px;height:30px;border-radius:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;font:700 9px var(--font-mono);color:#0b0c0e;border:2px solid #0b0c0e;transition:left .8s linear}\n.smr .friends{margin-top:10px;font-family:var(--font-mono);font-size:9px;letter-spacing:.12em;color:#6a6d75;display:flex;gap:14px}\n.smr .friends b{font-weight:400}\n/* TALK — the one special key. Full width, unmistakable, hold-to-talk */\n.smr .talk{position:absolute;top:366px;left:20px;right:20px;height:92px;border-radius:22px;background:linear-gradient(180deg,#d9ff4c,#c3f22e);box-shadow:0 6px 0 #74901a,0 14px 30px rgba(204,255,54,.22);display:flex;align-items:center;justify-content:center;gap:14px;cursor:pointer;transition:transform .07s,box-shadow .07s;touch-action:none}\n.smr .talk:active,.smr .talk.on{transform:translateY(4px);box-shadow:0 2px 0 #74901a,0 6px 16px rgba(204,255,54,.2)}\n.smr .talk .splat{width:44px;height:38px}\n.smr .talk .splat path.b{fill:#171a06}\n.smr .talk .splat .eye{stroke:#d9ff4c;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}\n.smr .talk .t1{font-family:var(--font-display);font-weight:800;font-size:19px;letter-spacing:.04em;color:#171a06}\n.smr .talk .t2{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.22em;color:#4d5c14;display:block;margin-top:3px}\n.smr .talk .wave{position:absolute;bottom:10px;left:24px;right:24px;height:14px;display:none;align-items:flex-end;gap:2.5px}\n.smr .talk.on .wave{display:flex}\n.smr .talk .wave b{flex:1;background:#171a06;border-radius:1px;height:20%}\n/* THE DECK — four giant keys, distinct corners + shapes, eyes-free */\n.smr .deck{position:absolute;left:20px;right:20px;bottom:34px;top:482px;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:16px}\n.smr .key{border-radius:24px;background:#15161a;border:1px solid rgba(255,255,255,.06);border-top-color:rgba(255,255,255,.11);box-shadow:0 4px 0 rgba(0,0,0,.6);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;cursor:pointer;transition:transform .07s,box-shadow .07s}\n.smr .key:active{transform:translateY(3px);box-shadow:0 1px 0 rgba(0,0,0,.6)}\n.smr .key .kl{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.24em;color:#54575e}\n.smr .key.play{background:#17190f;border-color:rgba(204,255,54,.35)}\n.smr .key.play svg path{fill:#ccff36}\n.smr .key.play.on{background:#1d2210;box-shadow:0 4px 0 rgba(0,0,0,.6),inset 0 0 26px rgba(204,255,54,.12)}\n.smr .key.rec .dot{width:26px;height:26px;border-radius:50%;background:#b5453a;box-shadow:inset 0 2px 4px rgba(0,0,0,.4)}\n.smr .key.rec.on .dot{animation:smr-rec 1.4s ease-in-out infinite}\n@keyframes smr-rec{50%{box-shadow:0 0 22px rgba(224,80,60,.9),inset 0 2px 4px rgba(0,0,0,.4)}}\n.smr .key.loop svg{stroke:#9fa3ad}\n.smr .key.loop.on{border-color:rgba(204,255,54,.3)}\n.smr .key.loop.on svg{stroke:#ccff36}\n</style>\n<div class=\"status\"><span>9:41</span><span style=\"font-family:var(--font-mono);font-size:11px\">&#9679;&#9679;&#9679;&#9675;&nbsp;&#9889;</span></div>\n<div class=\"glance\">\n  <div class=\"song\">NOCTURNE_04 &nbsp;·&nbsp; 128 &nbsp;·&nbsp; A&#9837; MIN</div>\n  <div class=\"bbt\" id=\"smr-bbt\">005<b>·</b>2<b>·</b>04</div>\n  <div class=\"sub\">PAIRED · MACBOOK PRO · 12MS</div>\n</div>\n<div class=\"tl\" id=\"smr-tl\">\n  <div class=\"lab\"><span>SONG POSITION · DRAG TO SCRUB</span><span id=\"smr-pct\">32%</span></div>\n  <div class=\"bar\" id=\"smr-bar\">\n    <span class=\"fill\" id=\"smr-fill\"></span>\n    <span class=\"bead\" style=\"background:#f0a05a;left:58%\" id=\"smr-b1\">KAI</span>\n    <span class=\"bead\" style=\"background:#6fc7e8;left:81%\" id=\"smr-b2\">JU</span>\n    <span class=\"cursor\" id=\"smr-cur\"></span>\n  </div>\n  <div class=\"friends\"><span style=\"color:#f0a05a\">&#9679; KAI <b>· bar 10 · cooking</b></span><span style=\"color:#6fc7e8\">&#9679; JUJU <b>· bar 13 · listening</b></span></div>\n</div>\n<div class=\"talk\" id=\"smr-talk\">\n  <svg class=\"splat\" viewBox=\"0 0 44 38\">\n    <path class=\"b\" d=\"M22 3c8.4 0 16 5.4 16 13.8 0 4.2-2 7.4-5.2 9.6 1.6 2.4 4 3.8 4 3.8s-4.4-.2-7.6-2c-2 .8-4.5 1.2-7.2 1.2C13.6 29.4 6 24 6 16.8S13.6 3 22 3z\"/>\n    <path class=\"eye\" d=\"M16 14.5l3.4 2.1-3.4 2.1\"/><path class=\"eye\" d=\"M28 14.5l-3.4 2.1 3.4 2.1\"/>\n  </svg>\n  <div><div class=\"t1\">TALK TO MOSH</div><span class=\"t2\">HOLD &nbsp;·&nbsp; SPEAK &nbsp;·&nbsp; RELEASE</span></div>\n  <div class=\"wave\" id=\"smr-wave\"></div>\n</div>\n<div class=\"deck\">\n  <div class=\"key play\" id=\"smr-play\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\"><path d=\"M9 5l20 12L9 29z\"/></svg><span class=\"kl\">PLAY</span></div>\n  <div class=\"key\" id=\"smr-stop\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\"><rect width=\"26\" height=\"26\" rx=\"5\" fill=\"#9fa3ad\"/></svg><span class=\"kl\">STOP</span></div>\n  <div class=\"key rec\" id=\"smr-rec\"><span class=\"dot\"></span><span class=\"kl\">RECORD</span></div>\n  <div class=\"key loop\" id=\"smr-loop\"><svg width=\"30\" height=\"26\" viewBox=\"0 0 30 26\" fill=\"none\" stroke-width=\"2.6\" stroke-linecap=\"round\"><path d=\"M6 13a9 8 0 0 1 18 0a9 8 0 0 1-18 0\" /><path d=\"M21 8l3.4 4.6L19 13.6\" stroke-linejoin=\"round\"/></svg><span class=\"kl\">LOOP</span></div>\n</div>\n<div class=\"home\"></div>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  var wave=root.querySelector('#smr-wave');for(var i=0;i<26;i++)wave.insertAdjacentHTML('beforeend','<b></b>');\n  var playing=true,scrub=null,pos=.32;\n  var play=root.querySelector('#smr-play'),stop=root.querySelector('#smr-stop'),rec=root.querySelector('#smr-rec'),loop=root.querySelector('#smr-loop'),talk=root.querySelector('#smr-talk');\n  play.addEventListener('click',function(){playing=!playing;play.classList.toggle('on',playing)});\n  stop.addEventListener('click',function(){playing=false;play.classList.remove('on');pos=0});\n  rec.addEventListener('click',function(){rec.classList.toggle('on')});\n  loop.addEventListener('click',function(){loop.classList.toggle('on')});\n  play.classList.add('on');\n  // hold-to-talk: pointer capture so release outside never latches\n  var talking=false;\n  talk.addEventListener('pointerdown',function(e){\n    if(talk.setPointerCapture){try{talk.setPointerCapture(e.pointerId)}catch(_){}}\n    talking=true;talk.classList.add('on');\n  });\n  var endTalk=function(){if(talking){talking=false;talk.classList.remove('on')}};\n  talk.addEventListener('pointerup',endTalk);talk.addEventListener('pointercancel',endTalk);\n  // the scrub bar: capture + big thumb travel\n  var bar=root.querySelector('#smr-bar');\n  bar.addEventListener('pointerdown',function(e){\n    if(bar.setPointerCapture){try{bar.setPointerCapture(e.pointerId)}catch(_){}}\n    var set=function(ev){var r=bar.getBoundingClientRect();scrub=Math.min(1,Math.max(0,(ev.clientX-r.left)/r.width))};\n    set(e);\n    var mv=function(ev){set(ev)};\n    var up=function(){if(scrub!==null){pos=scrub}scrub=null;bar.removeEventListener('pointermove',mv);bar.removeEventListener('pointerup',up);bar.removeEventListener('pointercancel',up)};\n    bar.addEventListener('pointermove',mv);bar.addEventListener('pointerup',up);bar.addEventListener('pointercancel',up);\n  });\n  var fill=root.querySelector('#smr-fill'),cur=root.querySelector('#smr-cur'),bbt=root.querySelector('#smr-bbt'),pct=root.querySelector('#smr-pct');\n  var b1=root.querySelector('#smr-b1'),b2=root.querySelector('#smr-b2');\n  var waveBars=wave.children,f1=.58,f2=.81;\n  var last=null;\n  function tick(ts){\n    if(last===null)last=ts;var dt=(ts-last)/1000;last=ts;\n    if(playing&&scrub===null){pos=(pos+dt/46)%1}\n    var p=scrub!==null?scrub:pos;\n    fill.style.width=(p*100)+'%';cur.style.left=(p*100)+'%';\n    pct.textContent=Math.round(p*100)+'%';\n    var bar_=1+Math.floor(p*16),beat=1+Math.floor((p*16%1)*4);\n    bbt.innerHTML=('00'+bar_).slice(-3)+'<b>·</b>'+beat+'<b>·</b>'+('0'+Math.floor((p*64%1)*96)).slice(-2);\n    // friends drift along, slightly behind/ahead — presence on the SAME bar\n    f1=(f1+dt/52)%1;f2=(f2+dt/49)%1;\n    b1.style.left=(f1*100)+'%';b2.style.left=(f2*100)+'%';\n    if(talking){var t=ts/1000;for(var i=0;i<waveBars.length;i++){waveBars[i].style.height=(14+82*Math.abs(Math.sin(t*6+i*.7))*Math.abs(Math.sin(t*2.2+i*.31)))+'%'}}\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
