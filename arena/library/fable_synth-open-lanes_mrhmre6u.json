  "source": "<div class=\"ol\">\n<style>\n/* SYNTH · OPEN LANES — the header column is dead. Lanes run full-bleed and symmetric;\n   a track is known by its COLOR and a small glyph, not a giant labeled rectangle.\n   Mute/solo/arm float in on hover and PIN only when toggled. Identity hues tint each\n   track's waveforms; lime stays reserved for the playhead, play, and the caret. */\n.ol{position:absolute;inset:0;background:#0c0d10;font-family:var(--font-body);color:#e2e5ea;overflow:hidden}\n.ol *{box-sizing:border-box;margin:0}\n/* symmetric topbar */\n.ol .top{position:absolute;inset:0 0 auto 0;height:56px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 40px;border-bottom:1px solid rgba(255,255,255,.05)}\n.ol .brand{font-family:var(--font-display);font-weight:800;font-size:16px;letter-spacing:.15em;color:#eef0f4}\n.ol .brand i{font-style:normal;color:#565961}\n.ol .tr{display:flex;align-items:center;gap:12px;justify-self:center}\n.ol .k{width:30px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:#14151a;border:1px solid rgba(255,255,255,.05);border-top-color:rgba(255,255,255,.1);cursor:pointer}\n.ol .k:active{transform:translateY(1px)}\n.ol .k.play svg path{fill:#ccff36}\n.ol .rd{font-family:var(--font-mono);font-size:19px;color:#eef0f4;font-variant-numeric:tabular-nums}\n.ol .rd b{font-weight:400;color:#43464c}\n.ol .rd .s{display:block;font-size:8px;letter-spacing:.22em;color:#54575e;margin-top:2px}\n.ol .sess{justify-self:end;font-family:var(--font-mono);font-size:9px;letter-spacing:.16em;color:#54575e}\n/* full-width ruler — same margin both sides: symmetry */\n.ol .ruler{position:absolute;top:56px;left:40px;right:40px;height:26px;border-bottom:1px solid rgba(255,255,255,.045);font-family:var(--font-mono);font-size:8px;color:#4a4d54}\n.ol .ruler i{position:absolute;top:8px;font-style:normal;letter-spacing:.05em}\n/* lanes: full-bleed, no header rectangle anywhere */\n.ol .lanes{position:absolute;top:82px;left:40px;right:40px;bottom:96px}\n.ol .lane{position:absolute;left:0;right:0;height:25%;border-bottom:1px solid rgba(255,255,255,.035)}\n/* identity: a hue. Twin edge ticks (left+right, symmetric) + a soft lane aura + glyph. */\n.ol .lane .edge{position:absolute;top:18%;bottom:18%;width:3px;border-radius:2px;background:var(--hue);opacity:.85}\n.ol .lane .edge.l{left:-14px}.ol .lane .edge.r{right:-14px}\n.ol .lane .aura{position:absolute;inset:0;background:linear-gradient(90deg,color-mix(in srgb,var(--hue) 5%,transparent),transparent 30%,transparent 70%,color-mix(in srgb,var(--hue) 5%,transparent));opacity:0;transition:opacity .3s;pointer-events:none}\n.ol .lane:hover .aura{opacity:1}\n.ol .lane .tag{position:absolute;top:9px;left:12px;display:flex;align-items:center;gap:7px;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.16em;color:color-mix(in srgb,var(--hue) 55%,#7c7f87);opacity:.75;transition:opacity .25s,color .25s;z-index:3}\n.ol .lane:hover .tag{opacity:1;color:var(--hue)}\n.ol .lane .tag svg{display:block;opacity:.9}\n/* floating controls: appear on hover, PIN when toggled */\n.ol .ctl{position:absolute;top:9px;right:12px;display:flex;gap:7px;z-index:6;opacity:0;transform:translateY(-3px);transition:opacity .22s,transform .22s;pointer-events:none}\n.ol .lane:hover .ctl{opacity:1;transform:none;pointer-events:auto}\n.ol .cbtn{width:30px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font:700 9.5px var(--font-mono);color:#8c8f98;background:rgba(18,19,24,.92);border:1px solid rgba(255,255,255,.09);cursor:pointer;backdrop-filter:blur(6px)}\n.ol .cbtn:hover{color:#e2e5ea;border-color:rgba(255,255,255,.2)}\n.ol .cbtn.arm .dot{width:9px;height:9px;border-radius:50%;background:#8a4038}\n/* pinned states stay visible without hover */\n.ol .cbtn.on{opacity:1!important;pointer-events:auto}\n.ol .cbtn.m.on{color:#f0968a;border-color:rgba(224,110,90,.5);background:rgba(40,18,16,.9)}\n.ol .cbtn.s.on{color:#ccff36;border-color:rgba(204,255,54,.5);background:rgba(30,36,10,.9)}\n.ol .cbtn.arm.on{border-color:rgba(224,110,90,.6)}\n.ol .cbtn.arm.on .dot{background:#e0563c;animation:ol-arm 1.4s ease-in-out infinite}\n@keyframes ol-arm{50%{box-shadow:0 0 10px rgba(224,86,60,.9)}}\n.ol .lane.has-pin .ctl{opacity:1;transform:none;pointer-events:auto}\n.ol .lane.has-pin .ctl .cbtn:not(.on){opacity:0;pointer-events:none;transition:opacity .22s}\n.ol .lane.has-pin:hover .ctl .cbtn:not(.on){opacity:1;pointer-events:auto}\n.ol .lane.muted .clip{filter:saturate(.2) brightness(.45)}\n/* clips: waveforms carry the track hue — the identity IS the content */\n.ol .clip{position:absolute;top:20%;height:62%;border-radius:9px;background:#111216;border:1px solid rgba(255,255,255,.045);overflow:hidden;cursor:grab;transition:filter .4s,border-color .25s}\n.ol .clip:hover{border-color:color-mix(in srgb,var(--hue) 45%,transparent)}\n.ol .clip canvas{position:absolute;inset:0;width:100%;height:100%}\n.ol .ph{position:absolute;top:0;bottom:0;width:1.5px;background:#ccff36;box-shadow:0 0 9px rgba(204,255,54,.6);z-index:8}\n/* composer + hint, centered = symmetric */\n.ol .comp{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);width:520px;height:42px;border-radius:12px;background:#111216;border:1px solid rgba(255,255,255,.055);border-top-color:rgba(255,255,255,.1);box-shadow:0 3px 10px rgba(0,0,0,.5);display:flex;align-items:center;gap:10px;padding:0 14px}\n.ol .comp .caret{width:1.5px;height:15px;background:#ccff36;animation:ol-blink 1.1s steps(1) infinite}\n@keyframes ol-blink{50%{opacity:0}}\n.ol .comp .ph-t{font-size:12.5px;color:#54575e}\n.ol .comp .mic{margin-left:auto;color:#6a6d75;cursor:pointer}.ol .comp .mic:hover{color:#c9ccd3}\n.ol .hint{position:absolute;bottom:26px;right:40px;font-family:var(--font-mono);font-size:8px;letter-spacing:.16em;color:#3c3f45}\n</style>\n<header class=\"top\">\n  <div class=\"brand\">MOSH<i>·</i></div>\n  <div class=\"tr\">\n    <div class=\"k play\" title=\"play\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\"><path d=\"M2 1l7 4-7 4z\"/></svg></div>\n    <div class=\"k\" title=\"stop\"><svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\"><rect width=\"8\" height=\"8\" rx=\"1.5\" fill=\"#9a9da5\"/></svg></div>\n    <div class=\"k\" title=\"record\"><span style=\"width:8px;height:8px;border-radius:50%;background:#8a4038\"></span></div>\n    <div class=\"rd\"><span id=\"ol-pos\">005<b>·</b>2<b>·</b>04</span><span class=\"s\">128 BPM · A&#9837; MIN · 4/4</span></div>\n  </div>\n  <span class=\"sess\">NOCTURNE_04</span>\n</header>\n<div class=\"ruler\" id=\"ol-ruler\"></div>\n<main class=\"lanes\" id=\"ol-lanes\"></main>\n<div class=\"comp\">\n  <span class=\"caret\"></span><span class=\"ph-t\">Ask Mosh to…</span>\n  <svg class=\"mic\" width=\"12\" height=\"14\" viewBox=\"0 0 13 15\"><rect x=\"4\" y=\"1\" width=\"5\" height=\"8\" rx=\"2.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M1.5 7.5a5 5 0 0 0 10 0M6.5 12.5V14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg>\n</div>\n<span class=\"hint\">HOVER A LANE</span>\n<script>\n(function(){\n  var root=document.currentScript.parentElement;\n  function rng(s){return function(){s|=0;s=s+0x6D2B79F5|0;var t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}\n  var rr='';for(var b=0;b<17;b++)rr+='<i style=\"left:'+(b/17*100)+'%\">'+(b+1)+'</i>';\n  root.querySelector('#ol-ruler').innerHTML=rr;\n  // identity = hue + glyph. No names shouting; the tag whispers, the color speaks.\n  var G={\n    drum:'<svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\"><circle cx=\"5.5\" cy=\"5.5\" r=\"4.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"/><circle cx=\"5.5\" cy=\"5.5\" r=\"1.4\" fill=\"currentColor\"/></svg>',\n    bass:'<svg width=\"12\" height=\"11\" viewBox=\"0 0 12 11\"><path d=\"M1 8c2-6 4 3 6-3s4 1 4 1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>',\n    keys:'<svg width=\"12\" height=\"11\" viewBox=\"0 0 12 11\"><rect x=\"1\" y=\"2\" width=\"10\" height=\"7\" rx=\"1.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M4.3 2v4.4M7.6 2v4.4\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg>',\n    vox:'<svg width=\"10\" height=\"12\" viewBox=\"0 0 10 12\"><rect x=\"3\" y=\"1\" width=\"4\" height=\"6\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M1.5 6a3.5 3.5 0 0 0 7 0M5 9.5V11\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg>'};\n  var lanes=[\n    {hue:'#e8a04c',g:'drum',n:'DRUMS',k:'drum',clips:[[2,26],[34,28]]},\n    {hue:'#8b7bff',g:'bass',n:'BASS', k:'bass',clips:[[2,44]]},\n    {hue:'#4cc9b0',g:'keys',n:'KEYS', k:'midi',clips:[[16,36]],muted:true},\n    {hue:'#ff7ba6',g:'vox', n:'VOX',  k:'vox', clips:[[26,46]]}];\n  var el=root.querySelector('#ol-lanes'),html='';\n  lanes.forEach(function(l,i){\n    html+='<div class=\"lane'+(l.muted?' muted has-pin':'')+'\" style=\"--hue:'+l.hue+';top:'+(i*25)+'%\">'\n      +'<span class=\"edge l\"></span><span class=\"edge r\"></span><span class=\"aura\"></span>'\n      +'<span class=\"tag\">'+G[l.g]+l.n+'</span>'\n      +'<span class=\"ctl\"><span class=\"cbtn arm\" title=\"arm\"><span class=\"dot\"></span></span><span class=\"cbtn m'+(l.muted?' on':'')+'\" title=\"mute\">M</span><span class=\"cbtn s\" title=\"solo\">S</span></span>';\n    l.clips.forEach(function(c){html+='<div class=\"clip\" style=\"left:'+c[0]+'%;width:'+c[1]+'%\"><canvas></canvas></div>'});\n    html+='</div>';\n  });\n  el.innerHTML=html;\n  el.insertAdjacentHTML('beforeend','<div class=\"ph\" id=\"ol-ph\"></div>');\n  // waveforms tinted by the lane hue — after layout (canvas sizing needs real boxes)\n  function draw(){\n    var retry=false;\n    root.querySelectorAll('.lane').forEach(function(lane,li){\n      var hue=lanes[li].hue,k=lanes[li].k;\n      lane.querySelectorAll('canvas').forEach(function(cv){\n        var w=cv.parentElement.offsetWidth,h=cv.parentElement.offsetHeight;\n        if(w<8){retry=true;return}\n        cv.width=w*2;cv.height=h*2;var g=cv.getContext('2d');g.scale(2,2);\n        var r=rng(li*997+w|0);\n        g.fillStyle=hue;\n        if(k==='midi'){for(var n=0;n<12;n++){var x=6+n*(w-16)/12,y=8+r()*(h-24);g.globalAlpha=.5+r()*.5;g.beginPath();g.roundRect(x,y,10+r()*26,6.5,3);g.fill()}}\n        else if(k==='drum'){for(var K=0;K<Math.floor(w/9);K++){var v=(K%4===0)?1:(K%2===0?.6:.26+r()*.2);g.globalAlpha=.35+v*.6;var bh=Math.max(2,v*h*.66);g.fillRect(4+K*9,(h-bh)/2,3.4,bh)}}\n        else{var N=Math.floor(w/3);for(var q=0;q<N;q++){var t=q/N,e=(Math.sin(t*19+r()*7)*.5+.5)*(.35+.65*Math.pow(Math.sin(t*3.1),2))*(k==='bass'?.9:1)*(.5+r()*.5);g.globalAlpha=.4+e*.6;var hh=Math.max(2,e*h*.66);g.fillRect(q*3,(h-hh)/2,1.9,hh)}}\n      });\n    });\n    if(retry)requestAnimationFrame(draw);\n  }\n  requestAnimationFrame(draw);\n  // floating controls: toggle + pin\n  root.querySelectorAll('.lane').forEach(function(lane){\n    lane.querySelectorAll('.cbtn').forEach(function(btn){\n      btn.addEventListener('click',function(){\n        var on=btn.classList.toggle('on');\n        if(btn.classList.contains('m'))lane.classList.toggle('muted',on);\n        var any=lane.querySelectorAll('.cbtn.on').length>0;\n        lane.classList.toggle('has-pin',any);\n      });\n    });\n  });\n  var ph=root.querySelector('#ol-ph'),pos=root.querySelector('#ol-pos');\n  function tick(ts){\n    var p=(window.__mosh&&typeof window.__mosh.playhead==='number')?window.__mosh.playhead:((ts/15000)%1);\n    ph.style.left=(p*100)+'%';\n    var b=1+Math.floor(p*17),bt=1+Math.floor((p*17%1)*4);\n    pos.innerHTML=('00'+b).slice(-3)+'<b>·</b>'+bt+'<b>·</b>'+('0'+Math.floor((p*68%1)*96)).slice(-2);\n    requestAnimationFrame(tick);\n  }\n  requestAnimationFrame(tick);\n})();\n</script>\n</div>",
