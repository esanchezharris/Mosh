  "source": "<div class=\"mc-root\" id=\"mcRoot\">\n\n  <!-- ═══════════ GLANCE ZONE — calm, zero-touch, readable across the room ═══════════ -->\n  <div class=\"mc-glance\">\n    <div class=\"mc-blob mc-blobA\"></div>\n    <div class=\"mc-blob mc-blobB\"></div>\n    <div class=\"mc-grain\"></div>\n\n    <!-- iOS status bar -->\n    <div class=\"mc-status\">\n      <span class=\"mc-clock\">9:41</span>\n      <span class=\"mc-sicons\">\n        <svg width=\"18\" height=\"12\" viewBox=\"0 0 18 12\" fill=\"currentColor\"><rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\"/><rect x=\"5\" y=\"5.5\" width=\"3\" height=\"6.5\" rx=\"1\"/><rect x=\"10\" y=\"3\" width=\"3\" height=\"9\" rx=\"1\"/><rect x=\"15\" y=\"0.5\" width=\"3\" height=\"11.5\" rx=\"1\"/></svg>\n        <svg width=\"17\" height=\"12\" viewBox=\"0 0 17 12\" fill=\"currentColor\"><path d=\"M8.5 12 5.2 8.7a4.7 4.7 0 0 1 6.6 0Z\"/><path d=\"M3.1 6.6a7.7 7.7 0 0 1 10.8 0l-1.6 1.6a5.4 5.4 0 0 0-7.6 0Z\" opacity=\".92\"/><path d=\"M.9 4.4a10.8 10.8 0 0 1 15.2 0l-1.6 1.6a8.5 8.5 0 0 0-12 0Z\" opacity=\".92\"/></svg>\n        <svg width=\"26\" height=\"13\" viewBox=\"0 0 26 13\" fill=\"none\"><rect x=\"0.5\" y=\"0.5\" width=\"22\" height=\"12\" rx=\"3.5\" stroke=\"currentColor\" opacity=\".45\"/><rect x=\"2\" y=\"2\" width=\"15.5\" height=\"9\" rx=\"2\" fill=\"currentColor\"/><path d=\"M24.5 4.5v4a2.2 2.2 0 0 0 0-4Z\" fill=\"currentColor\" opacity=\".45\"/></svg>\n      </span>\n    </div>\n\n    <!-- session header -->\n    <div class=\"mc-head\">\n      <div class=\"mc-titlerow\">\n        <span class=\"mc-coat\" title=\"session coat\"></span>\n        <span class=\"mc-title\">poppinshit</span>\n        <span class=\"mc-brand\" id=\"mcBrand\">MOSH&nbsp;REMOTE</span>\n        <span class=\"mc-recchip\" id=\"mcRecChip\"><i></i>REC <em id=\"mcRecT\">0:00</em></span>\n      </div>\n      <div class=\"mc-sub\">134&nbsp;BPM&nbsp;&nbsp;·&nbsp;&nbsp;F&nbsp;MIN&nbsp;&nbsp;·&nbsp;&nbsp;4/4</div>\n    </div>\n\n    <!-- the enormous bars·beats readout -->\n    <div class=\"mc-bigwrap\">\n      <div class=\"mc-big\" id=\"mcBig\" aria-label=\"bar and beat position\">\n        <span class=\"mc-bars\" id=\"mcBars\"><i>1</i><i>7</i></span><span class=\"mc-bdot\">.</span><span class=\"mc-beat\" id=\"mcBeat\">1</span>\n      </div>\n      <div class=\"mc-beatdots\" id=\"mcDots\"><b></b><b></b><b></b><b></b></div>\n      <div class=\"mc-bigcap\"><span id=\"mcCapBar\">BAR 17</span><span class=\"mc-capsep\">·</span><span id=\"mcCapTime\">00:28.6</span><span class=\"mc-capsep\">·</span><span id=\"mcCapSec\">HOOK</span></div>\n    </div>\n  </div>\n\n  <!-- ═══════════ THE DECK — one frosted slab, every touchable pixel lives here ═══════════ -->\n  <div class=\"mc-deck\">\n    <div class=\"mc-deckglass\"></div>\n\n    <!-- row A · connection face + ask -->\n    <div class=\"mc-rowA\">\n      <button class=\"mc-linkcluster\" id=\"mcLink\" aria-label=\"connection status — tap to simulate link events\">\n        <div class=\"mc-moshihost\" id=\"mcMoshi\">\n          <!-- graceful fallback creature (replaced by the real runtime when present) -->\n          <div class=\"mc-fb\" id=\"mcFb\"><span class=\"mc-fbeye mc-fbL\"><svg viewBox=\"0 0 10 14\" width=\"9\" height=\"13\"><path d=\"M1.5 1.5 8 7l-6.5 5.5\" fill=\"none\" stroke=\"#ccff36\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"mc-fbeye mc-fbR\"><svg viewBox=\"0 0 10 14\" width=\"9\" height=\"13\"><path d=\"M8.5 1.5 2 7l6.5 5.5\" fill=\"none\" stroke=\"#ccff36\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></div>\n        </div>\n        <div class=\"mc-linktext\">\n          <span class=\"mc-linkline1\" id=\"mcLinkL1\">paired to MacBook&nbsp;Pro</span>\n          <span class=\"mc-linkline2\" id=\"mcLinkL2\"><i class=\"mc-dot\" id=\"mcLinkDot\"></i><span id=\"mcLat\">12 ms · wifi</span></span>\n        </div>\n      </button>\n\n      <button class=\"mc-ask\" id=\"mcAsk\" aria-label=\"Ask Mosh — hold to talk\">\n        <span class=\"mc-askmic\">\n          <svg width=\"15\" height=\"20\" viewBox=\"0 0 15 20\" fill=\"none\"><rect x=\"4.5\" y=\"1\" width=\"6\" height=\"11\" rx=\"3\" fill=\"currentColor\"/><path d=\"M1.5 9.5a6 6 0 0 0 12 0\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M7.5 15.5V19\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n        </span>\n        <span class=\"mc-asktext\">\n          <span class=\"mc-askmain\" id=\"mcAskMain\">Ask Mosh</span>\n          <span class=\"mc-asksub\" id=\"mcAskSub\">hold to talk · F&nbsp;min</span>\n        </span>\n        <span class=\"mc-askwave\" id=\"mcAskWave\"><b></b><b></b><b></b><b></b></span>\n      </button>\n    </div>\n\n    <!-- row B · jog strip -->\n    <div class=\"mc-jog\">\n      <div class=\"mc-joglabels\"><span>SCRUB</span><span class=\"mc-joglabR\">SNAP · BAR&nbsp;&nbsp;·&nbsp;&nbsp;64 BARS</span></div>\n      <div class=\"mc-rail\" id=\"mcRail\">\n        <div class=\"mc-track\" id=\"mcTrack\">\n          <div class=\"mc-ticks\" id=\"mcTicks\"></div>\n          <div class=\"mc-sections\" id=\"mcSections\"></div>\n          <div class=\"mc-jfill\" id=\"mcJfill\"></div>\n          <div class=\"mc-jhandle\" id=\"mcHandle\" role=\"slider\" aria-label=\"song position\" tabindex=\"0\">\n            <i></i><i class=\"mc-notch\"></i><i></i>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- row C · faders + thumb-arc transport -->\n    <div class=\"mc-rowC\">\n      <div class=\"mc-faders\">\n        <div class=\"mc-ch\" id=\"mcChV\">\n          <div class=\"mc-chhead\"><span class=\"mc-chname\">VOX</span><span class=\"mc-chdb\" id=\"mcDbV\">−3.2</span></div>\n          <div class=\"mc-groove\" id=\"mcGrooveV\">\n            <div class=\"mc-meter\" id=\"mcMeterV\"></div>\n            <div class=\"mc-peak\" id=\"mcPeakV\"></div>\n            <div class=\"mc-unity\"></div>\n            <div class=\"mc-cap\" id=\"mcCapV\"><i></i><i></i><i></i></div>\n          </div>\n          <div class=\"mc-msrow\">\n            <button class=\"mc-ms mc-m\" id=\"mcMV\" aria-label=\"mute vox\">M</button>\n            <button class=\"mc-ms mc-s\" id=\"mcSV\" aria-label=\"solo vox\">S</button>\n          </div>\n        </div>\n        <div class=\"mc-ch\" id=\"mcChD\">\n          <div class=\"mc-chhead\"><span class=\"mc-chname\">DRUMS</span><span class=\"mc-chdb\" id=\"mcDbD\">−6.0</span></div>\n          <div class=\"mc-groove\" id=\"mcGrooveD\">\n            <div class=\"mc-meter\" id=\"mcMeterD\"></div>\n            <div class=\"mc-peak\" id=\"mcPeakD\"></div>\n            <div class=\"mc-unity\"></div>\n            <div class=\"mc-cap\" id=\"mcCapD\"><i></i><i></i><i></i></div>\n          </div>\n          <div class=\"mc-msrow\">\n            <button class=\"mc-ms mc-m\" id=\"mcMD\" aria-label=\"mute drums\">M</button>\n            <button class=\"mc-ms mc-s\" id=\"mcSD\" aria-label=\"solo drums\">S</button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"mc-transport\">\n        <button class=\"mc-tbtn mc-stop\" id=\"mcStop\" aria-label=\"stop\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><rect x=\"1.5\" y=\"1.5\" width=\"13\" height=\"13\" rx=\"3\" fill=\"currentColor\"/></svg>\n        </button>\n        <button class=\"mc-tbtn mc-rec\" id=\"mcRec\" aria-label=\"record\">\n          <span class=\"mc-recdot\"></span>\n        </button>\n        <button class=\"mc-play\" id=\"mcPlay\" aria-label=\"play / pause\">\n          <span class=\"mc-playring\"></span>\n          <svg class=\"mc-iplay\" width=\"34\" height=\"38\" viewBox=\"0 0 34 38\"><path d=\"M31.2 15.7c1.8 1 1.8 3.6 0 4.6L5.5 35.2c-1.8 1-4-.3-4-2.3V5.1c0-2 2.2-3.3 4-2.3Z\" fill=\"currentColor\"/></svg>\n          <svg class=\"mc-ipause\" width=\"26\" height=\"30\" viewBox=\"0 0 26 30\"><rect x=\"1\" y=\"1\" width=\"8.5\" height=\"28\" rx=\"2.6\" fill=\"currentColor\"/><rect x=\"16.5\" y=\"1\" width=\"8.5\" height=\"28\" rx=\"2.6\" fill=\"currentColor\"/></svg>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"mc-home\"></div>\n  </div>\n</div>\n\n<style>\n  .mc-root{position:absolute;inset:0;overflow:hidden;background:var(--v2-bg);color:var(--v2-text);\n    font-family:var(--font-body);-webkit-font-smoothing:antialiased;user-select:none;-webkit-user-select:none;\n    --coat1:#8b6cff;--coat2:#ff9d5c;}\n  .mc-root *{box-sizing:border-box;margin:0;padding:0}\n  .mc-root button{background:none;border:0;color:inherit;font:inherit;cursor:pointer;touch-action:manipulation}\n  .mc-root button:focus-visible{outline:2px solid var(--v2-accent);outline-offset:3px;border-radius:12px}\n\n  /* ── GLANCE ZONE ─────────────────────────────────────────────── */\n  .mc-glance{position:absolute;inset:0 0 auto 0;height:380px;overflow:hidden}\n  .mc-blob{position:absolute;border-radius:50%;filter:blur(64px);opacity:.16;pointer-events:none}\n  .mc-blobA{width:320px;height:300px;left:-110px;top:-40px;background:radial-gradient(circle at 40% 40%,var(--coat1),transparent 70%);animation:mcDriftA 52s ease-in-out infinite alternate}\n  .mc-blobB{width:280px;height:260px;right:-90px;top:110px;background:radial-gradient(circle at 55% 45%,var(--coat2),transparent 70%);opacity:.11;animation:mcDriftB 64s ease-in-out infinite alternate}\n  @keyframes mcDriftA{from{transform:translate(0,0) rotate(0deg)}to{transform:translate(46px,26px) rotate(28deg)}}\n  @keyframes mcDriftB{from{transform:translate(0,0)}to{transform:translate(-38px,34px)}}\n  .mc-grain{position:absolute;inset:0;pointer-events:none;opacity:.07;mix-blend-mode:overlay;\n    background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/><feColorMatrix type='saturate' values='0'/></filter><rect width='140' height='140' filter='url(%23n)'/></svg>\")}\n\n  .mc-status{position:absolute;top:0;left:0;right:0;height:54px;display:flex;align-items:flex-end;\n    justify-content:space-between;padding:0 30px 8px;pointer-events:none}\n  .mc-clock{font-size:15px;font-weight:600;letter-spacing:.01em;font-variant-numeric:tabular-nums}\n  .mc-sicons{display:flex;align-items:center;gap:7px;color:var(--v2-text)}\n\n  .mc-head{position:absolute;top:66px;left:24px;right:24px;pointer-events:none}\n  .mc-titlerow{display:flex;align-items:center;gap:10px}\n  .mc-coat{width:13px;height:13px;border-radius:4.5px;flex:none;\n    background:linear-gradient(135deg,var(--coat1) 10%,#4636a0 45%,var(--coat2) 95%);\n    box-shadow:0 0 0 1px rgba(255,255,255,.10),0 2px 8px rgba(139,108,255,.35)}\n  .mc-title{font-family:var(--font-display);font-size:24px;letter-spacing:.01em;line-height:1;transform:translateY(-1px)}\n  .mc-brand{margin-left:auto;font-family:var(--font-mono);font-size:8px;letter-spacing:.24em;color:var(--v2-faint)}\n  .mc-recchip{display:none;margin-left:auto;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;\n    border:1px solid rgba(255,59,92,.5);background:rgba(255,59,92,.12);color:var(--v2-rec);\n    font-family:var(--font-mono);font-size:10px;letter-spacing:.1em}\n  .mc-recchip i{width:6px;height:6px;border-radius:50%;background:var(--v2-rec);animation:mcRecBlink 1s steps(2,end) infinite}\n  .mc-recchip em{font-style:normal;font-variant-numeric:tabular-nums}\n  .mc-root.mc-armed .mc-recchip{display:inline-flex}\n  .mc-root.mc-armed .mc-brand{display:none}\n  @keyframes mcRecBlink{50%{opacity:.25}}\n  .mc-sub{margin-top:9px;font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;color:var(--v2-dim)}\n\n  .mc-bigwrap{position:absolute;left:0;right:0;top:150px;text-align:center;pointer-events:none;transition:opacity .5s}\n  .mc-root.mc-lost .mc-bigwrap{opacity:.32}\n  .mc-big{font-family:var(--font-display);font-size:122px;line-height:1;letter-spacing:-.015em;\n    font-variant-numeric:tabular-nums;display:inline-flex;align-items:baseline;\n    text-shadow:0 2px 30px rgba(0,0,0,.5)}\n  .mc-bars{display:inline-flex}\n  .mc-bars i,.mc-beat{display:inline-block;width:.64em;text-align:center;font-style:normal}\n  .mc-bdot{display:inline-block;width:.3em;text-align:center;color:var(--v2-faint)}\n  .mc-beat{color:var(--v2-accent);transition:transform .2s cubic-bezier(.2,1.4,.4,1);will-change:transform}\n  .mc-beat.pk{transform:scale(1.09);text-shadow:0 0 26px rgba(204,255,54,.45)}\n  .mc-beatdots{margin-top:16px;display:flex;justify-content:center;gap:12px}\n  .mc-beatdots b{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.14);transition:background .12s,box-shadow .12s,transform .12s}\n  .mc-beatdots b.on{background:var(--v2-accent);box-shadow:0 0 12px rgba(204,255,54,.5);transform:scale(1.25)}\n  .mc-bigcap{margin-top:14px;font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;color:var(--v2-faint);font-variant-numeric:tabular-nums}\n  .mc-capsep{margin:0 8px;opacity:.6}\n\n  /* ── THE DECK ────────────────────────────────────────────────── */\n  .mc-deck{position:absolute;left:0;right:0;top:380px;bottom:0;border-radius:28px 28px 0 0;\n    padding:14px 16px 0;overflow:hidden;\n    box-shadow:0 -26px 70px rgba(0,0,0,.6),0 -1px 0 rgba(255,255,255,.13)}\n  .mc-deckglass{position:absolute;inset:0;pointer-events:none;border-radius:28px 28px 0 0;\n    background:linear-gradient(180deg,rgba(27,27,29,.86),rgba(14,14,15,.94));\n    -webkit-backdrop-filter:blur(26px) saturate(1.25);backdrop-filter:blur(26px) saturate(1.25)}\n  .mc-deckglass::before{content:\"\";position:absolute;inset:0;border-radius:inherit;\n    background:linear-gradient(115deg,rgba(139,108,255,.05),transparent 42%,rgba(255,157,92,.04) 92%)}\n  .mc-deckglass::after{content:\"\";position:absolute;top:0;left:24px;right:24px;height:1px;\n    background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent)}\n  .mc-deck>*:not(.mc-deckglass){position:relative}\n\n  /* row A */\n  .mc-rowA{display:flex;align-items:center;gap:10px;height:72px}\n  .mc-linkcluster{display:flex;align-items:center;gap:11px;padding:2px;border-radius:18px;min-width:0;\n    transition:transform .15s}\n  .mc-linkcluster:active{transform:scale(.98)}\n  .mc-moshihost{width:66px;height:66px;flex:none;border-radius:18px;overflow:hidden;position:relative;\n    background:var(--v2-surface-sunken);border:1px solid var(--v2-line);\n    box-shadow:inset 0 2px 8px rgba(0,0,0,.55)}\n  .mc-fb{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:7px;\n    background:radial-gradient(80% 80% at 50% 42%,#141414,#0b0b0b)}\n  .mc-fbeye{display:inline-flex;transform-origin:center;animation:mcBlink 5.2s infinite}\n  .mc-fbR{animation-delay:.05s}\n  @keyframes mcBlink{0%,93%,100%{transform:scaleY(1)}95.5%{transform:scaleY(.08)}}\n  .mc-root.mc-lost .mc-fbeye{animation:none;transform:scaleY(.08)}\n  .mc-root.mc-spike .mc-fbeye{animation:none;transform:scaleY(.45)}\n  .mc-linktext{display:flex;flex-direction:column;align-items:flex-start;gap:5px;min-width:0;overflow:hidden}\n  .mc-linkline1{font-size:12px;color:var(--v2-dim);white-space:nowrap;letter-spacing:.01em;transition:color .3s;\n    max-width:100%;overflow:hidden;text-overflow:ellipsis}\n  .mc-linkline2{display:flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:11px;\n    color:var(--v2-text);font-variant-numeric:tabular-nums;white-space:nowrap;transition:color .3s;\n    max-width:100%;overflow:hidden}\n  .mc-linkline2 span{min-width:0;overflow:hidden;text-overflow:ellipsis}\n  .mc-dot{flex:none;width:7px;height:7px;border-radius:50%;background:var(--status-ok);\n    box-shadow:0 0 8px rgba(63,224,106,.6);transition:background .3s,box-shadow .3s}\n  .mc-root.mc-spike .mc-dot{background:var(--status-warn);box-shadow:0 0 8px rgba(255,212,92,.6)}\n  .mc-root.mc-spike .mc-linkline2{color:var(--status-warn)}\n  .mc-root.mc-lost .mc-dot{background:var(--v2-rec);box-shadow:0 0 8px rgba(255,59,92,.6);animation:mcRecBlink 1.1s steps(2,end) infinite}\n  .mc-root.mc-lost .mc-linkline1{color:var(--v2-rec)}\n  .mc-root.mc-lost .mc-linkline2{color:var(--v2-rec)}\n  .mc-linkline2.mc-repair{color:var(--status-ok)!important}\n\n  .mc-ask{margin-left:auto;flex:none;display:flex;align-items:center;gap:10px;height:52px;padding:0 16px 0 14px;\n    border-radius:26px;background:var(--v2-surface-2);border:1px solid var(--v2-line);\n    box-shadow:var(--v2-glow),0 6px 18px rgba(0,0,0,.35);\n    transition:background .2s,border-color .2s,transform .15s,box-shadow .2s}\n  .mc-ask:active{transform:scale(.97)}\n  .mc-askmic{color:var(--v2-dim);display:inline-flex;transition:color .2s}\n  .mc-asktext{display:flex;flex-direction:column;align-items:flex-start;gap:3px}\n  .mc-askmain{font-size:13px;font-weight:600;letter-spacing:.01em;line-height:1}\n  .mc-asksub{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.1em;color:var(--v2-faint);line-height:1;white-space:nowrap}\n  .mc-askwave{display:none;align-items:center;gap:3px;height:16px}\n  .mc-askwave b{width:3px;border-radius:2px;background:var(--v2-accent);height:6px;animation:mcWave .8s ease-in-out infinite}\n  .mc-askwave b:nth-child(2){animation-delay:.12s}.mc-askwave b:nth-child(3){animation-delay:.24s}.mc-askwave b:nth-child(4){animation-delay:.36s}\n  @keyframes mcWave{50%{height:15px}}\n  .mc-ask.mc-hold{background:var(--v2-accent-soft);border-color:rgba(204,255,54,.4);\n    box-shadow:0 0 0 4px rgba(204,255,54,.08),0 6px 22px rgba(0,0,0,.4)}\n  .mc-ask.mc-hold .mc-askmic{color:var(--v2-accent)}\n  .mc-ask.mc-hold .mc-askwave{display:inline-flex}\n  .mc-ask.mc-hold .mc-asksub{color:var(--v2-accent)}\n  .mc-ask.mc-sent{border-color:rgba(63,224,106,.45)}\n  .mc-ask.mc-sent .mc-asksub{color:var(--status-ok)}\n\n  /* row B · jog */\n  .mc-jog{margin-top:11px}\n  .mc-joglabels{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:8.5px;\n    letter-spacing:.22em;color:var(--v2-faint);padding:0 2px 7px}\n  .mc-rail{height:66px;border-radius:14px;background:var(--v2-surface-sunken);\n    border:1px solid var(--v2-line);box-shadow:inset 0 2px 10px rgba(0,0,0,.5);\n    position:relative;touch-action:none;cursor:grab}\n  .mc-track{position:absolute;inset:0 26px;}\n  .mc-ticks{position:absolute;top:7px;left:0;right:0;height:26px;pointer-events:none}\n  .mc-tick{position:absolute;top:12px;width:1px;height:8px;background:rgba(255,255,255,.13);transform:translateX(-.5px)}\n  .mc-tick.mc-t4{top:10px;height:12px;background:rgba(255,255,255,.24)}\n  .mc-ticknum{position:absolute;top:-8px;transform:translateX(-50%);font-family:var(--font-mono);\n    font-size:7.5px;color:var(--v2-faint);font-variant-numeric:tabular-nums;letter-spacing:.05em}\n  .mc-sections{position:absolute;left:0;right:0;top:37px;height:12px;pointer-events:none}\n  .mc-sec{position:absolute;top:0;height:100%;border-radius:3px;background:rgba(255,255,255,.05);\n    display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:7px;\n    letter-spacing:.14em;color:var(--v2-faint);transition:background .3s,color .3s}\n  .mc-sec.mc-live{background:rgba(255,255,255,.11);color:var(--v2-dim)}\n  .mc-jfill{position:absolute;left:0;bottom:6px;height:2px;border-radius:1px;background:var(--v2-accent);\n    opacity:.55;pointer-events:none}\n  .mc-jhandle{position:absolute;top:50%;width:52px;height:50px;border-radius:13px;cursor:grab;\n    transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;gap:5px;\n    background:linear-gradient(180deg,rgba(52,52,58,.72),rgba(30,30,34,.78));\n    -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);\n    border:1px solid var(--v2-line-strong);\n    box-shadow:0 4px 14px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.14);\n    transition:box-shadow .2s,border-color .2s}\n  .mc-jhandle i{width:2px;height:16px;border-radius:1px;background:rgba(255,255,255,.28)}\n  .mc-jhandle i.mc-notch{height:24px;background:var(--v2-accent);opacity:.85;box-shadow:0 0 8px rgba(204,255,54,.35)}\n  .mc-jhandle.mc-drag{cursor:grabbing;border-color:rgba(204,255,54,.55);\n    box-shadow:0 0 0 4px rgba(204,255,54,.1),0 0 26px rgba(204,255,54,.22),0 4px 14px rgba(0,0,0,.5)}\n  .mc-jhandle.mc-snap{transition:left .3s cubic-bezier(.2,1.7,.35,1),box-shadow .2s,border-color .2s}\n  .mc-jhandle.mc-barx i.mc-notch{box-shadow:0 0 16px rgba(204,255,54,.8)}\n\n  /* row C */\n  .mc-rowC{margin-top:13px;display:flex;gap:12px;align-items:flex-start}\n  .mc-faders{display:flex;gap:10px}\n  .mc-ch{width:94px;display:flex;flex-direction:column;align-items:center}\n  .mc-chhead{width:100%;display:flex;justify-content:space-between;align-items:baseline;padding:0 5px 7px}\n  .mc-chname{font-family:var(--font-mono);font-size:9px;letter-spacing:.2em;color:var(--v2-dim)}\n  .mc-chdb{font-family:var(--font-mono);font-size:10px;color:var(--v2-text);font-variant-numeric:tabular-nums}\n  .mc-groove{position:relative;width:56px;height:148px;border-radius:12px;background:var(--v2-surface-sunken);\n    border:1px solid var(--v2-line);box-shadow:inset 0 2px 10px rgba(0,0,0,.55);\n    touch-action:none;cursor:grab;overflow:visible}\n  .mc-meter{position:absolute;left:5px;right:5px;bottom:5px;height:0%;border-radius:7px;\n    background:linear-gradient(180deg,rgba(233,236,240,.34),rgba(233,236,240,.12));pointer-events:none}\n  .mc-peak{position:absolute;left:5px;right:5px;bottom:0;height:2px;border-radius:1px;background:var(--v2-accent);\n    opacity:.9;pointer-events:none;box-shadow:0 0 6px rgba(204,255,54,.4)}\n  .mc-unity{position:absolute;left:-7px;right:-7px;top:22px;height:1px;background:rgba(255,255,255,.12);pointer-events:none}\n  .mc-cap{position:absolute;left:50%;width:72px;height:38px;border-radius:11px;transform:translateX(-50%);\n    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3.5px;cursor:grab;\n    background:linear-gradient(180deg,rgba(56,56,62,.96),rgba(34,34,38,.96));\n    border:1px solid var(--v2-line-strong);\n    box-shadow:0 5px 14px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.16);\n    transition:box-shadow .2s,border-color .2s}\n  .mc-cap i{width:34px;height:1.5px;border-radius:1px;background:rgba(255,255,255,.22)}\n  .mc-cap i:nth-child(2){background:rgba(204,255,54,.6);width:40px}\n  .mc-groove.mc-drag .mc-cap{border-color:rgba(204,255,54,.5);\n    box-shadow:0 0 0 4px rgba(204,255,54,.09),0 5px 16px rgba(0,0,0,.55)}\n  .mc-msrow{display:flex;gap:6px;margin-top:9px}\n  .mc-ms{width:44px;height:40px;border-radius:11px;background:var(--v2-surface-2);border:1px solid var(--v2-line);\n    font-family:var(--font-mono);font-size:11px;font-weight:700;color:var(--v2-dim);\n    box-shadow:var(--v2-glow);transition:all .15s}\n  .mc-ms:active{transform:scale(.94)}\n  .mc-ms.mc-on.mc-m{background:rgba(255,212,92,.16);border-color:rgba(255,212,92,.5);color:var(--status-warn)}\n  .mc-ms.mc-on.mc-s{background:var(--v2-accent-soft);border-color:rgba(204,255,54,.5);color:var(--v2-accent)}\n  .mc-ch.mc-ducked .mc-groove,.mc-ch.mc-ducked .mc-chdb{opacity:.45}\n\n  .mc-transport{position:relative;flex:1;height:236px}\n  .mc-tbtn{position:absolute;width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;\n    background:var(--v2-surface-2);border:1px solid var(--v2-line);color:var(--v2-dim);\n    box-shadow:var(--v2-glow),0 8px 20px rgba(0,0,0,.4);transition:all .16s}\n  .mc-tbtn:active{transform:scale(.92)}\n  .mc-stop{left:6px;top:10px}\n  .mc-stop:active{color:var(--v2-text)}\n  .mc-rec{right:6px;top:10px;width:56px;height:56px}\n  .mc-recdot{width:19px;height:19px;border-radius:50%;background:var(--v2-rec);opacity:.85;transition:all .2s}\n  .mc-rec.mc-on{background:rgba(255,59,92,.16);border-color:rgba(255,59,92,.6);\n    box-shadow:0 0 0 5px rgba(255,59,92,.1),0 0 28px rgba(255,59,92,.3),0 8px 20px rgba(0,0,0,.4)}\n  .mc-rec.mc-on .mc-recdot{opacity:1;box-shadow:0 0 14px rgba(255,59,92,.8);animation:mcRecBlink 1.2s steps(2,end) infinite}\n  .mc-play{position:absolute;left:50%;transform:translateX(-50%);top:86px;width:108px;height:108px;border-radius:50%;\n    display:flex;align-items:center;justify-content:center;color:var(--v2-accent-ink);\n    background:radial-gradient(120% 120% at 32% 24%,#e4ff70 0%,var(--v2-accent) 44%,#9fcc23 100%);\n    box-shadow:0 18px 44px rgba(204,255,54,.24),0 8px 22px rgba(0,0,0,.5),\n      inset 0 2px 2px rgba(255,255,255,.5),inset 0 -10px 22px rgba(60,90,0,.32);\n    transition:transform .14s cubic-bezier(.3,1.4,.5,1),box-shadow .2s,filter .4s}\n  .mc-play:active{transform:translateX(-50%) scale(.94)}\n  .mc-play svg{position:relative;filter:drop-shadow(0 1px 0 rgba(255,255,255,.25))}\n  .mc-iplay{margin-left:7px}\n  .mc-ipause{display:none}\n  .mc-root.mc-playing .mc-iplay{display:none}\n  .mc-root.mc-playing .mc-ipause{display:block}\n  .mc-playring{position:absolute;inset:-7px;border-radius:50%;border:1.5px solid rgba(204,255,54,.0);pointer-events:none}\n  .mc-playring.pk{animation:mcRing .46s ease-out}\n  @keyframes mcRing{0%{border-color:rgba(204,255,54,.5);transform:scale(1)}100%{border-color:rgba(204,255,54,0);transform:scale(1.16)}}\n  .mc-root.mc-lost .mc-play{filter:grayscale(.6) brightness(.75)}\n  .mc-root.mc-lost .mc-deck{--x:0}\n\n  .mc-home{position:absolute;left:50%;bottom:9px;transform:translateX(-50%);width:134px;height:5px;\n    border-radius:3px;background:rgba(255,255,255,.3)}\n\n  @media (prefers-reduced-motion:reduce){\n    .mc-blob,.mc-fbeye,.mc-askwave b{animation:none!important}\n  }\n</style>\n\n<script>\n(function(){\n  var $ = function(id){ return document.getElementById(id); };\n  var root=$('mcRoot');\n  if(!root) return;\n\n  /* ── state ─────────────────────────────────────────── */\n  var BPM=134, BPB=4, BARS=64, TOTAL=BARS*BPB;\n  var S={\n    beats:16*BPB,            // bar 17.1\n    playing:true,\n    rec:false, recStart:0,\n    link:'ok',               // ok | spike | lost\n    asking:false,\n    scrub:false,\n    ch:{ v:{g:0.861,m:false,s:false,lvl:0,peak:0,peakT:0},\n         d:{g:0.818,m:false,s:false,lvl:0,peak:0,peakT:0} }\n  };\n  var SECTIONS=[\n    {n:'IN', a:0, b:8},{n:'V1',a:8, b:24},{n:'HK',a:24,b:32},\n    {n:'V2',a:32,b:48},{n:'HK',a:48,b:56},{n:'OUT',a:56,b:64}\n  ];\n\n  /* ── build jog ticks + sections ────────────────────── */\n  var ticks=$('mcTicks'), secs=$('mcSections');\n  for(var b=0;b<BARS;b++){\n    var pct=(b*BPB/TOTAL*100);\n    var t=document.createElement('span');\n    t.className='mc-tick'+(b%4===0?' mc-t4':'');\n    t.style.left=pct+'%';\n    ticks.appendChild(t);\n    if(b%8===0){\n      var n=document.createElement('span');\n      n.className='mc-ticknum'; n.textContent=(b+1);\n      n.style.left=pct+'%';\n      ticks.appendChild(n);\n    }\n  }\n  var secEls=[];\n  SECTIONS.forEach(function(s){\n    var e=document.createElement('span');\n    e.className='mc-sec';\n    e.style.left=(s.a/BARS*100)+'%';\n    e.style.width=((s.b-s.a)/BARS*100-0.7)+'%';\n    e.textContent=s.n;\n    secs.appendChild(e); secEls.push(e);\n  });\n\n  /* ── Moshi: the connection's face ──────────────────── */\n  var m=null, fb=$('mcFb');\n  try{\n    if(window.Moshi){\n      var host=$('mcMoshi');\n      if(fb) fb.style.display='none';\n      m=window.Moshi(host,{personality:'TAR',seed:0.5,quality:'ps2',style:'toon',interactive:true,room:false});\n      m.set('mood',0.65); m.set('energy',0.5); m.set('heat',0.05);\n    }\n  }catch(e){ if(fb) fb.style.display='flex'; m=null; }\n\n  function moshiResolve(){\n    var st, heat=0.05, energy=S.playing?0.55:0.3;\n    if(S.link==='lost'){ st='SLEEPING'; energy=0.1; }\n    else if(S.link==='spike'){ st='PAUSED'; energy=0.2; }\n    else if(S.asking){ st='LISTENING'; energy=0.6; }\n    else if(S.rec){ st='RECORDING'; heat=0.7; energy=0.7; }\n    else st='IDLE';\n    if(m){ try{ m.setState(st); m.set('heat',heat); m.set('energy',energy); }catch(e){} }\n  }\n\n  /* ── link telemetry demo (tap the cluster) ─────────── */\n  var latEl=$('mcLat'), l1=$('mcLinkL1'), l2=$('mcLinkL2');\n  var lat=12, latTimer=null, repairTimer=null;\n  function jitter(){\n    if(S.link==='ok'){ lat=9+Math.round(Math.random()*7); latEl.textContent=lat+' ms · wifi'; }\n    else if(S.link==='spike'){ lat=180+Math.round(Math.random()*60); latEl.textContent=lat+' ms · congested'; }\n  }\n  latTimer=setInterval(jitter,900);\n  function setLink(mode){\n    S.link=mode;\n    root.classList.toggle('mc-spike',mode==='spike');\n    root.classList.toggle('mc-lost',mode==='lost');\n    l2.classList.remove('mc-repair');\n    if(mode==='ok'){ l1.textContent='paired to MacBook Pro'; jitter(); }\n    if(mode==='spike'){ l1.textContent='paired to MacBook Pro'; jitter(); }\n    if(mode==='lost'){\n      l1.textContent='connection lost';\n      latEl.textContent='reconnecting…';\n      clearTimeout(repairTimer);\n      repairTimer=setTimeout(function(){          // auto re-pair — Moshi wakes\n        setLink('ok');\n        latEl.textContent='re-paired · 11 ms';\n        l2.classList.add('mc-repair');\n        if(m){ try{ m.setState('LISTENING'); }catch(e){} }\n        setTimeout(function(){ l2.classList.remove('mc-repair'); moshiResolve(); },1600);\n      },3800);\n    }\n    moshiResolve();\n  }\n  $('mcLink').addEventListener('click',function(){\n    if(S.link==='ok') setLink('spike');\n    else if(S.link==='spike') setLink('lost');\n    else { clearTimeout(repairTimer); setLink('ok'); }\n  });\n\n  /* ── transport ─────────────────────────────────────── */\n  var playBtn=$('mcPlay'), ring=playBtn.querySelector('.mc-playring');\n  playBtn.addEventListener('click',function(){\n    S.playing=!S.playing;\n    root.classList.toggle('mc-playing',S.playing);\n    moshiResolve();\n  });\n  root.classList.add('mc-playing');\n\n  $('mcStop').addEventListener('click',function(){\n    if(S.playing){ S.playing=false; root.classList.remove('mc-playing');\n      S.beats=Math.floor(S.beats/BPB)*BPB; }        // stop → bar start\n    else if(S.beats%BPB===0 && S.beats>0){ S.beats=0; }  // stop again → top\n    else { S.beats=Math.floor(S.beats/BPB)*BPB; }\n    moshiResolve();\n  });\n\n  var recBtn=$('mcRec');\n  recBtn.addEventListener('click',function(){\n    S.rec=!S.rec;\n    if(S.rec) S.recStart=nowS();\n    recBtn.classList.toggle('mc-on',S.rec);\n    root.classList.toggle('mc-armed',S.rec);\n    moshiResolve();\n  });\n\n  /* ── Ask Mosh · hold to talk ───────────────────────── */\n  var ask=$('mcAsk'), askMain=$('mcAskMain'), askSub=$('mcAskSub');\n  function askDown(e){ e.preventDefault(); S.asking=true; ask.classList.add('mc-hold');\n    askMain.textContent='listening…'; askSub.textContent='release to send'; moshiResolve(); }\n  function askUp(){\n    if(!S.asking) return;\n    S.asking=false; ask.classList.remove('mc-hold');\n    askMain.textContent='Ask Mosh'; askSub.textContent='sent ✓';\n    ask.classList.add('mc-sent');\n    setTimeout(function(){ askSub.textContent='hold to talk · F min'; ask.classList.remove('mc-sent'); },1500);\n    moshiResolve();\n  }\n  ask.addEventListener('pointerdown',askDown);\n  ask.addEventListener('pointerup',askUp);\n  ask.addEventListener('pointercancel',askUp);\n  ask.addEventListener('pointerleave',askUp);\n\n  /* ── jog strip · magnetic bar detents ──────────────── */\n  var track=$('mcTrack'), handle=$('mcHandle'), jfill=$('mcJfill');\n  var dragId=null, lastBarCross=-1;\n  function jogPos(clientX){\n    var r=track.getBoundingClientRect();\n    return Math.max(0,Math.min(1,(clientX-r.left)/r.width));\n  }\n  function jogDown(e){\n    dragId=e.pointerId; S.scrub=true;\n    handle.classList.add('mc-drag'); handle.classList.remove('mc-snap');\n    try{ track.setPointerCapture(e.pointerId); }catch(_){}\n    jogMove(e);\n  }\n  function jogMove(e){\n    if(dragId!==e.pointerId) return;\n    var x01=jogPos(e.clientX);\n    S.beats=x01*TOTAL;\n    var bar=Math.floor(S.beats/BPB);\n    if(bar!==lastBarCross){                          // detent tick on each bar crossed\n      lastBarCross=bar;\n      handle.classList.add('mc-barx');\n      setTimeout(function(){ handle.classList.remove('mc-barx'); },70);\n    }\n    paintJog();\n  }\n  function jogUp(e){\n    if(dragId!==e.pointerId) return;\n    dragId=null; S.scrub=false;\n    handle.classList.remove('mc-drag');\n    S.beats=Math.min(TOTAL-BPB,Math.round(S.beats/BPB)*BPB);   // SNAP to bar\n    handle.classList.add('mc-snap');\n    paintJog();\n    setTimeout(function(){ handle.classList.remove('mc-snap'); },320);\n  }\n  track.addEventListener('pointerdown',jogDown);\n  track.addEventListener('pointermove',jogMove);\n  track.addEventListener('pointerup',jogUp);\n  track.addEventListener('pointercancel',jogUp);\n\n  function paintJog(){\n    var pct=S.beats/TOTAL*100;\n    handle.style.left=pct+'%';\n    jfill.style.width=pct+'%';\n  }\n\n  /* ── faders ────────────────────────────────────────── */\n  function db(g){ var v=-60+g*66; return v<=-58?'−∞':(v>0?'+':v<0?'−':'')+Math.abs(v).toFixed(1); }\n  function wireFader(key,grooveId,capId,dbId){\n    var groove=$(grooveId), cap=$(capId), dbEl=$(dbId), id=null;\n    var CAPH=38;\n    function paint(){\n      var h=groove.clientHeight||148;\n      cap.style.bottom=(S.ch[key].g*(h-CAPH))+'px';\n      dbEl.textContent=db(S.ch[key].g);\n    }\n    function mv(e){\n      if(id!==e.pointerId) return;\n      var r=groove.getBoundingClientRect();\n      S.ch[key].g=Math.max(0,Math.min(1,1-(e.clientY-r.top-CAPH/2)/(r.height-CAPH)));\n      paint();\n    }\n    groove.addEventListener('pointerdown',function(e){\n      id=e.pointerId; groove.classList.add('mc-drag');\n      try{ groove.setPointerCapture(e.pointerId); }catch(_){}\n      mv(e);\n    });\n    groove.addEventListener('pointermove',mv);\n    var up=function(e){ if(id===e.pointerId){ id=null; groove.classList.remove('mc-drag'); } };\n    groove.addEventListener('pointerup',up);\n    groove.addEventListener('pointercancel',up);\n    paint();\n    return paint;\n  }\n  wireFader('v','mcGrooveV','mcCapV','mcDbV');\n  wireFader('d','mcGrooveD','mcCapD','mcDbD');\n\n  function wireMS(key,mId,sId){\n    $(mId).addEventListener('click',function(){ S.ch[key].m=!S.ch[key].m; this.classList.toggle('mc-on',S.ch[key].m); duck(); });\n    $(sId).addEventListener('click',function(){ S.ch[key].s=!S.ch[key].s; this.classList.toggle('mc-on',S.ch[key].s); duck(); });\n  }\n  function duck(){\n    var anySolo=S.ch.v.s||S.ch.d.s;\n    $('mcChV').classList.toggle('mc-ducked',(anySolo&&!S.ch.v.s)||S.ch.v.m);\n    $('mcChD').classList.toggle('mc-ducked',(anySolo&&!S.ch.d.s)||S.ch.d.m);\n  }\n  wireMS('v','mcMV','mcSV');\n  wireMS('d','mcMD','mcSD');\n\n  /* ── simulated program levels (grooves at 134) ─────── */\n  function voxLvl(t,beats){\n    var phrase=(Math.sin(beats*Math.PI/8)+1)/2;\n    var gate=phrase>0.28?1:0.08;\n    var w=0.55+0.25*Math.sin(t*2.3)+0.12*Math.sin(t*6.1)+0.08*Math.sin(t*11.7);\n    return Math.max(0,Math.min(1,w))*gate*0.92;\n  }\n  function drumLvl(beats){\n    var ph=beats%1;\n    var l=Math.exp(-6*ph)*0.95;                       // kick\n    var b=Math.floor(beats)%4;\n    if(b===1||b===3) l=Math.max(l,Math.exp(-4.6*ph)*0.88);  // snare\n    l=Math.max(l,Math.exp(-9*((beats*2)%1))*0.32);    // hats\n    return l;\n  }\n  function chGain(key){\n    var c=S.ch[key], anySolo=S.ch.v.s||S.ch.d.s;\n    var g=c.m?0:c.g;\n    if(anySolo&&!c.s) g*=0.05;\n    return g;\n  }\n\n  /* ── clock + render loop ───────────────────────────── */\n  function nowS(){\n    if(window.__mosh&&typeof window.__mosh.time==='number') return window.__mosh.time;\n    return performance.now()/1000;\n  }\n  var prev=nowS(), lastBeatInt=-1, lastBig='';\n  var barsEl=$('mcBars'), beatEl=$('mcBeat'),\n      dots=$('mcDots').children,\n      capBar=$('mcCapBar'), capTime=$('mcCapTime'), capSec=$('mcCapSec'),\n      meterV=$('mcMeterV'), peakV=$('mcPeakV'),\n      meterD=$('mcMeterD'), peakD=$('mcPeakD'),\n      recT=$('mcRecT');\n\n  function frame(){\n    var t=nowS(), dt=Math.max(0,Math.min(0.1,t-prev)); prev=t;\n\n    if(S.playing&&!S.scrub&&S.link!=='lost'){\n      S.beats+=dt*BPM/60;\n      if(S.beats>=TOTAL) S.beats-=TOTAL;\n    }\n\n    /* giant readout */\n    var bar=Math.floor(S.beats/BPB)+1, beat=Math.floor(S.beats%BPB)+1;\n    var big=bar+'.'+beat;\n    if(big!==lastBig){\n      lastBig=big;\n      var ds=''+bar, html='';\n      for(var i=0;i<ds.length;i++) html+='<i>'+ds[i]+'</i>';\n      barsEl.innerHTML=html;\n      beatEl.textContent=beat;\n      capBar.textContent='BAR '+bar;\n      for(var k=0;k<4;k++) dots[k].classList.toggle('on',k===beat-1);\n      var cb=bar-1;\n      for(var s2=0;s2<SECTIONS.length;s2++){\n        var live=cb>=SECTIONS[s2].a&&cb<SECTIONS[s2].b;\n        secEls[s2].classList.toggle('mc-live',live);\n        if(live) capSec.textContent=SECTIONS[s2].n==='IN'?'INTRO':SECTIONS[s2].n==='HK'?'HOOK':SECTIONS[s2].n==='OUT'?'OUTRO':'VERSE';\n      }\n    }\n    var bi=Math.floor(S.beats);\n    if(bi!==lastBeatInt){\n      lastBeatInt=bi;\n      if(S.playing){\n        beatEl.classList.add('pk');\n        setTimeout(function(){ beatEl.classList.remove('pk'); },130);\n        ring.classList.remove('pk'); void ring.offsetWidth; ring.classList.add('pk');\n      }\n    }\n    var sec=S.beats*60/BPM;\n    capTime.textContent=('0'+Math.floor(sec/60)).slice(-2)+':'+('0'+Math.floor(sec%60)).slice(-2)+'.'+Math.floor((sec%1)*10);\n\n    if(!S.scrub) paintJog();\n\n    /* meters */\n    var run=S.playing&&S.link!=='lost';\n    var tv=run?voxLvl(t,S.beats)*chGain('v'):0;\n    var td=run?drumLvl(S.beats)*chGain('d'):0;\n    [['v',tv,meterV,peakV],['d',td,meterD,peakD]].forEach(function(row){\n      var c=S.ch[row[0]], tgt=row[1];\n      c.lvl+= (tgt-c.lvl)*(tgt>c.lvl?0.5:0.14);\n      if(c.lvl>c.peak){ c.peak=c.lvl; c.peakT=t; }\n      else if(t-c.peakT>0.5) c.peak=Math.max(c.lvl,c.peak-dt*0.6);\n      row[2].style.height=(c.lvl*94)+'%';\n      row[3].style.bottom=(5+c.peak*94*1.38)+'px';\n    });\n\n    /* rec timer */\n    if(S.rec){\n      var rs=t-S.recStart;\n      recT.textContent=Math.floor(rs/60)+':'+('0'+Math.floor(rs%60)).slice(-2);\n    }\n\n    requestAnimationFrame(frame);\n  }\n  paintJog();\n  requestAnimationFrame(frame);\n  moshiResolve();\n})();\n</script>",
