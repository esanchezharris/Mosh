  "source": "<div id=\"mosh-frame\" class=\"theme-midnight\">\n  <style>\n    :root {\n      --gt-ink: #0B0B0B;\n      --gt-lime: #CCFF23;\n      --gt-glow: #D9FF4C;\n      --gt-bone: #F6F2EB;\n      --gt-mist: #E5E5E1;\n    }\n    /* Frame */\n    #mosh-frame {\n      position: relative;\n      width: 1280px;\n      height: 800px;\n      background: var(--v2-bg);\n      color: var(--v2-ground-text);\n      font-family: var(--font-body);\n      letter-spacing: 0.01em;\n      -webkit-font-smoothing: antialiased;\n      overflow: hidden;\n    }\n    /* Stage coat: the song \"patina\" aura - tints the UI, intensity controlled */\n    .stage-coat {\n      position: absolute; inset: 0;\n      pointer-events: none;\n      mix-blend-mode: screen;\n      opacity: var(--coat-intensity, 0.18);\n      filter: saturate(120%) blur(20px);\n      background:\n        radial-gradient(60% 80% at 70% 35%, rgba(205,255,40,0.08), transparent 62%),\n        conic-gradient(from 200deg at 30% 60%, rgba(255,153,60,0.08), rgba(180,102,255,0.06), rgba(120,186,255,0.08), rgba(255,60,120,0.06), rgba(255,210,80,0.08), rgba(205,255,40,0.08));\n    }\n    .stage-coat.patina-morph {\n      background:\n        radial-gradient(22% 18% at 22% 24%, rgba(205,255,40,0.10), transparent 63%),\n        radial-gradient(18% 16% at 76% 46%, rgba(255,110,80,0.10), transparent 66%),\n        radial-gradient(16% 20% at 54% 78%, rgba(140,200,255,0.10), transparent 62%),\n        conic-gradient(from 160deg at 50% 50%, rgba(255,255,255,0.02), rgba(0,0,0,0.0) 50%, rgba(255,255,255,0.03) 100%);\n      opacity: var(--coat-intensity, 0.28);\n      filter: saturate(140%) blur(18px) contrast(105%);\n    }\n\n    /* Topbar */\n    .topbar {\n      position: absolute; left: 0; top: 0; right: 0; height: var(--v2-topbar-h);\n      display: grid;\n      grid-template-columns: 280px 1fr 320px;\n      align-items: center;\n      padding: 0 var(--v2-space-8);\n      backdrop-filter: saturate(140%) blur(8px);\n      background: linear-gradient(180deg, rgba(16,16,16,0.72), rgba(12,12,12,0.54));\n      border-bottom: 1px solid var(--v2-line);\n      box-shadow: inset 0 -1px 0 rgba(255,255,255,0.03);\n    }\n    .brand {\n      display: flex; align-items: center; gap: 10px;\n      font-family: var(--font-display); font-weight: 800; font-size: 17px; letter-spacing: 0.02em;\n    }\n    .brand .splat {\n      width: 30px; height: 30px; border-radius: 8px;\n      display: grid; place-items: center;\n      background: radial-gradient(circle at 60% 40%, rgba(204,255,54,0.18), rgba(204,255,54,0.06));\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 0 1px rgba(255,255,255,0.06);\n    }\n    .brand svg { display: block; }\n    .transport {\n      display: flex; align-items: center; gap: 10px; justify-content: center;\n    }\n    .t-btn {\n      height: 32px; min-width: 32px; padding: 0 12px;\n      border-radius: var(--v2-radius-pill);\n      display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n      background: var(--v2-surface);\n      border: 1px solid var(--v2-line);\n      color: var(--v2-text);\n      box-shadow: var(--v2-glow);\n      cursor: pointer;\n      transition: transform .12s ease, background .2s, border-color .2s, box-shadow .2s;\n    }\n    .t-btn:hover { transform: translateY(-1px); background: var(--v2-surface-2); }\n    .t-btn.primary { background: linear-gradient(180deg, rgba(204,255,54,0.22), rgba(204,255,54,0.10)); color: var(--accent-ink); border-color: rgba(204,255,54,0.42); box-shadow: 0 0 0 1px rgba(204,255,54,0.24), 0 10px 22px rgba(204,255,54,0.12), inset 0 1px 0 rgba(255,255,255,0.18); }\n    .t-time { font-family: var(--font-mono); font-size: var(--v2-fs-md); color: var(--v2-dim); letter-spacing: 0.06em; padding: 0 8px; }\n    .top-right {\n      display: flex; align-items: center; justify-content: flex-end; gap: 8px;\n    }\n    .pill {\n      height: 28px; padding: 0 10px; border: 1px solid var(--v2-line); border-radius: var(--v2-radius-pill);\n      display: inline-flex; align-items: center; gap: 8px; background: var(--v2-surface);\n      box-shadow: var(--v2-glow); color: var(--v2-dim); font-size: var(--v2-fs-sm); cursor: pointer;\n    }\n    .pill .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--v2-dim); box-shadow: 0 0 10px rgba(0,0,0,0.3) inset; }\n    .pill .dot.state-LISTENING { background: var(--gt-lime); box-shadow: 0 0 10px var(--gt-lime); }\n    .pill .dot.state-RECORDING { background: var(--v2-rec); box-shadow: 0 0 10px var(--v2-rec); }\n    .pill .dot.state-RENDERING { background: var(--status-warn); box-shadow: 0 0 10px var(--status-warn); }\n\n    /* Layout: composer and rail */\n    .composer {\n      position: absolute; left: var(--v2-gap); right: calc(var(--v2-rail-w) + var(--v2-gap)); top: calc(var(--v2-topbar-h) + var(--v2-gap)); bottom: var(--v2-gap);\n      display: grid; grid-template-rows: var(--v2-ruler-h) 1fr;\n      gap: var(--v2-space-4);\n    }\n    .ruler {\n      position: relative; border-radius: var(--v2-radius); background: linear-gradient(180deg, rgba(28,28,30,0.66), rgba(18,18,20,0.6));\n      border: 1px solid var(--v2-line);\n      overflow: hidden; box-shadow: var(--v2-glow);\n    }\n    .ruler .ticks {\n      position: absolute; inset: 0; background:\n        repeating-linear-gradient(90deg, rgba(255,255,255,0.07) 0px, rgba(255,255,255,0.07) 1px, transparent 1px, transparent 40px),\n        linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.00));\n    }\n    .playhead {\n      position: absolute; top: 0; bottom: 0; width: 2px;\n      background: var(--v2-playhead);\n      box-shadow: 0 0 0 1px rgba(204,255,54,0.38), 0 0 16px rgba(204,255,54,0.32);\n      transform: translateX(0);\n      will-change: transform;\n    }\n    .lanes {\n      position: relative; border-radius: var(--v2-radius); border: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(21,21,23,0.64), rgba(16,16,18,0.64));\n      box-shadow: var(--v2-glow);\n      overflow: hidden;\n    }\n    .lane {\n      position: relative; height: var(--v2-lane-h);\n      border-bottom: 1px solid var(--v2-line);\n      display: grid; grid-template-columns: var(--v2-head-w) 1fr;\n    }\n    .lane:last-child { border-bottom: 0; }\n    .head {\n      display: flex; align-items: center; gap: 8px; padding: 0 var(--v2-space-6);\n      border-right: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(28,28,30,0.26), rgba(24,24,26,0.18));\n      color: var(--v2-dim); font-size: var(--v2-fs-sm);\n    }\n    .track {\n      position: relative;\n      display: flex; align-items: center; gap: 8px; padding: 0 var(--v2-space-6);\n      background:\n        linear-gradient(180deg, rgba(255,255,255,0.0), rgba(255,255,255,0.02)),\n        repeating-linear-gradient(90deg, rgba(255,255,255,0.04) 0px, rgba(255,255,255,0.04) 1px, transparent 1px, transparent 24px);\n    }\n    .clip {\n      height: 38px; min-width: 120px; border-radius: var(--v2-radius-sm);\n      background: var(--v2-clip-block); border: 1px solid var(--v2-line-strong);\n      box-shadow: 0 8px 22px rgba(0,0,0,0.24), inset 0 1px 0 rgba(255,255,255,0.05);\n    }\n    .clip.wave { background: var(--v2-clip-wave); }\n    .clip.midi { background: var(--v2-clip-midi); }\n    .clip.drum { background: var(--v2-clip-drum); }\n\n    /* Right Rail */\n    .rail {\n      position: absolute; top: var(--v2-gap); right: var(--v2-gap); bottom: var(--v2-gap); width: var(--v2-rail-w);\n      display: grid; grid-template-rows: auto 1fr; gap: var(--v2-space-8);\n    }\n    .card {\n      background: linear-gradient(180deg, rgba(30,30,32,0.72), rgba(22,22,24,0.68));\n      border: 1px solid var(--v2-line); border-radius: var(--v2-radius);\n      box-shadow: var(--v2-shadow), var(--v2-glow);\n      overflow: hidden;\n    }\n    .card .headbar {\n      display: flex; align-items: center; justify-content: space-between;\n      padding: var(--v2-space-6) var(--v2-space-8);\n      border-bottom: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.00));\n      text-transform: uppercase; letter-spacing: var(--v2-tracking-caps); font-size: var(--v2-fs-xs); color: var(--v2-dim);\n    }\n\n    /* Moshi Dock: two channels, one being */\n    .moshi-wrap {\n      position: relative; padding: var(--v2-space-8);\n      display: grid; gap: var(--v2-space-6);\n    }\n    .agent-tile {\n      position: relative; height: 218px;\n      border-radius: calc(var(--v2-radius) + 2px);\n      background: linear-gradient(180deg, rgba(18,18,18,0.72), rgba(12,12,12,0.66));\n      border: 1px solid var(--v2-line-strong);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 20px 60px rgba(0,0,0,0.55);\n      overflow: hidden;\n    }\n    /* BODY: aura band (never touching the FACE) */\n    .aura {\n      position: absolute; inset: 12px;\n      pointer-events: none;\n      filter: blur(6px) saturate(120%);\n      --ring-color: rgba(204,255,54,0.40);\n      --ring2: rgba(204,255,54,0.16);\n      --gap: 92px; /* inner hole radius to guarantee separation from face host */\n      background:\n        conic-gradient(from 0deg, var(--ring-color), var(--ring2), var(--ring-color));\n      -webkit-mask:\n        radial-gradient(circle at 50% 50%, transparent calc(var(--gap) - 2px), black calc(var(--gap) + 12px)),\n        linear-gradient(#000, #000);\n      mask:\n        radial-gradient(circle at 50% 50%, transparent calc(var(--gap) - 2px), black calc(var(--gap) + 12px)),\n        linear-gradient(#000, #000);\n      opacity: 0.9;\n      border-radius: 16px;\n    }\n    /* FACE host (agent canvas lives here) */\n    .face-plate {\n      position: absolute; inset: 0;\n      display: grid; place-items: center;\n    }\n    .face-host {\n      width: 164px; height: 164px; border-radius: 16px;\n      background: linear-gradient(180deg, rgba(22,22,24,0.88), rgba(12,12,14,0.88));\n      border: 1px solid rgba(255,255,255,0.06);\n      box-shadow: inset 0 2px 0 rgba(255,255,255,0.04), 0 10px 30px rgba(0,0,0,0.5);\n      transition: transform .18s ease;\n      will-change: transform;\n    }\n    .agent-tile:hover .face-host { transform: translateY(-1px) scale(1.01); }\n\n    /* Caption + meters (status: one word) */\n    .status-row {\n      display: flex; align-items: center; justify-content: space-between; gap: 8px;\n      padding: 0 var(--v2-space-2);\n    }\n    .caption {\n      display: inline-flex; align-items: center; gap: 8px;\n      font-family: var(--font-mono); font-size: var(--v2-fs-sm); letter-spacing: 0.06em; color: var(--v2-text);\n    }\n    .heat {\n      width: 8px; height: 8px; border-radius: 50%;\n      background: radial-gradient(circle at 40% 40%, #ff8a8a, #ff3b5c);\n      box-shadow: 0 0 10px rgba(255,59,92,0.6), 0 0 20px rgba(255,59,92,0.3);\n      opacity: var(--heat, 0.2);\n      transition: opacity .2s ease;\n    }\n    .meters { display: flex; gap: 6px; align-items: center; }\n    .meter {\n      width: 48px; height: 6px; border-radius: 6px; background: rgba(255,255,255,0.06);\n      position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,0.06);\n    }\n    .meter .f { position: absolute; left: 0; top: 0; bottom: 0; width: 36%;\n      background: linear-gradient(90deg, rgba(204,255,54,0.35), rgba(204,255,54,0.18));\n      box-shadow: inset 0 0 8px rgba(204,255,54,0.35);\n    }\n\n    /* Controls under Moshi */\n    .row { display: flex; align-items: center; gap: 8px; }\n    .row.stretch { justify-content: space-between; }\n    .pills2 {\n      display: inline-flex; gap: 6px; background: rgba(255,255,255,0.04); padding: 4px; border-radius: 999px; border: 1px solid var(--v2-line);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);\n    }\n    .seg {\n      height: 24px; padding: 0 10px; border-radius: 999px; font-size: var(--v2-fs-xs); color: var(--v2-dim);\n      display: inline-flex; align-items: center; cursor: pointer;\n    }\n    .seg.on {\n      background: linear-gradient(180deg, rgba(204,255,54,0.23), rgba(204,255,54,0.14));\n      color: var(--accent-ink); border: 1px solid rgba(204,255,54,0.42);\n      box-shadow: 0 0 0 1px rgba(204,255,54,0.24), inset 0 1px 0 rgba(255,255,255,0.18);\n    }\n    .slider {\n      -webkit-appearance: none; appearance: none;\n      height: 4px; width: 140px; border-radius: 999px; background: rgba(255,255,255,0.08);\n      outline: none; border: 1px solid var(--v2-line);\n    }\n    .slider::-webkit-slider-thumb {\n      -webkit-appearance: none; appearance: none;\n      width: 14px; height: 14px; border-radius: 50%;\n      background: var(--gt-lime); border: 1px solid rgba(255,255,255,0.6);\n      box-shadow: 0 5px 16px rgba(204,255,54,0.35), inset 0 1px 0 rgba(255,255,255,0.6);\n      margin-top: -5px;\n    }\n\n    /* State glow around tile (LIGHTS the body; doesn't touch face) */\n    .agent-tile::after {\n      content: \"\";\n      position: absolute; inset: -6px;\n      border-radius: calc(var(--v2-radius) + 8px);\n      box-shadow: 0 0 0 1px rgba(255,255,255,0.06);\n      pointer-events: none;\n    }\n    .agent-tile.state-LISTENING { box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 20px 60px rgba(0,0,0,0.55), 0 0 40px rgba(204,255,54,0.18); }\n    .agent-tile.state-RECORDING { box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 20px 60px rgba(0,0,0,0.55), 0 0 48px rgba(255,59,92,0.24); }\n    .agent-tile.state-RENDERING { box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 20px 60px rgba(0,0,0,0.55), 0 0 46px rgba(255,212,92,0.24); }\n    .agent-tile.state-PAUSED { box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 20px 60px rgba(0,0,0,0.55), 0 0 28px rgba(200,200,200,0.10); }\n    .agent-tile.state-SLEEPING { filter: saturate(70%); }\n\n    /* Control card below */\n    .ctrl-wrap { padding: var(--v2-space-8); display: grid; gap: var(--v2-space-6); }\n    .ctrl-group { display: grid; gap: 8px; }\n    .label { font-size: var(--v2-fs-xs); color: var(--v2-dim); letter-spacing: var(--v2-tracking-caps); text-transform: uppercase; }\n\n    /* Floating contextual presence */\n    .agent-float {\n      position: absolute; left: 240px; top: 84px; width: 180px; height: 96px; display: none;\n      z-index: 6;\n    }\n    .agent-float.on { display: block; }\n    .float-bg {\n      position: absolute; inset: 0; border-radius: 16px;\n      background: linear-gradient(180deg, rgba(22,22,24,0.88), rgba(14,14,16,0.82));\n      border: 1px solid var(--v2-line);\n      box-shadow: 0 18px 40px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.04);\n      backdrop-filter: blur(6px) saturate(130%);\n    }\n    .float-aura {\n      position: absolute; inset: 10px; border-radius: 12px; pointer-events: none;\n      background: conic-gradient(from 90deg, rgba(204,255,54,0.30), rgba(204,255,54,0.10), rgba(204,255,54,0.30));\n      -webkit-mask: radial-gradient(circle at 50% 50%, transparent 28px, black 44px);\n      mask: radial-gradient(circle at 50% 50%, transparent 28px, black 44px);\n      filter: blur(6px);\n    }\n    .float-face {\n      position: absolute; inset: 0; display: grid; place-items: center;\n    }\n    .float-face .face-host {\n      width: 52px; height: 52px; border-radius: 10px;\n    }\n    .float-cap {\n      position: absolute; right: 12px; bottom: 10px; font-family: var(--font-mono); font-size: 10px; color: var(--v2-dim); letter-spacing: 0.04em;\n    }\n\n    /* Lens overlay (summoned presence) */\n    .lens {\n      position: absolute; inset: 0; display: none; z-index: 8;\n      background: radial-gradient(140% 100% at 50% 0%, rgba(0,0,0,0.62), rgba(0,0,0,0.78) 60%, rgba(0,0,0,0.92));\n      backdrop-filter: blur(4px);\n    }\n    .lens.on { display: block; }\n    .lens-inner {\n      position: absolute; right: calc(var(--v2-rail-w) + var(--v2-space-8) + 12px); top: calc(var(--v2-topbar-h) + 20px);\n      width: 420px; height: 320px; border-radius: 18px;\n      background: linear-gradient(180deg, rgba(22,22,24,0.85), rgba(14,14,16,0.8));\n      border: 1px solid var(--v2-line-strong); box-shadow: 0 28px 120px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.06);\n      overflow: hidden;\n    }\n    .lens-head {\n      display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-bottom: 1px solid var(--v2-line);\n      text-transform: uppercase; font-size: var(--v2-fs-xs); letter-spacing: var(--v2-tracking-caps); color: var(--v2-dim);\n    }\n    .lens-stage {\n      position: absolute; inset: 42px 12px 12px 12px; border-radius: 14px; overflow: hidden;\n      background: radial-gradient(70% 70% at 50% 40%, rgba(204,255,54,0.14), rgba(255,255,255,0.00) 60%),\n                  linear-gradient(180deg, rgba(26,26,30,0.72), rgba(18,18,22,0.72));\n      border: 1px solid var(--v2-line);\n    }\n    .lens-aura {\n      position: absolute; inset: 12px; border-radius: 12px; pointer-events: none;\n      background:\n        radial-gradient(14% 16% at 26% 50%, rgba(255,210,80,0.24), transparent 60%),\n        radial-gradient(18% 18% at 70% 44%, rgba(255,90,128,0.22), transparent 62%),\n        radial-gradient(22% 14% at 48% 64%, rgba(140,200,255,0.24), transparent 60%),\n        conic-gradient(from 0deg, rgba(204,255,54,0.32), rgba(204,255,54,0.08), rgba(204,255,54,0.32));\n      -webkit-mask: radial-gradient(circle at 50% 50%, transparent 92px, black 116px);\n      mask: radial-gradient(circle at 50% 50%, transparent 92px, black 116px);\n      filter: blur(10px) saturate(130%);\n    }\n    .lens-face {\n      position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none;\n    }\n    .lens-face .face-host { width: 128px; height: 128px; border-radius: 18px; }\n\n    /* Theme toggle (cream) */\n    .theme-cream .topbar, .theme-cream .card, .theme-cream .agent-tile, .theme-cream .ruler, .theme-cream .lanes, .theme-cream .float-bg, .theme-cream .lens-inner, .theme-cream .lens-stage {\n      background: linear-gradient(180deg, rgba(246,242,235,0.82), rgba(229,229,225,0.74));\n      color: #111;\n    }\n    .theme-cream .brand .splat { background: radial-gradient(circle at 60% 40%, rgba(0,0,0,0.06), rgba(0,0,0,0.02)); }\n    .theme-cream { color: #111; }\n    .theme-cream .t-btn, .theme-cream .pill, .theme-cream .pills2, .theme-cream .agent-tile, .theme-cream .card { border-color: rgba(0,0,0,0.14); }\n    .theme-cream .ruler, .theme-cream .lanes { border-color: rgba(0,0,0,0.14); }\n    .theme-cream .pill, .theme-cream .t-btn { background: rgba(246,242,235,0.7); color: #222; }\n    .theme-cream .lanes .track { background:\n      linear-gradient(180deg, rgba(255,255,255,0.36), rgba(255,255,255,0.16)),\n      repeating-linear-gradient(90deg, rgba(0,0,0,0.06) 0px, rgba(0,0,0,0.06) 1px, transparent 1px, transparent 24px);\n    }\n\n    /* Text trimming */\n    .muted { color: var(--v2-dim); }\n  </style>\n\n  <!-- Ambient patina layer -->\n  <div class=\"stage-coat\" id=\"stageCoat\"></div>\n\n  <!-- Topbar -->\n  <div class=\"topbar\">\n    <div class=\"brand\">\n      <div class=\"splat\" title=\"Mosh splat\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" aria-hidden=\"true\">\n          <path fill=\"var(--gt-lime)\" d=\"M11.8 1.5c1.6.3 2.7 1.9 2.4 3.5-.1.6-.4 1.1-.8 1.6-.3.4-.2 1 .2 1.3.4.3.9.3 1.3.1 1.5-.8 3.4-.1 4.2 1.5.8 1.6.1 3.6-1.6 4.3-.5.2-1.1.3-1.7.2-.5-.1-1 .2-1.2.7-.2.5-.1 1 .2 1.4.9 1.3.6 3.1-.7 4-1.3.9-3.1.6-4-.7-.3-.4-.5-.9-.6-1.4-.1-.5-.6-.9-1.2-.8-.5.1-1 .4-1.3.8-1 1.3-2.9 1.6-4.2.6-1.3-1-1.6-2.9-.6-4.2.3-.4.7-.7 1.1-.9.5-.2.7-.8.5-1.3-.2-.5-.6-.8-1.1-.9-1.7-.3-2.9-1.9-2.6-3.6.3-1.7 1.9-2.9 3.6-2.6.6.1 1.2.4 1.7.8.4.3 1 .3 1.3-.1.4-.4.5-1 .2-1.4-.9-1.3-.5-3.1.9-4 1.3-.9 2.7-.5 3.7.1z\"/>\n        </svg>\n      </div>\n      MOSH\n      <span class=\"muted\" style=\"font-size:12px; letter-spacing:.08em;\">alpha</span>\n    </div>\n    <div class=\"transport\">\n      <button class=\"t-btn\" id=\"btnStop\" title=\"Stop\">■</button>\n      <button class=\"t-btn primary\" id=\"btnPlay\" title=\"Play/Pause\">▶</button>\n      <button class=\"t-btn\" id=\"btnRec\" title=\"Record\" style=\"color:var(--v2-rec)\">●</button>\n      <button class=\"t-btn\" id=\"btnRender\" title=\"Render\">⏵⏵</button>\n      <div class=\"t-time\" id=\"timecode\">00:00:00</div>\n      <div class=\"pill\" id=\"statePill\" title=\"Agent state\">\n        <span class=\"dot state-LISTENING\" id=\"stateDot\"></span>\n        <span id=\"stateLabel\">vibe</span>\n      </div>\n      <div class=\"pill\" id=\"themeToggle\" title=\"Theme\">\n        ◑ <span class=\"muted\">light</span>\n      </div>\n    </div>\n    <div class=\"top-right\">\n      <div class=\"pill\" id=\"lensToggle\" title=\"Summon Moshi (Lens)\">\n        ✦ Lens\n      </div>\n      <div class=\"pill\" id=\"floatToggle\" title=\"Float with focus\">\n        ⌁ Float\n      </div>\n      <div class=\"pill\" title=\"Aura Intensity\">\n        Aura <input id=\"intensity\" type=\"range\" class=\"slider\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.18\"/>\n      </div>\n    </div>\n  </div>\n\n  <!-- Composer -->\n  <div class=\"composer\">\n    <div class=\"ruler\">\n      <div class=\"ticks\"></div>\n      <div class=\"playhead\" id=\"playhead\"></div>\n    </div>\n    <div class=\"lanes\" id=\"lanes\">\n      <div class=\"lane\">\n        <div class=\"head\">Drums</div>\n        <div class=\"track\">\n          <div class=\"clip drum\" style=\"width:160px\"></div>\n          <div class=\"clip drum\" style=\"width:120px\"></div>\n          <div class=\"clip drum\" style=\"width:140px\"></div>\n        </div>\n      </div>\n      <div class=\"lane\">\n        <div class=\"head\">Bass</div>\n        <div class=\"track\">\n          <div class=\"clip wave\" style=\"width:240px\"></div>\n        </div>\n      </div>\n      <div class=\"lane\">\n        <div class=\"head\">Keys</div>\n        <div class=\"track\">\n          <div class=\"clip midi\" style=\"width:120px\"></div>\n          <div class=\"clip midi\" style=\"width:100px\"></div>\n        </div>\n      </div>\n      <div class=\"lane\">\n        <div class=\"head\">Lead</div>\n        <div class=\"track\">\n          <div class=\"clip wave\" style=\"width:160px\"></div>\n        </div>\n      </div>\n      <div class=\"lane\">\n        <div class=\"head\">Vox</div>\n        <div class=\"track\">\n          <div class=\"clip wave\" style=\"width:200px\"></div>\n        </div>\n      </div>\n      <div class=\"lane\">\n        <div class=\"head\">FX</div>\n        <div class=\"track\">\n          <div class=\"clip midi\" style=\"width:90px\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Floating contextual presence -->\n  <div class=\"agent-float\" id=\"floatSlot\">\n    <div class=\"float-bg\"></div>\n    <div class=\"float-aura\" id=\"floatAura\"></div>\n    <div class=\"float-face\">\n      <div class=\"face-host\" id=\"moshiFloatHost\"></div>\n    </div>\n    <div class=\"float-cap\" id=\"floatCap\">vibe</div>\n  </div>\n\n  <!-- Right Rail -->\n  <aside class=\"rail\">\n    <div class=\"card\">\n      <div class=\"headbar\">\n        <span>Moshi</span>\n        <div class=\"row\">\n          <div class=\"pill\" id=\"dockLensToggle\" title=\"Summon Lens\">✦</div>\n        </div>\n      </div>\n      <div class=\"moshi-wrap\">\n        <div class=\"agent-tile state-LISTENING\" id=\"agentTile\">\n          <div class=\"aura\" id=\"aura\"></div>\n          <div class=\"face-plate\">\n            <div class=\"face-host\" id=\"moshiHost\" aria-label=\"Moshi agent\"></div>\n          </div>\n        </div>\n        <div class=\"status-row\">\n          <div class=\"caption\"><span id=\"captionWord\">vibe</span><span class=\"heat\" id=\"heatDot\"></span></div>\n          <div class=\"meters\">\n            <div class=\"meter\" title=\"mood\"><div class=\"f\" id=\"moodBar\"></div></div>\n            <div class=\"meter\" title=\"energy\"><div class=\"f\" id=\"energyBar\" style=\"width:28%\"></div></div>\n            <div class=\"meter\" title=\"heat\"><div class=\"f\" id=\"heatBar\" style=\"width:14%\"></div></div>\n          </div>\n        </div>\n        <div class=\"row stretch\">\n          <div class=\"ctrl-group\">\n            <div class=\"label\">Style</div>\n            <div class=\"pills2\" id=\"stylePills\">\n              <div class=\"seg on\" data-style=\"ps2\">ps2</div>\n              <div class=\"seg\" data-style=\"toon\">toon</div>\n              <div class=\"seg\" data-style=\"baked\">baked</div>\n            </div>\n          </div>\n          <div class=\"ctrl-group\">\n            <div class=\"label\">Family</div>\n            <div class=\"pills2\" id=\"famPills\" style=\"max-width: 160px; overflow: hidden;\">\n              <div class=\"seg on\" data-fam=\"TAR\">tar</div>\n              <div class=\"seg\" data-fam=\"DISCO\">disco</div>\n              <div class=\"seg\" data-fam=\"MOLTEN\">molten</div>\n            </div>\n          </div>\n        </div>\n        <div class=\"row stretch\">\n          <div class=\"ctrl-group\">\n            <div class=\"label\">Body</div>\n            <div class=\"pills2\" id=\"bodyMode\">\n              <div class=\"seg on\" data-body=\"patina\">patina</div>\n              <div class=\"seg\" data-body=\"morph\">body</div>\n            </div>\n          </div>\n          <div class=\"ctrl-group\">\n            <div class=\"label\">Presence</div>\n            <div class=\"pills2\" id=\"presence\">\n              <div class=\"seg on\" data-pres=\"dock\">dock</div>\n              <div class=\"seg\" data-pres=\"float\">float</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"card\">\n      <div class=\"headbar\"><span>Stage</span></div>\n      <div class=\"ctrl-wrap\">\n        <div class=\"ctrl-group\">\n          <div class=\"label\">Intensity</div>\n          <input id=\"intensity2\" type=\"range\" class=\"slider\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.18\"/>\n        </div>\n        <div class=\"ctrl-group\">\n          <div class=\"label\">Patina bands</div>\n          <div class=\"pills2\" id=\"bands\">\n            <div class=\"seg on\" data-b=\"on\">on</div>\n            <div class=\"seg\" data-b=\"min\">min</div>\n            <div class=\"seg\" data-b=\"off\">off</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  <!-- Lens overlay -->\n  <div class=\"lens\" id=\"lens\">\n    <div class=\"lens-inner\">\n      <div class=\"lens-head\">\n        <span>Moshi Lens</span>\n        <div class=\"pill\" id=\"lensClose\">Close</div>\n      </div>\n      <div class=\"lens-stage\">\n        <div class=\"lens-aura\" id=\"lensAura\"></div>\n        <div class=\"lens-face\">\n          <div class=\"face-host\" id=\"moshiLensHost\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function(){\n      const $ = sel => document.querySelector(sel);\n      const frame = $('#mosh-frame');\n      const stageCoat = $('#stageCoat');\n      const playhead = $('#playhead');\n      const timecode = $('#timecode');\n      const statePill = $('#statePill');\n      const stateDot = $('#stateDot');\n      const stateLabel = $('#stateLabel');\n      const btnPlay = $('#btnPlay');\n      const btnStop = $('#btnStop');\n      const btnRec = $('#btnRec');\n      const btnRender = $('#btnRender');\n      const themeToggle = $('#themeToggle');\n      const intensity = $('#intensity');\n      const intensity2 = $('#intensity2');\n      const agentTile = $('#agentTile');\n      const captionWord = $('#captionWord');\n      const heatDot = $('#heatDot');\n      const moodBar = $('#moodBar');\n      const energyBar = $('#energyBar');\n      const heatBar = $('#heatBar');\n      const stylePills = $('#stylePills');\n      const famPills = $('#famPills');\n      const bodyMode = $('#bodyMode');\n      const presence = $('#presence');\n      const bands = $('#bands');\n      const floatSlot = $('#floatSlot');\n      const floatCap = $('#floatCap');\n      const aura = $('#aura');\n      const floatAura = $('#floatAura');\n      const lens = $('#lens');\n      const lensToggle = $('#lensToggle');\n      const dockLensToggle = $('#dockLensToggle');\n      const lensClose = $('#lensClose');\n\n      let isPlaying = true;\n      let currState = 'LISTENING';\n      let currStyle = 'ps2';\n      let currFam = 'TAR';\n      let presMode = 'dock';\n      let bodyIsMorph = false;\n      let lensOpen = false;\n\n      // One being: the face host (we move it between dock, float, lens)\n      const faceDock = $('#moshiHost');\n      const faceFloat = $('#moshiFloatHost');\n      const faceLens  = $('#moshiLensHost');\n      let mountAt = faceDock;\n\n      // Mount the real creature\n      let m;\n      function mountMoshi() {\n        const host = mountAt;\n        if (!host) return;\n        m = window.Moshi && window.Moshi(host, { personality: currFam, seed: 0.5, quality: 'ps2', style: currStyle, interactive: true, room: false });\n        if (m) {\n          m.setState(currState);\n          m.set('mood', 0.7);\n          m.set('energy', 0.5);\n          m.set('heat', 0.2);\n        }\n      }\n      mountMoshi();\n\n      function moveFace(toEl){\n        if (!toEl || toEl === mountAt) return;\n        // Move the existing host element (and therefore the canvas) into the new slot\n        toEl.appendChild(faceDock.firstChild || faceFloat.firstChild || faceLens.firstChild || document.createTextNode(''));\n      }\n\n      // State mapping (caption + glow colors)\n      const stateMeta = {\n        LISTENING: { word:'vibe', dot:'state-LISTENING', aura:'#CCFF23', glowA:'rgba(204,255,54,0.40)', glowB:'rgba(204,255,54,0.16)' },\n        RECORDING: { word:'rec',  dot:'state-RECORDING', aura:'#ff3b5c', glowA:'rgba(255,59,92,0.40)', glowB:'rgba(255,59,92,0.16)' },\n        RENDERING: { word:'cook', dot:'state-RENDERING', aura:'#ffd45c', glowA:'rgba(255,212,92,0.40)', glowB:'rgba(255,212,92,0.16)' },\n        PAUSED:    { word:'chill',dot:'', aura:'rgba(200,200,200,0.5)', glowA:'rgba(200,200,200,0.20)', glowB:'rgba(200,200,200,0.08)' },\n        IDLE:      { word:'idle', dot:'', aura:'rgba(200,200,200,0.35)', glowA:'rgba(200,200,200,0.14)', glowB:'rgba(200,200,200,0.06)' },\n        SLEEPING:  { word:'zzz',  dot:'', aura:'rgba(120,140,170,0.5)', glowA:'rgba(120,140,170,0.20)', glowB:'rgba(120,140,170,0.08)' },\n      };\n      function setState(newState){\n        currState = newState;\n        const meta = stateMeta[newState] || stateMeta.LISTENING;\n        captionWord.textContent = meta.word;\n        floatCap.textContent = meta.word;\n        // Heat dot is visible for recording/working\n        heatDot.style.setProperty('opacity', (newState==='RECORDING'||newState==='RENDERING')? 0.9 : 0.2);\n        agentTile.className = 'agent-tile state-' + newState;\n        stateDot.className = 'dot ' + (meta.dot || ''); stateLabel.textContent = meta.word;\n        // Light the body (ring colors) without touching face\n        aura.style.setProperty('--ring-color', meta.glowA);\n        aura.style.setProperty('--ring2', meta.glowB);\n        floatAura.style.background = `conic-gradient(from 90deg, ${meta.glowA}, ${meta.glowB}, ${meta.glowA})`;\n        $('#lensAura').style.background = `\n          radial-gradient(14% 16% at 26% 50%, ${meta.glowA}, transparent 60%),\n          radial-gradient(18% 18% at 70% 44%, ${meta.glowB}, transparent 62%),\n          radial-gradient(22% 14% at 48% 64%, ${meta.glowA}, transparent 60%),\n          conic-gradient(from 0deg, ${meta.glowA}, ${meta.glowB}, ${meta.glowA})\n        `;\n        if (m && m.setState) m.setState(newState);\n      }\n\n      // Transport controls\n      btnPlay.addEventListener('click', () => {\n        isPlaying = !isPlaying;\n        setState(isPlaying ? 'LISTENING' : 'PAUSED');\n      });\n      btnStop.addEventListener('click', () => {\n        isPlaying = false; setState('IDLE');\n      });\n      btnRec.addEventListener('click', () => {\n        isPlaying = true; setState('RECORDING');\n      });\n      btnRender.addEventListener('click', () => {\n        isPlaying = true; setState('RENDERING');\n        // simulate short render window\n        setTimeout(()=>{ if (currState==='RENDERING') setState('LISTENING'); }, 2600);\n      });\n\n      // Theme toggle\n      themeToggle.addEventListener('click', ()=>{\n        frame.classList.toggle('theme-cream');\n      });\n\n      // Intensity slider (duplicate controls)\n      function setIntensity(v){\n        stageCoat.style.setProperty('--coat-intensity', v);\n      }\n      [intensity, intensity2].forEach(sl=>{\n        sl.addEventListener('input', e=>{\n          const v = e.target.value;\n          setIntensity(v);\n          (sl===intensity? intensity2:intensity).value = v;\n        });\n      });\n\n      // Style pills\n      stylePills.addEventListener('click', e=>{\n        const seg = e.target.closest('.seg'); if (!seg) return;\n        [...stylePills.children].forEach(x=>x.classList.remove('on'));\n        seg.classList.add('on');\n        currStyle = seg.dataset.style;\n        if (m && m.setStyle) m.setStyle(currStyle);\n      });\n\n      // Family pills\n      famPills.addEventListener('click', e=>{\n        const seg = e.target.closest('.seg'); if (!seg) return;\n        [...famPills.children].forEach(x=>x.classList.remove('on'));\n        seg.classList.add('on');\n        currFam = seg.dataset.fam;\n        if (m && m.setPersonality) m.setPersonality(currFam);\n      });\n\n      // Body mode (patina vs morph) affects the aura layer only (never face)\n      bodyMode.addEventListener('click', e=>{\n        const seg = e.target.closest('.seg'); if (!seg) return;\n        [...bodyMode.children].forEach(x=>x.classList.remove('on'));\n        seg.classList.add('on');\n        bodyIsMorph = (seg.dataset.body === 'morph');\n        stageCoat.classList.toggle('patina-morph', bodyIsMorph);\n      });\n\n      // Presence (dock vs float) -> move the being\n      function setPresence(mode){\n        presMode = mode;\n        [...presence.children].forEach(x=>{\n          if (x.dataset.pres === mode) x.classList.add('on'); else x.classList.remove('on');\n        });\n        floatSlot.classList.toggle('on', presMode==='float' && !lensOpen);\n        if (lensOpen) return;\n        if (presMode==='dock') {\n          // Move face back to dock\n          if (faceFloat.firstChild) faceDock.appendChild(faceFloat.firstChild);\n        } else {\n          // Move face to float\n          if (faceDock.firstChild) faceFloat.appendChild(faceDock.firstChild);\n        }\n      }\n      presence.addEventListener('click', e=>{\n        const seg = e.target.closest('.seg'); if (!seg) return;\n        setPresence(seg.dataset.pres);\n      });\n      // Mirror presence from topbar float toggle\n      const floatToggle = $('#floatToggle');\n      floatToggle.addEventListener('click', ()=>{\n        setPresence(presMode==='dock' ? 'float' : 'dock');\n      });\n\n      // Bands control (visual detail in tracks)\n      bands.addEventListener('click', e=>{\n        const seg = e.target.closest('.seg'); if (!seg) return;\n        [...bands.children].forEach(x=>x.classList.remove('on'));\n        seg.classList.add('on');\n        const mode = seg.dataset.b;\n        if (mode==='on') $('#lanes').style.background = '';\n        if (mode==='min') $('#lanes').style.background = 'linear-gradient(180deg, rgba(21,21,23,0.74), rgba(18,18,20,0.74))';\n        if (mode==='off') $('#lanes').style.background = 'linear-gradient(180deg, rgba(18,18,20,0.92), rgba(14,14,16,0.92))';\n      });\n\n      // Lens toggle: one being moves into lens\n      function openLens(){\n        lensOpen = true; lens.classList.add('on'); floatSlot.classList.remove('on');\n        if (faceDock.firstChild) faceLens.appendChild(faceDock.firstChild);\n        if (faceFloat.firstChild) faceLens.appendChild(faceFloat.firstChild);\n      }\n      function closeLens(){\n        lensOpen = false; lens.classList.remove('on');\n        setPresence(presMode); // restore\n      }\n      lensToggle.addEventListener('click', openLens);\n      dockLensToggle.addEventListener('click', openLens);\n      $('#lensClose').addEventListener('click', closeLens);\n\n      // Time + playhead anim + patina drift\n      function pad(n){ return String(n).padStart(2,'0'); }\n      function raf(){\n        const t = (window.__mosh && window.__mosh.time) || performance.now()/1000;\n        const ph = (window.__mosh && window.__mosh.playhead) || ((t*0.1)%1);\n        const lanes = $('#lanes');\n        const w = lanes.clientWidth || 800;\n        const x = ph * w;\n        playhead.style.transform = `translateX(${x}px)`;\n        const mins = Math.floor(t/60); const secs = Math.floor(t%60); const ms = Math.floor((t%1)*100);\n        timecode.textContent = `${pad(mins)}:${pad(secs)}:${pad(ms)}`;\n        // Drift the aura ring slowly\n        const rot = (t*24)%360;\n        aura.style.transform = `rotate(${rot}deg)`;\n        floatAura.style.transform = `rotate(${rot*1.2}deg)`;\n        // Mood/energy/heat gentle motion; sync to time\n        const mood = 0.5 + 0.4*Math.sin(t*0.6);\n        const energy = 0.4 + 0.3*Math.cos(t*0.9);\n        const heat = (currState==='RECORDING') ? 0.8 + 0.1*Math.sin(t*3.1) : 0.2 + 0.1*Math.sin(t*1.6);\n        moodBar.style.width = Math.round(mood*100)+'%';\n        energyBar.style.width = Math.round(energy*100)+'%';\n        heatBar.style.width = Math.round(heat*100)+'%';\n        heatDot.style.opacity = heat.toFixed(2);\n        if (m && m.set) { m.set('mood', mood); m.set('energy', energy); m.set('heat', heat); }\n        requestAnimationFrame(raf);\n      }\n      requestAnimationFrame(raf);\n\n      // Initialize state\n      setState('LISTENING');\n      setIntensity(intensity.value);\n\n      // Micro: hover caption bounce (delight)\n      agentTile.addEventListener('mouseenter', ()=> captionWord.style.transform = 'translateY(-1px)');\n      agentTile.addEventListener('mouseleave', ()=> captionWord.style.transform = 'translateY(0)');\n\n      // Ensure dock hosts the actual Moshi canvas if external initializes later\n      const ensureMoshi = setInterval(()=>{\n        if (m && faceDock.firstChild) { clearInterval(ensureMoshi); }\n        else if (window.Moshi && !m) { mountMoshi(); }\n      }, 200);\n    })();\n  </script>\n</div>",
