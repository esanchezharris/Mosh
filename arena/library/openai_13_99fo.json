{
  "id": "openai_13_99fo",
  "title": "Ambient stage · qlk7x",
  "target": "stage",
  "pass": "elevate",
  "kind": "html",
  "model": "gpt-5",
  "source": "<div id=\"frame\">\n  <style>\n    /* AMBIENT STAGE — qlk7x */\n    :root {\n      --ink: #0B0B0B;\n      --lime: var(--v2-accent);\n      --glow: #D9FF4C;\n      --bone: #F6F2EB;\n      --mist: #E5E5E1;\n      --ambient-intensity: 0.42; /* 0..1 */\n      --coat-h: 212;   /* Song's coat hue — session-tinted */\n      --coat-s: 72%;   /* coat saturation */\n      --coat-l: 48%;   /* coat lightness */\n      --coat-h2: calc(var(--coat-h) + 138);\n      --coat-h3: calc(var(--coat-h) - 36);\n      --glass: rgba(26,26,28,0.52);\n      --glass-2: rgba(33,33,35,0.62);\n      --glass-blur: blur(18px);\n      --ring: rgba(255,255,255,0.08);\n      --ring-2: rgba(255,255,255,0.16);\n      --shadow-soft: 0 18px 50px rgba(0,0,0,0.55);\n      --hairline: rgba(255,255,255,0.10);\n      --shine: rgba(255,255,255,0.35);\n      --fg: var(--v2-text);\n      --fg-dim: var(--v2-dim);\n    }\n    #frame {\n      position: relative;\n      width: 1440px; height: 900px; overflow: hidden; background: var(--v2-bg);\n      font-family: var(--font-body); color: var(--fg); letter-spacing: 0.01em;\n    }\n    /* Stage canvas fills, sits below UI */\n    .layer {\n      position: absolute; inset: 0; pointer-events: none;\n    }\n    #viz {\n      position: absolute; inset: 0; width: 100%; height: 100%;\n      filter: saturate(1) brightness(0.9) contrast(1.05);\n    }\n    /* Session coat tint that tints the whole surface via intensity dial */\n    .coat-tint {\n      background:\n        radial-gradient(120% 90% at 75% -20%, hsla(var(--coat-h),70%,18%, calc(0.22 * var(--ambient-intensity))) 0%, transparent 60%),\n        radial-gradient(120% 95% at 15% 110%, hsla(var(--coat-h2),70%,26%, calc(0.20 * var(--ambient-intensity))) 10%, transparent 68%),\n        radial-gradient(80% 70% at 60% 40%, hsla(var(--coat-h3),72%,22%, calc(0.18 * var(--ambient-intensity))) 0%, transparent 55%);\n      mix-blend-mode: screen;\n      opacity: 1;\n    }\n    /* Soft noise+dither to keep PS2 spirit without banding */\n    .dither {\n      background-image:\n        radial-gradient(1px 1px at 1px 1px, rgba(255,255,255,0.05) 0.5px, transparent 0.6px),\n        radial-gradient(1px 1px at 2px 2px, rgba(0,0,0,0.06) 0.5px, transparent 0.6px);\n      background-size: 3px 3px, 3px 3px;\n      opacity: 0.45;\n      mix-blend-mode: overlay;\n    }\n    /* Vignette to keep work readable even at max ambient */\n    .safety-vignette {\n      background:\n        radial-gradient(120% 140% at 50% 20%, rgba(0,0,0,calc(0.32 + var(--ambient-intensity)*0.18)) 0%, rgba(0,0,0,calc(0.24 + var(--ambient-intensity)*0.12)) 48%, rgba(0,0,0,calc(0.46 + var(--ambient-intensity)*0.22)) 100%);\n      pointer-events: none;\n    }\n\n    /* Top bar with splat and minimal system chrome */\n    .topbar {\n      position: absolute; left: 0; right: 0; top: 0; height: var(--v2-topbar-h);\n      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;\n      padding: 0 18px; gap: 8px;\n      background: linear-gradient(to bottom, rgba(16,16,17,0.7), rgba(16,16,17,0.38));\n      backdrop-filter: blur(8px);\n      box-shadow: inset 0 -1px var(--v2-line);\n      pointer-events: auto;\n    }\n    .tb-left, .tb-right { display: flex; align-items: center; gap: 10px; }\n    .tb-left { justify-self: start; }\n    .tb-center { justify-self: center; display: flex; align-items: center; gap: 12px; }\n    .tb-right { justify-self: end; }\n    .splat {\n      width: 30px; height: 30px; display: grid; place-items: center;\n      filter: drop-shadow(0 2px 6px rgba(0,0,0,0.35));\n    }\n    .title {\n      font-family: var(--font-display); font-size: 16px; letter-spacing: 0.04em;\n      color: var(--fg); text-transform: uppercase;\n    }\n    .crumb {\n      font-size: var(--v2-fs-sm); color: var(--fg-dim);\n      padding: 6px 10px; border-radius: var(--v2-radius-pill);\n      background: rgba(255,255,255,0.04); box-shadow: var(--v2-glow);\n    }\n    .mode-toggle {\n      position: relative; display: inline-flex; align-items: center; gap: 6px;\n      padding: 8px 10px; border-radius: var(--v2-radius-pill);\n      background: var(--glass); box-shadow: var(--v2-glow); border: 1px solid var(--hairline);\n      cursor: pointer; user-select: none;\n    }\n    .mode-toggle .dot {\n      width: 12px; height: 12px; border-radius: 999px; background: var(--lime);\n      box-shadow: 0 0 0 2px rgba(204,255,54,0.12), 0 0 20px rgba(204,255,54,0.28);\n    }\n    .mode-toggle span { font-size: var(--v2-fs-sm); color: var(--fg); }\n\n    /* Right rail dock for Moshi */\n    .rail {\n      position: absolute; top: calc(var(--v2-topbar-h) + 10px); right: 10px; width: var(--v2-rail-w);\n      display: flex; flex-direction: column; gap: 12px; pointer-events: auto;\n    }\n    .dock {\n      position: relative; margin-left: auto; width: 218px; height: 218px; border-radius: 18px;\n      background: linear-gradient(180deg, var(--glass), var(--glass-2));\n      backdrop-filter: blur(12px);\n      border: 1px solid var(--ring); box-shadow: var(--shadow-soft), inset 0 1px rgba(255,255,255,0.04);\n      overflow: hidden;\n    }\n    .dock::before {\n      content: \"\"; position: absolute; inset: 0;\n      background: conic-gradient(from 180deg, hsla(var(--coat-h),80%,54%,0.05), hsla(var(--coat-h2),80%,45%,0.08), hsla(var(--coat-h3),80%,56%,0.05), transparent 60%);\n      mix-blend-mode: screen; pointer-events: none;\n      transform: scale(1.3);\n    }\n    .dock .halo {\n      position: absolute; inset: -18px; border-radius: 22px;\n      box-shadow:\n        0 0 0 1px rgba(255,255,255,0.06),\n        0 0 0 6px rgba(204,255,54,0.06),\n        0 0 28px 10px rgba(204,255,54,0.08),\n        inset 0 1px rgba(255,255,255,0.05);\n      pointer-events: none;\n    }\n    .moshi-host {\n      position: absolute; inset: 12px 12px 42px 12px; border-radius: 12px; overflow: hidden;\n      background: radial-gradient(90% 60% at 50% 110%, rgba(0,0,0,0.45), rgba(0,0,0,0.05));\n      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04);\n    }\n    .caption {\n      position: absolute; left: 12px; right: 12px; bottom: 10px; height: 28px;\n      display: flex; align-items: center; justify-content: space-between;\n      font-size: var(--v2-fs-sm); color: var(--fg);\n      border-radius: 8px; padding: 0 10px;\n      background: rgba(17,17,18,0.55); border: 1px solid var(--ring);\n      box-shadow: inset 0 1px rgba(255,255,255,0.04);\n      letter-spacing: 0.08em; text-transform: lowercase;\n    }\n    .caption .state-dot {\n      width: 10px; height: 10px; border-radius: 999px; background: var(--lime);\n      box-shadow: 0 0 10px rgba(204,255,54,0.6);\n    }\n    /* Tiny coat picker chips under dock */\n    .chips {\n      display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; padding: 8px;\n      margin-left: auto; width: 218px;\n      background: rgba(18,18,19,0.5); border: 1px solid var(--ring); border-radius: 12px;\n      box-shadow: var(--v2-glow); backdrop-filter: blur(10px);\n    }\n    .chip {\n      height: 24px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.12);\n      box-shadow: inset 0 1px rgba(255,255,255,0.05), 0 6px 14px rgba(0,0,0,0.35);\n      cursor: pointer; position: relative; overflow: hidden;\n    }\n    .chip::after {\n      content: \"\"; position: absolute; inset: 0;\n      background: linear-gradient(90deg, rgba(255,255,255,0.12), transparent 40%, rgba(255,255,255,0.08));\n      mix-blend-mode: overlay; opacity: 0.2;\n    }\n    .chip[data-active=\"1\"] { outline: 2px solid var(--lime); }\n    /* Ambient control capsule */\n    .capsule {\n      position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);\n      display: flex; align-items: center; gap: 16px; padding: 12px 16px;\n      background: linear-gradient(180deg, rgba(24,24,26,0.7), rgba(18,18,20,0.6));\n      border: 1px solid var(--ring); border-radius: 16px; backdrop-filter: blur(10px);\n      box-shadow: var(--shadow-soft), inset 0 1px rgba(255,255,255,0.04);\n      pointer-events: auto;\n    }\n    .knob {\n      width: 42px; height: 42px; border-radius: 999px;\n      display: grid; place-items: center; position: relative;\n      background: radial-gradient(60% 60% at 50% 30%, rgba(255,255,255,0.08), rgba(255,255,255,0.02));\n      border: 1px solid var(--ring-2); box-shadow: inset 0 1px rgba(255,255,255,0.06);\n      cursor: pointer; overflow: hidden;\n    }\n    .knob::before {\n      content: \"\"; position: absolute; inset: 3px; border-radius: 999px;\n      background: conic-gradient(var(--lime) calc(var(--ambient-intensity)*360deg), rgba(255,255,255,0.06) 0);\n      mask: radial-gradient( farthest-side, transparent calc(100% - 5px), black 0);\n    }\n    .knob::after {\n      content: \"\"; width: 3px; height: 12px; border-radius: 2px; background: var(--lime);\n      transform: rotate(calc(-140deg + var(--ambient-intensity) * 280deg)) translateY(-10px);\n      transform-origin: 50% 21px; filter: drop-shadow(0 0 6px rgba(204,255,54,0.55));\n    }\n    .capsule .meta {\n      display: grid; gap: 2px; min-width: 180px;\n    }\n    .meta .label { font-size: var(--v2-fs-xs); color: var(--fg-dim); letter-spacing: var(--v2-tracking-caps); text-transform: uppercase; }\n    .meta .value { font-size: var(--v2-fs-md); color: var(--fg); }\n    .slider {\n      -webkit-appearance: none; appearance: none; width: 260px; height: 8px; border-radius: 999px;\n      background: linear-gradient(90deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));\n      border: 1px solid var(--ring); outline: none; cursor: pointer;\n      box-shadow: inset 0 1px rgba(255,255,255,0.05), 0 2px 10px rgba(0,0,0,0.25);\n    }\n    .slider::-webkit-slider-thumb {\n      -webkit-appearance: none; appearance: none; width: 18px; height: 18px; border-radius: 999px;\n      background: radial-gradient(70% 70% at 40% 35%, rgba(255,255,255,0.35), rgba(255,255,255,0.05));\n      border: 1px solid rgba(255,255,255,0.25);\n      box-shadow: 0 0 0 3px rgba(204,255,54,0.2), 0 6px 14px rgba(0,0,0,0.5), inset 0 1px rgba(255,255,255,0.4);\n    }\n    .toggles {\n      display: inline-flex; gap: 6px; margin-left: 2px;\n    }\n    .toggle {\n      font-size: var(--v2-fs-xs); color: var(--fg);\n      padding: 6px 8px; border-radius: 999px; border: 1px solid var(--ring);\n      background: rgba(255,255,255,0.04);\n      box-shadow: inset 0 1px rgba(255,255,255,0.05);\n      cursor: pointer; user-select: none;\n    }\n    .toggle[data-active=\"1\"] {\n      color: var(--accent-ink); background: var(--lime); border-color: rgba(255,255,255,0.35);\n      box-shadow: 0 6px 16px rgba(204,255,54,0.4), inset 0 1px rgba(255,255,255,0.35);\n    }\n\n    /* Center ghost work surface to demonstrate non-drowning */\n    .workplate {\n      position: absolute; top: 92px; left: 60px; right: calc(var(--v2-rail-w) + 24px); bottom: 100px;\n      border-radius: 18px; overflow: hidden;\n      background: linear-gradient(180deg, rgba(26,26,28,0.64), rgba(19,19,21,0.66));\n      border: 1px solid var(--v2-line); box-shadow: var(--v2-shadow), inset 0 1px rgba(255,255,255,0.04);\n      backdrop-filter: blur(6px);\n    }\n    .workplate .hairline { position: absolute; top: 52px; left: 0; right: 0; height: 1px; background: var(--v2-line); }\n    .tabs { position: absolute; top: 10px; left: 12px; display: flex; gap: 8px; }\n    .tab {\n      min-width: 84px; height: 30px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center;\n      font-size: var(--v2-fs-sm); color: var(--fg-dim); border-radius: 8px; border: 1px solid var(--ring);\n      background: rgba(255,255,255,0.04); box-shadow: inset 0 1px rgba(255,255,255,0.05);\n    }\n    .tab[data-active=\"1\"] { color: var(--fg); outline: 2px solid rgba(204,255,54,0.28); border-color: rgba(255,255,255,0.15); }\n    .workplate .hint {\n      position: absolute; right: 16px; top: 10px; font-size: var(--v2-fs-xs); color: var(--fg-dim);\n      padding: 6px 10px; border-radius: 999px; border: 1px solid var(--ring); background: rgba(255,255,255,0.04);\n    }\n\n    /* Light option (cream) — surfaces only, stage stays honest midnight */\n    .light .workplate {\n      background: linear-gradient(180deg, rgba(252,250,247,0.86), rgba(244,240,233,0.82));\n      color: #242424;\n      border-color: rgba(0,0,0,0.08);\n    }\n    .light .tab { background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.12); color: #333; }\n    .light .tab[data-active=\"1\"] { outline-color: rgba(204,255,54,0.45); color: #111; }\n    .light .hint { background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.12); color: #333; }\n    .light .capsule { background: linear-gradient(180deg, rgba(250,248,243,0.8), rgba(244,240,233,0.78)); border-color: rgba(0,0,0,0.12); }\n    .light .mode-toggle { background: rgba(0,0,0,0.08); border-color: rgba(0,0,0,0.12); }\n    .light .chips { background: rgba(250,248,243,0.7); border-color: rgba(0,0,0,0.12); }\n\n    /* Micro-interaction: thin scanning line during adjust */\n    .scanline {\n      position: absolute; top: 0; bottom: 0; width: 1px; background: var(--lime);\n      box-shadow: 0 0 10px rgba(204,255,54,0.7);\n      opacity: 0; pointer-events: none;\n    }\n    .scanline.active { opacity: 0.9; }\n\n    /* Accessibility cursor cues */\n    .knob:hover, .toggle:hover, .chip:hover { box-shadow: 0 10px 26px rgba(0,0,0,0.5), inset 0 1px rgba(255,255,255,0.09); }\n  </style>\n\n  <!-- Generative layer -->\n  <canvas id=\"viz\" class=\"layer\"></canvas>\n  <div class=\"layer coat-tint\"></div>\n  <div class=\"layer dither\"></div>\n  <div class=\"layer safety-vignette\"></div>\n  <div id=\"scan\" class=\"scanline\"></div>\n\n  <!-- Topbar -->\n  <div class=\"topbar\">\n    <div class=\"tb-left\">\n      <svg class=\"splat\" viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n        <defs>\n          <radialGradient id=\"g\" cx=\"50%\" cy=\"40%\" r=\"60%\">\n            <stop offset=\"0%\" stop-color=\"var(--lime)\" stop-opacity=\"1\"/>\n            <stop offset=\"60%\" stop-color=\"var(--lime)\" stop-opacity=\"0.7\"/>\n            <stop offset=\"100%\" stop-color=\"var(--lime)\" stop-opacity=\"0\"/>\n          </radialGradient>\n        </defs>\n        <g>\n          <circle cx=\"32\" cy=\"32\" r=\"16\" fill=\"url(#g)\"/>\n          <path d=\"M31 4c2 4 3 6 2 10s-4 5-2 8 5 2 9 0 6-2 9 1c3 3 0 6-2 9-3 3-3 5-1 8s4 5 1 8-6 0-9-1-5-1-8 2-4 7-8 5-2-6-1-9 2-5 0-9-5-3-8-2-6 1-8-2 2-6 5-8 5-2 8-1 6 0 9-3 1-6 2-9 3-5 6-5z\"\n                fill=\"rgba(204,255,54,0.35)\"/>\n        </g>\n      </svg>\n      <div class=\"title\">MOSH</div>\n      <div class=\"crumb\">Stage · Ambient</div>\n    </div>\n    <div class=\"tb-center\">\n      <div class=\"crumb\" id=\"ambientReadout\">Ambient 42%</div>\n      <div class=\"crumb\" id=\"coatName\">Coat: Tar · Indigo</div>\n    </div>\n    <div class=\"tb-right\">\n      <div class=\"mode-toggle\" id=\"modeToggle\">\n        <div class=\"dot\"></div>\n        <span>Midnight</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Ghost workplate -->\n  <div class=\"workplate\">\n    <div class=\"tabs\">\n      <div class=\"tab\" data-active=\"1\">Composer</div>\n      <div class=\"tab\">Mix</div>\n      <div class=\"tab\">Arrange</div>\n      <div class=\"tab\">Perform</div>\n    </div>\n    <div class=\"hint\">The stage tints — the work stays sharp.</div>\n    <div class=\"hairline\"></div>\n  </div>\n\n  <!-- Right rail with living Moshi -->\n  <div class=\"rail\">\n    <div class=\"dock\" id=\"dock\">\n      <div class=\"halo\"></div>\n      <div class=\"moshi-host\" id=\"moshiHost\"></div>\n      <div class=\"caption\">\n        <span id=\"moshiCaption\">vibe</span>\n        <span class=\"state-dot\"></span>\n      </div>\n    </div>\n    <div class=\"chips\" id=\"chips\">\n      <!-- coat chips (session patina palette) -->\n      <div class=\"chip\" data-h=\"212\" data-s=\"72\" data-l=\"48\" style=\"background: linear-gradient(90deg, hsl(212,72%,48%), hsl(350,68%,46%));\" data-name=\"Indigo\"></div>\n      <div class=\"chip\" data-h=\"132\" data-s=\"68\" data-l=\"40\" style=\"background: linear-gradient(90deg, hsl(132,68%,40%), hsl(24,78%,48%));\" data-name=\"Moss\"></div>\n      <div class=\"chip\" data-h=\"278\" data-s=\"70\" data-l=\"52\" style=\"background: linear-gradient(90deg, hsl(278,70%,52%), hsl(196,72%,46%));\" data-name=\"Violet\"></div>\n      <div class=\"chip\" data-h=\"18\" data-s=\"80\" data-l=\"50\" style=\"background: linear-gradient(90deg, hsl(18,80%,50%), hsl(228,70%,52%));\" data-name=\"Spice\"></div>\n      <div class=\"chip\" data-h=\"196\" data-s=\"80\" data-l=\"50\" style=\"background: linear-gradient(90deg, hsl(196,80%,50%), hsl(146,60%,46%));\" data-name=\"Aqua\"></div>\n    </div>\n  </div>\n\n  <!-- Ambient capsule -->\n  <div class=\"capsule\">\n    <div class=\"knob\" id=\"knob\" title=\"Ambient Intensity\"></div>\n    <div class=\"meta\">\n      <div class=\"label\">Tint & Visuals</div>\n      <div class=\"value\"><span id=\"valPct\">42%</span> · <span id=\"visName\">Flow</span></div>\n    </div>\n    <input type=\"range\" min=\"0\" max=\"100\" value=\"42\" class=\"slider\" id=\"slider\" aria-label=\"Ambient Intensity\"/>\n    <div class=\"toggles\">\n      <div class=\"toggle\" id=\"tFlow\" data-active=\"1\">Flow</div>\n      <div class=\"toggle\" id=\"tStrands\" data-active=\"0\">Strands</div>\n      <div class=\"toggle\" id=\"tDust\" data-active=\"0\">Dust</div>\n      <div class=\"toggle\" id=\"tFull\" data-active=\"0\">Full</div>\n    </div>\n  </div>\n\n  <script>\n    (function() {\n      const frame = document.getElementById('frame');\n      const canvas = document.getElementById('viz');\n      const ctx = canvas.getContext('2d');\n      const slider = document.getElementById('slider');\n      const valPctEl = document.getElementById('valPct');\n      const ambientReadout = document.getElementById('ambientReadout');\n      const visName = document.getElementById('visName');\n      const modeToggle = document.getElementById('modeToggle');\n      const knob = document.getElementById('knob');\n      const tFlow = document.getElementById('tFlow');\n      const tStrands = document.getElementById('tStrands');\n      const tDust = document.getElementById('tDust');\n      const tFull = document.getElementById('tFull');\n      const chips = document.getElementById('chips');\n      const coatName = document.getElementById('coatName');\n      const scan = document.getElementById('scan');\n\n      // Stage state\n      let style = 'flow';\n      let intensity = parseInt(slider.value, 10) / 100;\n      let w = 1440, h = 900, dpr = Math.min(2, window.devicePixelRatio || 1);\n\n      function size() {\n        w = canvas.clientWidth; h = canvas.clientHeight;\n        canvas.width = Math.floor(w * dpr);\n        canvas.height = Math.floor(h * dpr);\n        ctx.setTransform(dpr,0,0,dpr,0,0);\n      }\n      size();\n      window.addEventListener('resize', size);\n\n      // Helper HSL->rgba string\n      function hsl(h,s,l,a) { return `hsla(${h},${s}%,${l}%,${a})`; }\n\n      // Read coat from CSS vars\n      function getCoat() {\n        const style = getComputedStyle(frame);\n        const ch = parseFloat(style.getPropertyValue('--coat-h'));\n        const cs = parseFloat(style.getPropertyValue('--coat-s'));\n        const cl = parseFloat(style.getPropertyValue('--coat-l'));\n        return {h:ch, s:parseFloat(cs), l:parseFloat(cl)};\n      }\n\n      // UI Bindings\n      function setIntensity(v) {\n        intensity = Math.max(0, Math.min(1, v));\n        frame.style.setProperty('--ambient-intensity', intensity.toFixed(3));\n        const pct = Math.round(intensity * 100);\n        valPctEl.textContent = pct + '%';\n        ambientReadout.textContent = 'Ambient ' + pct + '%';\n        if (m) {\n          m.set('mood', 0.5 + intensity*0.4);\n          m.set('energy', 0.35 + intensity*0.5);\n          // Subtle heat when closer to full\n          m.set('heat', 0.15 + intensity*0.3);\n        }\n      }\n\n      slider.addEventListener('input', (e) => {\n        setIntensity(e.target.value / 100);\n        pulseScan();\n      });\n      knob.addEventListener('click', () => {\n        // snap between tasteful 0.18, 0.42, 0.72\n        const steps = [0.18, 0.42, 0.72];\n        const idx = steps.findIndex(s => Math.abs(s - intensity) < 0.06);\n        const next = steps[(idx + 1) % steps.length];\n        slider.value = Math.round(next * 100);\n        setIntensity(next);\n        pulseScan();\n      });\n\n      function setStyle(name) {\n        style = name;\n        visName.textContent = name.charAt(0).toUpperCase() + name.slice(1);\n        tFlow.dataset.active = name === 'flow' ? '1' : '0';\n        tStrands.dataset.active = name === 'strands' ? '1' : '0';\n        tDust.dataset.active = name === 'dust' ? '1' : '0';\n      }\n      tFlow.addEventListener('click', () => setStyle('flow'));\n      tStrands.addEventListener('click', () => setStyle('strands'));\n      tDust.addEventListener('click', () => setStyle('dust'));\n      tFull.addEventListener('click', () => {\n        const on = tFull.dataset.active === '0';\n        tFull.dataset.active = on ? '1' : '0';\n        setIntensity(on ? 1 : 0.42);\n        slider.value = Math.round(intensity * 100);\n        pulseScan();\n      });\n\n      modeToggle.addEventListener('click', () => {\n        const light = frame.classList.toggle('light');\n        modeToggle.querySelector('span').textContent = light ? 'Cream' : 'Midnight';\n      });\n\n      // Coat chips\n      chips.addEventListener('click', (e) => {\n        const chip = e.target.closest('.chip');\n        if (!chip) return;\n        [...chips.children].forEach(c => c.dataset.active = (c === chip) ? '1' : '0');\n        frame.style.setProperty('--coat-h', chip.dataset.h);\n        frame.style.setProperty('--coat-s', chip.dataset.s + '%');\n        frame.style.setProperty('--coat-l', chip.dataset.l + '%');\n        const name = chip.dataset.name || 'Custom';\n        coatName.textContent = 'Coat: Tar · ' + name;\n      });\n\n      function pulseScan() {\n        scan.classList.add('active');\n        const playX = (window.__mosh && typeof window.__mosh.playhead === 'number' ? window.__mosh.playhead : Math.random()) * w;\n        scan.style.transform = `translateX(${playX | 0}px)`;\n        setTimeout(() => scan.classList.remove('active'), 220);\n      }\n\n      // Generative visualizer\n      function draw(t) {\n        ctx.clearRect(0,0,w,h);\n        const coat = getCoat();\n        const playhead = (window.__mosh && typeof window.__mosh.playhead === 'number') ? window.__mosh.playhead : ((t*0.00005) % 1);\n        const time = (window.__mosh && typeof window.__mosh.time === 'number') ? window.__mosh.time : (t*0.001);\n        const tempo = 110 + (coat.h % 40); // playful\n        const pulse = (Math.sin(time * tempo * 0.2) * 0.5 + 0.5);\n\n        // Background subtle bands\n        const layers = (style === 'flow') ? 4 : (style === 'strands' ? 7 : 3);\n        for (let i=0; i<layers; i++) {\n          const ph = i * 1.7;\n          const amp = (style === 'strands' ? 18 : 36) * (0.35 + 0.5*intensity);\n          const y0 = h*(0.25 + 0.5*(i/layers)) + Math.sin(time*0.25 + i)*22;\n          ctx.beginPath();\n          ctx.moveTo(0, y0);\n          for (let x=0; x<=w; x+=6) {\n            const y = y0 + Math.sin(x*0.004 + time*0.9 + ph) * amp * Math.sin((x*0.0009) + ph);\n            ctx.lineTo(x,y);\n          }\n          const hue = (i%2===0) ? coat.h : (coat.h2 || (coat.h + 138));\n          const light = (style==='strands' ? 60 : 54) + Math.sin(time*0.6 + i)*6;\n          ctx.strokeStyle = hsl((hue + (pulse*6))%360, 70, light, 0.06 + 0.14*intensity);\n          ctx.lineWidth = (style==='strands' ? 1.2 : 3);\n          ctx.globalCompositeOperation = 'lighter';\n          ctx.stroke();\n        }\n\n        // Dust particles riding beat\n        if (style === 'dust') {\n          const count = Math.floor(60 + 90*intensity);\n          for (let i=0; i<count; i++) {\n            const x = (i*97 + time*40) % (w+100) - 50;\n            const y = (i*53 % h);\n            const r = 0.6 + (i%7)*0.12 + 0.8*intensity;\n            ctx.beginPath();\n            ctx.arc(x, y + Math.sin(time*0.6 + i)*8, r, 0, Math.PI*2);\n            ctx.fillStyle = hsl((coat.h3 || (coat.h - 36))%360, 70, 60, 0.05 + 0.08*intensity);\n            ctx.fill();\n          }\n        }\n\n        // Playhead hairline\n        ctx.globalCompositeOperation = 'source-over';\n        const x = Math.floor(playhead * w);\n        ctx.fillStyle = getComputedStyle(frame).getPropertyValue('--v2-playhead') || '#ccff36';\n        ctx.fillRect(x, 0, 1, h);\n\n        requestAnimationFrame(draw);\n      }\n      requestAnimationFrame(draw);\n\n      // Mount the real Moshi\n      const hostEl = document.getElementById('moshiHost');\n      let m = null;\n      function mountMoshi() {\n        if (window.Moshi && !m) {\n          m = window.Moshi(hostEl, { personality:'TAR', seed:0.5, quality:'ps2', style:'toon', interactive:true, room:false });\n          m.setState('LISTENING');\n          m.set('mood', 0.7); m.set('energy', 0.5); m.set('heat', 0.2);\n          m.setStyle('ps2'); m.setPersonality('TAR');\n        }\n      }\n      mountMoshi();\n      // Fallback retry if loaded late\n      let tries = 0; const iv = setInterval(() => { if (m || tries++>40) return clearInterval(iv); mountMoshi(); }, 200);\n\n      // Dock micro-interactions\n      const dock = document.getElementById('dock');\n      const caption = document.getElementById('moshiCaption');\n      dock.addEventListener('pointerenter', () => {\n        dock.style.boxShadow = '0 18px 60px rgba(0,0,0,0.65), inset 0 1px rgba(255,255,255,0.06), 0 0 60px 10px rgba(204,255,54,0.18)';\n        caption.textContent = 'vibe';\n        if (m) { m.set('mood', Math.min(1, 0.7 + intensity*0.3)); }\n      });\n      dock.addEventListener('pointerleave', () => {\n        dock.style.boxShadow = '0 18px 50px rgba(0,0,0,0.55), inset 0 1px rgba(255,255,255,0.04)';\n        caption.textContent = 'vibe';\n        if (m) { m.set('mood', 0.6 + intensity*0.2); }\n      });\n\n      // Initial chip active\n      chips.children[0].dataset.active = '1';\n\n      // Initialize\n      setStyle('flow');\n      setIntensity(intensity);\n    })();\n  </script>\n</div>",
