  "source": "<style>\n/* Canvas */\n.frame {\n  position: relative;\n  width: 1000px;\n  height: 620px;\n  background: var(--v2-bg);\n  color: var(--v2-text);\n  font-family: var(--font-body);\n  letter-spacing: 0.01em;\n  -webkit-font-smoothing: antialiased;\n  overflow: hidden;\n}\n\n/* Vignette + soft grain */\n.frame::before {\n  content: \"\";\n  position: absolute;\n  inset: -2px;\n  background:\n    radial-gradient(120% 80% at 50% -10%, rgba(255,255,255,0.02), rgba(0,0,0,0) 50%),\n    radial-gradient(60% 40% at 50% 115%, rgba(0,0,0,0.6), rgba(0,0,0,0) 40%),\n    linear-gradient(0deg, rgba(255,255,255,0.02), rgba(255,255,255,0.02));\n  pointer-events: none;\n  mix-blend-mode: screen;\n}\n\n/* Agent card */\n.agent-wrap {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 0 80px;\n}\n\n.agent-card {\n  position: relative;\n  width: 860px;\n  height: 280px;\n  background: linear-gradient(180deg, rgba(24,24,25,0.68), rgba(18,18,19,0.6));\n  border: 1px solid var(--v2-line);\n  border-radius: calc(var(--v2-radius) + 8px);\n  box-shadow: var(--v2-shadow);\n  overflow: hidden;\n  -webkit-backdrop-filter: blur(18px) saturate(1.04);\n  backdrop-filter: blur(18px) saturate(1.04);\n}\n\n/* Hairline highlight + inner glow for materiality */\n.agent-card::before,\n.agent-card::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n}\n.agent-card::before {\n  background:\n    linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0) 32%),\n    radial-gradient(140% 80% at 50% -60%, rgba(255,255,255,0.10), rgba(255,255,255,0) 50%);\n  mix-blend-mode: screen;\n}\n.agent-card::after {\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06), inset 0 18px 40px rgba(0,0,0,0.36);\n}\n\n/* Header row */\n.card-head {\n  position: absolute;\n  top: 18px;\n  left: 20px;\n  right: 20px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 0 6px;\n}\n\n.caption {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--v2-dim);\n  font-size: var(--v2-fs-sm);\n  letter-spacing: var(--v2-tracking-caps);\n  text-transform: uppercase;\n}\n.caption .dot {\n  width: 8px; height: 8px; border-radius: 50%;\n  background: radial-gradient(circle at 30% 30%, #fff, #fff0 35%), var(--v2-accent);\n  box-shadow: 0 0 0 3px var(--v2-accent-soft), 0 0 14px rgba(204,255,54,0.18);\n}\n\n/* Cream view toggle (light option) */\n.theme-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: var(--v2-surface);\n  border: 1px solid var(--v2-line);\n  color: var(--v2-dim);\n  padding: 6px 10px;\n  border-radius: var(--v2-radius-pill);\n  font-size: var(--v2-fs-xs);\n  cursor: pointer;\n  transition: all 160ms ease;\n}\n.theme-toggle:hover { border-color: var(--v2-line-strong); color: var(--v2-text); }\n.theme-toggle .sun {\n  width: 14px; height: 14px; border-radius: 50%;\n  background: conic-gradient(from 0deg, rgba(255,255,255,0.3), rgba(255,255,255,0.0) 40%, rgba(255,255,255,0.3) 80%, rgba(255,255,255,0.0));\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.15);\n}\n\n/* Agent input row */\n.agent {\n  position: absolute;\n  left: 20px;\n  right: 20px;\n  top: 72px;\n  height: 76px;\n  display: grid;\n  grid-template-columns: 64px 1fr 68px;\n  align-items: center;\n  gap: 12px;\n}\n\n.mic {\n  position: relative;\n  width: 64px; height: 64px;\n  border-radius: 16px;\n  background: linear-gradient(180deg, rgba(30,31,32,0.76), rgba(16,17,18,0.76));\n  border: 1px solid var(--v2-line);\n  box-shadow: var(--v2-glow), 0 12px 28px rgba(0,0,0,0.46);\n  display: grid; place-items: center;\n  cursor: pointer;\n  transition: border-color 140ms ease, transform 120ms ease, box-shadow 220ms ease, background 220ms ease;\n  overflow: hidden;\n}\n.mic svg { width: 18px; height: 18px; stroke: var(--v2-dim); transition: stroke 140ms ease, transform 220ms ease; }\n.mic:hover { border-color: var(--v2-line-strong); transform: translateY(-1px); }\n.mic:active { transform: translateY(0); }\n.mic .ring, .mic .ring2 {\n  position: absolute;\n  inset: -8px;\n  border-radius: 18px;\n  border: 1px solid var(--v2-accent);\n  opacity: 0;\n  transform: scale(0.9);\n  filter: blur(0.2px);\n}\n.mic .ring2 { inset: -16px; border-color: rgba(204,255,54,0.65); }\n\n.agent-card[data-listening=\"true\"] .mic {\n  border-color: rgba(204,255,54,0.55);\n  background: linear-gradient(180deg, rgba(44,45,46,0.7), rgba(20,22,20,0.7));\n  box-shadow: 0 0 0 1px rgba(204,255,54,0.18) inset, 0 0 24px rgba(204,255,54,0.18), 0 14px 36px rgba(0,0,0,0.5);\n}\n.agent-card[data-listening=\"true\"] .mic svg { stroke: var(--v2-accent); transform: scale(1.04); }\n.agent-card[data-listening=\"true\"] .mic .ring {\n  opacity: 0.4;\n  animation: pulseA 1900ms ease-in-out infinite;\n}\n.agent-card[data-listening=\"true\"] .mic .ring2 {\n  opacity: 0.2;\n  animation: pulseB 2200ms ease-in-out infinite;\n}\n\n@keyframes pulseA {\n  0% { transform: scale(0.92); opacity:0.38; }\n  50%{ transform: scale(1.03); opacity:0.12; }\n  100%{ transform: scale(0.92); opacity:0.38; }\n}\n@keyframes pulseB {\n  0% { transform: scale(0.86); opacity:0.22; }\n  50%{ transform: scale(1.06); opacity:0.06; }\n  100%{ transform: scale(0.86); opacity:0.22; }\n}\n\n/* Prompt field */\n.prompt-wrap {\n  position: relative;\n  height: 64px;\n  border-radius: 16px;\n  background: linear-gradient(180deg, rgba(36,36,38,0.72), rgba(22,22,24,0.68));\n  border: 1px solid var(--v2-line);\n  box-shadow: var(--v2-glow), inset 0 1px 0 rgba(255,255,255,0.03);\n  overflow: hidden;\n  transition: border-color 160ms ease, box-shadow 220ms ease, background 220ms ease;\n}\n.prompt-wrap::before {\n  content:\"\";\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0) 36%);\n  pointer-events: none;\n}\n.prompt {\n  position: absolute;\n  inset: 0;\n  padding: 18px 18px 18px 18px;\n  color: var(--v2-text);\n  font-size: var(--v2-fs-lg);\n  line-height: 28px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  outline: none;\n}\n.prompt[data-empty=\"true\"]::before {\n  content: \"Ask Mosh to…\";\n  color: var(--v2-dim);\n}\n\n.prompt-caret {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  right: 18px;\n  width: 1px; height: 22px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.25));\n  opacity: 0;\n  transition: opacity 160ms ease;\n}\n\n/* Listening bars overlay */\n.listen-bars {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  grid-template-columns: repeat(32, 1fr);\n  align-items: center;\n  gap: 4px;\n  padding: 0 18px;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 180ms ease;\n}\n.listen-bars span {\n  display: block;\n  height: 6px;\n  border-radius: 3px;\n  background: linear-gradient(180deg, rgba(204,255,54,0.85), rgba(204,255,54,0.28));\n  transform-origin: center;\n  transform: scaleY(0.2);\n  filter: drop-shadow(0 0 1px rgba(204,255,54,0.3));\n}\n\n/* Send button */\n.send {\n  position: relative;\n  width: 64px; height: 64px;\n  border-radius: 16px;\n  border: 1px solid var(--v2-line);\n  background:\n    radial-gradient(120% 120% at 50% -20%, rgba(255,255,255,0.06), rgba(255,255,255,0) 40%),\n    linear-gradient(180deg, rgba(30,31,32,0.76), rgba(16,17,18,0.76));\n  box-shadow: var(--v2-glow), 0 12px 28px rgba(0,0,0,0.46);\n  display: grid; place-items: center;\n  cursor: default;\n  transition: transform 120ms ease, box-shadow 200ms ease, background 220ms ease, border-color 160ms ease, opacity 160ms ease;\n  overflow: hidden;\n}\n.send svg { width: 19px; height: 19px; fill: none; stroke: var(--v2-dim); stroke-width: 1.6; transition: stroke 160ms ease, transform 180ms ease; }\n.send:not([disabled]):hover { transform: translateY(-1px); }\n.send:not([disabled]):active { transform: translateY(0); }\n.send:not([disabled]) {\n  cursor: pointer;\n  border-color: rgba(204,255,54,0.42);\n  background:\n    radial-gradient(120% 120% at 50% -20%, rgba(204,255,54,0.18), rgba(255,255,255,0) 42%),\n    linear-gradient(180deg, rgba(60,62,40,0.7), rgba(26,28,20,0.76));\n  box-shadow: 0 0 0 1px rgba(204,255,54,0.18) inset, 0 14px 36px rgba(0,0,0,0.5), 0 0 24px rgba(204,255,54,0.16);\n}\n.send:not([disabled]) svg { stroke: var(--v2-accent); transform: translateX(0.2px); }\n.send[disabled] { opacity: 0.6; }\n\n/* Suggestion chips */\n.chips {\n  position: absolute;\n  left: 20px; right: 20px; bottom: 22px; height: 44px;\n  display: flex; gap: 10px; align-items: center;\n}\n.chip {\n  position: relative;\n  height: 44px;\n  padding: 0 14px;\n  border-radius: var(--v2-radius-pill);\n  background: linear-gradient(180deg, rgba(30,31,32,0.54), rgba(16,17,18,0.54));\n  border: 1px solid var(--v2-line);\n  color: var(--v2-ground-dim);\n  font-size: var(--v2-fs-sm);\n  line-height: 44px;\n  cursor: pointer;\n  transition: border-color 140ms ease, color 140ms ease, transform 120ms ease, background 200ms ease;\n  overflow: hidden;\n}\n.chip::after {\n  content:\"\";\n  position:absolute; inset:-1px;\n  border-radius:inherit;\n  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0) 40%);\n  pointer-events: none;\n}\n.chip:hover { border-color: var(--v2-line-strong); color: var(--v2-text); transform: translateY(-1px); }\n.chip:active { transform: translateY(0); }\n.chip.active {\n  color: var(--v2-accent-ink);\n  background:\n    radial-gradient(120% 120% at 50% -20%, rgba(204,255,54,0.22), rgba(255,255,255,0) 42%),\n    linear-gradient(180deg, rgba(204,255,54,0.95), rgba(204,255,54,0.78));\n  border-color: rgba(204,255,54,0.7);\n  box-shadow: 0 0 0 1px rgba(0,0,0,0.16) inset, 0 6px 18px rgba(204,255,54,0.22);\n}\n\n/* Status line */\n.status {\n  position: absolute;\n  top: 152px;\n  left: 20px;\n  right: 20px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--v2-dim);\n  font-size: var(--v2-fs-xs);\n  letter-spacing: 0.04em;\n  min-height: 16px;\n}\n.status .led {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: var(--v2-faint);\n  box-shadow: 0 0 0 2px rgba(255,255,255,0.04);\n  transition: background 140ms ease, box-shadow 200ms ease;\n}\n.agent-card[data-listening=\"true\"] .status .led {\n  background: var(--v2-accent);\n  box-shadow: 0 0 10px rgba(204,255,54,0.36);\n}\n\n/* Focus + typing */\n.agent-card[data-focused=\"true\"] .prompt-wrap {\n  border-color: rgba(204,255,54,0.38);\n  box-shadow: 0 0 0 1px rgba(204,255,54,0.16) inset, 0 0 24px rgba(204,255,54,0.1);\n}\n.agent-card[data-focused=\"true\"] .prompt-caret { opacity: 0.9; animation: caret 1000ms step-end infinite; }\n@keyframes caret {\n  0%,60% { opacity: 0.9; }\n  61%,100% { opacity: 0; }\n}\n\n/* Cream theme (optional) */\n.frame.cream {\n  background: radial-gradient(130% 100% at 50% -10%, #f4f2ea 0%, #efece2 48%, #e8e5db 100%);\n  color: #222;\n}\n.frame.cream .agent-card {\n  background: linear-gradient(180deg, rgba(255,255,255,0.62), rgba(250,250,246,0.6));\n  border-color: rgba(0,0,0,0.06);\n  box-shadow: 0 20px 60px rgba(0,0,0,0.16);\n}\n.frame.cream .agent-card::after { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5), inset 0 18px 40px rgba(0,0,0,0.04); }\n.frame.cream .caption, .frame.cream .status, .frame.cream .chip { color: #56564d; }\n.frame.cream .mic, .frame.cream .send, .frame.cream .prompt-wrap, .frame.cream .chip {\n  background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(250,250,246,0.75));\n  border-color: rgba(0,0,0,0.08);\n  box-shadow: 0 8px 22px rgba(0,0,0,0.08), inset 0 1px 0 rgba(255,255,255,0.7);\n}\n.frame.cream .mic svg, .frame.cream .send svg { stroke: #6b6b62; }\n.frame.cream .chip:hover { border-color: rgba(0,0,0,0.16); color: #222; }\n.frame.cream .prompt { color: #222; }\n.frame.cream .prompt[data-empty=\"true\"]::before { color: #8b8b7d; }\n\n/* Tiny underline optimism tick when sending */\n.send .tick {\n  position: absolute;\n  bottom: 9px; left: 13px; right: 13px;\n  height: 2px; border-radius: 2px;\n  background: linear-gradient(90deg, rgba(204,255,54,0), rgba(204,255,54,0.8), rgba(204,255,54,0));\n  opacity: 0; transform: translateY(4px);\n  transition: opacity 220ms ease, transform 220ms ease;\n}\n.send.sending .tick { opacity: 1; transform: translateY(0); }\n\n/* Ripple utility */\n.ripple {\n  position: absolute;\n  border-radius: 999px;\n  pointer-events: none;\n  transform: translate(-50%, -50%);\n  background: radial-gradient(circle, rgba(204,255,54,0.26) 0%, rgba(204,255,54,0.12) 50%, rgba(204,255,54,0) 70%);\n  width: 2px; height: 2px;\n  animation: ripple 700ms ease-out forwards;\n}\n@keyframes ripple {\n  from { opacity: 0.24; width: 2px; height: 2px; }\n  to { opacity: 0; width: 180px; height: 180px; }\n}\n</style>\n\n<div class=\"frame\" id=\"root\">\n  <div class=\"agent-wrap\">\n    <div class=\"agent-card\" id=\"agent\" data-listening=\"false\" data-focused=\"false\">\n      <div class=\"card-head\">\n        <div class=\"caption\"><span class=\"dot\"></span>Agent Composer</div>\n        <button class=\"theme-toggle\" id=\"theme\" aria-pressed=\"false\" title=\"Toggle Cream\">\n          <span class=\"sun\"></span> Cream\n        </button>\n      </div>\n\n      <div class=\"agent\">\n        <button class=\"mic\" id=\"mic\" aria-pressed=\"false\" title=\"Listen\">\n          <span class=\"ring\"></span><span class=\"ring2\"></span>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 14a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v5a3 3 0 0 0 3 3Z\"></path>\n            <path d=\"M19 11a7 7 0 0 1-14 0\"></path>\n            <path d=\"M12 18v3\"></path>\n          </svg>\n        </button>\n\n        <div class=\"prompt-wrap\" id=\"promptWrap\">\n          <div class=\"prompt\" id=\"prompt\" contenteditable=\"true\" spellcheck=\"false\" role=\"textbox\" aria-multiline=\"false\"></div>\n          <div class=\"listen-bars\" id=\"bars\" aria-hidden=\"true\"></div>\n          <span class=\"prompt-caret\" id=\"caret\"></span>\n        </div>\n\n        <button class=\"send\" id=\"send\" disabled title=\"Send\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M4 12h13\"></path>\n            <path d=\"M12 5l7 7-7 7\"></path>\n          </svg>\n          <span class=\"tick\"></span>\n        </button>\n      </div>\n\n      <div class=\"status\" id=\"status\">\n        <span class=\"led\"></span>\n        <span class=\"text\">Ready</span>\n      </div>\n\n      <div class=\"chips\" id=\"chips\">\n        <button class=\"chip\" data-fill=\"Finish this section\">Finish this section</button>\n        <button class=\"chip\" data-fill=\"Re-imagine the drums\">Re‑imagine the drums</button>\n        <button class=\"chip\" data-fill=\"Write a hook\">Write a hook</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const root = document.getElementById('root');\n  const agent = document.getElementById('agent');\n  const mic = document.getElementById('mic');\n  const prompt = document.getElementById('prompt');\n  const promptWrap = document.getElementById('promptWrap');\n  const caret = document.getElementById('caret');\n  const bars = document.getElementById('bars');\n  const send = document.getElementById('send');\n  const statusText = document.querySelector('.status .text');\n  const chips = document.getElementById('chips');\n  const theme = document.getElementById('theme');\n\n  // Build bars\n  for (let i=0;i<32;i++){ const s=document.createElement('span'); bars.appendChild(s); }\n\n  function setListening(on){\n    agent.dataset.listening = on ? 'true' : 'false';\n    mic.setAttribute('aria-pressed', on ? 'true' : 'false');\n    statusText.textContent = on ? 'Listening…' : (getValue().length ? 'Ready to send' : 'Ready');\n    bars.style.opacity = on ? 1 : 0;\n    updatePlaceholder();\n  }\n\n  function getValue(){\n    return prompt.textContent.trim();\n  }\n\n  function updateSend(){\n    const v = getValue();\n    const enabled = v.length > 0 && !agent.dataset.listening.includes('true');\n    if (enabled) send.removeAttribute('disabled'); else send.setAttribute('disabled','');\n  }\n\n  function updatePlaceholder(){\n    const empty = getValue().length === 0;\n    prompt.dataset.empty = empty ? 'true' : 'false';\n    caret.style.opacity = agent.dataset.focused==='true' && empty ? '0.9' : '0';\n  }\n\n  function rippleAt(el, x, y){\n    const r = document.createElement('span');\n    r.className = 'ripple';\n    r.style.left = x+'px'; r.style.top = y+'px';\n    el.appendChild(r);\n    r.addEventListener('animationend',()=>r.remove());\n  }\n\n  // Focus handling\n  prompt.addEventListener('focus', ()=>{\n    agent.dataset.focused = 'true';\n    statusText.textContent = getValue().length ? 'Typing…' : 'Thinking…';\n    updatePlaceholder();\n  });\n  prompt.addEventListener('blur', ()=>{\n    agent.dataset.focused = 'false';\n    statusText.textContent = getValue().length ? 'Ready to send' : (agent.dataset.listening==='true'?'Listening…':'Ready');\n    caret.style.opacity = 0;\n  });\n\n  // Ensure single-line contenteditable\n  prompt.addEventListener('keydown', (e)=>{\n    if (e.key === 'Enter'){ e.preventDefault(); if(!send.disabled) send.click(); }\n  });\n  prompt.addEventListener('input', ()=>{\n    statusText.textContent = 'Typing…';\n    updatePlaceholder();\n    updateSend();\n  });\n  updatePlaceholder();\n  updateSend();\n\n  // Mic interactions\n  mic.addEventListener('click', (e)=>{\n    rippleAt(mic, e.offsetX, e.offsetY);\n    const on = agent.dataset.listening!=='true';\n    setListening(on);\n    updateSend();\n  });\n\n  // Chips\n  chips.addEventListener('click', (e)=>{\n    const btn = e.target.closest('.chip');\n    if (!btn) return;\n    chips.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));\n    btn.classList.add('active');\n    rippleAt(btn, btn.clientWidth/2, btn.clientHeight/2);\n    prompt.textContent = btn.dataset.fill || btn.textContent.trim();\n    statusText.textContent = 'Ready to send';\n    setListening(false);\n    updatePlaceholder();\n    updateSend();\n    prompt.focus();\n    // Place caret at end\n    const range = document.createRange();\n    range.selectNodeContents(prompt);\n    range.collapse(false);\n    const sel = window.getSelection();\n    sel.removeAllRanges(); sel.addRange(range);\n  });\n\n  // Send\n  send.addEventListener('click', (e)=>{\n    if (send.hasAttribute('disabled')) return;\n    rippleAt(send, e.offsetX, e.offsetY);\n    send.classList.add('sending');\n    statusText.textContent = 'Sending…';\n    setTimeout(()=>{\n      send.classList.remove('sending');\n      statusText.textContent = 'Composing…';\n      // Subtle clear after a beat\n      setTimeout(()=>{\n        prompt.textContent = '';\n        updatePlaceholder();\n        updateSend();\n        statusText.textContent = 'Ready';\n        chips.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));\n      }, 1100);\n    }, 360);\n  });\n\n  // Theme\n  theme.addEventListener('click', (e)=>{\n    rippleAt(theme, e.offsetX, e.offsetY);\n    const on = !root.classList.contains('cream');\n    root.classList.toggle('cream', on);\n    theme.setAttribute('aria-pressed', on ? 'true':'false');\n  });\n\n  // Animate listening bars with transport if present\n  const spans = Array.from(bars.children);\n  function loop(){\n    const t = (window.__mosh && typeof window.__mosh.time==='number') ? window.__mosh.time : performance.now()/1000;\n    if (agent.dataset.listening==='true'){\n      const base = 0.25 + 0.15*Math.sin(t*1.7);\n      spans.forEach((el,i)=>{\n        const k = (i/32);\n        const ph = t*2.6 + k*3.2;\n        const amp = 0.15 + 0.85*(0.5+0.5*Math.sin(ph)) * Math.pow(Math.sin(Math.PI*k), 0.9);\n        const h = Math.max(0.18, Math.min(1.0, base + amp));\n        el.style.transform = `scaleY(${h.toFixed(3)})`;\n        el.style.opacity = 0.6 + 0.4*Math.sin(ph+0.3);\n      });\n    }\n    requestAnimationFrame(loop);\n  }\n  loop();\n\n  // Initial bar values\n  spans.forEach((el,i)=>el.style.transform=`scaleY(${(0.2+0.05*i%1).toFixed(3)})`);\n})();\n</script>",
