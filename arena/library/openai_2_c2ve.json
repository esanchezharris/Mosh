</div>\n    </div>\n  </div>\n\n  <div class=\"stage-wrap\">\n    <div class=\"stage\" id=\"stage\">\n      <div class=\"stage-glass\"></div>\n      <div class=\"ruler\" id=\"ruler\">\n        <div class=\"ruler-bg\"></div>\n        <div class=\"bars\">\n          <div class=\"bar tick\"><span>1</span></div>\n          <div class=\"bar\"><span>2</span></div>\n          <div class=\"bar\"><span>3</span></div>\n          <div class=\"bar\"><span>4</span></div>\n          <div class=\"bar\"><span>5</span></div>\n          <div class=\"bar\"><span>6</span></div>\n          <div class=\"bar\"><span>7</span></div>\n          <div class=\"bar\"><span>8</span></div>\n          <div class=\"bar tick\"><span>9</span></div>\n          <div class=\"bar\"><span>10</span></div>\n          <div class=\"bar\"><span>11</span></div>\n          <div class=\"bar\"><span>12</span></div>\n          <div class=\"bar\"><span>13</span></div>\n          <div class=\"bar\"><span>14</span></div>\n          <div class=\"bar\"><span>15</span></div>\n          <div class=\"bar\"><span>16</span></div>\n        </div>\n      </div>\n\n      <div class=\"lanes\">\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"lh-dot drum\"></div>\n            <div class=\"lh-meta\">\n              <div class=\"lh-name\">Drums</div>\n              <div class=\"lh-sub\">Kit: 909 Hybrid</div>\n            </div>\n          </div>\n          <div class=\"lane-body\">\n            <div class=\"clip drum\" style=\"left:0%;width:47%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">DR A</div>\n              <svg class=\"wave\" viewBox=\"0 0 160 40\" preserveAspectRatio=\"none\">\n                <path d=\"M0 20c10-8 20-8 30 0s20 8 30 0 20-8 30 0 20 8 30 0 20-8 40 0\" stroke=\"rgba(10,15,4,0.7)\" stroke-width=\"2\" fill=\"none\"/>\n                <path d=\"M0 20c10 8 20 8 30 0s20-8 30 0 20 8 30 0 20-8 30 0 20 8 40 0\" stroke=\"rgba(204,255,54,0.85)\" stroke-width=\"1.2\" fill=\"none\"/>\n              </svg>\n            </div>\n            <div class=\"clip drum\" style=\"left:50%;width:47%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">DR B</div>\n              <svg class=\"wave\" viewBox=\"0 0 160 40\" preserveAspectRatio=\"none\">\n                <path d=\"M0 20c10-8 20-8 30 0s20 8 30 0 20-8 30 0 20 8 30 0 20-8 40 0\" stroke=\"rgba(10,15,4,0.7)\" stroke-width=\"2\" fill=\"none\"/>\n                <path d=\"M0 20c10 8 20 8 30 0s20-8 30 0 20 8 30 0 20-8 30 0 20 8 40 0\" stroke=\"rgba(204,255,54,0.85)\" stroke-width=\"1.2\" fill=\"none\"/>\n              </svg>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"lh-dot bass\"></div>\n            <div class=\"lh-meta\">\n              <div class=\"lh-name\">Bass</div>\n              <div class=\"lh-sub\">Mono Sub</div>\n            </div>\n          </div>\n          <div class=\"lane-body\">\n            <div class=\"clip midi\" style=\"left:0%;width:30%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">BASS Riff</div>\n              <div class=\"midi-bars\"></div>\n            </div>\n            <div class=\"clip midi\" style=\"left:34%;width:28%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">BASS Fill</div>\n              <div class=\"midi-bars\"></div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"lh-dot keys\"></div>\n            <div class=\"lh-meta\">\n              <div class=\"lh-name\">Keys</div>\n              <div class=\"lh-sub\">Poly Pad</div>\n            </div>\n          </div>\n          <div class=\"lane-body\">\n            <div class=\"clip block\" style=\"left:0%;width:48%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">Pads A</div>\n              <div class=\"midi-grid\"></div>\n            </div>\n            <div class=\"clip block\" style=\"left:52%;width:44%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">Pads B</div>\n              <div class=\"midi-grid\"></div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"lh-dot vox\"></div>\n            <div class=\"lh-meta\">\n              <div class=\"lh-name\">Vox</div>\n              <div class=\"lh-sub\">Lead</div>\n            </div>\n          </div>\n          <div class=\"lane-body\">\n            <div class=\"clip wave\" id=\"voxA\" style=\"left:0%;width:48%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">Lead Take A</div>\n              <svg class=\"wave dense\" viewBox=\"0 0 200 40\" preserveAspectRatio=\"none\">\n                <path d=\"M0 20c8-10 16-10 24 0s16 10 24 0 16-10 24 0 16 10 24 0 16-10 24 0 16 10 24 0 16-10 32 0\" stroke=\"rgba(154,160,180,0.95)\" stroke-width=\"1.2\" fill=\"none\"/>\n              </svg>\n            </div>\n            <div class=\"clip wave\" style=\"left:52%;width:44%;\">\n              <div class=\"clip-glass\"></div>\n              <div class=\"clip-label\">Lead Comp</div>\n              <svg class=\"wave dense\" viewBox=\"0 0 200 40\" preserveAspectRatio=\"none\">\n                <path d=\"M0 20c8-10 16-10 24 0s16 10 24 0 16-10 24 0 16 10 24 0 16-10 24 0 16 10 24 0 16-10 32 0\" stroke=\"rgba(154,160,180,0.95)\" stroke-width=\"1.2\" fill=\"none\"/>\n              </svg>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"grid-overlay\"></div>\n      <div class=\"playhead\" id=\"playhead\">\n        <div class=\"ph-tip\"></div>\n      </div>\n    </div>\n  </div>\n\n  <button class=\"ai-pill\" aria-label=\"Compose with Mosh\">\n    <span class=\"ai-glow\"></span>\n    <span class=\"ai-dot\"></span>\n    <span class=\"ai-label\">Compose with Mosh</span>\n    <span class=\"ai-hint mono\">⌘K</span>\n  </button>\n\n  <div class=\"grain\"></div>\n  <div class=\"sheen\"></div>\n</div>\n\n<style>\n.mosh-app {\n  position: relative;\n  width: 1440px;\n  height: 900px;\n  background: var(--v2-bg);\n  color: var(--v2-text);\n  font-family: var(--font-body);\n  letter-spacing: 0.01em;\n  overflow: hidden;\n  isolation: isolate;\n}\n.mosh-app::before {\n  content: \"\";\n  position: absolute; inset: 0;\n  background: radial-gradient(80% 50% at 50% -10%, rgba(204,255,54,0.05), rgba(204,255,54,0) 48%),\n              radial-gradient(40% 80% at 80% 100%, rgba(204,255,54,0.05), rgba(204,255,54,0) 70%);\n  pointer-events: none;\n  mix-blend-mode: screen;\n}\n\n/* Topbar */\n.topbar {\n  position: absolute; top: 0; left: 0; right: 0; height: var(--v2-topbar-h);\n  display: flex; align-items: center;\n  z-index: 30;\n}\n.topbar-bg {\n  position: absolute; inset: 0;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)) , var(--v2-surface);\n  border-bottom: 1px solid var(--v2-line-strong);\n  backdrop-filter: blur(10px) saturate(120%);\n  box-shadow: var(--v2-glow);\n  pointer-events: none;\n}\n.brand {\n  position: absolute; left: 24px;\n  font-family: var(--font-display);\n  font-size: 18px; letter-spacing: var(--v2-tracking-caps);\n  color: var(--v2-text);\n  text-shadow: 0 1px 0 rgba(0,0,0,0.6);\n}\n.transport {\n  position: absolute; left: 50%; transform: translateX(-50%);\n  height: 40px; min-width: 430px;\n  display: grid; grid-auto-flow: column; align-items: center; gap: 10px;\n  padding: 6px 12px;\n}\n.transport-glass {\n  position: absolute; inset: 0;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n  border: 1px solid var(--v2-line);\n  border-radius: var(--v2-radius-pill);\n  box-shadow: var(--v2-glow), 0 10px 30px rgba(0,0,0,0.25);\n  backdrop-filter: blur(8px) saturate(120%);\n}\n.tbtn {\n  position: relative;\n  width: 28px; height: 28px;\n  border-radius: 99px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));\n  border: 1px solid var(--v2-line-strong);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 2px 10px rgba(0,0,0,0.25);\n  display: grid; place-items: center;\n  transition: transform .12s ease, box-shadow .2s ease, background .2s ease;\n  cursor: pointer;\n}\n.tbtn:hover { box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 6px 18px rgba(0,0,0,0.35); }\n.tbtn:active { transform: translateY(1px) scale(0.98); }\n.icon.play {\n  width: 0; height: 0; border-left: 8px solid var(--v2-text);\n  border-top: 5px solid transparent; border-bottom: 5px solid transparent; margin-left: 2px;\n  filter: drop-shadow(0 1px 0 rgba(0,0,0,0.5));\n}\n.icon.stop {\n  width: 10px; height: 10px; background: var(--v2-text); border-radius: 2px;\n  box-shadow: 0 1px 0 rgba(0,0,0,0.5);\n}\n.tbtn.rec {\n  width: 36px; height: 28px; padding: 0 4px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));\n}\n.tbtn.rec .pulse {\n  width: 10px; height: 10px; border-radius: 50%;\n  background: var(--v2-rec);\n  box-shadow: 0 0 0 0 rgba(255,59,92,0.5);\n  animation: rec-pulse 2s ease-out infinite;\n}\n@keyframes rec-pulse {\n  0% { box-shadow: 0 0 0 0 rgba(255,59,92,0.55); transform: scale(1); }\n  70% { box-shadow: 0 0 0 8px rgba(255,59,92,0); transform: scale(1.04); }\n  100% { box-shadow: 0 0 0 0 rgba(255,59,92,0); transform: scale(1); }\n}\n.time {\n  display: grid; grid-auto-flow: column; align-items: center; gap: 8px;\n  margin-left: 6px; padding-left: 12px; padding-right: 10px;\n  height: 28px; border-radius: 999px; position: relative;\n  border: 1px solid var(--v2-line);\n  background: radial-gradient(100% 100% at 0% 0%, rgba(204,255,54,0.08), rgba(255,255,255,0.02));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);\n}\n.time-led {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: var(--v2-accent); box-shadow: 0 0 10px rgba(204,255,54,0.5), 0 0 2px rgba(204,255,54,1);\n  transition: opacity .3s ease;\n}\n.readout {\n  font-family: var(--font-mono);\n  font-size: var(--v2-fs-md);\n  letter-spacing: 0.06em;\n  color: var(--v2-text);\n  text-shadow: 0 1px 0 rgba(0,0,0,0.5);\n}\n\n/* Rails */\n.left-rail {\n  position: absolute; top: var(--v2-topbar-h); bottom: 0; left: 0; width: 56px;\n  border-right: 1px solid var(--v2-line);\n  z-index: 20;\n}\n.rail-glass {\n  position: absolute; inset: 0;\n  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));\n  backdrop-filter: blur(6px) saturate(110%);\n  box-shadow: inset -1px 0 0 rgba(255,255,255,0.03);\n}\n.toolset {\n  position: absolute; top: 16px; left: 8px; right: 8px; display: grid; gap: 10px;\n}\n.tool {\n  height: 38px; border-radius: 12px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));\n  border: 1px solid var(--v2-line);\n  display: grid; place-items: center; cursor: pointer;\n  box-shadow: var(--v2-glow);\n  transition: transform .12s ease, box-shadow .2s ease, border-color .2s ease;\n}\n.tool:hover { box-shadow: var(--v2-glow), 0 8px 18px rgba(0,0,0,0.35); }\n.tool:active { transform: translateY(1px) scale(0.98); }\n.tool.active {\n  border-color: rgba(204,255,54,0.5);\n  box-shadow: 0 0 0 1px rgba(204,255,54,0.25), inset 0 1px 0 rgba(255,255,255,0.06);\n}\n\n/* Right rail */\n.right-rail {\n  position: absolute; top: var(--v2-topbar-h); bottom: 0; right: 0; width: var(--v2-rail-w);\n  padding: 16px 16px 20px 16px;\n  border-left: 1px solid var(--v2-line);\n  z-index: 15;\n  display: grid; grid-template-rows: auto 1fr; gap: 12px;\n}\n.presence {\n  position: relative;\n  height: 120px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n  border: 1px solid var(--v2-line);\n  border-radius: var(--v2-radius-lg);\n  box-shadow: var(--v2-glow), 0 12px 30px rgba(0,0,0,0.3);\n  padding: 12px;\n  display: grid; grid-template-columns: 80px 1fr; gap: 12px; align-items: center;\n  overflow: hidden;\n}\n.presence::after {\n  content: \"\";\n  position: absolute; inset: 0;\n  background: radial-gradient(120% 100% at 0% 0%, rgba(204,255,54,0.06), transparent 50%);\n  pointer-events: none;\n}\n.orb {\n  position: relative; width: 64px; height: 64px; border-radius: 50%;\n  filter: drop-shadow(0 8px 18px rgba(0,0,0,0.45));\n}\n.orb-core {\n  position: absolute; inset: 0; border-radius: 50%;\n  background: conic-gradient(from 0deg, #ccff36, #eaf0c8, #9aa0b4, #ccff36);\n  animation: orb-rot 8s linear infinite;\n  mask: radial-gradient(circle at 30% 30%, rgba(0,0,0,1), rgba(0,0,0,0.6) 60%, rgba(0,0,0,0.1));\n}\n@keyframes orb-rot { to { transform: rotate(360deg); } }\n.orb-ring {\n  position: absolute; inset: -3px; border-radius: 50%;\n  border: 1px solid rgba(204,255,54,0.35);\n  box-shadow: inset 0 0 10px rgba(204,255,54,0.25), 0 0 0 1px rgba(255,255,255,0.04);\n}\n.orb-spark {\n  position: absolute; width: 8px; height: 8px; border-radius: 50%;\n  background: var(--v2-accent);\n  left: 50%; top: -4px; transform-origin: -18px 36px;\n  animation: spark 3.6s ease-in-out infinite;\n  box-shadow: 0 0 10px rgba(204,255,54,0.7), 0 0 2px rgba(204,255,54,1);\n}\n@keyframes spark {\n  0% { transform: rotate(0deg) translateX(0); opacity: .9; }\n  50% { transform: rotate(180deg) translateX(2px); opacity: .6; }\n  100% { transform: rotate(360deg) translateX(0); opacity: .9; }\n}\n.presence-meta .agent-name {\n  font-size: var(--v2-fs-md);\n  letter-spacing: .08em; font-weight: 600;\n}\n.presence-meta .agent-role {\n  margin-top: 2px;\n  font-size: var(--v2-fs-sm); color: var(--v2-dim);\n}\n.inspector {\n  position: relative;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n  border: 1px solid var(--v2-line);\n  border-radius: var(--v2-radius);\n  box-shadow: var(--v2-glow), 0 12px 30px rgba(0,0,0,0.3);\n  padding: 12px;\n  display: grid; grid-template-rows: auto auto 1fr auto; gap: 8px;\n}\n.inspector-head { display: grid; grid-auto-flow: column; justify-content: space-between; align-items: center; }\n.i-title {\n  font-size: var(--v2-fs-sm); text-transform: uppercase; letter-spacing: var(--v2-tracking-caps);\n  color: var(--v2-dim);\n}\n.i-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--v2-accent); box-shadow: 0 0 8px rgba(204,255,54,0.7); }\n.i-section { display: grid; gap: 6px; }\n.i-row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; align-items: center; }\n.k { font-size: var(--v2-fs-sm); color: var(--v2-faint); }\n.v { font-size: var(--v2-fs-base); text-align: right; }\n.mono { font-family: var(--font-mono); letter-spacing: .04em; }\n.i-actions { display: grid; grid-auto-flow: column; gap: 8px; }\n.ia-btn {\n  height: 30px; padding: 0 10px; border-radius: 8px; cursor: pointer;\n  border: 1px solid var(--v2-line); background: rgba(255,255,255,0.04);\n  color: var(--v2-text);\n  box-shadow: var(--v2-glow);\n  transition: transform .12s ease, box-shadow .2s ease, border-color .2s ease;\n}\n.ia-btn:hover { border-color: rgba(204,255,54,0.5); box-shadow: 0 0 0 1px rgba(204,255,54,0.25), 0 10px 24px rgba(0,0,0,0.35); }\n.ia-btn.ghost { background: transparent; }\n\n/* Stage */\n.stage-wrap {\n  position: absolute; top: calc(var(--v2-topbar-h) + 14px); bottom: 86px; left: 56px; right: var(--v2-rail-w);\n  padding: 0 24px;\n  display: grid; place-items: center;\n}\n.stage {\n  position: relative;\n  width: min(var(--v2-stage-max), 100%); height: 100%;\n  border-radius: 18px;\n  overflow: hidden;\n  box-shadow: var(--v2-shadow), inset 0 1px 0 rgba(255,255,255,0.05);\n  border: 1px solid var(--v2-line-strong);\n  background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.018));\n  isolation: isolate;\n}\n.stage-glass {\n  position: absolute