  "source": "<div class=\"mosh-app\">\n  <div class=\"topbar\">\n    <div class=\"topbar-bg\"></div>\n    <div class=\"brand\">MOSH</div>\n    <div class=\"transport\" aria-label=\"Transport\">\n      <div class=\"transport-glass\"></div>\n      <button class=\"tbtn stop\" aria-label=\"Stop\">\n        <span class=\"icon stop\"></span>\n      </button>\n      <button class=\"tbtn play\" aria-label=\"Play\">\n        <span class=\"icon play\"></span>\n      </button>\n      <button class=\"tbtn rec\" aria-label=\"Record\">\n        <span class=\"pulse\"></span>\n      </button>\n      <div class=\"time\">\n        <span class=\"time-led\"></span>\n        <span class=\"readout\">000•1.1</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"left-rail\">\n    <div class=\"rail-glass\"></div>\n    <div class=\"toolset\">\n      <button class=\"tool active\" title=\"Pointer (V)\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><path d=\"M4 2l9.5 4.8-5.2 1.4 1.9 5.9-1.5.6-2-6.2-3 .8z\" fill=\"url(#g1)\"/><defs><linearGradient id=\"g1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#fafafa\" stop-opacity=\".95\"/><stop offset=\"1\" stop-color=\"#bfc3d0\" stop-opacity=\".85\"/></linearGradient></defs></svg>\n      </button>\n      <button class=\"tool\" title=\"Range (R)\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><rect x=\"3\" y=\"5\" width=\"12\" height=\"8\" rx=\"2\" fill=\"#dfe3ef\" opacity=\".9\"/><rect x=\"6\" y=\"3\" width=\"6\" height=\"12\" rx=\"2\" fill=\"#c7ccdb\" opacity=\".9\"/></svg>\n      </button>\n      <button class=\"tool\" title=\"Blade (B)\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><path d=\"M3 9h12\" stroke=\"#e7eaf4\" stroke-width=\"1.4\"/><path d=\"M6 5l6 8\" stroke=\"#e7eaf4\" stroke-width=\"1.2\"/></svg>\n      </button>\n      <button class=\"tool\" title=\"Draw (D)\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><path d=\"M5 12c2-2 5-5 8-8