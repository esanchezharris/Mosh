der-radius: inherit;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.1), inset 0 -1px 0 rgba(0,0,0,0.3);\n  pointer-events: none;\n}\n\n/* Accessibility focus */\nbutton:focus-visible { outline: 2px solid rgba(204,255,54,0.6); outline-offset: 2px; }\n</style>\n\n<script>\n(function(){\n  const barsTotal = 16;\n  const beatsPerBar = 4;\n  let lastT = 0, playing = false, rafId = null;\n\n  const ph = document.getElementById('playhead');\n  const stage = document.getElementById('stage');\n  const readout = document.querySelector('.readout');\n  const timeLed = document.querySelector('.time-led');\n  const voxClip = document.getElementById('voxA');\n\n  function fmt(n, pad=3){ return String(n).padStart(pad,'0'); }\n\n  function update() {\n    const host = window.__mosh || {};\n    const t = typeof host.time === 'number' ? host.time : 0;\n    const p = typeof host.playhead === 'number' ? host.playhead : 0;\n\n    // Detect playing state\n    playing = t !== lastT;\n    lastT = t;\n\n    // Time readout as bars•beats.subbeats (4/4)\n    const posBars = p * barsTotal;\n    const barIndex = Math.floor(posBars) + 1;\n    const beatFloat = (posBars % 1) * beatsPerBar;\n    const beatIndex = Math.floor(beatFloat) + 1;\n    const sub = Math.floor((beatFloat % 1) * 4) + 1;\n    readout.textContent = fmt(barIndex) + '•' + beatIndex + '.' + sub;\n\n    // Move playhead within the timeline (from head width to right edge)\n    const rect = stage.getBoundingClientRect();\n    const headW = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--v2-head-w')) || 168;\n    const rulerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--v2-ruler-h')) || 24;\n    const left = headW + (rect.width - headW) * p;\n    ph.style.transform = 'translateX(' + left + 'px)';\n\n    // Micro-interactions\n    timeLed.style.opacity = playing ? '1' : '0.5';\n\n    // Subtle waveform shimmer on Vox lead\n    if (voxClip) {\n      const shimmer = 2 + Math.sin((t || 0) * 1.4) * 1.2;\n      voxClip.style.filter = 'saturate(' + (playing ? 1.1 : 1.0) + ') brightness(' + (1 + (playing ? 0.02 : 0)) + ')';\n      voxClip.style.setProperty('--wav-off', shimmer.toFixed(2) + 'px');\n    }\n\n    rafId = requestAnimationFrame(update);\n  }\n\n  // Delight: soft tick on play button when host is advancing\n  const playBtn = document.querySelector('.tbtn.play');\n  function tickPlayBtn() {\n    if (!playBtn) return;\n    if (playing) {\n      playBtn.style.boxShadow = 'inset 0 1px 0 rgba(255,255,255,0.12), 0 0 0 1px rgba(204,255,54,0.25), 0 10px 24px rgba(0,0,0,0.4)';\n    } else {\n      playBtn.style.boxShadow = '';\n    }\n  }\n  setInterval(tickPlayBtn, 120);\n\n  cancelAnimationFrame(rafId);\n  update();\n})();\n</script>",
