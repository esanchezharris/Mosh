  "source": "<div id=\"mosh-app\">\n  <style>\n    /* Frame */\n    #mosh-app {\n      position: relative;\n      width: 1440px;\n      height: 900px;\n      background: var(--v2-bg);\n      color: var(--v2-text);\n      font-family: var(--font-body);\n      -webkit-font-smoothing: antialiased;\n      overflow: hidden;\n    }\n    /* Subtle film grain */\n    .grain {\n      position: absolute;\n      inset: -20px;\n      pointer-events: none;\n      opacity: 0.06;\n      mix-blend-mode: soft-light;\n      filter: contrast(110%) brightness(110%);\n    }\n    /* Top bar */\n    .topbar {\n      position: absolute;\n      top: 0; left: 0; right: 0;\n      height: var(--v2-topbar-h);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.0));\n      box-shadow: inset 0 -1px 0 var(--v2-line), inset 0 1px 0 rgba(255,255,255,0.04);\n      z-index: 10;\n    }\n    .topbar::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: radial-gradient(60% 180% at 50% -80%, rgba(204,255,54,0.06), transparent 40%);\n      pointer-events: none;\n    }\n    .brand {\n      position: absolute;\n      left: 22px;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      letter-spacing: var(--v2-tracking-caps);\n      font-family: var(--font-display);\n      font-size: var(--v2-fs-lg);\n      text-transform: uppercase;\n      color: var(--v2-text);\n      text-shadow: 0 1px 0 rgba(0,0,0,0.6);\n    }\n    .brand-badge {\n      width: 10px; height: 10px; border-radius: 50%;\n      background: var(--v2-accent);\n      box-shadow: 0 0 0 2px rgba(204,255,54,0.18), 0 0 10px rgba(204,255,54,0.22), inset 0 0 4px rgba(0,0,0,0.6);\n    }\n\n    /* Transport */\n    .transport {\n      display: inline-flex;\n      align-items: center;\n      gap: 14px;\n      background: linear-gradient(180deg, rgba(26,26,28,0.65), rgba(20,20,22,0.6));\n      padding: 6px 12px;\n      border-radius: var(--v2-radius-pill);\n      border: 1px solid var(--v2-line);\n      box-shadow: var(--v2-shadow), var(--v2-glow);\n      backdrop-filter: blur(8px);\n    }\n    .t-btn {\n      position: relative;\n      width: 36px; height: 36px;\n      display: grid; place-items: center;\n      background: linear-gradient(180deg, rgba(33,33,35,0.75), rgba(24,24,26,0.7));\n      border: 1px solid var(--v2-line-strong);\n      border-radius: var(--v2-radius-pill);\n      color: var(--v2-dim);\n      cursor: pointer;\n      transition: transform 0.08s ease, color 0.15s ease, background 0.2s ease, box-shadow 0.2s ease;\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 2px 10px rgba(0,0,0,0.4);\n    }\n    .t-btn:hover {\n      color: var(--v2-text);\n      box-shadow: 0 0 0 1px rgba(255,255,255,0.06), 0 6px 18px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.06);\n    }\n    .t-btn:active { transform: translateY(1px) scale(0.98); }\n\n    .t-btn.play {\n      background: radial-gradient(140% 140% at 50% 0%, rgba(204,255,54,0.18), rgba(33,33,35,0.72));\n      color: var(--v2-accent);\n      box-shadow: 0 0 0 1px rgba(204,255,54,0.15), inset 0 1px 0 rgba(255,255,255,0.08);\n    }\n    .t-btn.play.glow {\n      animation: pulse 1.6s ease-in-out infinite;\n    }\n    @keyframes pulse {\n      0%,100% { box-shadow: 0 0 0 1px rgba(204,255,54,0.14), 0 0 24px rgba(204,255,54,0.12), inset 0 1px 0 rgba(255,255,255,0.08); }\n      50% { box-shadow: 0 0 0 2px rgba(204,255,54,0.2), 0 0 42px rgba(204,255,54,0.18), inset 0 1px 0 rgba(255,255,255,0.1); }\n    }\n    .t-btn.rec { color: var(--v2-rec); }\n    .t-btn.active.rec {\n      background: radial-gradient(140% 140% at 50% 0%, rgba(255,59,92,0.18), rgba(33,33,35,0.72));\n      box-shadow: 0 0 18px rgba(255,59,92,0.3);\n    }\n\n    .timecode {\n      font-family: var(--font-mono);\n      font-size: var(--v2-fs-xl);\n      letter-spacing: 0.02em;\n      color: var(--v2-text);\n      padding: 0 10px 0 4px;\n      display: inline-flex; align-items:center;\n      gap: 10px;\n    }\n    .time-bpm {\n      font-size: var(--v2-fs-sm);\n      color: var(--v2-dim);\n      padding: 2px 8px;\n      border-radius: var(--v2-radius-pill);\n      border: 1px solid var(--v2-line);\n      background: rgba(26,26,28,0.5);\n    }\n\n    /* Left tool rail */\n    .tool-rail {\n      position: absolute;\n      top: calc(var(--v2-topbar-h) + 10px);\n      bottom: 84px;\n      left: 16px;\n      width: 56px;\n      background: linear-gradient(180deg, rgba(33,33,35,0.7), rgba(26,26,28,0.64));\n      border: 1px solid var(--v2-line);\n      border-radius: 14px;\n      box-shadow: var(--v2-shadow), var(--v2-glow);\n      backdrop-filter: blur(8px);\n      display: flex; flex-direction: column; align-items: center; gap: 8px;\n      padding: 10px 6px;\n    }\n    .tool-rail .cap {\n      width: 28px; height: 4px;\n      border-radius: var(--v2-radius-pill);\n      background: linear-gradient(90deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));\n      margin: 2px 0 6px;\n    }\n    .tool {\n      width: 44px; height: 44px;\n      border-radius: 12px;\n      border: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(40,40,42,0.58), rgba(28,28,30,0.54));\n      display: grid; place-items: center;\n      color: var(--v2-dim);\n      cursor: pointer;\n      transition: 0.18s ease;\n      position: relative;\n      overflow: hidden;\n    }\n    .tool:hover { color: var(--v2-text); box-shadow: 0 6px 16px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.06); }\n    .tool.active {\n      color: var(--v2-accent);\n      border-color: rgba(204,255,54,0.22);\n      box-shadow: 0 0 0 1px rgba(204,255,54,0.18), inset 0 1px 0 rgba(255,255,255,0.08);\n    }\n\n    /* Stage */\n    .stage {\n      position: absolute;\n      top: 116px;\n      left: 50%;\n      transform: translateX(-50%);\n      width: var(--v2-stage-max);\n      background: linear-gradient(180deg, rgba(24,24,26,0.48), rgba(17,17,19,0.46));\n      border: 1px solid var(--v2-line);\n      border-radius: var(--v2-radius);\n      box-shadow: var(--v2-shadow), var(--v2-glow);\n      backdrop-filter: blur(8px);\n      overflow: hidden;\n    }\n    .stage::before {\n      content: \"\";\n      position: absolute; inset: 0;\n      background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent 9%), linear-gradient(0deg, rgba(255,255,255,0.02), transparent 30%);\n      pointer-events: none;\n    }\n\n    /* Ruler */\n    .ruler {\n      position: relative;\n      height: var(--v2-ruler-h);\n      border-bottom: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n      font-family: var(--font-mono);\n      font-size: var(--v2-fs-xs);\n      letter-spacing: 0.02em;\n      color: var(--v2-dim);\n    }\n    .ruler-grid {\n      position: absolute; left: var(--v2-head-w); right: 0; top: 0; bottom: 0;\n      background:\n        repeating-linear-gradient(90deg, rgba(255,255,255,0.06) 0px, rgba(255,255,255,0.06) 1px, transparent 1px, transparent calc((1000px - var(--v2-head-w)) / 64)),\n        repeating-linear-gradient(90deg, rgba(255,255,255,0.12) 0px, rgba(255,255,255,0.12) 1px, transparent 1px, transparent calc((1000px - var(--v2-head-w)) / 16));\n      opacity: 0.18;\n      pointer-events: none;\n    }\n    .ruler-labels {\n      position: absolute; left: var(--v2-head-w); right: 0; top: 0; bottom: 0;\n      display: grid;\n      grid-template-columns: repeat(16, 1fr);\n      align-items: center;\n      padding: 0 6px;\n    }\n    .ruler-labels div {\n      opacity: 0.9;\n      padding-left: 3px;\n    }\n\n    /* Lanes */\n    .lanes { position: relative; }\n    .lane {\n      display: grid;\n      grid-template-columns: var(--v2-head-w) 1fr;\n      height: var(--v2-lane-h);\n      border-bottom: 1px solid var(--v2-line);\n      position: relative;\n    }\n    .lane:last-child { border-bottom: none; }\n\n    .lane-head {\n      position: relative;\n      padding: 10px 12px;\n      display: flex; align-items: center; gap: 10px; justify-content: space-between;\n      background: linear-gradient(180deg, rgba(33,33,35,0.42), rgba(24,24,26,0.36));\n      border-right: 1px solid var(--v2-line);\n    }\n    .lane-head .label {\n      display: flex; align-items: center; gap: 10px;\n      font-weight: 600;\n      font-size: var(--v2-fs-md);\n    }\n    .lane-head .pill {\n      width: 10px; height: 10px; border-radius: 8px;\n      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08), 0 0 12px rgba(0,0,0,0.5);\n    }\n    .lane-head .meters {\n      display: inline-flex; gap: 2px; align-items: flex-end;\n    }\n    .meter {\n      width: 3px; height: 14px; border-radius: 2px;\n      background: linear-gradient(180deg, rgba(120,230,150,0.6), rgba(40,170,90,0.4));\n      opacity: 0.65; transform-origin: bottom;\n      animation: vu 720ms linear infinite;\n    }\n    .meter:nth-child(2) { animation-delay: 0.12s; }\n    .meter:nth-child(3) { animation-delay: 0.22s; }\n    .meter:nth-child(4) { animation-delay: 0.32s; }\n    @keyframes vu {\n      0% { transform: scaleY(0.3); }\n      45% { transform: scaleY(0.95); }\n      100% { transform: scaleY(0.4); }\n    }\n\n    .lane-body {\n      position: relative;\n      background:\n        linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.0)),\n        repeating-linear-gradient(90deg, rgba(255,255,255,0.06) 0px, rgba(255,255,255,0.06) 1px, transparent 1px, transparent calc((1000px - var(--v2-head-w)) / 16));\n      background-blend-mode: normal;\n    }\n    .lane-body::before {\n      content: \"\";\n      position: absolute; inset: 0;\n      background: repeating-linear-gradient(90deg, rgba(255,255,255,0.06) 0, rgba(255,255,255,0.06) 1px, transparent 1px, transparent calc((1000px - var(--v2-head-w)) / 4));\n      opacity: 0.05; pointer-events: none;\n    }\n\n    /* Clips */\n    .clip {\n      position: absolute;\n      top: 8px; height: calc(100% - 16px);\n      min-width: 40px;\n      border-radius: var(--v2-radius-xs);\n      border: 1px solid var(--v2-line-strong);\n      box-shadow: 0 2px 12px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.06);\n      overflow: hidden;\n      cursor: pointer;\n      transition: 0.18s ease;\n    }\n    .clip:hover { box-shadow: 0 6px 16px rgba(0,0,0,0.48), inset 0 1px 0 rgba(255,255,255,0.09); }\n    .clip .name {\n      position: absolute; left: 8px; top: 6px;\n      font-size: var(--v2-fs-xs);\n      color: rgba(255,255,255,0.82);\n      text-shadow: 0 1px 0 rgba(0,0,0,0.6);\n      pointer-events: none;\n    }\n    .clip .wave {\n      position: absolute; inset: 0; opacity: 0.9; pointer-events: none;\n      mix-blend-mode: screen;\n    }\n    .clip .sheen {\n      content: \"\";\n      position: absolute; inset: 0;\n      background: linear-gradient(105deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.02) 28%, rgba(255,255,255,0.08) 56%, rgba(255,255,255,0.0) 72%);\n      opacity: 0.06;\n      transform: translateX(-40%);\n      transition: opacity 0.3s ease, transform 0.9s ease;\n    }\n    .clip:hover .sheen { opacity: 0.14; transform: translateX(0%); }\n    .clip.selected { outline: 2px solid rgba(204,255,54,0.6); border-color: rgba(204,255,54,0.35); }\n    .clip.playing::after {\n      content:\"\";\n      position:absolute; left:-20%; top:0; bottom:0; width:18%;\n      background: linear-gradient(90deg, rgba(204,255,54,0.0), rgba(204,255,54,0.18), rgba(204,255,54,0.0));\n      filter: blur(2px);\n      animation: sweep 2.4s linear infinite;\n      pointer-events: none;\n    }\n    @keyframes sweep { 0%{transform:translateX(0)} 100%{transform:translateX(700%)} }\n\n    .clip.wave-clip { background: var(--v2-clip-block); }\n    .clip.midi-clip { background: linear-gradient(180deg, rgba(196,202,220,0.8), rgba(144,150,170,0.75)); color: var(--v2-ink); }\n    .clip.drum-clip { background: linear-gradient(180deg, rgba(204,255,54,0.78), rgba(122,170,30,0.7)); color: var(--v2-accent-ink); }\n\n    /* Playhead */\n    .playhead {\n      position: absolute;\n      top: var(--v2-ruler-h);\n      bottom: 0;\n      width: 2px;\n      background: var(--v2-playhead);\n      box-shadow: 0 0 0 1px rgba(204,255,54,0.4), 0 0 18px rgba(204,255,54,0.28);\n      transform: translateX(calc(var(--v2-head-w) + 0px));\n      pointer-events: none;\n    }\n    .playhead .cap {\n      position: absolute;\n      top: -10px; left: -5px;\n      width: 12px; height: 12px; border-radius: 3px;\n      background: var(--v2-accent);\n      box-shadow: 0 2px 12px rgba(204,255,54,0.4), inset 0 1px 0 rgba(255,255,255,0.4);\n    }\n\n    /* Right rail */\n    .right-rail {\n      position: absolute; top: calc(var(--v2-topbar-h) + 10px);\n      right: 16px; bottom: 84px;\n      width: var(--v2-rail-w);\n      display: grid; grid-template-rows: auto 1fr;\n      gap: 12px;\n    }\n    .presence {\n      position: relative;\n      height: 84px;\n      background: linear-gradient(180deg, rgba(33,33,35,0.72), rgba(24,24,26,0.66));\n      border: 1px solid var(--v2-line);\n      border-radius: 14px;\n      box-shadow: var(--v2-shadow), var(--v2-glow);\n      backdrop-filter: blur(8px);\n      display: flex; align-items: center; gap: 12px; padding: 10px 12px;\n    }\n    .orb {\n      position: relative;\n      width: 56px; height: 56px; border-radius: 50%;\n      background: radial-gradient(60% 60% at 40% 35%, #eaff8a, #b0da2c 60%, #5b8d12);\n      box-shadow: 0 0 0 2px rgba(204,255,54,0.2), 0 18px 28px rgba(204,255,54,0.16), inset 0 1px 0 rgba(255,255,255,0.5);\n      overflow: hidden;\n      animation: breathe 3.4s ease-in-out infinite;\n    }\n    .orb::after {\n      content: \"\";\n      position: absolute; inset: -20%;\n      background: conic-gradient(from 0deg, rgba(255,255,255,0.16), rgba(255,255,255,0) 30%, rgba(255,255,255,0.18), rgba(255,255,255,0) 60%, rgba(255,255,255,0.16));\n      mix-blend-mode: soft-light;\n      animation: spin 8s linear infinite;\n    }\n    @keyframes breathe { 0%,100% { transform: scale(0.98) } 50% { transform: scale(1.02) } }\n    @keyframes spin { 0% { transform: rotate(0) } 100% { transform: rotate(360deg) } }\n\n    .presence .meta {\n      display: grid; gap: 4px;\n    }\n    .presence .meta .title {\n      font-weight: 600; letter-spacing: 0.02em; font-size: var(--v2-fs-md);\n    }\n    .presence .meta .sub {\n      font-size: var(--v2-fs-sm); color: var(--v2-dim);\n    }\n\n    .inspector {\n      position: relative;\n      background: linear-gradient(180deg, rgba(33,33,35,0.72), rgba(24,24,26,0.66));\n      border: 1px solid var(--v2-line);\n      border-radius: 14px;\n      box-shadow: var(--v2-shadow), var(--v2-glow);\n      backdrop-filter: blur(8px);\n      padding: 12px;\n      display: grid; grid-auto-rows: min-content; gap: 10px;\n    }\n    .ins-title {\n      font-size: var(--v2-fs-lg); font-weight: 700;\n      letter-spacing: 0.02em;\n    }\n    .prop {\n      display: grid; grid-template-columns: 1fr auto; align-items: center;\n      font-size: var(--v2-fs-sm);\n      padding: 6px 8px;\n      border-radius: var(--v2-radius-sm);\n      border: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(40,40,42,0.5), rgba(28,28,30,0.45));\n    }\n    .prop .k { color: var(--v2-dim); }\n    .prop .v { font-family: var(--font-mono); }\n\n    /* Composer pill */\n    .composer {\n      position: absolute; left: 50%; transform: translateX(-50%);\n      bottom: 16px;\n      height: 52px;\n      display: inline-flex; align-items: center; gap: 12px;\n      padding: 0 16px;\n      background: linear-gradient(180deg, rgba(33,33,35,0.8), rgba(24,24,26,0.76));\n      border: 1px solid var(--v2-line-strong);\n      border-radius: var(--v2-radius-pill);\n      box-shadow: 0 12px 28px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06), inset 0 1px 0 rgba(255,255,255,0.08);\n      backdrop-filter: blur(10px);\n      cursor: pointer;\n      transition: transform 0.2s ease, box-shadow 0.2s ease;\n      color: var(--v2-text);\n    }\n    .composer:hover { transform: translateX(-50%) translateY(-2px); box-shadow: 0 18px 36px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.08), inset 0 1px 0 rgba(255,255,255,0.1); }\n    .composer .glow {\n      position: absolute; inset: -2px;\n      border-radius: var(--v2-radius-pill);\n      background: radial-gradient(80% 100% at 50% 120%, rgba(204,255,54,0.18), transparent 60%);\n      filter: blur(8px);\n      z-index: -1;\n      animation: hoverglow 2.8s ease-in-out infinite;\n    }\n    @keyframes hoverglow { 0%,100% { opacity: 0.35 } 50% { opacity: 0.6 } }\n    .composer .spark {\n      width: 10px; height: 10px; border-radius: 8px;\n      background: var(--v2-accent);\n      box-shadow: 0 0 12px rgba(204,255,54,0.6), 0 0 24px rgba(204,255,54,0.3);\n      animation: orbit 3.6s linear infinite;\n    }\n    @keyframes orbit { \n      0% { transform: translateY(0) }\n      25% { transform: translateY(-6px) }\n      50% { transform: translateY(0) }\n      75% { transform: translateY(6px) }\n      100% { transform: translateY(0) }\n    }\n    .composer .text { font-weight: 700; letter-spacing: 0.02em; }\n    .composer .hint { font-size: var(--v2-fs-sm); color: var(--v2-dim) }\n\n    /* Icons */\n    .ic { width: 18px; height: 18px; display: inline-block; }\n    .ic svg { display:block; width:100%; height:100%; }\n\n    /* Utility */\n    .muted { color: var(--v2-dim); }\n    .accent { color: var(--v2-accent); }\n    .sr { position: absolute !important; width:1px; height:1px; clip:rect(1px,1px,1px,1px); overflow:hidden; }\n\n    /* Progressive hairlines */\n    .halo {\n      position:absolute; inset:-1px; border-radius:inherit;\n      box-shadow: 0 0 0 1px rgba(255,255,255,0.06), inset 0 1px 0 rgba(255,255,255,0.06);\n      pointer-events:none;\n    }\n  </style>\n\n  <!-- Top bar -->\n  <div class=\"topbar\">\n    <div class=\"brand\">\n      <div class=\"brand-badge\"></div>\n      <div>MOSH</div>\n    </div>\n\n    <div class=\"transport\">\n      <button class=\"t-btn stop\" id=\"btnStop\" aria-label=\"Stop\">\n        <span class=\"ic\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"7\" y=\"7\" width=\"10\" height=\"10\" rx=\"2\"/></svg>\n        </span>\n      </button>\n      <button class=\"t-btn play glow\" id=\"btnPlay\" aria-label=\"Play\">\n        <span class=\"ic\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M9 7l9 5-9 5z\"/></svg>\n        </span>\n      </button>\n      <button class=\"t-btn rec\" id=\"btnRec\" aria-label=\"Record\">\n        <span class=\"ic\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"5\"/></svg>\n        </span>\n      </button>\n\n      <div class=\"timecode\">\n        <span id=\"barCount\">001·1·1</span>\n        <span class=\"time-bpm\"><span id=\"tempo\">120</span> BPM · 4/4</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Left Tool Rail -->\n  <div class=\"tool-rail\">\n    <div class=\"cap\"></div>\n    <div class=\"tool active\" data-tool=\"select\" title=\"Select (V)\">\n      <span class=\"ic\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M5 3l12 7-5 1 3 7-2 1-3-7-5 3z\"/></svg>\n      </span>\n    </div>\n    <div class=\"tool\" data-tool=\"draw\" title=\"Draw (B)\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 17l5 4 13-13-5-4L3 17zm6.5 2.1l-2.6-2.1 8.5-8.5 2.6 2.1-8.5 8.5z\"/></svg></span>\n    </div>\n    <div class=\"tool\" data-tool=\"split\" title=\"Split (S)\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11 3h2v18h-2zM7 10h4v4H7zM13 10h4v4h-4z\"/></svg></span>\n    </div>\n    <div class=\"tool\" data-tool=\"auto\" title=\"Automation (A)\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 17l4-6 4 3 4-8 6 11-2 1-4-7-4 8-4-3-3 4z\"/></svg></span>\n    </div>\n    <div style=\"flex:1\"></div>\n    <div class=\"tool\" data-tool=\"zoom\" title=\"Zoom (Z)\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M15.5 14h-.8l-.3-.3a6.5 6.5 0 10-1.5 1.5l.3.3v.8l5 5 1.5-1.5-5-5zm-6 0A4.5 4.5 0 1114 9.5 4.5 4.5 0 019.5 14z\"/></svg></span>\n    </div>\n  </div>\n\n  <!-- Stage -->\n  <div class=\"stage\" id=\"stage\">\n    <div class=\"ruler\">\n      <div class=\"ruler-grid\"></div>\n      <div class=\"ruler-labels\">\n        <div>1</div><div>2</div><div>3</div><div>4</div>\n        <div>5</div><div>6</div><div>7</div><div>8</div>\n        <div>9</div><div>10</div><div>11</div><div>12</div>\n        <div>13</div><div>14</div><div>15</div><div>16</div>\n      </div>\n    </div>\n\n    <div class=\"lanes\">\n\n      <!-- Drums -->\n      <div class=\"lane\" data-track=\"Drums\">\n        <div class=\"lane-head\">\n          <div class=\"label\"><span class=\"pill\" style=\"background: var(--v2-clip-drum)\"></span>Drums</div>\n          <div class=\"meters\"><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div></div>\n          <span class=\"halo\"></span>\n        </div>\n        <div class=\"lane-body\">\n          <div class=\"clip drum-clip playing selected\" id=\"clip-drums-a\" style=\"left: calc(var(--v2-head-w) + 6px); width: calc((1000px - var(--v2-head-w)) * 0.24);\">\n            <div class=\"name\">Kit A</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <defs>\n                <linearGradient id=\"gD\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                  <stop offset=\"0%\" stop-color=\"rgba(10,15,4,0.0)\"/>\n                  <stop offset=\"100%\" stop-color=\"rgba(10,15,4,0.18)\"/>\n                </linearGradient>\n              </defs>\n              <rect width=\"400\" height=\"64\" fill=\"url(#gD)\"/>\n              <polyline fill=\"none\" stroke=\"#293a08\" stroke-width=\"2\" points=\"0,42 20,42 20,12 40,12 40,42 60,42 60,18 80,18 80,42 100,42 100,8 120,8 120,42 140,42 140,22 160,22 160,42 180,42 180,10 200,10 200,42 220,42 220,20 240,20 240,42 260,42 260,14 280,14 280,42 300,42 300,8 320,8 320,42 340,42 340,18 360,18 360,42 380,42 380,12 400,12\"></polyline>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n          <div class=\"clip drum-clip\" id=\"clip-drums-b\" style=\"left: calc(var(--v2-head-w) + 6px + (1000px - var(--v2-head-w)) * 0.26); width: calc((1000px - var(--v2-head-w)) * 0.22);\">\n            <div class=\"name\">Fill</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <polyline fill=\"none\" stroke=\"#2a3c0a\" stroke-width=\"2\" points=\"0,32 15,8 30,42 45,22 60,52 75,16 90,46 105,18 120,50 135,14 150,46 165,12 180,44 195,12 210,40 225,10 240,38 255,10 270,36 285,10 300,34 315,10 330,32 345,10 360,30 375,10 390,28 400,10\"></polyline>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Bass -->\n      <div class=\"lane\" data-track=\"Bass\">\n        <div class=\"lane-head\">\n          <div class=\"label\"><span class=\"pill\" style=\"background: #7aa8ff\"></span>Bass</div>\n          <div class=\"meters\"><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div></div>\n          <span class=\"halo\"></span>\n        </div>\n        <div class=\"lane-body\">\n          <div class=\"clip wave-clip\" id=\"clip-bass-a\" style=\"left: calc(var(--v2-head-w) + 6px); width: calc((1000px - var(--v2-head-w)) * 0.28);\">\n            <div class=\"name\">Bassline</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <path d=\"M0 32 C20 10, 40 54, 60 32 S100 10, 120 32 160 54, 180 32 220 10, 240 32 280 54, 300 32 340 10, 360 32 400 54\" fill=\"none\" stroke=\"#7b8194\" stroke-width=\"2\"/>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n          <div class=\"clip wave-clip\" id=\"clip-bass-b\" style=\"left: calc(var(--v2-head-w) + 6px + (1000px - var(--v2-head-w)) * 0.30); width: calc((1000px - var(--v2-head-w)) * 0.18);\">\n            <div class=\"name\">Slide</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <path d=\"M0 48 Q40 12 80 48 T160 48 T240 48 T320 48 T400 48\" fill=\"none\" stroke=\"#8a90a6\" stroke-width=\"2\"/>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Keys -->\n      <div class=\"lane\" data-track=\"Keys\">\n        <div class=\"lane-head\">\n          <div class=\"label\"><span class=\"pill\" style=\"background: #d2d6e6\"></span>Keys</div>\n          <div class=\"meters\"><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div></div>\n          <span class=\"halo\"></span>\n        </div>\n        <div class=\"lane-body\">\n          <div class=\"clip midi-clip\" id=\"clip-keys-a\" style=\"left: calc(var(--v2-head-w) + 6px); width: calc((1000px - var(--v2-head-w)) * 0.24);\">\n            <div class=\"name\">Chords</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <g fill=\"#384050\">\n                <rect x=\"10\" y=\"14\" width=\"24\" height=\"36\" rx=\"3\"/>\n                <rect x=\"46\" y=\"22\" width=\"24\" height=\"28\" rx=\"3\"/>\n                <rect x=\"82\" y=\"10\" width=\"24\" height=\"40\" rx=\"3\"/>\n                <rect x=\"118\" y=\"26\" width=\"24\" height=\"24\" rx=\"3\"/>\n                <rect x=\"154\" y=\"18\" width=\"24\" height=\"32\" rx=\"3\"/>\n                <rect x=\"190\" y=\"22\" width=\"24\" height=\"28\" rx=\"3\"/>\n                <rect x=\"226\" y=\"14\" width=\"24\" height=\"36\" rx=\"3\"/>\n              </g>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n          <div class=\"clip midi-clip\" id=\"clip-keys-b\" style=\"left: calc(var(--v2-head-w) + 6px + (1000px - var(--v2-head-w)) * 0.26); width: calc((1000px - var(--v2-head-w)) * 0.22);\">\n            <div class=\"name\">Arp</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <g fill=\"#384050\">\n                <rect x=\"10\" y=\"40\" width=\"18\" height=\"12\" rx=\"3\"/>\n                <rect x=\"38\" y=\"32\" width=\"18\" height=\"20\" rx=\"3\"/>\n                <rect x=\"66\" y=\"24\" width=\"18\" height=\"28\" rx=\"3\"/>\n                <rect x=\"94\" y=\"16\" width=\"18\" height=\"36\" rx=\"3\"/>\n                <rect x=\"122\" y=\"8\" width=\"18\" height=\"44\" rx=\"3\"/>\n                <rect x=\"150\" y=\"16\" width=\"18\" height=\"36\" rx=\"3\"/>\n                <rect x=\"178\" y=\"24\" width=\"18\" height=\"28\" rx=\"3\"/>\n                <rect x=\"206\" y=\"32\" width=\"18\" height=\"20\" rx=\"3\"/>\n                <rect x=\"234\" y=\"40\" width=\"18\" height=\"12\" rx=\"3\"/>\n              </g>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Vox -->\n      <div class=\"lane\" data-track=\"Vox\">\n        <div class=\"lane-head\">\n          <div class=\"label\"><span class=\"pill\" style=\"background: #ff9eb0\"></span>Vox</div>\n          <div class=\"meters\"><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div><div class=\"meter\"></div></div>\n          <span class=\"halo\"></span>\n        </div>\n        <div class=\"lane-body\">\n          <div class=\"clip wave-clip\" id=\"clip-vox-a\" style=\"left: calc(var(--v2-head-w) + 6px + (1000px - var(--v2-head-w)) * 0.08); width: calc((1000px - var(--v2-head-w)) * 0.20);\">\n            <div class=\"name\">Verse</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <polyline fill=\"none\" stroke=\"#b7bccd\" stroke-width=\"2\" points=\"0,32 10,20 20,42 30,24 40,48 50,32 60,18 70,36 80,20 90,42 100,22 110,38 120,20 130,48 140,26 150,36 160,18 170,46 180,26 190,36 200,18 210,46 220,32 230,36 240,18 250,46 260,30 270,36 280,20 290,42 300,24 310,36 320,20 330,44 340,28 350,36 360,20 370,42 380,24 390,36 400,20\"/>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n          <div class=\"clip wave-clip\" id=\"clip-vox-b\" style=\"left: calc(var(--v2-head-w) + 6px + (1000px - var(--v2-head-w)) * 0.30); width: calc((1000px - var(--v2-head-w)) * 0.18);\">\n            <div class=\"name\">Adlib</div>\n            <svg class=\"wave\" viewBox=\"0 0 400 64\" preserveAspectRatio=\"none\">\n              <path d=\"M0 40 L20 16 L40 48 L60 16 L80 48 L100 16 L120 48 L140 16 L160 48 L180 16 L200 48 L220 16 L240 48 L260 16 L280 48 L300 16 L320 48 L340 16 L360 48 L380 16 L400 48\" fill=\"none\" stroke=\"#a8aeca\" stroke-width=\"2\"/>\n            </svg>\n            <div class=\"sheen\"></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"playhead\" id=\"playhead\"><div class=\"cap\"></div></div>\n    </div>\n  </div>\n\n  <!-- Right Rail -->\n  <div class=\"right-rail\">\n    <div class=\"presence\">\n      <div class=\"orb\"></div>\n      <div class=\"meta\">\n        <div class=\"title\">Ava</div>\n        <div class=\"sub\">Presence · Listening</div>\n      </div>\n    </div>\n\n    <div class=\"inspector\" id=\"inspector\">\n      <div class=\"ins-title\">Inspector</div>\n      <div class=\"prop\"><div class=\"k\">Clip</div><div class=\"v\" id=\"ins-name\">Kit A</div></div>\n      <div class=\"prop\"><div class=\"k\">Track</div><div class=\"v\" id=\"ins-track\">Drums</div></div>\n      <div class=\"prop\"><div class=\"k\">Color</div><div class=\"v\" id=\"ins-color\">Lime</div></div>\n      <div class=\"prop\"><div class=\"k\">Start</div><div class=\"v\" id=\"ins-start\">1.1.1</div></div>\n      <div class=\"prop\"><div class=\"k\">End</div><div class=\"v\" id=\"ins-end\">3.1.1</div></div>\n      <div class=\"prop\"><div class=\"k\">Gain</div><div class=\"v\" id=\"ins-gain\">-2.0 dB</div></div>\n    </div>\n  </div>\n\n  <!-- Composer -->\n  <div class=\"composer\" id=\"composer\">\n    <div class=\"spark\" aria-hidden=\"true\"></div>\n    <div class=\"text\">Compose with Mosh</div>\n    <div class=\"hint\">Ask for a bass drop at bar 9</div>\n    <span class=\"glow\"></span>\n  </div>\n\n  <!-- Film grain SVG -->\n  <svg class=\"grain\" viewBox=\"0 0 1440 900\" preserveAspectRatio=\"none\">\n    <filter id=\"fNoise\">\n      <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.9\" numOctaves=\"2\" stitchTiles=\"stitch\" />\n      <feColorMatrix type=\"saturate\" values=\"0\" />\n      <feComponentTransfer>\n        <feFuncA type=\"table\" tableValues=\"0 0.8 0\"/>\n      </feComponentTransfer>\n    </filter>\n    <rect width=\"1440\" height=\"900\" filter=\"url(#fNoise)\" opacity=\"0.16\"/>\n  </svg>\n\n  <script>\n    (function(){\n      const stage = document.getElementById('stage');\n      const playhead = document.getElementById('playhead');\n      const barCount = document.getElementById('barCount');\n      const tempoEl = document.getElementById('tempo');\n      const btnPlay = document.getElementById('btnPlay');\n      const btnStop = document.getElementById('btnStop');\n      const btnRec = document.getElementById('btnRec');\n      const composer = document.getElementById('composer');\n\n      // Inspector fields\n      const ins = {\n        name: document.getElementById('ins-name'),\n        track: document.getElementById('ins-track'),\n        color: document.getElementById('ins-color'),\n        start: document.getElementById('ins-start'),\n        end: document.getElementById('ins-end'),\n        gain: document.getElementById('ins-gain')\n      };\n\n      // Transport state\n      const state = {\n        tempo: 120,\n        sigBeats: 4,\n        playing: false,\n        rec: false,\n        startMs: 0,\n        offsetMs: 0,\n        loopBars: 16\n      };\n\n      function fmt(n, pad=3){ n = Math.max(1, Math.floor(n)); return String(n).padStart(pad,'0'); }\n\n      // Compute geometry\n      function getTimelineRect(){\n        const headW = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--v2-head-w'));\n        const width = 1000 - headW; // stage max is fixed 1000\n        const left = headW;\n        return { left, width };\n      }\n\n      // Time -> bars, beats, ticks\n      function timeToBars(t){\n        const spb = 60 / state.tempo;\n        const spBar = spb * state.sigBeats;\n        const bars = Math.floor(t / spBar) + 1;\n        const beatFloat = (t % spBar) / spb;\n        const beats = Math.floor(beatFloat) + 1;\n        const ticks = Math.floor(((beatFloat % 1) * 4)) + 1; // quarters for feel\n        return { bars, beats, ticks, spBar };\n      }\n\n      function updateTime(t){\n        const {bars, beats, ticks, spBar} = timeToBars(t);\n        barCount.textContent = `${fmt(bars)}·${beats}·${ticks}`;\n        const r = getTimelineRect();\n        // Playhead position uses external playhead if available\n        let p = (window.__mosh && typeof window.__mosh.playhead === 'number')\n          ? window.__mosh.playhead\n          : ((t % (spBar * state.loopBars)) / (spBar * state.loopBars));\n\n        const x = r.left + p * r.width;\n        playhead.style.transform = `translateX(${x}px)`;\n      }\n\n      function nowSec(){\n        if (window.__mosh && typeof window.__mosh.time === 'number') return window.__mosh.time;\n        if (state.playing) return (performance.now() - state.startMs) / 1000;\n        return state.offsetMs / 1000;\n      }\n\n      function raf(){\n        updateTime(nowSec());\n        requestAnimationFrame(raf);\n      }\n      requestAnimationFrame(raf);\n\n      // Transport controls\n      btnPlay.addEventListener('click', () => {\n        state.playing = !state.playing;\n        if (state.playing){\n          state.startMs = performance.now() - state.offsetMs;\n          btnPlay.classList.add('glow');\n          document.querySelectorAll('.clip').forEach(c => c.classList.toggle('playing', true));\n        } else {\n          state.offsetMs = performance.now() - state.startMs;\n          btnPlay.classList.remove('glow');\n          document.querySelectorAll('.clip').forEach(c => c.classList.toggle('playing', false));\n        }\n      });\n\n      btnStop.addEventListener('click', () => {\n        state.playing = false;\n        state.startMs = performance.now();\n        state.offsetMs = 0;\n        btnPlay.classList.remove('glow');\n        updateTime(0);\n        document.querySelectorAll('.clip').forEach(c => c.classList.toggle('playing', false));\n      });\n\n      btnRec.addEventListener('click', () => {\n        state.rec = !state.rec;\n        btnRec.classList.toggle('active', state.rec);\n      });\n\n      // Clip selection -> Inspector update\n      function setInspector({name, track, color, start, end, gain}){\n        ins.name.textContent = name;\n        ins.track.textContent = track;\n        ins.color.textContent = color;\n        ins.start.textContent = start;\n        ins.end.textContent = end;\n        ins.gain.textContent = gain;\n      }\n      function barsAt(leftPx){\n        const r = getTimelineRect();\n        const p = Math.max(0, Math.min(1, (leftPx - r.left) / r.width));\n        const bar = 1 + Math.floor(p * state.loopBars);\n        return `${fmt(bar)}.1.1`;\n      }\n\n      document.querySelectorAll('.clip').forEach(clip => {\n        clip.addEventListener('click', (e) => {\n          document.querySelectorAll('.clip.selected').forEach(c => c.classList.remove('selected'));\n          clip.classList.add('selected');\n\n          const track = clip.closest('.lane').dataset.track;\n          const rect = clip.getBoundingClientRect();\n          const stageRect = stage.getBoundingClientRect();\n          const startBar = barsAt(rect.left - stageRect.left);\n          const endBar = barsAt(rect.right - stageRect.left);\n          const baseColor = clip.classList.contains('drum-clip') ? 'Lime' :\n                            clip.classList.contains('midi-clip') ? 'Cream' : 'Wave';\n          setInspector({\n            name: clip.querySelector('.name')?.textContent || 'Clip',\n            track,\n            color: baseColor,\n            start: startBar,\n            end: endBar,\n            gain: track === 'Vox' ? '-1.2 dB' : '-2.0 dB'\n          });\n        });\n      });\n\n      // Composer micro-interaction\n      composer.addEventListener('click', () => {\n        // Delight: brief sparkle glow on click\n        composer.style.boxShadow = '0 0 0 2px rgba(204,255,54,0.35), 0 22px 44px rgba(0,0,0,0.7)';\n        setTimeout(()=> composer.style.boxShadow = '', 260);\n      });\n\n      // Initialize inspector from selected\n      document.querySelector('.clip.selected')?.click();\n\n      // Type: ensure display fonts already present via tokens.\n      tempoEl.textContent = state.tempo;\n    })();\n  </script>\n</div>",
