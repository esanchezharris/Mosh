  "source": "<div class=\"frame theme-midnight\" data-seed=\"9s008\">\n  <style>\n    .frame {\n      position: relative;\n      width: 820px;\n      height: 480px;\n      color: var(--v2-text);\n      font-family: var(--font-body);\n      -webkit-font-smoothing: antialiased;\n      background: var(--v2-bg);\n      overflow: hidden;\n      isolation: isolate;\n    }\n\n    /* Atmosphere */\n    .halo {\n      position: absolute;\n      inset: -12% -8% auto -8%;\n      height: 70%;\n      background: radial-gradient(40% 60% at 30% 40%, rgba(204,255,54,0.05), transparent 60%),\n                  radial-gradient(30% 40% at 70% 20%, rgba(255,255,255,0.06), transparent 60%);\n      pointer-events: none;\n      filter: blur(16px);\n    }\n\n    .grain {\n      position: absolute;\n      inset: 0;\n      background-image:\n        radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.03), rgba(0,0,0,0) 60%),\n        radial-gradient(1px 1px at 80% 65%, rgba(255,255,255,0.02), rgba(0,0,0,0) 60%),\n        radial-gradient(1px 1px at 45% 75%, rgba(255,255,255,0.02), rgba(0,0,0,0) 60%);\n      mix-blend-mode: soft-light;\n      opacity: .35;\n      pointer-events: none;\n    }\n\n    /* Theme tokens */\n    .theme-midnight {\n      --bg-elev: var(--v2-surface);\n      --bg-elev-2: var(--v2-surface-2);\n      --line: var(--v2-line);\n      --line-strong: var(--v2-line-strong);\n      --text: var(--v2-text);\n      --dim: var(--v2-dim);\n      --faint: var(--v2-faint);\n      --glass-highlight: rgba(255,255,255,0.06);\n      --glass-shadow: rgba(0,0,0,0.5);\n      --card-bloom: 0 24px 60px rgba(0,0,0,0.55);\n    }\n    .theme-cream {\n      --bg-elev: rgba(248, 246, 240, 0.74);\n      --bg-elev-2: rgba(254, 253, 248, 0.82);\n      --line: rgba(10,10,10,0.08);\n      --line-strong: rgba(10,10,10,0.16);\n      --text: #0c0c0c;\n      --dim: rgba(12,12,12,0.62);\n      --faint: rgba(12,12,12,0.38);\n      --glass-highlight: rgba(255,255,255,0.45);\n      --glass-shadow: rgba(0,0,0,0.12);\n      --card-bloom: 0 16px 44px rgba(0,0,0,0.12);\n    }\n    .frame.theme-cream {\n      background: radial-gradient(130% 90% at 50% -10%, #fbfaf7 0%, #f5f2ea 52%, #f0ecdf 100%);\n    }\n\n    /* Layout */\n    .stage {\n      position: absolute;\n      inset: 24px;\n      display: grid;\n      grid-template-columns: 1.1fr 0.9fr;\n      grid-template-rows: auto 1fr;\n      gap: var(--v2-space-8);\n    }\n\n    .title {\n      grid-column: 1 / -1;\n      height: var(--v2-topbar-h);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 var(--v2-space-8);\n      border-radius: var(--v2-radius-lg);\n      background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0)) , var(--bg-elev);\n      border: 1px solid var(--line);\n      box-shadow: var(--v2-glow), 0 0 0 1px rgba(255,255,255,0.02) inset;\n      overflow: hidden;\n      position: relative;\n    }\n    .title:before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(180deg, rgba(255,255,255,0.12), transparent 24%);\n      opacity: .25;\n      pointer-events: none;\n    }\n    .brand {\n      display: flex;\n      align-items: baseline;\n      gap: 10px;\n    }\n    .brand h1 {\n      font-family: var(--font-display);\n      font-size: var(--v2-fs-xl);\n      letter-spacing: -0.01em;\n      margin: 0;\n    }\n    .brand .badge {\n      padding: 2px 8px;\n      border-radius: var(--v2-radius-pill);\n      font-size: var(--v2-fs-2xs);\n      letter-spacing: var(--v2-tracking-caps);\n      text-transform: uppercase;\n      color: var(--v2-ink);\n      background: linear-gradient(180deg, #ccff36, #b8ec25);\n      box-shadow: 0 0 0 1px rgba(10,15,4,0.36) inset, 0 8px 24px rgba(204,255,54,0.16);\n    }\n    .hint {\n      font-size: var(--v2-fs-sm);\n      color: var(--dim);\n    }\n\n    .panel {\n      border-radius: 18px;\n      padding: 18px;\n      background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0)) , var(--bg-elev-2);\n      border: 1px solid var(--line);\n      box-shadow: var(--card-bloom), var(--v2-glow);\n      position: relative;\n      overflow: hidden;\n    }\n    .panel:after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      background:\n        linear-gradient(180deg, var(--glass-highlight), transparent 22%),\n        linear-gradient(180deg, transparent 70%, rgba(0,0,0,0.12));\n      mix-blend-mode: soft-light;\n    }\n\n    .stack {\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n    }\n    .row {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n    .label {\n      font-size: var(--v2-fs-xs);\n      color: var(--faint);\n      letter-spacing: var(--v2-tracking-caps);\n      text-transform: uppercase;\n      margin-bottom: 2px;\n    }\n\n    /* Buttons */\n    .btn {\n      --h: 42px;\n      height: var(--h);\n      padding: 0 18px;\n      border-radius: var(--v2-radius-pill);\n      border: 1px solid var(--line);\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 600;\n      font-size: var(--v2-fs-md);\n      letter-spacing: .01em;\n      cursor: pointer;\n      position: relative;\n      transition: transform .18s ease, filter .18s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;\n      user-select: none;\n      -webkit-tap-highlight-color: transparent;\n      background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0)) , rgba(36,36,38,0.52);\n      color: var(--text);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 6px 18px var(--glass-shadow);\n      overflow: hidden;\n    }\n    .btn:before {\n      content:\"\";\n      position:absolute;\n      inset: 0;\n      pointer-events: none;\n      background:\n        radial-gradient(120px 60px at var(--sheen-x, -40%) 0%, rgba(255,255,255,0.08), rgba(255,255,255,0) 60%);\n      mix-blend-mode: screen;\n      transition: opacity .3s ease;\n      opacity: var(--sheen-o, 0);\n    }\n    .btn:hover {\n      filter: brightness(1.05);\n    }\n    .btn:active {\n      transform: translateY(0.5px) scale(0.995);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.02), 0 2px 10px var(--glass-shadow);\n    }\n    .btn .ripple {\n      position: absolute;\n      border-radius: 50%;\n      transform: translate(-50%, -50%);\n      pointer-events: none;\n      background: radial-gradient(circle at center, rgba(204,255,54,0.45), rgba(204,255,54,0.12) 40%, rgba(204,255,54,0) 70%);\n      filter: blur(0.2px);\n      animation: ripple .6s ease-out forwards;\n      mix-blend-mode: screen;\n    }\n    @keyframes ripple {\n      from { width: 0; height: 0; opacity: .55; }\n      to { width: 360px; height: 360px; opacity: 0; }\n    }\n\n    .btn.primary {\n      background:\n        linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0.08)),\n        linear-gradient(180deg, #d1ff4c, #b9ef2b);\n      color: var(--v2-accent-ink);\n      border-color: rgba(64,72,16,0.35);\n      box-shadow:\n        inset 0 1px 0 rgba(255,255,255,0.55),\n        0 10px 24px rgba(204,255,54,0.22),\n        0 0 0 1px rgba(138,168,35,0.35);\n    }\n    .btn.primary .dot {\n      width: 8px; height: 8px; border-radius: 50%;\n      background: var(--v2-accent-ink);\n      box-shadow: 0 0 0 1px rgba(10,15,4,0.28) inset;\n    }\n    .btn.ghost {\n      background:\n        linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0)),\n        rgba(30,30,32,0.36);\n      color: var(--text);\n      border: 1px solid var(--line-strong);\n    }\n    .btn.ghost:hover {\n      border-color: rgba(255,255,255,0.24);\n    }\n\n    /* Icon button (small) */\n    .icon-btn {\n      --s: 32px;\n      width: var(--s);\n      height: var(--s);\n      border-radius: var(--v2-radius-pill);\n      border: 1px solid var(--line-strong);\n      background: linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0)), rgba(30,30,32,0.42);\n      display: inline-grid;\n      place-items: center;\n      cursor: pointer;\n      position: relative;\n      transition: filter .18s ease, transform .18s ease, border-color .2s ease;\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 6px 16px var(--glass-shadow);\n      color: var(--text);\n      overflow: hidden;\n    }\n    .icon-btn svg {\n      width: 14px; height: 14px;\n      opacity: 0.92;\n    }\n    .icon-btn:hover { filter: brightness(1.07); border-color: rgba(255,255,255,0.26); }\n    .icon-btn:active { transform: translateY(0.5px) scale(0.98); }\n    .icon-btn .pulse {\n      position: absolute;\n      inset: -6px;\n      border-radius: inherit;\n      background: radial-gradient(220px 120px at 50% 50%, rgba(204,255,54,0.16), transparent 70%);\n      opacity: var(--pulse-o, 0);\n      transition: opacity .2s ease;\n      pointer-events: none;\n      mix-blend-mode: screen;\n    }\n    .icon-btn.active { border-color: rgba(204,255,54,0.55); }\n    .icon-btn.active .pulse { opacity: .55; }\n\n    /* Segmented control */\n    .seg {\n      --h: 40px;\n      height: var(--h);\n      border-radius: var(--v2-radius-pill);\n      border: 1px solid var(--line-strong);\n      position: relative;\n      display: inline-grid;\n      grid-auto-flow: column;\n      gap: 0;\n      background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0)), rgba(28,28,30,0.42);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 8px 20px var(--glass-shadow);\n      overflow: hidden;\n    }\n    .seg .thumb {\n      position: absolute;\n      top: 2px; bottom: 2px;\n      width: calc((100% - 4px) / 3);\n      left: 2px;\n      border-radius: var(--v2-radius-pill);\n      background:\n        linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0.12)),\n        linear-gradient(180deg, rgba(204,255,54,0.22), rgba(204,255,54,0.06));\n      box-shadow:\n        inset 0 1px 0 rgba(255,255,255,0.65),\n        0 6px 18px rgba(204,255,54,0.18),\n        0 0 0 1px rgba(255,255,255,0.14);\n      transition: transform .28s cubic-bezier(.2,.8,.2,1), width .28s ease;\n      pointer-events: none;\n    }\n    .seg .seg-item {\n      min-width: 104px;\n      padding: 0 14px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n      z-index: 1;\n      color: var(--dim);\n      font-weight: 600;\n      font-size: var(--v2-fs-md);\n      cursor: pointer;\n      user-select: none;\n      transition: color .2s ease, filter .2s ease;\n    }\n    .seg .seg-item:hover { filter: brightness(1.15); }\n    .seg .seg-item.active { color: var(--v2-ink); }\n    .seg .seg-item .k {\n      font-family: var(--font-mono);\n      font-size: var(--v2-fs-xs);\n      opacity: .7;\n      margin-right: 8px;\n    }\n\n    /* Toggle switch */\n    .toggle {\n      --w: 64px;\n      --h: 34px;\n      position: relative;\n      width: var(--w); height: var(--h);\n      border-radius: var(--v2-radius-pill);\n      border: 1px solid var(--line-strong);\n      background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0)), rgba(28,28,30,0.44);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 6px 18px var(--glass-shadow);\n      cursor: pointer;\n      transition: filter .2s ease, border-color .2s ease, background .2s ease;\n      overflow: hidden;\n    }\n    .toggle .knob {\n      position: absolute;\n      top: 2px; left: 2px;\n      width: calc(var(--h) - 4px);\n      height: calc(var(--h) - 4px);\n      border-radius: var(--v2-radius-pill);\n      background: linear-gradient(180deg, rgba(255,255,255,0.65), rgba(255,255,255,0.18));\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.85), 0 6px 16px var(--glass-shadow), 0 0 0 1px rgba(255,255,255,0.16);\n      transition: transform .26s cubic-bezier(.2,.8,.2,1), box-shadow .26s ease, background .26s ease;\n    }\n    .toggle.on {\n      border-color: rgba(204,255,54,0.55);\n      background:\n        linear-gradient(180deg, rgba(204,255,54,0.22), rgba(204,255,54,0.06)),\n        rgba(28,28,30,0.44);\n    }\n    .toggle.on .knob {\n      transform: translateX(calc(var(--w) - var(--h)));\n      box-shadow:\n        inset 0 1px 0 rgba(255,255,255,0.85),\n        0 8px 20px rgba(204,255,54,0.35),\n        0 0 0 1px rgba(204,255,54,0.38);\n      background: linear-gradient(180deg, #ffffff, rgba(255,255,255,0.38));\n    }\n    .toggle .aura {\n      position: absolute;\n      inset: -10px;\n      border-radius: inherit;\n      background: radial-gradient(220px 120px at var(--mx,50%) 50%, rgba(204,255,54,0.2), transparent 60%);\n      opacity: 0;\n      transition: opacity .3s ease;\n      mix-blend-mode: screen;\n      pointer-events: none;\n    }\n    .toggle.on .aura { opacity: .55; }\n\n    .toggle-label {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      color: var(--dim);\n      font-weight: 600;\n      font-size: var(--v2-fs-md);\n      user-select: none;\n    }\n    .toggle-label strong { color: var(--text); }\n\n    /* Divider hairlines */\n    .hairline {\n      height: 1px;\n      background: linear-gradient(90deg, transparent, var(--line), transparent);\n      margin: 8px 0;\n    }\n\n    /* Footer micro copy */\n    .micro {\n      font-size: var(--v2-fs-xs);\n      color: var(--faint);\n      letter-spacing: .02em;\n    }\n  </style>\n\n  <div class=\"halo\"></div>\n  <div class=\"grain\"></div>\n\n  <div class=\"stage\">\n    <div class=\"title\">\n      <div class=\"brand\">\n        <h1>Controls</h1>\n        <div class=\"badge\">Mosh</div>\n      </div>\n      <div class=\"hint\">Midnight Drive • Sacred Lime • Calm Minimal</div>\n    </div>\n\n    <div class=\"panel stack\">\n      <div class=\"group\">\n        <div class=\"label\">Buttons</div>\n        <div class=\"row\">\n          <button class=\"btn primary\" id=\"btn-primary\" aria-label=\"Primary action\">\n            <div class=\"dot\"></div>\n            <span>ELEVATE</span>\n          </button>\n\n          <button class=\"btn ghost\" aria-label=\"Ghost action\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M10 3v14M3 10h14\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            </svg>\n            <span>Ghost</span>\n          </button>\n\n          <button class=\"icon-btn\" id=\"icon-btn\" aria-label=\"Micro action\">\n            <div class=\"pulse\"></div>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n              <path d=\"M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M19.1 4.9l-2.8 2.8M7.7 16.3l-2.8 2.8\"/>\n              <circle cx=\"12\" cy=\"12\" r=\"3.2\"/>\n            </svg>\n          </button>\n        </div>\n      </div>\n\n      <div class=\"hairline\"></div>\n\n      <div class=\"group\">\n        <div class=\"label\">Modes</div>\n        <div class=\"row\">\n          <div class=\"seg\" role=\"tablist\" aria-label=\"Editor mode\" id=\"seg\">\n            <div class=\"thumb\" aria-hidden=\"true\"></div>\n            <div class=\"seg-item active\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\" data-i=\"0\"><span class=\"k\">D</span>Draw</div>\n            <div class=\"seg-item\" role=\"tab\" aria-selected=\"false\" tabindex=\"0\" data-i=\"1\"><span class=\"k\">E</span>Edit</div>\n            <div class=\"seg-item\" role=\"tab\" aria-selected=\"false\" tabindex=\"0\" data-i=\"2\"><span class=\"k\">M</span>Mix</div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"hairline\"></div>\n\n      <div class=\"group\">\n        <div class=\"label\">Theme</div>\n        <div class=\"row\">\n          <div class=\"toggle-label\">\n            <strong>Midnight</strong>\n            <div class=\"toggle\" id=\"themeToggle\" role=\"switch\" aria-checked=\"false\">\n              <div class=\"aura\"></div>\n              <div class=\"knob\"></div>\n            </div>\n            <span>Cream</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"hairline\"></div>\n      <div class=\"micro\">Micro-interactions: gentle sheen on primary, pulse-synced icon, magnetic aura on toggle, and gliding segment thumb.</div>\n    </div>\n\n    <div class=\"panel stack\">\n      <div class=\"group\">\n        <div class=\"label\">Preview</div>\n        <div class=\"row\" style=\"gap:16px; flex-wrap: nowrap;\">\n          <button class=\"btn ghost\" style=\"--h:38px; padding:0 14px;\" aria-label=\"Secondary\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M4 6h12M4 10h12M4 14h8\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n            </svg>\n            <span>List</span>\n          </button>\n\n          <div class=\"seg\" style=\"--h:36px;\">\n            <div class=\"thumb\" aria-hidden=\"true\" style=\"width: calc((100% - 4px)/2);\"></div>\n            <div class=\"seg-item active\" data-i=\"0\">A/B</div>\n            <div class=\"seg-item\" data-i=\"1\">All</div>\n          </div>\n\n          <button class=\"btn primary\" style=\"--h:38px; padding:0 16px;\" aria-label=\"Commit\">\n            <span>Commit</span>\n          </button>\n        </div>\n      </div>\n      <div class=\"hairline\"></div>\n      <div class=\"group\">\n        <div class=\"label\">State Hints</div>\n        <div class=\"row\">\n          <button class=\"btn ghost\" disabled style=\"opacity:.5; cursor:not-allowed;\">Disabled</button>\n          <div class=\"toggle on\" aria-checked=\"true\" style=\"pointer-events:none;\">\n            <div class=\"aura\" style=\"opacity:.35\"></div>\n            <div class=\"knob\"></div>\n          </div>\n          <button class=\"icon-btn active\" aria-label=\"Active tiny\">\n            <div class=\"pulse\"></div>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n              <path d=\"M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M19.1 4.9l-2.8 2.8M7.7 16.3l-2.8 2.8\"/>\n              <circle cx=\"12\" cy=\"12\" r=\"3.2\"/>\n            </svg>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function(){\n      const frame = document.querySelector('.frame');\n      const primary = document.getElementById('btn-primary');\n      const iconBtn = document.getElementById('icon-btn');\n      const seg = document.getElementById('seg');\n      const segItems = [...seg.querySelectorAll('.seg-item')];\n      const thumb = seg.querySelector('.thumb');\n      const themeToggle = document.getElementById('themeToggle');\n\n      // Ripple for buttons\n      function addRipple(e, el){\n        const r = document.createElement('span');\n        r.className = 'ripple';\n        const rect = el.getBoundingClientRect();\n        r.style.left = (e.clientX - rect.left) + 'px';\n        r.style.top = (e.clientY - rect.top) + 'px';\n        el.appendChild(r);\n        r.addEventListener('animationend', ()=> r.remove());\n      }\n      document.querySelectorAll('.btn, .icon-btn').forEach(btn=>{\n        btn.addEventListener('pointerdown', (e)=> addRipple(e, btn));\n      });\n\n      // Segmented control logic\n      function setSeg(i){\n        segItems.forEach((it,idx)=>{\n          const on = idx === i;\n          it.classList.toggle('active', on);\n          it.setAttribute('aria-selected', on ? 'true' : 'false');\n        });\n        const w = seg.clientWidth - 4;\n        const per = w / segItems.length;\n        thumb.style.transform = `translateX(${2 + per * i}px)`;\n      }\n      segItems.forEach(it=>{\n        it.addEventListener('click', ()=> setSeg(+it.dataset.i));\n        it.addEventListener('keydown', (e)=> {\n          if(e.key==='Enter' || e.key===' '){ e.preventDefault(); setSeg(+it.dataset.i); }\n        });\n      });\n      setSeg(0);\n\n      // Theme toggle\n      function setTheme(on){\n        themeToggle.classList.toggle('on', on);\n        themeToggle.setAttribute('aria-checked', on ? 'true':'false');\n        frame.classList.toggle('theme-cream', on);\n        frame.classList.toggle('theme-midnight', !on);\n      }\n      themeToggle.addEventListener('click', ()=> setTheme(!themeToggle.classList.contains('on')));\n      themeToggle.addEventListener('pointermove', (e)=>{\n        const rect = themeToggle.getBoundingClientRect();\n        const x = (e.clientX - rect.left) / rect.width * 100;\n        themeToggle.style.setProperty('--mx', x + '%');\n      });\n\n      // Micro sync with transport: sheen + pulse\n      let t0;\n      function tick(ts){\n        if(!t0) t0 = ts;\n        const playTime = (window.__mosh && typeof window.__mosh.time === 'number') ? window.__mosh.time : (ts - t0)/1000;\n        const beat = Math.sin(playTime * Math.PI * 2 * 0.5) * 0.5 + 0.5; // slow 0.5 Hz\n        // Primary sheen sweeps subtly on beats\n        const sweep = ((playTime * 14) % 140) - 40; // -40% .. 100%\n        primary.style.setProperty('--sheen-x', sweep + '%');\n        primary.style.setProperty('--sheen-o', (0.15 + beat * 0.15).toFixed(3));\n\n        // Icon pulse breathes with beat or when active\n        const isActive = iconBtn.classList.contains('active');\n        const pulseO = isActive ? (0.35 + beat * 0.4) : (0.12 + beat * 0.18);\n        iconBtn.style.setProperty('--pulse-o', pulseO.toFixed(3));\n\n        requestAnimationFrame(tick);\n      }\n      requestAnimationFrame(tick);\n\n      // Toggle icon active on click for demo delight\n      iconBtn.addEventListener('click', ()=> iconBtn.classList.toggle('active'));\n\n      // Initialize\n      setTheme(false);\n    })();\n  </script>\n</div>",
