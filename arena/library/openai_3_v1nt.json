an>\n  </button>\n</div>\n\n<style>\n#mosh-frame {\n  position: relative;\n  width: 1440px; height: 900px;\n  overflow: hidden;\n  color: var(--v2-text);\n  font-family: var(--font-body);\n  background: var(--v2-bg);\n}\n.bg .vignette {\n  position: absolute; inset: -20px;\n  background:\n    radial-gradient(90% 60% at 50% -10%, rgba(204,255,54,0.05), transparent 60%),\n    radial-gradient(70% 50% at 10% 0%, rgba(107,255,119,0.04), transparent 60%),\n    radial-gradient(60% 40% at 90% 0%, rgba(204,255,54,0.04), transparent 70%);\n  pointer-events: none;\n}\n.bg .beams {\n  position: absolute; inset: -10%;\n  background:\n    conic-gradient(from 210deg at 70% -10%, rgba(204,255,54,0.06), transparent 25%),\n    conic-gradient(from 150deg at 20% -10%, rgba(160,255,160,0.05), transparent 30%);\n  mix-blend-mode: screen;\n  animation: beams 18s linear infinite;\n  filter: blur(10px) saturate(110%);\n}\n@keyframes beams { to { transform: rotate(360deg); } }\n.bg .grain {\n  position: absolute; inset: 0;\n  background-image:\n    radial-gradient(1200px 500px at 50% 120%, rgba(204,255,54,0.05), transparent 60%);\n  mix-blend-mode: overlay;\n  opacity: .5; pointer-events: none;\n}\n\n.topbar {\n  position: absolute; left: 0; right: 0; top: 0; height: var(--v2-topbar-h);\n  display: grid; grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  z-index: 10;\n}\n.topbar .brand {\n  display: flex; align-items: center; gap: var(--v2-space-4);\n  padding-left: 20px;\n}\n.brand .badge {\n  width: 14px; height: 14px; border-radius: 50%;\n  background: radial-gradient(circle at 30% 30%, #fff, #ccff36 40%, #4b5c1a 60%);\n  box-shadow: 0 0 0 2px rgba(204,255,54,0.1), 0 0 14px rgba(204,255,54,0.35);\n  animation: pulse 2.2s ease-in-out infinite;\n}\n@keyframes pulse {\n  0%, 100% { transform: scale(1); box-shadow: 0 0 0 2px rgba(204,255,54,0.10), 0 0 14px rgba(204,255,54,0.35); }\n  50% { transform: scale(1.08); box-shadow: 0 0 0 4px rgba(204,255,54,0.18), 0 0 22px rgba(204,255,54,0.55); }\n}\n.brand .logo {\n  font-family: var(--font-display);\n  letter-spacing: var(--v2-tracking-caps);\n  font-size: 18px; line-height: 1;\n  color: var(--v2-text);\n  text-shadow: 0 0 12px rgba(204,255,54,0.18);\n  position: relative;\n}\n.brand .logo::after {\n  content: \"\";\n  position: absolute; left: -6px; right: -10px; bottom: -6px; height: 2px;\n  background: linear-gradient(90deg, transparent, rgba(204,255,54,0.35), transparent);\n  filter: blur(0.3px);\n}\n\n.topbar .transport {\n  position: relative; display: flex; align-items: center; gap: 12px;\n  padding: 8px 12px; border-radius: var(--v2-radius-pill);\n  background: linear-gradient(180deg, rgba(30,30,32,.8), rgba(18,18,20,.7));\n  box-shadow: var(--v2-shadow), var(--v2-glow), inset 0 0 0 1px rgba(255,255,255,.05);\n  backdrop-filter: blur(8px);\n}\n.tbtn {\n  width: 34px; height: 34px; border-radius: 50%;\n  display: grid; place-items: center;\n  background: radial-gradient(100% 100% at 50% 0%, rgba(255,255,255,0.08), rgba(0,0,0,0.3));\n  border: 1px solid var(--v2-line-strong);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 6px 14px rgba(0,0,0,0.35);\n  transition: transform .12s ease, box-shadow .2s ease, background .2s ease;\n}\n.tbtn:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 10px 20px rgba(0,0,0,0.45); }\n.tbtn svg { width: 16px; height: 16px; fill: var(--v2-dim); stroke: var(--v2-dim); }\n.tbtn.play.playing svg path { fill: var(--v2-accent); filter: drop-shadow(0 0 6px rgba(204,255,54,0.65)); }\n.tbtn.stop svg rect { fill: rgba(235,235,238,0.75); }\n.tbtn.rec svg circle { fill: var(--v2-rec); filter: drop-shadow(0 0 6px rgba(255,59,92,0.6)); }\n.time {\n  position: relative; display: flex; align-items: center; gap: 10px;\n  padding-left: 10px; margin-left: 4px;\n}\n.time::before {\n  content: \"\"; position: absolute; left: 0; top: 8px; bottom: 8px; width: 1px; background: var(--v2-line-strong);\n}\n.time .time-glow {\n  position: absolute; inset: -8px -14px; pointer-events: none;\n  background: radial-gradient(40% 60% at 60% 50%, rgba(204,255,54,0.12), transparent 60%);\n  opacity: .9; filter: blur(10px);\n}\n.time-readout {\n  font-family: var(--font-mono); font-size: 16px;\n  letter-spacing: .06em; color: var(--v2-text);\n  text-shadow: 0 0 14px rgba(204,255,54,0.35);\n}\n.time .tempo {\n  font-size: 11px; color: var(--v2-dim);\n}\n.topbar .topbar-gloss {\n  position: absolute; left: 0; right: 0; bottom: 0; height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);\n  opacity: .6;\n}\n\n.left-rail {\n  position: absolute; top: var(--v2-topbar-h); bottom: 0; left: 0; width: 64px;\n  display: flex; flex-direction: column; align-items: center; padding-top: 14px; gap: 10px;\n  background: linear-gradient(180deg, rgba(20,20,22,.55), rgba(12,12,14,.55));\n  border-right: 1px solid var(--v2-line-strong);\n  backdrop-filter: blur(6px);\n}\n.left-rail .tool {\n  width: 42px; height: 42px; border-radius: 12px;\n  background: radial-gradient(100% 100% at 50% 10%, rgba(255,255,255,0.06), rgba(0,0,0,0.4));\n  border: 1px solid var(--v2-line);\n  display: grid; place-items: center;\n  transition: transform .12s ease, box-shadow .2s ease, border-color .2s ease;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);\n}\n.left-rail .tool:hover { transform: translateY(-1px); border-color: var(--v2-line-strong); }\n.left-rail .tool.active { box-shadow: 0 0 0 1px rgba(204,255,54,.45), inset 0 1px 0 rgba(255,255,255,0.1); background: linear-gradient(180deg, rgba(46,46,50,.85), rgba(18,18,20,.85)); }\n.left-rail .tool svg { width: 18px; height: 18px; fill: none; stroke: var(--v2-dim); }\n.left-rail .tool.active svg { stroke: var(--v2-accent); filter: drop-shadow(0 0 6px rgba(204,255,54,.6)); }\n.rail-glow {\n  margin-top: auto; margin-bottom: 22px; width: 10px; height: 10px; border-radius: 50%;\n  background: radial-gradient(circle at 30% 30%, #fff, #ccff36 45%, #4b5c1a 7