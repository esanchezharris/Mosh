  "source": "<style>\n/* MOSH — Arrangement Shell (1440×900) — Seed: raln8 */\n#mosh {\n  position: relative;\n  width: 1440px;\n  height: 900px;\n  overflow: hidden;\n  font-family: var(--font-body);\n  color: var(--v2-text);\n  background: var(--v2-bg);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* Cinematic ground: aurora + fogPulse + grain vignette */\n#mosh::before, #mosh::after {\n  content: \"\";\n  position: absolute; inset: 0; pointer-events: none;\n}\n#mosh::before {\n  /* Dual animated beams + aurora sweep */\n  background:\n    radial-gradient(60% 40% at 68% -10%, rgba(204,255,54,0.10), transparent 60%),\n    radial-gradient(50% 25% at 30% 0%, rgba(131,160,46,0.08), transparent 70%),\n    conic-gradient(from 210deg at 50% -40%, rgba(204,255,54,0.08), rgba(0,0,0,0) 35%) no-repeat,\n    linear-gradient(110deg, rgba(204,255,54,0.05) 15%, rgba(0,0,0,0) 35%, rgba(204,255,54,0.04) 55%, rgba(0,0,0,0) 75%) no-repeat;\n  mix-blend-mode: screen;\n  animation: beams 18s ease-in-out infinite alternate, aurora 28s ease-in-out infinite;\n  filter: saturate(1.05) contrast(1.02);\n}\n#mosh::after {\n  /* Grain + vignette */\n  background:\n    radial-gradient(120% 85% at 50% -10%, rgba(255,255,255,0.02), rgba(0,0,0,0) 60%),\n    radial-gradient(90% 75% at 50% 120%, rgba(0,0,0,0.55), rgba(0,0,0,0) 45%),\n    repeating-linear-gradient(0deg, rgba(255,255,255,0.02) 0, rgba(255,255,255,0.02) 1px, transparent 1px, transparent 2px);\n  opacity: 0.9;\n  mix-blend-mode: overlay;\n  animation: grain 1.6s steps(2, end) infinite;\n}\n@keyframes beams {\n  0% { background-position: 0 0, 0 0, 10% -60%, -20% 0; }\n  100% { background-position: -10% 0, 5% 0, 30% -30%, 10% 0; }\n}\n@keyframes aurora {\n  0%,100% { filter: blur(0.5px) brightness(1); }\n  50% { filter: blur(0.8px) brightness(1.06); }\n}\n@keyframes grain {\n  0%,100% { transform: translate3d(0,0,0); }\n  50% { transform: translate3d(0.5px, -0.6px, 0); }\n}\n\n/* Elevated glass top bar */\n.topbar {\n  position: absolute; left: 0; right: 0; top: 0; height: var(--v2-topbar-h);\n  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;\n  padding: 0 18px;\n  z-index: 20;\n  backdrop-filter: blur(40px) saturate(1.05);\n  background: linear-gradient(180deg, rgba(26,26,28,0.56), rgba(18,18,20,0.42));\n  box-shadow: 0 30px 60px rgba(0,0,0,0.45);\n  border-bottom: 1px solid rgba(255,255,255,0.05);\n}\n.topbar::after {\n  /* Subtle lime inset line */\n  content:\"\"; position:absolute; left:0; right:0; bottom:-1px; height:1px;\n  background: radial-gradient(80% 50% at 50% 100%, rgba(204,255,54,0.45), rgba(204,255,54,0.0));\n  filter: blur(0.4px);\n  opacity: 0.65;\n}\n\n/* Brand */\n.brand {\n  display: flex; align-items: center; gap: 10px;\n}\n.logo {\n  font-family: var(--font-display);\n  letter-spacing: 0.06em;\n  font-weight: 900;\n  font-size: 18px;\n  color: #e6e7e9;\n  text-shadow: 0 0 28px rgba(204,255,54,0.10), 0 1px 0 rgba(255,255,255,0.08);\n  transform: translateZ(0);\n  position: relative;\n}\n.logo::after {\n  /* Pulse-glow underline */\n  content:\"\"; position:absolute; left:2px; right:2px; bottom:-6px; height:2px;\n  background: linear-gradient(90deg, rgba(204,255,54,0), rgba(204,255,54,0.5), rgba(204,255,54,0));\n  filter: blur(2px);\n  opacity: 0.0;\n  animation: logoPulse 4.6s ease-in-out infinite;\n}\n@keyframes logoPulse {\n  0%,100% { opacity: 0.0; transform: translateY(0); }\n  50% { opacity: 0.45; transform: translateY(0); }\n}\n\n/* Transport cluster */\n.transport {\n  justify-self: center;\n  display: flex; align-items: center; gap: 16px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n  border: 1px solid rgba(255,255,255,0.08);\n  box-shadow: var(--v2-shadow), inset 0 1px 0 rgba(255,255,255,0.06);\n  border-radius: var(--v2-radius-pill);\n  padding: 10px 16px;\n  transform: translateZ(0);\n}\n.ctrls { display: flex; align-items: center; gap: 10px; }\n.btn {\n  --btn-bg: rgba(36,36,38,0.7);\n  --btn-bd: rgba(255,255,255,0.10);\n  width: 36px; height: 28px; border-radius: 12px;\n  display: grid; place-items: center;\n  background: var(--btn-bg);\n  border: 1px solid var(--btn-bd);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 5px 16px rgba(0,0,0,0.35);\n  cursor: pointer; transition: 140ms ease;\n}\n.btn:hover { border-color: rgba(255,255,255,0.18); transform: translateY(-0.5px); }\n.btn:active { transform: translateY(0.5px) scale(0.98); }\n.btn.play { background: linear-gradient(180deg, rgba(50,52,60,0.72), rgba(28,30,34,0.64)); }\n.btn.rec { background: linear-gradient(180deg, rgba(54,24,30,0.72), rgba(32,16,20,0.62)); }\n\n.svg-ic { width: 12px; height: 12px; display: block; }\n.ic-stop rect { fill: #dfe1e6; opacity: 0.9; }\n.ic-play polygon { fill: var(--v2-accent); filter: drop-shadow(0 0 6px rgba(204,255,54,0.35)); }\n.ic-rec circle { fill: var(--v2-rec); filter: drop-shadow(0 0 6px rgba(255,59,92,0.35)); }\n\n.cluster {\n  display: grid; grid-auto-flow: column; align-items: center; gap: 14px;\n  padding-left: 6px;\n}\n.readout {\n  display: grid; grid-auto-flow: column; align-items: baseline; gap: 8px;\n  padding: 2px 10px; border-radius: 10px;\n  background: rgba(12,12,14,0.55);\n  border: 1px solid rgba(255,255,255,0.08);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);\n}\n.time {\n  font-family: var(--font-mono);\n  font-size: 14px;\n  letter-spacing: 0.08em;\n  color: #f3f4f6;\n}\n.sep {\n  width: 1px; height: 18px; background: rgba(255,255,255,0.10); border-radius: 1px;\n}\n.chips { display: flex; gap: 8px; }\n.chip {\n  font-family: var(--font-mono);\n  font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;\n  color: var(--v2-dim);\n  padding: 4px 8px; border-radius: 9px;\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n  border: 1px solid rgba(255,255,255,0.08);\n}\n.chip.bpm { color: #e9ebee; border-color: rgba(204,255,54,0.28); box-shadow: inset 0 0 0 1px rgba(204,255,54,0.12); }\n.chip.live { color: #cfd2d9; }\n\n/* Left tool rail */\n.left-rail {\n  position: absolute; top: var(--v2-topbar-h); bottom: 80px; left: 0; width: 56px;\n  display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 16px 8px;\n  background: linear-gradient(180deg, rgba(20,20,22,0.65), rgba(18,18,20,0.45));\n  border-right: 1px solid rgba(255,255,255,0.06);\n  box-shadow: inset -1px 0 0 rgba(0,0,0,0.35);\n  z-index: 5;\n}\n.tool {\n  width: 40px; height: 36px; border-radius: 12px;\n  display: grid; place-items: center;\n  background: rgba(34,34,36,0.5);\n  border: 1px solid rgba(255,255,255,0.08);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);\n  cursor: pointer;\n  transition: 140ms ease;\n}\n.tool svg { width: 18px; height: 18px; }\n.tool:hover { transform: translateY(-1px); border-color: rgba(255,255,255,0.18); }\n.tool.active {\n  background: linear-gradient(180deg, rgba(204,255,54,0.24), rgba(204,255,54,0.10));\n  border-color: rgba(204,255,54,0.55);\n  box-shadow: 0 0 18px rgba(204,255,54,0.25), inset 0 0 0 1px rgba(204,255,54,0.25);\n}\n.sep-vert {\n  width: 28px; height: 1px; background: rgba(255,255,255,0.08); border-radius: 1px; margin: 6px 0;\n}\n\n/* Right rail */\n.right-rail {\n  position: absolute; top: var(--v2-topbar-h); right: 0; bottom: 80px; width: 260px;\n  display: flex; flex-direction: column; gap: 12px; padding: 16px;\n  background: linear-gradient(180deg, rgba(20,20,22,0.65), rgba(18,18,20,0.45));\n  border-left: 1px solid rgba(255,255,255,0.06);\n  box-shadow: inset 1px 0 0 rgba(0,0,0,0.35);\n  z-index: 5;\n}\n.presence {\n  display: flex; align-items: center; gap: 12px; padding: 10px 12px;\n  background: rgba(28,28,30,0.6); border: 1px solid rgba(255,255,255,0.08);\n  border-radius: var(--v2-radius);\n}\n.orb {\n  width: 28px; height: 28px; border-radius: 50%;\n  background:\n    radial-gradient(40% 40% at 35% 30%, rgba(255,255,255,0.8), rgba(255,255,255,0) 60%),\n    radial-gradient(60% 60% at 70% 70%, rgba(204,255,54,0.55), rgba(204,255,54,0.0) 70%),\n    radial-gradient(100% 100% at 50% 50%, rgba(204,255,54,0.25), rgba(0,0,0,0) 70%),\n    linear-gradient(180deg, rgba(204,255,54,0.25), rgba(204,255,54,0.05));\n  box-shadow: 0 0 0 2px rgba(204,255,54,0.35), 0 0 26px rgba(204,255,54,0.25);\n  animation: orbPulse 3.8s ease-in-out infinite;\n}\n@keyframes orbPulse {\n  0%,100% { transform: translateZ(0) scale(1); box-shadow: 0 0 0 2px rgba(204,255,54,0.35), 0 0 18px rgba(204,255,54,0.18); }\n  50% { transform: translateZ(0) scale(1.06); box-shadow: 0 0 0 3px rgba(204,255,54,0.38), 0 0 30px rgba(204,255,54,0.28); }\n}\n.pres-meta { display: grid; line-height: 1.2; }\n.pres-name { font-weight: 600; font-size: 12px; }\n.pres-state { font-size: 10px; color: var(--v2-dim); }\n\n.inspector {\n  flex: 1;\n  display: grid; gap: 10px;\n  background: rgba(28,28,30,0.6); border: 1px solid rgba(255,255,255,0.08);\n  border-radius: var(--v2-radius);\n  padding: 12px;\n}\n.ins-title { font-size: 11px; color: #cfd2d9; letter-spacing: var(--v2-tracking-caps); text-transform: uppercase; }\n.card {\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 10px; padding: 10px;\n}\n.meta { display: grid; grid-template-columns: 1fr auto; gap: 6px; font-size: 11px; color: var(--v2-dim); }\n.meta strong { color: var(--v2-text); font-weight: 600; }\n\n/* Centered stage */\n.stage {\n  position: absolute; top: calc(var(--v2-topbar-h) + 22px); bottom: 116px;\n  left: 50%; transform: translateX(-50%);\n  width: var(--v2-stage-max);\n  border-radius: var(--v2-radius-lg);\n  overflow: hidden;\n  background: linear-gradient(180deg, rgba(24,24,26,0.66), rgba(18,18,20,0.60));\n  border: 1px solid rgba(255,255,255,0.08);\n  box-shadow: var(--v2-shadow), inset 0 1px 0 rgba(255,255,255,0.05);\n  z-index: 10;\n}\n.stage::before, .stage::after {\n  /* Quiet dual beams across stage */\n  content:\"\"; position:absolute; inset:0; pointer-events:none; mix-blend-mode: screen;\n}\n.stage::before {\n  background: linear-gradient(100deg, rgba(204,255,54,0.05), rgba(0,0,0,0) 25%, rgba(204,255,54,0.04) 65%, rgba(0,0,0,0) 80%);\n  animation: stageBeam 22s ease-in-out infinite alternate;\n}\n.stage::after {\n  background: linear-gradient(280deg, rgba(204,255,54,0.035), rgba(0,0,0,0) 30%, rgba(204,255,54,0.03) 70%, rgba(0,0,0,0) 85%);\n  animation: stageBeam2 30s ease-in-out infinite alternate;\n}\n@keyframes stageBeam { 0%{ background-position:-10% 0 } 100%{ background-position:15% 0 } }\n@keyframes stageBeam2 { 0%{ background-position:20% 0 } 100%{ background-position:-15% 0 } }\n\n/* Ruler */\n.ruler {\n  position: relative; height: var(--v2-ruler-h);\n  background: linear-gradient(180deg, rgba(40,40,44,0.55), rgba(28,28,32,0.55));\n  border-bottom: 1px solid rgba(255,255,255,0.08);\n  display: grid; grid-template-columns: repeat(16, 1fr); /* 16 bars visible */\n}\n.tick {\n  position: relative; border-right: 1px solid rgba(255,255,255,0.06);\n}\n.tick::after {\n  content: attr(data-bar);\n  position: absolute; top: 4px; left: 8px;\n  font-family: var(--font-mono); font-size: 10px; color: var(--v2-dim);\n}\n\n/* Lanes */\n.lanes { position: relative; display: grid; gap: 1px; background: rgba(255,255,255,0.06); }\n.lane {\n  display: grid; grid-template-columns: var(--v2-head-w) 1fr; align-items: stretch;\n  height: var(--v2-lane-h);\n  background: rgba(14,14,16,0.55);\n}\n.lane + .lane { border-top: 1px solid rgba(255,255,255,0.06); }\n\n.head {\n  display: flex; align-items: center; justify-content: space-between; gap: 10px;\n  padding: 0 12px; background: rgba(22,22,24,0.65);\n  border-right: 1px solid rgba(255,255,255,0.08);\n}\n.h-name {\n  font-weight: 700; font-size: 12px; letter-spacing: 0.04em;\n}\n.meter {\n  display: grid; grid-template-columns: repeat(4, 4px); gap: 3px; align-items: center;\n}\n.meter div {\n  width: 4px; height: 14px; border-radius: 3px; background: rgba(204,255,54,0.18);\n  animation: vu 1.2s ease-in-out infinite alternate;\n}\n.meter div:nth-child(2){ animation-delay: .15s }\n.meter div:nth-child(3){ animation-delay: .30s }\n.meter div:nth-child(4){ animation-delay: .45s }\n@keyframes vu {\n  0% { transform: scaleY(0.6); background: rgba(204,255,54,0.14); }\n  100% { transform: scaleY(1); background: rgba(204,255,54,0.35); }\n}\n\n/* Grid in the track area */\n.grid {\n  position: relative;\n  background-image:\n    linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px),\n    linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px);\n  background-size: calc(100% / 16) 100%, calc(100% / 64) 100%;\n}\n\n/* Clips */\n.clips { position: relative; height: 100%; }\n.clip {\n  position: absolute; top: 8px; height: calc(100% - 16px);\n  border-radius: 10px; overflow: hidden;\n  border: 1px solid rgba(255,255,255,0.10);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 12px 26px rgba(0,0,0,0.35);\n}\n.clip.audio { background: var(--v2-clip-block); }\n.clip.midi { background: linear-gradient(180deg, rgba(188,196,214,0.82), rgba(146,154,172,0.62)); }\n.clip.drum { background: linear-gradient(180deg, rgba(204,255,54,0.85), rgba(142,190,26,0.75)); color: var(--v2-accent-ink); }\n.clip .label {\n  position: absolute; top: 6px; left: 8px; font-size: 10px;\n  font-family: var(--font-mono);\n  letter-spacing: 0.06em;\n  color: rgba(255,255,255,0.82);\n  text-shadow: 0 1px 0 rgba(0,0,0,0.45);\n}\n.clip.drum .label { color: var(--v2-accent-ink); }\n\n/* Waveforms / MIDI blocks */\n.wave {\n  position: absolute; left: 0; right: 0; bottom: 0; top: 0; opacity: 0.9;\n  mix-blend-mode: screen;\n}\n.wave svg { width: 100%; height: 100%; display: block; }\n.wave path { stroke: rgba(230,234,244,0.85); stroke-width: 1; fill: none; filter: drop-shadow(0 1px 0 rgba(0,0,0,0.35)); }\n.clip.drum .wave path { stroke: rgba(32,44,8,0.85); }\n.midi-grid {\n  position: absolute; inset: 0; background:\n   repeating-linear-gradient(90deg, rgba(0,0,0,0.08) 0 6px, rgba(0,0,0,0) 6px 14px),\n   repeating-linear-gradient(180deg, rgba(0,0,0,0.12) 0 10px, rgba(0,0,0,0.0) 10px 20px);\n  opacity: 0.35;\n}\n\n/* Playhead */\n.playhead {\n  position: absolute; top: var(--v2-ruler-h); bottom: 0; width: 2px;\n  background: var(--v2-playhead);\n  box-shadow: 0 0 18px rgba(204,255,54,0.45), 0 0 1px rgba(204,255,54,0.9);\n  z-index: 5;\n}\n\n/* AI Composer pill */\n.ai {\n  position: absolute; left: 50%; transform: translateX(-50%);\n  bottom: 20px; z-index: 30;\n  display: inline-flex; align-items: center; gap: 10px;\n  padding: 10px 16px;\n  border-radius: var(--v2-radius-pill);\n  background:\n    linear-gradient(180deg, rgba(204,255,54,0.24), rgba(204,255,54,0.10)),\n    linear-gradient(180deg, rgba(30,32,26,0.8), rgba(20,22,18,0.7));\n  color: var(--v2-ink);\n  border: 1px solid rgba(204,255,54,0.55);\n  box-shadow: 0 10px 36px rgba(204,255,54,0.25), inset 0 0 0 1px rgba(204,255,54,0.25);\n  cursor: pointer;\n  transition: transform 160ms ease, box-shadow 160ms ease;\n  animation: aiFloat 5.2s ease-in-out infinite;\n}\n.ai:hover { transform: translateX(-50%) translateY(-2px); box-shadow: 0 16px 46px rgba(204,255,54,0.32), inset 0 0 0 1px rgba(204,255,54,0.3); }\n.ai:active { transform: translateX(-50%) translateY(0); }\n@keyframes aiFloat {\n  0%,100% { transform: translateX(-50%) translateY(0); }\n  50% { transform: translateX(-50%) translateY(-3px); }\n}\n.ai .spark {\n  width: 18px; height: 18px; border-radius: 50%;\n  background:\n    radial-gradient(55% 55% at 45% 40%, #fff, rgba(255,255,255,0) 60%),\n    radial-gradient(100% 100% at 50% 50%, rgba(204,255,54,0.55), rgba(204,255,54,0.0) 70%);\n  box-shadow: 0 0 0 2px rgba(204,255,54,0.35), 0 0 16px rgba(204,255,54,0.35);\n  animation: spark 3.4s ease-in-out infinite;\n}\n@keyframes spark { 0%,100% { transform: rotate(0deg) } 50% { transform: rotate(12deg) } }\n.ai .label { font-weight: 700; font-size: 12px; letter-spacing: 0.04em; color: #0e1206; }\n.ai .hint {\n  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: #1a240a;\n  opacity: 0.9; padding-left: 8px; border-left: 1px solid rgba(14,18,8,0.25);\n}\n\n/* FogPulse focal gradients */\n.fog {\n  position: absolute; inset: 0; pointer-events: none; z-index: 1;\n  background:\n    radial-gradient(380px 180px at 50% 64px, rgba(204,255,54,0.08), rgba(0,0,0,0)),\n    radial-gradient(260px 130px at 50% calc(100% - 60px), rgba(204,255,54,0.07), rgba(0,0,0,0)),\n    radial-gradient(200px 120px at 96% 140px, rgba(204,255,54,0.06), rgba(0,0,0,0));\n  animation: fogPulse 12s ease-in-out infinite alternate;\n}\n@keyframes fogPulse {\n  0% { filter: blur(0.8px) brightness(1); opacity: 0.9; }\n  100% { filter: blur(1.2px) brightness(1.05); opacity: 1; }\n}\n\n/* Micro shimmer for lime accents */\n.shimmer {\n  position: relative;\n}\n.shimmer::after {\n  content:\"\"; position:absolute; inset: -1px; border-radius: inherit; pointer-events:none;\n  background: linear-gradient(120deg, rgba(255,255,255,0.0) 30%, rgba(255,255,255,0.25) 50%, rgba(255,255,255,0.0) 70%);\n  mix-blend-mode: overlay;\n  transform: translateX(-120%);\n  animation: shimmer 6.5s ease-in-out infinite;\n  opacity: 0.18;\n}\n@keyframes shimmer {\n  0%,100% { transform: translateX(-120%); }\n  50% { transform: translateX(120%); }\n}\n</style>\n\n<div id=\"mosh\">\n  <div class=\"fog\"></div>\n\n  <div class=\"topbar\">\n    <div class=\"brand\">\n      <div class=\"logo\">MOSH</div>\n    </div>\n\n    <div class=\"transport shimmer\">\n      <div class=\"ctrls\">\n        <button class=\"btn stop\" aria-label=\"Stop\">\n          <svg class=\"svg-ic ic-stop\" viewBox=\"0 0 12 12\"><rect x=\"2\" y=\"2\" width=\"8\" height=\"8\" rx=\"1.5\"/></svg>\n        </button>\n        <button class=\"btn play\" aria-label=\"Play\">\n          <svg class=\"svg-ic ic-play\" viewBox=\"0 0 12 12\"><polygon points=\"3,2 10,6 3,10\"/></svg>\n        </button>\n        <button class=\"btn rec\" aria-label=\"Record\">\n          <svg class=\"svg-ic ic-rec\" viewBox=\"0 0 12 12\"><circle cx=\"6\" cy=\"6\" r=\"3.2\"/></svg>\n        </button>\n      </div>\n      <div class=\"cluster\">\n        <div class=\"readout\">\n          <div class=\"time\" id=\"time\">001 · 01 · 000</div>\n        </div>\n        <div class=\"sep\"></div>\n        <div class=\"chips\">\n          <div class=\"chip bpm\" id=\"bpm\">120 BPM</div>\n          <div class=\"chip live\">48k · 24bit LIVE</div>\n        </div>\n      </div>\n    </div>\n\n    <div></div>\n  </div>\n\n  <!-- Left tool rail -->\n  <div class=\"left-rail\">\n    <div class=\"tool active\" title=\"Pointer\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M6 3 L18 12 L12.2 12.6 L14.6 18.8 L12.9 19.5 L10.4 13.3 L7 15 Z\"\n              fill=\"none\" stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/>\n      </svg>\n    </div>\n    <div class=\"tool\" title=\"Draw\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M6 16 C7 14 9 12 12 12 C15 12 17 10 18 8\" fill=\"none\"\n              stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        <circle cx=\"18\" cy=\"8\" r=\"2\" fill=\"rgba(230,234,244,0.9)\"/>\n      </svg>\n    </div>\n    <div class=\"tool\" title=\"Cut\">\n      <svg viewBox=\"0 0 24 24\">\n        <circle cx=\"7\" cy=\"8\" r=\"2.2\" fill=\"none\" stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.5\"/>\n        <circle cx=\"7\" cy=\"16\" r=\"2.2\" fill=\"none\" stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.5\"/>\n        <path d=\"M20 5 L10 12 M20 19 L10 12\" stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      </svg>\n    </div>\n    <div class=\"sep-vert\"></div>\n    <div class=\"tool\" title=\"Loop\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M6 8 H18 M6 16 H18\" stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        <rect x=\"6\" y=\"6\" width=\"2\" height=\"12\" rx=\"1\" fill=\"rgba(230,234,244,0.9)\"/>\n        <rect x=\"16\" y=\"6\" width=\"2\" height=\"12\" rx=\"1\" fill=\"rgba(230,234,244,0.9)\"/>\n      </svg>\n    </div>\n    <div class=\"tool\" title=\"FX\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M12 3 L10 10 L14 10 L12 21\" fill=\"none\" stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\n      </svg>\n    </div>\n    <div class=\"tool\" title=\"Grid\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M4 8 H20 M4 16 H20 M8 4 V20 M16 4 V20\" stroke=\"rgba(230,234,244,0.9)\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n      </svg>\n    </div>\n  </div>\n\n  <!-- Right rail -->\n  <div class=\"right-rail\">\n    <div class=\"presence\">\n      <div class=\"orb\"></div>\n      <div class=\"pres-meta\">\n        <div class=\"pres-name\">Ari · Producer</div>\n        <div class=\"pres-state\">listening · bar 4</div>\n      </div>\n    </div>\n    <div class=\"inspector\">\n      <div class=\"ins-title\">Inspector</div>\n      <div class=\"card\">\n        <div class=\"meta\"><div>Track</div><strong id=\"ins-track\">Drums</strong></div>\n        <div class=\"meta\"><div>Clip</div><strong id=\"ins-clip\">Intro Groove</strong></div>\n        <div class=\"meta\"><div>Start</div><strong id=\"ins-start\">001·01·000</strong></div>\n        <div class=\"meta\"><div>Length</div><strong id=\"ins-len\">2 bars</strong></div>\n      </div>\n      <div class=\"card\">\n        <div class=\"meta\"><div>Gain</div><strong>-2.1 dB</strong></div>\n        <div class=\"meta\"><div>Pan</div><strong>L 8%</strong></div>\n        <div class=\"meta\"><div>FX</div><strong>Bus A · Glue</strong></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Stage: ruler + tracks -->\n  <div class=\"stage\">\n    <div class=\"ruler\">\n      <div class=\"tick\" data-bar=\"1\"></div>\n      <div class=\"tick\" data-bar=\"2\"></div>\n      <div class=\"tick\" data-bar=\"3\"></div>\n      <div class=\"tick\" data-bar=\"4\"></div>\n      <div class=\"tick\" data-bar=\"5\"></div>\n      <div class=\"tick\" data-bar=\"6\"></div>\n      <div class=\"tick\" data-bar=\"7\"></div>\n      <div class=\"tick\" data-bar=\"8\"></div>\n      <div class=\"tick\" data-bar=\"9\"></div>\n      <div class=\"tick\" data-bar=\"10\"></div>\n      <div class=\"tick\" data-bar=\"11\"></div>\n      <div class=\"tick\" data-bar=\"12\"></div>\n      <div class=\"tick\" data-bar=\"13\"></div>\n      <div class=\"tick\" data-bar=\"14\"></div>\n      <div class=\"tick\" data-bar=\"15\"></div>\n      <div class=\"tick\" data-bar=\"16\"></div>\n    </div>\n\n    <div class=\"lanes\">\n      <!-- DRUMS -->\n      <div class=\"lane\">\n        <div class=\"head\">\n          <div class=\"h-name\">Drums</div>\n          <div class=\"meter\"><div></div><div></div><div></div><div></div></div>\n        </div>\n        <div class=\"grid\">\n          <div class=\"clips\">\n            <div class=\"clip drum\" style=\"left:0%; width:25%;\" data-track=\"Drums\" data-clip=\"Intro Groove\" data-start=\"001·01·000\" data-len=\"2 bars\">\n              <div class=\"label\">Intro Groove</div>\n              <div class=\"wave\">\n                <svg viewBox=\"0 0 100 30\" preserveAspectRatio=\"none\">\n                  <path d=\"M0,18 L3,18 L3,12 L6,12 L6,18 L9,18 L9,8 L12,8 L12,18 L15,18 L15,14 L18,14 L18,18 L21,18 L21,10 L24,10 L24,18\n                           L27,18 L27,6 L30,6 L30,18 L33,18 L33,10 L36,10 L36,18 L39,18 L39,14 L42,14 L42,18 L45,18 L45,8 L48,8 L48,18\n                           L51,18 L51,12 L54,12 L54,18 L57,18 L57,10 L60,10 L60,18 L63,18 L63,6 L66,6 L66,18 L69,18 L69,12 L72,12 L72,18\n                           L75,18 L75,10 L78,10 L78,18 L81,18 L81,8 L84,8 L84,18 L87,18 L87,12 L90,12 L90,18 L93,18 L93,6 L96,6 L96,18 L100,18\"/>\n                </svg>\n              </div>\n            </div>\n            <div class=\"clip drum\" style=\"left:25%; width:25%;\" data-track=\"Drums\" data-clip=\"Fill A\" data-start=\"003·01·000\" data-len=\"2 bars\">\n              <div class=\"label\">Fill A</div>\n              <div class=\"wave\">\n                <svg viewBox=\"0 0 100 30\" preserveAspectRatio=\"none\">\n                  <path d=\"M0,20 L5,8 L10,16 L15,10 L20,18 L25,9 L30,17 L35,10 L40,20 L45,8 L50,18 L55,10 L60,20 L65,9 L70,18 L75,12 L80,20 L85,10 L90,18 L95,8 L100,20\"/>\n                </svg>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- BASS -->\n      <div class=\"lane\">\n        <div class=\"head\">\n          <div class=\"h-name\">Bass</div>\n          <div class=\"meter\"><div></div><div></div><div></div><div></div></div>\n        </div>\n        <div class=\"grid\">\n          <div class=\"clips\">\n            <div class=\"clip audio\" style=\"left:0%; width:37.5%;\" data-track=\"Bass\" data-clip=\"Verse Bass\" data-start=\"001·01·000\" data-len=\"3 bars\">\n              <div class=\"label\">Verse Bass</div>\n              <div class=\"wave\">\n                <svg viewBox=\"0 0 100 30\"><path d=\"M0,15 C5,10 10,20 15,15 C20,10 25,20 30,15 C35,12 40,18 45,15 C50,12 55,18 60,15 C65,10 70,20 75,15 C80,12 85,18 90,15 C95,10 100,20 100,20\"/></svg>\n              </div>\n            </div>\n            <div class=\"clip audio\" style=\"left:37.5%; width:25%;\" data-track=\"Bass\" data-clip=\"Turn\" data-start=\"004·01·000\" data-len=\"2 bars\">\n              <div class=\"label\">Turn</div>\n              <div class=\"wave\">\n                <svg viewBox=\"0 0 100 30\"><path d=\"M0,22 C10,8 20,8 30,22 C40,8 50,8 60,22 C70,8 80,8 90,22 100,8 100,8 100,8\"/></svg>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- KEYS -->\n      <div class=\"lane\">\n        <div class=\"head\">\n          <div class=\"h-name\">Keys</div>\n          <div class=\"meter\"><div></div><div></div><div></div><div></div></div>\n        </div>\n        <div class=\"grid\">\n          <div class=\"clips\">\n            <div class=\"clip midi\" style=\"left:12.5%; width:25%;\" data-track=\"Keys\" data-clip=\"Pad Stack\" data-start=\"002·01·000\" data-len=\"2 bars\">\n              <div class=\"label\">Pad Stack</div>\n              <div class=\"midi-grid\"></div>\n            </div>\n            <div class=\"clip midi\" style=\"left:50%; width:25%;\" data-track=\"Keys\" data-clip=\"Stab\" data-start=\"005·01·000\" data-len=\"2 bars\">\n              <div class=\"label\">Stab</div>\n              <div class=\"midi-grid\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- VOX -->\n      <div class=\"lane\">\n        <div class=\"head\">\n          <div class=\"h-name\">Vox</div>\n          <div class=\"meter\"><div></div><div></div><div></div><div></div></div>\n        </div>\n        <div class=\"grid\">\n          <div class=\"clips\">\n            <div class=\"clip audio\" style=\"left:0%; width:50%;\" data-track=\"Vox\" data-clip=\"Lead Take\" data-start=\"001·01·000\" data-len=\"4 bars\">\n              <div class=\"label\">Lead Take</div>\n              <div class=\"wave\">\n                <svg viewBox=\"0 0 100 30\"><path d=\"M0,15 C8,6 12,24 20,15 C28,6 32,24 40,15 C48,6 52,24 60,15 C68,6 72,24 80,15 C88,8 94,22 100,15\"/></svg>\n              </div>\n            </div>\n            <div class=\"clip audio\" style=\"left:50%; width:18.75%;\" data-track=\"Vox\" data-clip=\"Adlib\" data-start=\"005·01·000\" data-len=\"1.5 bars\">\n              <div class=\"label\">Adlib</div>\n              <div class=\"wave\">\n                <svg viewBox=\"0 0 100 30\"><path d=\"M0,16 L10,8 L20,22 L30,10 L40,20 L50,12 L60,18 L70,10 L80,18 L90,12 L100,16\"/></svg>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"playhead\" id=\"playhead\" style=\"left: 0%;\"></div>\n  </div>\n\n  <!-- AI Composer -->\n  <button class=\"ai shimmer\" id=\"ai\">\n    <div class=\"spark\"></div>\n    <div class=\"label\">Composer</div>\n    <div class=\"hint\">Suggest next 8 bars</div>\n  </button>\n</div>\n\n<script>\n(function(){\n  const timeEl = document.getElementById('time');\n  const bpmEl = document.getElementById('bpm');\n  const ph = document.getElementById('playhead');\n  const stage = document.querySelector('.stage');\n  const ticksPerQuarter = 960;\n  let bpm = 120;\n\n  // Hover inspector update on clip focus\n  const ins = {\n    track: document.getElementById('ins-track'),\n    clip: document.getElementById('ins-clip'),\n    start: document.getElementById('ins-start'),\n    len: document.getElementById('ins-len')\n  };\n  document.querySelectorAll('.clip').forEach(c => {\n    c.addEventListener('mouseenter', () => {\n      ins.track.textContent = c.getAttribute('data-track') || '';\n      ins.clip.textContent = c.getAttribute('data-clip') || '';\n      ins.start.textContent = c.getAttribute('data-start') || '';\n      ins.len.textContent = c.getAttribute('data-len') || '';\n    });\n  });\n\n  // Simple playhead/time sync with host clock\n  function pad(n, w){ n = Math.floor(n); return (Array(w).join('0') + n).slice(-w); }\n  function update(){\n    const hostTime = (window.__mosh && typeof window.__mosh.time === 'number') ? window.__mosh.time : performance.now()/1000;\n    const phFrac = (window.__mosh && typeof window.__mosh.playhead === 'number') ? window.__mosh.playhead % 1 : ((hostTime/8) % 1);\n    const tw = stage.clientWidth;\n    ph.style.left = Math.max(0, Math.min(1, phFrac)) * tw + 'px';\n\n    // Derive musical time from hostTime and bpm\n    const qDur = 60 / bpm;\n    const totalQuarters = hostTime / qDur;\n    const bars = Math.floor(totalQuarters / 4) + 1;\n    const beats = Math.floor(totalQuarters % 4) + 1;\n    const quartersFrac = totalQuarters - Math.floor(totalQuarters);\n    const ticks = Math.floor(quartersFrac * ticksPerQuarter);\n    timeEl.textContent = pad(bars,3) + ' · ' + pad(beats,2) + ' · ' + pad(ticks,3);\n\n    requestAnimationFrame(update);\n  }\n  requestAnimationFrame(update);\n\n  // BPM chip click toggles between 120/128 for a subtle live feel\n  bpmEl.addEventListener('click', () => {\n    bpm = (bpm === 120) ? 128 : 120;\n    bpmEl.textContent = bpm + ' BPM';\n  });\n\n  // AI pill micro interaction: nudge fog pulse text below\n  const ai = document.getElementById('ai');\n  ai.addEventListener('click', () => {\n    ai.classList.add('clicked');\n    setTimeout(()=> ai.classList.remove('clicked'), 300);\n  });\n})();\n</script>",
