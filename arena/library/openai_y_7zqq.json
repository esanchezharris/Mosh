  "source": "<div id=\"mosh-frame\">\n  <style>\n    /* Base */\n    * { box-sizing: border-box; }\n    #mosh-frame {\n      position: relative;\n      width: 1440px; height: 900px; overflow: hidden;\n      color: var(--v2-text); font-family: var(--font-body);\n      background: var(--v2-bg);\n      -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;\n    }\n    /* Cinematic atmosphere */\n    #mosh-frame::before, #mosh-frame::after {\n      content:\"\"; position:absolute; inset: -10%;\n      pointer-events:none; mix-blend-mode: screen;\n    }\n    /* Lime aurora sweep */\n    #mosh-frame::before {\n      background:\n        radial-gradient(60% 20% at 50% -5%, rgba(204,255,54,0.18), transparent 60%),\n        conic-gradient(from 210deg at 80% 20%, rgba(204,255,54,0.10), transparent 25% 75%, rgba(204,255,54,0.08), rgba(67,70,72,0.02));\n      filter: blur(24px) saturate(110%);\n      animation: aurora 18s linear infinite;\n    }\n    /* Grain + vignette */\n    #mosh-frame::after {\n      background:\n        radial-gradient(120% 90% at 50% 10%, rgba(0,0,0,0) 0%, rgba(0,0,0,0.2) 65%, rgba(0,0,0,0.6) 100%),\n        repeating-linear-gradient(0deg, rgba(255,255,255,0.02) 0 1px, rgba(0,0,0,0) 1px 2px);\n      mix-blend-mode: normal; opacity: 0.8; pointer-events: none;\n    }\n    @keyframes aurora { 0%{transform:translateY(0)} 50%{transform:translateY(12px)} 100%{transform:translateY(0)} }\n\n    /* Layout primitives */\n    .abs { position: absolute; }\n    .glass { backdrop-filter: blur(14px) saturate(120%); background: linear-gradient(180deg, rgba(28,28,30,0.56), rgba(18,18,20,0.58)); border: 1px solid var(--v2-line); box-shadow: var(--v2-shadow), var(--v2-glow); }\n    .pill { border-radius: var(--v2-radius-pill); }\n    .card { border-radius: var(--v2-radius-lg); }\n    .mono { font-family: var(--font-mono); }\n    .display { font-family: var(--font-display); }\n\n    /* Top Bar */\n    .topbar {\n      position: absolute; left: 0; right: 0; top: 0; height: var(--v2-topbar-h);\n      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;\n      padding: 0 18px;\n      background: linear-gradient(180deg, rgba(18,18,18,0.75), rgba(8,8,8,0.55));\n      border-bottom: 1px solid var(--v2-line-strong);\n      box-shadow: 0 10px 40px rgba(0,0,0,0.35), inset 0 -1px 0 rgba(255,255,255,0.05);\n    }\n    .brand {\n      justify-self: start; display: flex; align-items: center; gap: 10px; height: 100%;\n    }\n    .brand-badge {\n      width: 26px; height: 26px; border-radius: 8px;\n      background:\n        radial-gradient(100% 100% at 30% 30%, rgba(204,255,54,0.18), rgba(204,255,54,0.05) 60%, rgba(0,0,0,0) 100%),\n        linear-gradient(180deg, rgba(40,42,44,0.8), rgba(20,22,24,0.9));\n      border: 1px solid var(--v2-line-strong);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 8px 24px rgba(204,255,54,0.15);\n      position: relative; overflow: hidden;\n    }\n    .brand-badge::after {\n      content:\"\"; position:absolute; inset:-40%;\n      background: conic-gradient(from 0deg, rgba(204,255,54,0.2), transparent 25% 75%, rgba(204,255,54,0.18));\n      animation: spin 12s linear infinite;\n      filter: blur(10px);\n    }\n    @keyframes spin { to { transform: rotate(360deg); } }\n\n    .brand-name {\n      font-size: 18px; letter-spacing: 0.22em; font-weight: 800; color: var(--v2-text);\n      text-transform: uppercase; position: relative; overflow: hidden;\n    }\n    .brand-name::after {\n      content:\"\"; position:absolute; left:-30%; top:0; bottom:0; width: 60%;\n      background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,0.18) 45%, transparent 100%);\n      transform: skewX(-22deg);\n      animation: shine 5.2s ease-in-out infinite;\n    }\n    @keyframes shine { 0%{left:-40%} 30%{left:110%} 100%{left:110%} }\n\n    /* Transport Center */\n    .transport {\n      justify-self: center; display: grid; grid-template-columns: auto auto; gap: 18px; align-items: center;\n      padding: 8px 14px; border-radius: 14px; border: 1px solid var(--v2-line-strong);\n      background: linear-gradient(180deg, rgba(36,36,38,0.66), rgba(20,20,22,0.7));\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 10px 34px rgba(0,0,0,0.5);\n    }\n    .tr-btns { display:flex; gap: 10px; align-items:center; }\n    .btn {\n      width: 36px; height: 36px; border-radius: 11px; border: 1px solid var(--v2-line); position: relative; overflow: hidden;\n      background: linear-gradient(180deg, rgba(44,44,48,0.8), rgba(20,20,22,0.85));\n      box-shadow: 0 6px 16px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.04);\n      display: grid; place-items: center; cursor: default;\n    }\n    .btn:hover { border-color: var(--v2-line-strong); }\n    .btn.play.is-active { box-shadow: 0 0 0 1px rgba(204,255,54,0.25), 0 14px 34px rgba(204,255,54,0.25), inset 0 1px 0 rgba(255,255,255,0.05); }\n    .icon { width: 12px; height: 12px; display: block; }\n    .icon.rec { width: 10px; height: 10px; border-radius: 50%; background: var(--v2-rec); box-shadow: 0 0 0 2px rgba(255,59,92,0.15), 0 0 20px rgba(255,59,92,0.35) }\n    .time {\n      display:flex; align-items:baseline; gap: 10px; padding: 4px 10px 4px 12px; border-radius: 10px;\n      background: linear-gradient(180deg, rgba(18,18,20,0.7), rgba(12,12,14,0.85));\n      border: 1px solid var(--v2-line);\n    }\n    .time .readout {\n      font-family: var(--font-mono); font-weight: 700; font-size: 18px; letter-spacing: 0.06em;\n      text-shadow: 0 0 12px rgba(204,255,54,0.28);\n      color: var(--v2-accent);\n    }\n    .time .bpm { font-size: 11px; color: var(--v2-dim); letter-spacing: 0.08em; }\n\n    /* Right side of top bar: meters */\n    .top-right { justify-self: end; display: flex; align-items: center; gap: 14px; }\n    .mini-meters { display:flex; gap:6px; height: 24px; align-items: end; }\n    .bar { width: 4px; background: linear-gradient(180deg, rgba(204,255,54,0.85), rgba(204,255,54,0.25)); border-radius: 2px 2px 0 0; height: 8px; opacity: 0.8; }\n\n    /* Left Tool Rail (thin) */\n    .left-rail {\n      position: absolute; left: 0; top: var(--v2-topbar-h); bottom: 0; width: 64px;\n      border-right: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(16,16,18,0.76), rgba(10,10,12,0.86));\n      display:flex; flex-direction: column; align-items: center; gap: 12px; padding: 16px 8px;\n    }\n    .tool {\n      width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(42,42,46,0.6), rgba(18,18,22,0.82));\n      display:grid; place-items:center; position:relative; overflow:hidden; cursor: default;\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);\n    }\n    .tool:hover { border-color: var(--v2-line-strong); }\n    .tool.is-active {\n      border-color: rgba(204,255,54,0.45);\n      box-shadow: 0 12px 28px rgba(204,255,54,0.18), inset 0 1px 0 rgba(255,255,255,0.05);\n    }\n    .tool svg { width: 18px; height: 18px; stroke: var(--v2-dim); }\n    .tool.is-active svg { stroke: var(--v2-accent); }\n\n    /* Right Rail */\n    .right-rail {\n      position: absolute; right: 0; top: var(--v2-topbar-h); bottom: 0; width: var(--v2-rail-w);\n      border-left: 1px solid var(--v2-line);\n      background: linear-gradient(180deg, rgba(18,18,20,0.82), rgba(12,12,14,0.86));\n      padding: 16px;\n      display:flex; flex-direction: column; gap: 14px;\n    }\n\n    /* Presence Orb */\n    .presence {\n      position: relative; height: 120px; border-radius: 16px; padding: 16px; overflow: hidden;\n      border: 1px solid var(--v2-line-strong);\n      background: linear-gradient(180deg, rgba(30,30,34,0.6), rgba(16,16,18,0.7));\n      box-shadow: 0 18px 40px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);\n      display:flex; align-items: center; gap: 14px;\n    }\n    .orb {\n      width: 78px; height: 78px; border-radius: 50%; position: relative; flex: none;\n      background:\n        radial-gradient(60% 60% at 35% 30%, rgba(255,255,255,0.15), rgba(255,255,255,0) 60%),\n        conic-gradient(from 0deg, rgba(204,255,54,0.25), rgba(148,210,0,0.18), rgba(60,60,80,0.1), rgba(204,255,54,0.35));\n      border: 1px solid rgba(204,255,54,0.35);\n      box-shadow: inset 0 0 24px rgba(204,255,54,0.35), 0 0 30px rgba(204,255,54,0.18);\n      overflow: hidden;\n    }\n    .orb::after {\n      content:\"\"; position:absolute; inset: -25%;\n      background: conic-gradient(from 180deg, rgba(204,255,54,0.18), transparent 35% 65%, rgba(204,255,54,0.18));\n      filter: blur(10px);\n      animation: orbit 8s linear infinite;\n    }\n    .orb::before {\n      content:\"\"; position: absolute; left: 50%; top: 50%; width: 68%; height: 68%;\n      transform: translate(-50%, -50%);\n      background: radial-gradient(65% 65% at 50% 40%, rgba(255,255,255,0.35), rgba(255,255,255,0.05) 70%, transparent 100%),\n                  repeating-radial-gradient(circle at 50% 50%, rgba(204,255,54,0.25), rgba(204,255,54,0.25) 2px, transparent 3px 6px);\n      border-radius: 50%;\n      mix-blend-mode: screen; opacity: 0.6;\n    }\n    @keyframes orbit { to { transform: rotate(360deg); } }\n    .presence-meta { display:flex; flex-direction: column; gap: 6px; }\n    .presence-label { font-size: var(--v2-fs-sm); letter-spacing: var(--v2-tracking-caps); text-transform: uppercase; color: var(--v2-dim); }\n    .presence-name { font-size: var(--v2-fs-lg); font-weight: 800; }\n    .presence-cta { margin-top: 4px; display: inline-flex; align-items:center; gap: 8px; padding: 6px 10px; border: 1px solid var(--v2-line); border-radius: 10px; background: rgba(255,255,255,0.02); font-size: 11px; color: var(--v2-accent); }\n\n    /* Inspector */\n    .inspector { flex: 1; overflow: hidden; display:flex; flex-direction: column; gap: 10px; }\n    .panel {\n      background: linear-gradient(180deg, rgba(30,30,34,0.6), rgba(16,16,18,0.74));\n      border: 1px solid var(--v2-line-strong); border-radius: 14px; padding: 12px;\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);\n    }\n    .panel h4 { margin: 0 0 8px; font-size: 12px; letter-spacing: var(--v2-tracking-caps); text-transform: uppercase; color: var(--v2-dim); }\n    .kv { display: grid; grid-template-columns: 1fr auto; gap: 6px 10px; align-items: center; font-size: 12px; }\n    .slider { height: 6px; background: rgba(255,255,255,0.06); border-radius: 6px; position: relative; overflow: hidden; }\n    .slider .fill { position: absolute; left: 0; top: 0; bottom: 0; width: 60%; background: linear-gradient(90deg, rgba(204,255,54,0.25), rgba(204,255,54,0.6)); border-radius: 6px; box-shadow: 0 0 16px rgba(204,255,54,0.25); }\n    .tags { display:flex; gap: 8px; flex-wrap: wrap; }\n    .tag { padding: 4px 8px; border-radius: 8px; border: 1px solid var(--v2-line); background: rgba(255,255,255,0.02); font-size: 11px; color: var(--v2-dim); }\n\n    /* Stage (centered timeline) */\n    .stage-wrap {\n      position: absolute; top: calc(var(--v2-topbar-h) + 12px); bottom: 92px; left: 64px; right: var(--v2-rail-w);\n      display: grid; place-items: center;\n    }\n    .stage {\n      width: var(--v2-stage-max); max-width: var(--v2-stage-max); height: 100%;\n      border-radius: 18px;\n      border: 1px solid var(--v2-line-strong);\n      background:\n        linear-gradient(180deg, rgba(26,26,28,0.7), rgba(12,12,14,0.72)),\n        radial-gradient(80% 50% at 50% -30%, rgba(204,255,54,0.08), rgba(0,0,0,0));\n      box-shadow: 0 34px 60px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.05);\n      overflow: hidden; position: relative;\n    }\n    /* Subtle parallax gleam */\n    .stage::before {\n      content:\"\"; position:absolute; inset:0; background:\n        linear-gradient(120deg, rgba(204,255,54,0.06), transparent 22% 78%, rgba(204,255,54,0.04));\n      mix-blend-mode: screen; pointer-events: none;\n    }\n\n    /* Ruler */\n    .ruler {\n      height: var(--v2-ruler-h);\n      border-bottom: 1px solid var(--v2-line-strong);\n      background: linear-gradient(180deg, rgba(14,14,16,0.7), rgba(12,12,14,0.85));\n      position: sticky; top: 0; z-index: 3;\n      display: grid; grid-template-columns: var(--v2-head-w) 1fr;\n    }\n    .ruler .head {\n      border-right: 1px solid var(--v2-line);\n      display:flex; align-items:center; justify-content:center;\n      font-size: 10px; color: var(--v2-dim); letter-spacing: var(--v2-tracking-caps); text-transform: uppercase;\n    }\n    .ruler .grid {\n      position: relative;\n      background:\n        linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px) 0 0 / 62.5px 100%,\n        linear-gradient(90deg, rgba(255,255,255,0.12) 1px, transparent 1px) 0 0 / 125px 100%;\n    }\n    .bar-labels { position: absolute; inset: 0; display: flex; }\n    .bar-labels .bar-l { width: 125px; border-left: 1px solid rgba(255,255,255,0.18); font-size: 10px; color: var(--v2-dim); display:flex; align-items:center; padding-left: 6px; }\n    .bar-labels .bar-l:first-child { border-left: none; }\n\n    /* Tracks */\n    .lanes { position: absolute; left: 0; right: 0; top: var(--v2-ruler-h); bottom: 0; overflow: hidden; }\n    .lane {\n      height: var(--v2-lane-h); display: grid; grid-template-columns: var(--v2-head-w) 1fr;\n      border-bottom: 1px solid var(--v2-line); position: relative;\n      background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0));\n    }\n    .lane:nth-child(odd) { background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(0,0,0,0)); }\n    .lane .lane-head {\n      border-right: 1px solid var(--v2-line);\n      display:flex; align-items: center; gap: 10px; padding: 0 12px;\n    }\n    .track-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--v2-accent); box-shadow: 0 0 0 2px rgba(204,255,54,0.15); }\n    .lane-title { font-weight: 700; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }\n    .lane .clips { position: relative; }\n    /* Bar background in clips area */\n    .clips::before {\n      content:\"\"; position:absolute; inset:0;\n      background:\n        linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px) 0 0 / 62.5px 100%,\n        linear-gradient(90deg, rgba(255,255,255,0.12) 1px, transparent 1px) 0 0 / 125px 100%;\n      pointer-events: none;\n    }\n\n    /* Clip blocks */\n    .clip {\n      position: absolute; height: calc(var(--v2-lane-h) - 16px); top: 8px;\n      border-radius: 10px; border: 1px solid var(--v2-line-strong);\n      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 8px 22px rgba(0,0,0,0.45);\n      overflow: hidden; display:flex; align-items: flex-end;\n    }\n    .clip .label {\n      position: absolute; left: 8px; top: 6px; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--v2-dim);\n      background: rgba(0,0,0,0.25); padding: 2px 6px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08);\n    }\n    .clip.wave { background: var(--v2-clip-block); }\n    .clip.midi { background: linear-gradient(180deg, rgba(182,188,206,0.85), rgba(156,162,182,0.8)); }\n    .clip.drum { background: linear-gradient(180deg, rgba(204,255,54,0.75), rgba(168,218,0,0.8)); color: var(--v2-ink); }\n    .clip .wave {\n      position:absolute; left: 0; right: 0; bottom: 0; top: 0; opacity: 0.9; mix-blend-mode: screen;\n      background-size: 120px 36px; background-position: 0 60%; background-repeat: repeat-x;\n      filter: contrast(1.05) saturate(1.05);\n    }\n    /* Wave SVGs */\n    .wave.a { background-image: url(\"data:image/svg+xml;utf8,\\\n      <svg xmlns='http://www.w3.org/2000/svg' width='120' height='36' viewBox='0 0 120 36'>\\\n        <path d='M0 18 C8 2 16 2 24 18 S40 34 48 18 64 2 72 18 88 34 96 18 112 2 120 18' fill='none' stroke='rgba(236,236,240,0.75)' stroke-width='1.4' stroke-linecap='round'/>\\\n      </svg>\"); }\n    .wave.b { background-image: url(\"data:image/svg+xml;utf8,\\\n      <svg xmlns='http://www.w3.org/2000/svg' width='120' height='36' viewBox='0 0 120 36'>\\\n        <path d='M0 24 L6 22 L12 28 L18 16 L24 24 L30 10 L36 26 L42 14 L48 22 L54 8 L60 24 L66 16 L72 30 L78 18 L84 22 L90 12 L96 24 L102 18 L108 26 L114 16 L120 24' fill='none' stroke='rgba(236,236,240,0.65)' stroke-width='1.2' stroke-linecap='round'/>\\\n      </svg>\"); }\n    .wave.c { background-image: url(\"data:image/svg+xml;utf8,\\\n      <svg xmlns='http://www.w3.org/2000/svg' width='120' height='36' viewBox='0 0 120 36'>\\\n        <polyline points='0,20 10,12 20,24 30,8 40,26 50,10 60,22 70,14 80,20 90,12 100,28 110,16 120,24' fill='none' stroke='rgba(30,30,32,0.55)' stroke-width='1.4' stroke-linecap='round'/>\\\n      </svg>\"); }\n\n    /* Clip beat shimmer aligned to playhead */\n    .clip::after {\n      content:\"\"; position:absolute; top:0; bottom:0; width: 2px; left: calc(var(--progress, 0) * 1%); opacity: 0.6;\n      background: linear-gradient(180deg, rgba(204,255,54,0), rgba(204,255,54,0.9) 50%, rgba(204,255,54,0));\n      box-shadow: 0 0 30px rgba(204,255,54,0.35);\n      transform: translateX(-1px);\n      mix-blend-mode: screen; pointer-events: none;\n    }\n\n    /* Global Playhead */\n    .playhead {\n      position: absolute; z-index: 4; top: var(--v2-ruler-h); bottom: 0; width: 2px;\n      background: linear-gradient(180deg, rgba(204,255,54,0.05), rgba(204,255,54,0.95) 45%, rgba(204,255,54,0.05));\n      box-shadow: 0 0 26px rgba(204,255,54,0.35), 0 0 2px rgba(204,255,54,0.8);\n      transform: translateX(-1px);\n    }\n    .playhead::after {\n      content:\"\"; position:absolute; top: -var(--v2-ruler-h); height: var(--v2-ruler-h); left: -7px; right: -7px; border-radius: 6px 6px 0 0;\n      background: linear-gradient(180deg, rgba(204,255,54,0.85), rgba(204,255,54,0));\n      filter: blur(6px); opacity: 0.5;\n    }\n\n    /* Bottom AI Agent Pill */\n    .agent {\n      position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%);\n      display: flex; align-items: center; gap: 12px;\n      padding: 12px 18px; border-radius: 999px; border: 1px solid rgba(204,255,54,0.35);\n      background: radial-gradient(120% 120% at 50% 0%, rgba(204,255,54,0.12), rgba(10,10,12,0.86)), linear-gradient(180deg, rgba(28,30,30,0.72), rgba(12,12,14,0.9));\n      box-shadow: 0 18px 50px rgba(204,255,54,0.18), inset 0 1px 0 rgba(255,255,255,0.06);\n      color: var(--v2-accent);\n    }\n    .agent .spark {\n      width: 28px; height: 28px; border-radius: 50%;\n      background: radial-gradient(60% 60% at 40% 35%, rgba(255,255,255,0.5), rgba(255,255,255,0.1) 60%, rgba(0,0,0,0)),\n                  conic-gradient(from 0deg, rgba(204,255,54,0.8), rgba(160,240,40,0.8), rgba(204,255,54,0.8));\n      box-shadow: inset 0 0 16px rgba(204,255,54,0.55), 0 0 24px rgba(204,255,54,0.45);\n      animation: spin 5.5s linear infinite;\n    }\n    .agent .text { font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; }\n    .agent .ghost { font-size: 11px; color: var(--v2-ground-dim); letter-spacing: 0.04em; }\n\n    /* Icons (inline) */\n    .i-play, .i-stop { fill: none; stroke: var(--v2-text); stroke-width: 2; }\n    .i-play { transform: translateX(1px); }\n    .i-stop { }\n    .i-rec { }\n\n    /* Micro accents */\n    .beam {\n      position: absolute; left: 0; right: 0; height: 80px; top: 64px; pointer-events: none;\n      background: radial-gradient(60% 80% at 50% 0%, rgba(204,255,54,0.16), rgba(0,0,0,0));\n      filter: blur(14px); opacity: 0.6;\n    }\n\n    /* Focus ring effect */\n    .ring { position: absolute; inset: -1px; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05); }\n  </style>\n\n  <!-- Top Bar -->\n  <div class=\"topbar\">\n    <div class=\"brand\">\n      <div class=\"brand-badge\"></div>\n      <div class=\"brand-name display\">MOSH</div>\n    </div>\n\n    <div class=\"transport\">\n      <div class=\"tr-btns\">\n        <div class=\"btn stop\" title=\"Stop\">\n          <svg class=\"icon i-stop\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><rect x=\"2\" y=\"2\" width=\"8\" height=\"8\" fill=\"currentColor\" style=\"color:var(--v2-text)\"/></svg>\n        </div>\n        <div class=\"btn play is-active\" title=\"Play\">\n          <svg class=\"icon i-play\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><polygon points=\"3,2 10,6 3,10\" fill=\"currentColor\" style=\"color:var(--v2-accent)\"/></svg>\n        </div>\n        <div class=\"btn rec\" title=\"Record\">\n          <div class=\"icon rec\"></div>\n        </div>\n      </div>\n      <div class=\"time\">\n        <div class=\"readout mono\" id=\"barsbeats\">001·01</div>\n        <div class=\"bpm mono\" id=\"bpm-ind\">120 BPM</div>\n      </div>\n    </div>\n\n    <div class=\"top-right\">\n      <div class=\"mini-meters\" id=\"meters\">\n        <div class=\"bar\" style=\"height:12px\"></div>\n        <div class=\"bar\" style=\"height:18px\"></div>\n        <div class=\"bar\" style=\"height:10px\"></div>\n        <div class=\"bar\" style=\"height:16px\"></div>\n        <div class=\"bar\" style=\"height:14px\"></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Left Tool Rail -->\n  <aside class=\"left-rail\">\n    <div class=\"tool is-active\" title=\"Pointer\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 4l10 7-6 1 3 6\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </div>\n    <div class=\"tool\" title=\"Draw\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 19c1-4 3-6 7-10l3-3 3 3-3 3c-4 4-6 6-10 7z\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </div>\n    <div class=\"tool\" title=\"Cut\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 7l8 5-8 5M12 12l8-5M12 12l8 5\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </div>\n    <div class=\"tool\" title=\"Time\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"7\" stroke-width=\"1.6\"/><path d=\"M12 8v5l4 2\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>\n    </div>\n    <div class=\"tool\" title=\"Select Range\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"5\" y=\"5\" width=\"14\" height=\"14\" rx=\"2\" stroke-width=\"1.6\"/><path d=\"M5 10h14M10 5v14\" stroke-width=\"1.2\" opacity=\"0.7\"/></svg>\n    </div>\n  </aside>\n\n  <!-- Right Rail -->\n  <aside class=\"right-rail\">\n    <div class=\"presence\">\n      <div class=\"orb\"></div>\n      <div class=\"presence-meta\">\n        <div class=\"presence-label\">Presence</div>\n        <div class=\"presence-name\">Aurora</div>\n        <div class=\"presence-cta\">Listening… <span class=\"mono\" id=\"presence-pulse\">• • •</span></div>\n      </div>\n    </div>\n\n    <div class=\"inspector\">\n      <div class=\"panel\">\n        <h4>Inspector</h4>\n        <div class=\"kv\"><div>Track</div><div class=\"mono\" id=\"insp-track\">Drums</div></div>\n        <div class=\"kv\"><div>Clip</div><div class=\"mono\" id=\"insp-clip\">Beat A</div></div>\n        <div class=\"kv\"><div>Start</div><div class=\"mono\" id=\"insp-start\">001·01</div></div>\n        <div class=\"kv\"><div>Length</div><div class=\"mono\" id=\"insp-len\">2 bars</div></div>\n      </div>\n      <div class=\"panel\">\n        <h4>Mixer</h4>\n        <div class=\"kv\"><div>Volume</div><div class=\"mono\">-6.2 dB</div></div>\n        <div class=\"slider\"><div class=\"fill\" style=\"width:68%\"></div></div>\n        <div style=\"height:8px\"></div>\n        <div class=\"kv\"><div>Pan</div><div class=\"mono\">L12</div></div>\n        <div class=\"slider\"><div class=\"fill\" style=\"width:42%\"></div></div>\n        <div style=\"height:10px\"></div>\n        <div class=\"tags\">\n          <div class=\"tag\">Sidechain</div>\n          <div class=\"tag\">Humanize</div>\n          <div class=\"tag\">Tight</div>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  <!-- Stage -->\n  <div class=\"stage-wrap\">\n    <div class=\"stage\">\n      <div class=\"beam\"></div>\n      <div class=\"ruler\">\n        <div class=\"head\">Ruler</div>\n        <div class=\"grid\">\n          <div class=\"bar-labels\">\n            <div class=\"bar-l mono\">1</div>\n            <div class=\"bar-l mono\">2</div>\n            <div class=\"bar-l mono\">3</div>\n            <div class=\"bar-l mono\">4</div>\n            <div class=\"bar-l mono\">5</div>\n            <div class=\"bar-l mono\">6</div>\n            <div class=\"bar-l mono\">7</div>\n            <div class=\"bar-l mono\">8</div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"lanes\">\n        <!-- Drums -->\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"track-dot\"></div>\n            <div class=\"lane-title\">Drums</div>\n          </div>\n          <div class=\"clips\">\n            <div class=\"clip drum\" style=\"left: 10px; right: auto; width: calc(125px * 2 - 20px);\" data-start=\"001·01\" data-len=\"2 bars\" data-track=\"Drums\" data-clip=\"Beat A\">\n              <div class=\"label\">Beat A</div>\n              <div class=\"wave c\"></div>\n            </div>\n            <div class=\"clip drum\" style=\"left: calc(125px * 2 + 10px); width: calc(125px * 2 - 20px);\" data-start=\"003·01\" data-len=\"2 bars\" data-track=\"Drums\" data-clip=\"Beat B\">\n              <div class=\"label\">Beat B</div>\n              <div class=\"wave c\"></div>\n            </div>\n            <div class=\"clip drum\" style=\"left: calc(125px * 4 + 10px); width: calc(125px * 2 - 20px);\" data-start=\"005·01\" data-len=\"2 bars\" data-track=\"Drums\" data-clip=\"Fill\">\n              <div class=\"label\">Fill</div>\n              <div class=\"wave c\"></div>\n            </div>\n          </div>\n        </div>\n        <!-- Bass -->\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"track-dot\"></div>\n            <div class=\"lane-title\">Bass</div>\n          </div>\n          <div class=\"clips\">\n            <div class=\"clip midi\" style=\"left: 10px; width: calc(125px * 3 - 20px);\" data-start=\"001·01\" data-len=\"3 bars\" data-track=\"Bass\" data-clip=\"Pulse 1\">\n              <div class=\"label\">Pulse 1</div>\n              <div class=\"wave a\" style=\"opacity:0.45; mix-blend-mode:multiply\"></div>\n            </div>\n            <div class=\"clip midi\" style=\"left: calc(125px * 3 + 10px); width: calc(125px * 2 - 20px);\" data-start=\"004·01\" data-len=\"2 bars\" data-track=\"Bass\" data-clip=\"Pulse 2\">\n              <div class=\"label\">Pulse 2</div>\n              <div class=\"wave a\" style=\"opacity:0.45; mix-blend-mode:multiply\"></div>\n            </div>\n          </div>\n        </div>\n        <!-- Keys -->\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"track-dot\"></div>\n            <div class=\"lane-title\">Keys</div>\n          </div>\n          <div class=\"clips\">\n            <div class=\"clip wave\" style=\"left: calc(125px * 1 + 10px); width: calc(125px * 1 - 20px);\" data-start=\"002·01\" data-len=\"1 bar\" data-track=\"Keys\" data-clip=\"Stab A\">\n              <div class=\"label\">Stab A</div>\n              <div class=\"wave a\"></div>\n            </div>\n            <div class=\"clip wave\" style=\"left: calc(125px * 2 + 10px); width: calc(125px * 1 - 20px);\" data-start=\"003·01\" data-len=\"1 bar\" data-track=\"Keys\" data-clip=\"Stab B\">\n              <div class=\"label\">Stab B</div>\n              <div class=\"wave a\"></div>\n            </div>\n            <div class=\"clip wave\" style=\"left: calc(125px * 5 + 10px); width: calc(125px * 1 - 20px);\" data-start=\"006·01\" data-len=\"1 bar\" data-track=\"Keys\" data-clip=\"Pad Lift\">\n              <div class=\"label\">Pad Lift</div>\n              <div class=\"wave b\"></div>\n            </div>\n          </div>\n        </div>\n        <!-- Vox -->\n        <div class=\"lane\">\n          <div class=\"lane-head\">\n            <div class=\"track-dot\"></div>\n            <div class=\"lane-title\">Vox</div>\n          </div>\n          <div class=\"clips\">\n            <div class=\"clip wave\" style=\"left: calc(125px * 4 + 10px); width: calc(125px * 1.5 - 20px);\" data-start=\"005·01\" data-len=\"1.5 bars\" data-track=\"Vox\" data-clip=\"Phrase A\">\n              <div class=\"label\">Phrase A</div>\n              <div class=\"wave b\"></div>\n            </div>\n            <div class=\"clip wave\" style=\"left: calc(125px * 6 + 10px); width: calc(125px * 1.5 - 20px);\" data-start=\"007·01\" data-len=\"1.5 bars\" data-track=\"Vox\" data-clip=\"Phrase B\">\n              <div class=\"label\">Phrase B</div>\n              <div class=\"wave b\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Global Playhead -->\n      <div class=\"playhead\" id=\"playhead\" style=\"left: calc(var(--v2-head-w) + 0px);\"></div>\n    </div>\n  </div>\n\n  <!-- AI Agent Composer Pill -->\n  <div class=\"agent\">\n    <div class=\"spark\"></div>\n    <div class=\"text\">Agent Composer</div>\n    <div class=\"ghost mono\">“Sketch a drop in bars 5–8”</div>\n  </div>\n\n  <script>\n    (function() {\n      const stage = document.querySelector('.stage');\n      const playhead = document.getElementById('playhead');\n      const barsbeats = document.getElementById('barsbeats');\n      const bpmInd = document.getElementById('bpm-ind');\n      const meters = document.getElementById('meters').children;\n      const presencePulse = document.getElementById('presence-pulse');\n      const inspector = {\n        track: document.getElementById('insp-track'),\n        clip: document.getElementById('insp-clip'),\n        start: document.getElementById('insp-start'),\n        len: document.getElementById('insp-len'),\n      };\n\n      const BPM = 120; const SIG_BEATS = 4; // 4/4\n      const barsTotal = 8;\n      const headW = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--v2-head-w')) || 168;\n      const barW = 125; // from ruler layout (1000px / 8)\n      const timelineLeft = headW;\n      const timelineW = barW * barsTotal;\n\n      // Hover -> inspector updates\n      document.querySelectorAll('.clip').forEach(el=>{\n        el.addEventListener('mouseenter',()=>{\n          inspector.track.textContent = el.dataset.track || '';\n          inspector.clip.textContent = el.dataset.clip || '';\n          inspector.start.textContent = el.dataset.start || '';\n          inspector.len.textContent = el.dataset.len || '';\n        });\n      });\n\n      // Presence pulse\n      let pulseIdx = 0;\n      const pulseSeq = ['•  ·  ·', '• •  ·', '• • •', '· • •', '·  • •', '·  · •', '·  ·  ·'];\n      setInterval(()=>{ presencePulse.textContent = pulseSeq[pulseIdx++ % pulseSeq.length]; }, 260);\n\n      // Equalizer bounce\n      function meter() {\n        const t = (window.__mosh && window.__mosh.time) || performance.now()/1000;\n        for (let i=0;i<meters.length;i++){\n          const ph = Math.sin(t*3 + i*0.7) * 0.5 + 0.5;\n          const h = 8 + ph * 18 + Math.random()*6;\n          meters[i].style.height = h.toFixed(0)+'px';\n          meters[i].style.opacity = (0.65 + ph*0.35).toFixed(2);\n        }\n      }\n\n      // Playhead + readout\n      function formatBarsBeats(time) {\n        const beatsFloat = time * (BPM/60);\n        const totalBeats = Math.floor(beatsFloat);\n        const bars = Math.floor(totalBeats / SIG_BEATS) + 1;\n        const beat = (totalBeats % SIG_BEATS) + 1;\n        return String(bars).padStart(3,'0') + '·' + String(beat).padStart(2,'0');\n      }\n\n      function tick() {\n        const t = (window.__mosh && typeof window.__mosh.time === 'number') ? window.__mosh.time : performance.now()/1000;\n        const ph = (window.__mosh && typeof window.__mosh.playhead === 'number') ? window.__mosh.playhead : ((t/ (barsTotal * (60/BPM)*SIG_BEATS)) % 1);\n        const x = timelineLeft + ph * timelineW;\n        playhead.style.left = x + 'px';\n        barsbeats.textContent = formatBarsBeats(t);\n        bpmInd.textContent = BPM + ' BPM';\n\n        // Align clip shimmer to global playhead within each clip\n        document.querySelectorAll('.clip').forEach(clip=>{\n          const rect = clip.getBoundingClientRect();\n          const stageRect = stage.getBoundingClientRect();\n          const prog = Math.max(0, Math.min(1, (x - (clip.offsetLeft + timelineLeft - headW)) / clip.offsetWidth)) * 100;\n          clip.style.setProperty('--progress', prog);\n        });\n\n        meter();\n        requestAnimationFrame(tick);\n      }\n      requestAnimationFrame(tick);\n    })();\n  </script>\n</div>",
