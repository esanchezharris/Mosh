  "source": "<style>\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\n.mosh-controls {\n  position: absolute;\n  inset: 0;\n  width: 820px;\n  height: 480px;\n  background: var(--v2-bg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-body);\n  overflow: hidden;\n}\n\n.control-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 64px;\n  padding: 48px;\n}\n\n.control-section {\n  display: flex;\n  flex-direction: column;\n  gap: 32px;\n}\n\n.control-group {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.control-label {\n  font-size: var(--v2-fs-2xs);\n  text-transform: uppercase;\n  letter-spacing: var(--v2-tracking-caps);\n  color: var(--v2-faint);\n  font-weight: 600;\n}\n\n/* Primary Button */\n.btn-primary {\n  position: relative;\n  height: 48px;\n  padding: 0 28px;\n  background: var(--v2-accent);\n  color: var(--v2-accent-ink);\n  border: none;\n  border-radius: var(--v2-radius-sm);\n  font-size: var(--v2-fs-base);\n  font-weight: 600;\n  font-family: var(--font-body);\n  cursor: pointer;\n  transition: all 0.16s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: \n    0 0 0 1px rgba(204, 255, 54, 0.2),\n    0 2px 8px rgba(204, 255, 54, 0.24),\n    0 8px 24px rgba(0, 0, 0, 0.4),\n    inset 0 1px 0 rgba(255, 255, 255, 0.2);\n}\n\n.btn-primary:hover {\n  transform: translateY(-1px);\n  box-shadow: \n    0 0 0 1px rgba(204, 255, 54, 0.3),\n    0 4px 12px rgba(204, 255, 54, 0.32),\n    0 12px 32px rgba(0, 0, 0, 0.5),\n    inset 0 1px 0 rgba(255, 255, 255, 0.3);\n}\n\n.btn-primary:active {\n  transform: translateY(0);\n  box-shadow: \n    0 0 0 1px rgba(204, 255, 54, 0.2),\n    0 1px 4px rgba(204, 255, 54, 0.2),\n    0 4px 16px rgba(0, 0, 0, 0.4),\n    inset 0 1px 2px rgba(0, 0, 0, 0.2);\n}\n\n/* Ghost Button */\n.btn-ghost {\n  position: relative;\n  height: 48px;\n  padding: 0 28px;\n  background: rgba(24, 24, 25, 0.4);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  color: var(--v2-text);\n  border: none;\n  border-radius: var(--v2-radius-sm);\n  font-size: var(--v2-fs-base);\n  font-weight: 500;\n  font-family: var(--font-body);\n  cursor: pointer;\n  transition: all 0.16s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.08),\n    0 2px 8px rgba(0, 0, 0, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.04);\n}\n\n.btn-ghost:hover {\n  background: rgba(33, 33, 35, 0.6);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.12),\n    0 4px 12px rgba(0, 0, 0, 0.4),\n    inset 0 1px 0 rgba(255, 255, 255, 0.06);\n}\n\n.btn-ghost:active {\n  background: rgba(18, 18, 19, 0.5);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.06),\n    0 1px 4px rgba(0, 0, 0, 0.3),\n    inset 0 1px 2px rgba(0, 0, 0, 0.3);\n}\n\n/* Segmented Control */\n.segmented-control {\n  display: inline-flex;\n  background: rgba(12, 12, 13, 0.6);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border-radius: var(--v2-radius-sm);\n  padding: 3px;\n  position: relative;\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.06),\n    inset 0 1px 2px rgba(0, 0, 0, 0.4);\n}\n\n.segmented-control input {\n  display: none;\n}\n\n.segmented-control label {\n  position: relative;\n  padding: 10px 20px;\n  font-size: var(--v2-fs-sm);\n  font-weight: 500;\n  color: var(--v2-dim);\n  cursor: pointer;\n  transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  z-index: 1;\n  user-select: none;\n}\n\n.segmented-control input:checked + label {\n  color: var(--v2-text);\n}\n\n.segmented-indicator {\n  position: absolute;\n  top: 3px;\n  left: 3px;\n  height: calc(100% - 6px);\n  background: rgba(33, 33, 35, 0.9);\n  border-radius: var(--v2-radius-md);\n  transition: all 0.24s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.08),\n    0 2px 6px rgba(0, 0, 0, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.05);\n}\n\n.segmented-control input:nth-of-type(1):checked ~ .segmented-indicator {\n  width: 68px;\n  transform: translateX(0);\n}\n\n.segmented-control input:nth-of-type(2):checked ~ .segmented-indicator {\n  width: 68px;\n  transform: translateX(71px);\n}\n\n.segmented-control input:nth-of-type(3):checked ~ .segmented-indicator {\n  width: 68px;\n  transform: translateX(142px);\n}\n\n/* Toggle Switch */\n.toggle-switch {\n  position: relative;\n  width: 52px;\n  height: 32px;\n  cursor: pointer;\n}\n\n.toggle-switch input {\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n\n.toggle-track {\n  position: absolute;\n  inset: 0;\n  background: rgba(24, 24, 25, 0.6);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border-radius: var(--v2-radius-pill);\n  transition: all 0.24s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.06),\n    inset 0 1px 3px rgba(0, 0, 0, 0.4);\n}\n\n.toggle-thumb {\n  position: absolute;\n  top: 3px;\n  left: 3px;\n  width: 26px;\n  height: 26px;\n  background: linear-gradient(180deg, rgba(80, 80, 82, 0.95), rgba(60, 60, 62, 0.95));\n  border-radius: 50%;\n  transition: all 0.24s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.1),\n    0 2px 6px rgba(0, 0, 0, 0.4),\n    inset 0 1px 0 rgba(255, 255, 255, 0.15);\n}\n\n.toggle-switch input:checked + .toggle-track {\n  background: var(--v2-accent);\n  box-shadow: \n    0 0 0 1px rgba(204, 255, 54, 0.3),\n    0 0 12px rgba(204, 255, 54, 0.2),\n    inset 0 1px 0 rgba(255, 255, 255, 0.2);\n}\n\n.toggle-switch input:checked + .toggle-track .toggle-thumb {\n  transform: translateX(20px);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(240, 240, 242, 0.95));\n  box-shadow: \n    0 0 0 1px rgba(204, 255, 54, 0.2),\n    0 2px 8px rgba(0, 0, 0, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.4);\n}\n\n/* Icon Button */\n.btn-icon {\n  position: relative;\n  width: 36px;\n  height: 36px;\n  background: rgba(24, 24, 25, 0.4);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: none;\n  border-radius: var(--v2-radius-md);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.16s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.08),\n    0 2px 6px rgba(0, 0, 0, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.04);\n}\n\n.btn-icon svg {\n  width: 18px;\n  height: 18px;\n  stroke: var(--v2-text);\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  fill: none;\n  transition: stroke 0.16s;\n}\n\n.btn-icon:hover {\n  background: rgba(33, 33, 35, 0.6);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.12),\n    0 3px 8px rgba(0, 0, 0, 0.4),\n    inset 0 1px 0 rgba(255, 255, 255, 0.06);\n}\n\n.btn-icon:hover svg {\n  stroke: var(--v2-accent);\n}\n\n.btn-icon:active {\n  background: rgba(18, 18, 19, 0.5);\n  box-shadow: \n    0 0 0 1px rgba(255, 255, 255, 0.06),\n    0 1px 3px rgba(0, 0, 0, 0.3),\n    inset 0 1px 2px rgba(0, 0, 0, 0.3);\n}\n\n.button-row {\n  display: flex;\n  gap: 12px;\n}\n\n.toggle-row {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n\n.toggle-text {\n  font-size: var(--v2-fs-sm);\n  color: var(--v2-dim);\n  font-weight: 500;\n}\n</style>\n\n<div class=\"mosh-controls\">\n  <div class=\"control-grid\">\n    <div class=\"control-section\">\n      <div class=\"control-group\">\n        <div class=\"control-label\">Primary Action</div>\n        <button class=\"btn-primary\">Record Track</button>\n      </div>\n      \n      <div class=\"control-group\">\n        <div class=\"control-label\">Secondary Action</div>\n        <button class=\"btn-ghost\">Export Mix</button>\n      </div>\n      \n      <div class=\"control-group\">\n        <div class=\"control-label\">View Mode</div>\n        <div class=\"segmented-control\">\n          <input type=\"radio\" name=\"view\" id=\"view1\" checked>\n          <label for=\"view1\">Mixer</label>\n          <input type=\"radio\" name=\"view\" id=\"view2\">\n          <label for=\"view2\">Editor</label>\n          <input type=\"radio\" name=\"view\" id=\"view3\">\n          <label for=\"view3\">Live</label>\n          <div class=\"segmented-indicator\"></div>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"control-section\">\n      <div class=\"control-group\">\n        <div class=\"control-label\">Toggle States</div>\n        <div class=\"toggle-row\">\n          <label class=\"toggle-switch\">\n            <input type=\"checkbox\">\n            <div class=\"toggle-track\">\n              <div class=\"toggle-thumb\"></div>\n            </div>\n          </label>\n          <span class=\"toggle-text\">Metronome</span>\n        </div>\n        <div class=\"toggle-row\">\n          <label class=\"toggle-switch\">\n            <input type=\"checkbox\" checked>\n            <div class=\"toggle-track\">\n              <div class=\"toggle-thumb\"></div>\n            </div>\n          </label>\n          <span class=\"toggle-text\">Auto-Quantize</span>\n        </div>\n      </div>\n      \n      <div class=\"control-group\">\n        <div class=\"control-label\">Icon Actions</div>\n        <div class=\"button-row\">\n          <button class=\"btn-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n              <path d=\"M10 8l6 4-6 4z\"/>\n            </svg>\n          </button>\n          <button class=\"btn-icon\">\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M12 5v14M5 12h14\"/>\n            </svg>\n          </button>\n          <button class=\"",
