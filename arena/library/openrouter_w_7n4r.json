  "source": "<div id=\"ambient-stage\" style=\"position: absolute; inset: 0; width: 1440px; height: 900px; overflow: hidden; background: #0a0a0a;\">\n  <!-- Base gradient layer -->\n  <div id=\"base-layer\" style=\"position: absolute; inset: 0; background: radial-gradient(ellipse 140% 100% at 30% 20%, rgba(40, 25, 18, 0.4) 0%, rgba(12, 12, 12, 0) 50%), radial-gradient(ellipse 120% 90% at 70% 80%, rgba(25, 35, 20, 0.3) 0%, rgba(12, 12, 12, 0) 60%), #0a0a0a; transition: all 1.2s ease;\"></div>\n  \n  <!-- Generative particle field -->\n  <canvas id=\"particle-canvas\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.6; mix-blend-mode: screen;\"></canvas>\n  \n  <!-- Spectral flow bars -->\n  <div id=\"flow-container\" style=\"position: absolute; inset: 0; opacity: 0.15; pointer-events: none;\">\n    <div class=\"flow-bar\" style=\"position: absolute; left: 0; top: 20%; width: 100%; height: 2px; background: linear-gradient(90deg, transparent 0%, #ccff36 20%, #ccff36 80%, transparent 100%); transform-origin: left; animation: flowPulse1 8s ease-in-out infinite;\"></div>\n    <div class=\"flow-bar\" style=\"position: absolute; left: 0; top: 45%; width: 100%; height: 1px; background: linear-gradient(90deg, transparent 0%, rgba(204, 255, 54, 0.6) 30%, rgba(204, 255, 54, 0.6) 70%, transparent 100%); animation: flowPulse2 12s ease-in-out infinite 2s;\"></div>\n    <div class=\"flow-bar\" style=\"position: absolute; left: 0; top: 72%; width: 100%; height: 1px; background: linear-gradient(90deg, transparent 0%, rgba(204, 255, 54, 0.4) 25%, rgba(204, 255, 54, 0.4) 75%, transparent 100%); animation: flowPulse3 10s ease-in-out infinite 4s;\"></div>\n  </div>\n  \n  <!-- Frequency bloom (reactive to playhead) -->\n  <div id=\"freq-bloom\" style=\"position: absolute; left: 50%; top: 50%; width: 600px; height: 600px; margin: -300px 0 0 -300px; border-radius: 50%; background: radial-gradient(circle, rgba(204, 255, 54, 0.08) 0%, transparent 70%); filter: blur(80px); opacity: 0; transition: opacity 0.6s ease;\"></div>\n  \n  <!-- Vignette overlay -->\n  <div style=\"position: absolute; inset: 0; background: radial-gradient(ellipse 100% 80% at 50% 50%, transparent 30%, rgba(10, 10, 10, 0.6) 100%); pointer-events: none;\"></div>\n  \n  <!-- Moshi container (floating, contextual position) -->\n  <div id=\"moshi-container\" style=\"position: absolute; right: 80px; bottom: 120px; width: 180px; height: 180px; display: flex; flex-direction: column; align-items: center; gap: 16px; z-index: 100;\">\n    <!-- Moshi host -->\n    <div id=\"moshi-host\" style=\"width: 180px; height: 180px; position: relative; filter: drop-shadow(0 12px 40px rgba(0, 0, 0, 0.5));\"></div>\n    \n    <!-- Status caption with glow -->\n    <div id=\"moshi-status\" style=\"font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #ccff36; text-shadow: 0 0 12px rgba(204, 255, 54, 0.6), 0 0 24px rgba(204, 255, 54, 0.3); opacity: 0.9;\">LISTENING</div>\n  </div>\n  \n  <!-- Intensity control (bottom left) -->\n  <div id=\"intensity-control\" style=\"position: absolute; left: 40px; bottom: 40px; display: flex; flex-direction: column; gap: 12px; z-index: 50;\">\n    <div style=\"font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(237, 237, 238, 0.4);\">AMBIENT</div>\n    <div style=\"display: flex; gap: 6px; align-items: center;\">\n      <div class=\"intensity-pip\" data-level=\"1\" style=\"width: 3px; height: 16px; background: rgba(204, 255, 54, 0.3); border-radius: 2px; cursor: pointer; transition: all 0.2s ease;\"></div>\n      <div class=\"intensity-pip\" data-level=\"2\" style=\"width: 3px; height: 22px; background: rgba(204, 255, 54, 0.5); border-radius: 2px; cursor: pointer; transition: all 0.2s ease;\"></div>\n      <div class=\"intensity-pip active\" data-level=\"3\" style=\"width: 3px; height: 28px; background: #ccff36; border-radius: 2px; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 0 8px rgba(204, 255, 54, 0.6);\"></div>\n      <div class=\"intensity-pip\" data-level=\"4\" style=\"width: 3px; height: 34px; background: rgba(204, 255, 54, 0.3); border-radius: 2px; cursor: pointer; transition: all 0.2s ease;\"></div>\n    </div>\n  </div>\n  \n  <!-- Session coat indicator (top right) -->\n  <div id=\"coat-indicator\" style=\"position: absolute; top: 40px; right: 40px; display: flex; align-items: center; gap: 12px; opacity: 0.7; z-index: 50;\">\n    <div style=\"font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(237, 237, 238, 0.4);\">MOLTEN / Cm / 128</div>\n    <div style=\"width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, rgba(255, 120, 60, 0.3), rgba(204, 255, 54, 0.2)); border: 1px solid rgba(255, 255, 255, 0.09); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);\"></div>\n  </div>\n</div>\n\n<style>\n  @keyframes flowPulse1 {\n    0%, 100% { transform: scaleX(0.8); opacity: 0.15; }\n    50% { transform: scaleX(1.2); opacity: 0.4; }\n  }\n  \n  @keyframes flowPulse2 {\n    0%, 100% { transform: scaleX(0.9); opacity: 0.1; }\n    50% { transform: scaleX(1.1); opacity: 0.3; }\n  }\n  \n  @keyframes flowPulse3 {\n    0%, 100% { transform: scaleX(0.85); opacity: 0.12; }\n    50% { transform: scaleX(1.15); opacity: 0.25; }\n  }\n  \n  .intensity-pip:hover {\n    background: #ccff36 !important;\n    box-shadow: 0 0 8px rgba(204, 255, 54, 0.6);\n  }\n  \n  #moshi-container {\n    animation: moshiFloat 6s ease-in-out infinite;\n  }\n  \n  @keyframes moshiFloat {\n    0%, 100% { transform: translateY(0px); }\n    50% { transform: translateY(-8px); }\n  }\n</style>\n\n<script>\n(function() {\n  // Initialize Moshi\n  const hostEl = document.getElementById('moshi-host');\n  const m = window.Moshi(hostEl, {\n    personality: 'MOLTEN',\n    seed: 0.65,\n    quality: 'ps2',\n    style: 'toon',\n    interactive: true,\n    room: false\n  });\n  \n  m.setState('LISTENING');\n  m.set('mood', 0.7);\n  m.set('energy', 0.5);\n  m.set('heat', 0.3);\n  \n  // Particle system\n  const canvas = document.getElementById('particle-canvas');\n  const ctx = canvas.getContext('2d');\n  canvas.width = 1440;\n  canvas.height = 900;\n  \n  const particles = [];\n  const particleCount = 60;\n  \n  for (let i = 0; i < particleCount; i++) {\n    particles.push({\n      x: Math.random() * canvas.width,\n      y: Math.random() * canvas.height,\n      vx: (Math.random() - 0.5) * 0.3,\n      vy: (Math.random() - 0.5) * 0.3,\n      radius: Math.random() * 1.5 + 0.5,\n      alpha: Math.random() * 0.4 + 0.1,\n      phase: Math.random() * Math.PI * 2\n    });\n  }\n  \n  function drawParticles() {\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    \n    const time = window.__mosh?.time || 0;\n    const playhead = window.__mosh?.playhead || 0;\n    \n    particles.forEach((p, i) => {\n      p.x += p.vx;\n      p.y += p.vy;\n      \n      if (p.x < 0 || p.x > canvas.width) p.vx *= -1;\n      if (p.y < 0 || p.y > canvas.height) p.vy *= -1;\n      \n      const pulse = Math.sin(time * 0.5 + p.phase) * 0.3 + 0.7;\n      const reactivity = playhead > 0 ? Math.sin(playhead * Math.PI * 2) * 0.2 + 1 : 1;\n      \n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.radius * pulse * reactivity, 0, Math.PI * 2);\n      ctx.fillStyle = `rgba(204, 255, 54, ${p.alpha * pulse})`;\n      ctx.fill();\n      \n      // Connect nearby particles\n      particles.forEach((p2, j) => {\n        if (j <= i) return;\n        const dx = p2.x - p.x;\n        const dy = p2.y - p.y;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        \n        if (dist < 120) {\n          ctx.beginPath();\n          ctx.moveTo(p.x, p.y);\n          ctx.lineTo(p2.x, p2.y);\n          ctx.strokeStyle = `rgba(204, 255, 54, ${(1 - dist / 120) * 0.15 * pulse})`;\n          ctx.lineWidth = 0.5;\n          ctx.stroke();\n        }\n      });\n    });\n    \n    requestAnimationFrame(drawParticles);\n  }\n  \n  drawParticles();\n  \n  // Reactive bloom based on playhead\n  const bloom = document.getElementById('freq-bloom');\n  setInterval(() => {\n    const playhead = window.__mosh?.playhead || 0;\n    if (playhead > 0) {\n      const intensity = Math.sin(playhead * Math.PI * 2) * 0.5 + 0.5;\n      bloom.style.opacity = intensity * 0.4;\n      bloom.style.transform = `scale(${1 + intensity * 0.2})`;\n    } else {\n      bloom.style.opacity = 0;\n    }\n  }, 50);\n  \n  // Intensity control interaction\n  const pips = document.querySelectorAll('.intensity-pip');\n  const baseLayer = document.getElementById('base-layer');\n  \n  pips.forEach(pip => {\n    pip.addEventListener('click', () => {\n      pips.forEach(p => {\n        p.classList.remove('active');\n        p.style.background = 'rgba(204, 255, 54, 0.3)';\n        p.style.boxShadow = 'none';\n      });\n      \n      pip.classList.add('active');\n      pip.style.background = '#ccff36';\n      pip.style.boxShadow = '0 0 8px rgba(204, 255, 54, 0.6)';\n      \n      const level = parseInt(pip.dataset.level);\n      const opacity = level * 0.15;\n      \n      // Adjust ambient intensity\n      canvas.style.opacity = 0.4 + level * 0.15;\n      document.getElementById('flow-container').style.opacity = 0.1 + level * 0.1;\n      \n      if (level === 4) {\n        baseLayer.style.background = 'radial-gradient(ellipse 140% 100% at 30% 20%, rgba(60, 35, 25, 0.6) 0%, rgba(12, 12, 12, 0) 50%), radial-gradient(ellipse 120% 90% at 70% 80%, rgba(35, 50, 25, 0.5) 0%, rgba(12, 12, 12, 0) 60%), #0a0a0a';\n      } else {\n        baseLayer.style.background = 'radial-gradient(ellipse 140% 100% at 30% 20%, rgba(40, 25, 18, 0.4) 0%, rgba(12, 12, 12, 0) 50%), radial-gradient(ellipse 120% 90% at 70% 80%, rgba(25, 35, 20, 0.3) 0%, rgba(12, 12, 12, 0) 60%), #0a0a0a';\n      }\n    });\n  });\n  \n  // Moshi state cycling (demo)\n  const states = ['LISTENING', 'RECORDING', 'RENDERING', 'PAUSED'];\n  const statusEl = document.getElementById('moshi-status');\n  let stateIndex = 0;\n  \n  setInterval(() => {\n    stateIndex = (stateIndex + 1) % states.length;\n    const state = states[stateIndex];\n    m.setState(state);\n    statusEl.textContent = state === 'LISTENING' ? 'LISTENING' : \n                          state === 'RECORDING' ? 'REC' :\n                          state === 'RENDERING' ? 'COOK' : 'CHILL';",
