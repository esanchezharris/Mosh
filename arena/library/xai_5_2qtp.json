06em\">SYNTH • VAPOR</div>\n    </div>\n\n    <!-- LANES WITH PATINA -->\n    <div style=\"position:relative\">\n      <!-- Lane 1 -->\n      <div style=\"height:64px;background:var(--v2-surface-sunken);border-radius:12px;margin-bottom:14px;border:1px solid var(--v2-line);position:relative;overflow:hidden\">\n        <div style=\"position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(204,255,36,0.06) 40%,rgba(204,255,36,0.11) 55%,transparent);animation:flow 4.2s linear infinite\"></div>\n        <div style=\"position:absolute;left:24px;top:22px;width:120px;height:3px;background:#fff;opacity:0.6;border-radius:3px\"></div>\n      </div>\n      <!-- Lane 2 -->\n      <div style=\"height:64px;background:var(--v2-surface-sunken);border-radius:12px;margin-bottom:14px;border:1px solid var(--v2-line);position:relative;overflow:hidden\">\n        <div style=\"position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(204,255,36,0.07) 30%,rgba(204,255,36,0.15) 60%,transparent);animation:flow 3.1s linear infinite reverse\"></div>\n        <div style=\"position:absolute;left:60px;top:28px;width:210px;height:2px;background:#fff;opacity:0.55;border-radius:3px\"></div>\n      </div>\n      <!-- Lane 3 -->\n      <div style=\"height:64px;background:var(--v2-surface-sunken);border-radius:12px;border:1px solid var(--v2-line);position:relative;overflow:hidden\">\n        <div style=\"position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(204,255,36,0.04) 25%,rgba(204,255,36,0.09) 65%,transparent);animation:flow 5.4s linear infinite\"></div>\n      </div>\n    </div>\n\n    <!-- PLAYHEAD -->\n    <div style=\"position:absolute;top:130px;left:32px;width:3px;height:218px;background:#ccff23;box-shadow:0 0 14px #ccff23;opacity:0.9\"></div>\n  </div>\n\n  <!-- RIGHT RAIL -->\n  <div style=\"position:absolute;top:64px;right:0;width:286px;bottom:0;background:rgba(12,12,13,0.94);border-left:1px solid var(--v2-line)\">\n    <!-- MOSHI HOST -->\n    <div id=\"moshi-host\" style=\"position:absolute;top:48px;left:50%;transform:translateX(-50%);width:218px;height:218px;border-radius:999px;background:#111;border:1px solid #1f1f22;box-shadow:0 0 0 1px rgba(204,255,36,0.15),inset 0 40px 80px rgba(0,0,0,0.6),0 30px 70px rgba(0,0,0,0.7);overflow:hidden\">\n      <!-- THE CREATURE -->\n      <svg width=\"218\" height=\"218\" viewBox=\"0 0 218 218\" style=\"position:absolute;top:0;left:0\">\n        <!-- Body (PATINA INVARIANT) -->\n        <defs>\n          <linearGradient id=\"body\" x1=\"40\" y1=\"30\" x2=\"170\" y2=\"190\" gradientUnits=\"userSpaceOnUse\">\n            <stop offset=\"0%\" stop-color=\"#1a1a1c\"/>\n            <stop offset=\"48%\" stop-color=\"#0f0f11\"/>\n            <stop offset=\"100%\" stop-color=\"#0b0b0b\"/>\n          </linearGradient>\n          <filter id=\"dither\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n            <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"2\" result=\"noise\"/>\n            <feBlend in=\"SourceGraphic\" in2=\"noise\" mode=\"multiply\"/>\n          </filter>\n        </defs>\n        <!-- Gooey core body -->\n        <path id=\"blob\" d=\"M62 54 Q109 32 157 59 Q179 102 151 154 Q105 183 59 149 Q38 104 62 54\" fill=\"url(#body)\" stroke=\"#1f1f22\" stroke-width=\"7\"/>\n        <!-- Subtle vein patina (song coat) -->\n        <path d=\"M78 71 Q95 92 118 81\" fill=\"none\" stroke=\"#ccff23\" stroke-width=\"1.2\" opacity=\"0.35\"/>\n        <path d=\"M101 117 Q128 131 143 115\" fill=\"none\" stroke=\"#ccff23\" stroke-width=\"1\" opacity=\"0.28\"/>\n        \n        <!-- Face core (NEVER DEFORMED) -->\n        <!-- Left eye -->\n        <path id=\"left-eye\" d=\"M79 96 L92 85 L105 96 L92 108 Z\" fill=\"#ccff23\"/>\n        <!-- Right eye -->\n        <path id=\"right-eye\" d=\"M121 93 L134 82 L147 93 L134 105 Z\" fill=\"#ccff23\"/>\n        <!-- Heat ember -->\n        <circle cx=\"110\" cy=\"118\" r=\"5.5\" fill=\"#ccff23\" opacity=\"0.9\"/>\n        <circle cx=\"110\" cy=\"118\" r=\"2.5\" fill=\"#fff\"/>\n      </svg>\n    </div>\n\n    <!-- STATE LABEL -->\n    <div style=\"position:absolute;top:282px;left:50%;transform:translateX(-50%);text-align:center\">\n      <div style=\"font-size:10px;letter-spacing:2.4px;color:#ccff23;opacity:0.9\">LISTENING</div>\n      <div style=\"margin-top:1px;font-size:9px;color:var(--v2-dim)\">tar • sl1cd</div>\n    </div>\n  </div>\n\n  <!-- TRANSPORT -->\n  <div style=\"position:absolute;bottom:0;left:0;right:286px;height:52px;background:rgba(12,12,13,0.96);border-top:1px solid var(--v2-line);display:flex;align-items:center;padding:0 32px;font-size:12px\">\n    <div style=\"display:flex;align-items:center;gap:14px\">\n      <div style=\"width:28px;height:28px;border-radius:999px;background:#ccff23;display:flex;align-items:center;justify-content:center;color:#0a0f04\">▶</div>\n      <div style=\"color:var(--v2-dim)\">03:41 / 04:12</div>\n    </div>\n    <div style=\"flex:1\"></div>\n    <div style=\"color:#ccff23;letter-spacing:1px\">MOSHI IS WATCHING</div>\n  </div>\n</div>\n\n<style>\n:root { --v2-accent:#ccff23; }\n@keyframes flow {\n  0% { transform: translateX(-18%); }\n  100% { transform: translateX(28%); }\n}\n#blob { transition: transform .4s cubic-bezier(0.23,1,0.32,1); }\n#left-eye, #right-eye { transition: transform .2s ease; }\n</style>\n\n<script>\nconst host = document.getElementById('moshi-host');\nconst blob = document.getElementById('blob');\nconst left = document.getElementById('left-eye');\nconst right = document.getElementById('right-eye');\n\n// Idle life: gaze wander + slow breath\nlet t = 0;\nsetInterval(() => {\n  t += 0.06;\n  const sx = Math.sin(t * 0.9) * 2.5;\n  const sy = Math.cos(t * 1.1) * 1.8;\n  blob.setAttribute('transform', `translate(${sx} ${sy})`);\n  // subtle gaze wander (watching viewer)\n  const gx = Math.sin(t * 0.4) * 3.5;\n  left.setAttribute('transform', `translate(${gx} 0)`);\n  right.setAttribute('transform', `translate(${gx * 0.7} 0)`);\n}, 120);\n\n// Slow flow pulse (LISTENING)\nsetInterval(() => {\n  blob.setAttribute('opacity', '0.94');\n  setTimeout(() => blob.setAttribute('opacity', '1'), 380);\n}, 2400);\n\n// Click to earn glance\nhost.addEventListener('click', () => {\n  left.setAttribute('transform', 'translate(7 0)');\n  right.setAttribute('transform', 'translate(5 0)');\n  setTimeout(() => {\n    left.setAttribute('transform', 'translate(0 0)');\n    right.setAttribute('transform', 'translate(0 0)');\n  }, 420);\n});\n</script>",
