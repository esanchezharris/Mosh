{
  "name": "mosh-designer-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dev-only taste bench: audition rendered design candidates for the Mosh UI. Never bundled into Mosh.app.",
  "scripts": {
