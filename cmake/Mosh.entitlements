<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime entitlements for the NOTARIZED, Developer-ID-distributed Mosh.
         Mosh is NOT sandboxed (it's a direct-download DAW, not a Mac App Store app), so
         these are Hardened Runtime *exceptions*, not App Sandbox grants. Each one is
         load-bearing — dropping it breaks a shipping feature. Applied only by
         `./run-mosh.sh release`; the everyday ad-hoc `deploy` does not use this file. -->

    <!-- THE essential one for a plugin host. Hardened Runtime's library validation
         otherwise refuses to load any code not signed by our Team ID or Apple — which
         is every third-party VST3/AU the user owns, plus the bundled LibTorch/anira
         dylibs in the real-time-RAVE build. Without this, no user plugin loads. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- JIT: the JavaScript engine behind the WebView UI, and plugins/DSP that emit code. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Distinct from allow-jit (which permits MAP_JIT pages): this permits the older
         mprotect(PROT_WRITE|PROT_EXEC) pattern that some legacy VST3 synths still use.
         Kept because Mosh hosts arbitrary third-party plugins; dropping it would crash
         those plugins on a user's machine. Do NOT remove thinking allow-jit covers it. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Microphone: native voice control + audio recording.
         Pairs with NSMicrophoneUsageDescription (the TCC prompt string). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Camera: the WebView camera feature.
         Pairs with NSCameraUsageDescription (the TCC prompt string). -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
