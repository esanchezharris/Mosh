# Moshi brain — provider config TEMPLATE (safe to commit; no real keys here).
# Copy to .env.local and fill in your keys. .env.local is gitignored.
# A small local proxy reads these and forwards to the provider; the browser
# never sees a key. All three providers are OpenAI-compatible chat-completions.

MOSHI_BRAIN_PROVIDER=deepseek   # deepseek | openai | xai

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
XAI_API_KEY=
