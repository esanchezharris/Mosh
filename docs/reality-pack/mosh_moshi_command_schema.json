{
  "version": "0.1",
  "project": "Mosh",
  "assistant": "Moshi",
  "contract": "natural language -> typed commands -> DAW core execution -> UI reflection -> event log",
  "commands": [
    {
      "type": "PLAY",
      "family": "transport",
      "examples": [
        "play",
        "start from here"
      ],
      "required": [],
      "optional": [
        "positionBeat"
      ],
      "preconditions": [
        "audio engine ready"
      ],
      "stateChanges": [
        "transport.state=playing"
      ],
      "undo": "not undoable; transport action logged"
    },
    {
      "type": "STOP",
      "family": "transport",
      "examples": [
        "stop",
        "pause"
      ],
      "required": [],
      "optional": [
        "returnToStart"
      ],
      "preconditions": [
        "session loaded"
      ],
      "stateChanges": [
        "transport.state=stopped"
      ],
      "undo": "not undoable"
    },
    {
      "type": "SEEK",
      "family": "transport",
      "examples": [
        "go to bar 9",
        "jump to the hook"
      ],
      "required": [
        "positionBeat|markerId"
      ],
      "optional": [],
      "preconditions": [
        "position valid"
      ],
      "stateChanges": [
        "transport.playheadBeat set"
      ],
      "undo": "not undoable"
    },
    {
      "type": "SET_LOOP_RANGE",
      "family": "transport",
      "examples": [
        "loop these 8 bars",
        "loop the hook"
      ],
      "required": [
        "startBeat",
        "endBeat"
      ],
      "optional": [
        "enabled"
      ],
      "preconditions": [
        "range valid"
      ],
      "stateChanges": [
        "loop range updated"
      ],
      "undo": "undoable"
    },
    {
      "type": "SET_TEMPO",
      "family": "transport",
      "examples": [
        "set bpm to 140",
        "make it 92 bpm"
      ],
      "required": [
        "bpm"
      ],
      "optional": [
        "preserveAudioPitch"
      ],
      "preconditions": [
        "bpm in range"
      ],
      "stateChanges": [
        "session.tempo updated"
      ],
      "undo": "undoable"
    },
    {
