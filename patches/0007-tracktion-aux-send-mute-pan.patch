+/** Applies stereo balance to a send branch without changing the source track path. */
+class StereoBalanceNode final : public Node
+{
+public:
+    StereoBalanceNode (Node* inputNode, std::function<float()> panFunc, size_t nodeHashToUse = 0)
+        : input (inputNode), panFunction (std::move (panFunc)), nodeHash (nodeHashToUse)
+    {
+        assert (input != nullptr);
+        assert (panFunction);
+        const auto pan = juce::jlimit (-1.0f, 1.0f, panFunction());
+        lastLeftGain = pan > 0.0f ? 1.0f - pan : 1.0f;
+        lastRightGain = pan < 0.0f ? 1.0f + pan : 1.0f;
+    }
+
+    NodeProperties getNodeProperties() override
+    {
+        auto props = input->getNodeProperties();
+
+        if (nodeHash != 0)
+            hash_combine (props.nodeID, nodeHash);
+
+        constexpr size_t stereoBalanceNodeMagicHash = size_t (0x73746572656f5061);
+
+        if (props.nodeID != 0)
+            hash_combine (props.nodeID, stereoBalanceNodeMagicHash);
+
+        return props;
+    }
+
+    std::vector<Node*> getDirectInputNodes() override
+    {
+        return { input };
+    }
+
+    bool isReadyToProcess() override
+    {
+        return input->hasProcessed();
+    }
+
+    void process (ProcessContext& pc) override
+    {
+        auto source = input->getProcessedOutput();
+        copy (pc.buffers.audio, source.audio);
+        pc.buffers.midi.copyFrom (source.midi);
+
+        if (pc.buffers.audio.getNumChannels() < 2)
+            return;
+
+        const auto pan = juce::jlimit (-1.0f, 1.0f, panFunction());
+        const auto leftGain = pan > 0.0f ? 1.0f - pan : 1.0f;
+        const auto rightGain = pan < 0.0f ? 1.0f + pan : 1.0f;
+
+        applyChannelGain (pc.buffers.audio.getChannel (0), lastLeftGain, leftGain);
+        applyChannelGain (pc.buffers.audio.getChannel (1), lastRightGain, rightGain);
+        lastLeftGain = leftGain;
+        lastRightGain = rightGain;
+    }
+
+private:
+    template<typename BufferType>
+    static void applyChannelGain (BufferType&& buffer, float previous, float target)
+    {
+        if (previous == target)
+        {
+            if (target != 1.0f)
+                applyGain (buffer, target);
+            return;
+        }
+
+        juce::SmoothedValue<float> smoother (previous);
+        smoother.setTargetValue (target);
+        smoother.reset ((int) buffer.getNumFrames());
+        applyGainPerFrame (buffer, [&] { return smoother.getNextValue(); });
+    }
+
+    Node* input = nullptr;
+    std::function<float()> panFunction;
+    float lastLeftGain = 1.0f, lastRightGain = 1.0f;
+    size_t nodeHash = 0;
+};
