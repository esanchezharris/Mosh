+//==============================================================================
+//==============================================================================
+/** Passes through a fully-processed send branch and reports its final audio. */
+class SendMeasuringNode final : public Node
+{
+public:
+    SendMeasuringNode (std::unique_ptr<Node> inputNode,
+                       std::function<void(choc::buffer::ChannelArrayView<float>)> measureAudioFunc)
+        : input (std::move (inputNode)), measureAudioFunction (std::move (measureAudioFunc))
+    {
+        assert (input != nullptr);
+        assert (measureAudioFunction);
+        setOptimisations ({ ClearBuffers::no, AllocateAudioBuffer::no });
+    }
+
+    NodeProperties getNodeProperties() override
+    {
+        auto props = input->getNodeProperties();
+        constexpr size_t sendMeasuringNodeMagicHash = size_t (0x73656e644d657472);
+        if (props.nodeID != 0)
+            hash_combine (props.nodeID, sendMeasuringNodeMagicHash);
+        return props;
+    }
+
+    std::vector<Node*> getDirectInputNodes() override
+    {
+        return { input.get() };
+    }
+
+    bool isReadyToProcess() override
+    {
+        return input->hasProcessed();
+    }
+
+    void process (ProcessContext& pc) override
+    {
+        auto source = input->getProcessedOutput();
+        setAudioOutput (input.get(), source.audio);
+
+        if (input->numOutputNodes == 1)
+            pc.buffers.midi.swapWith (source.midi);
+        else
+            pc.buffers.midi.copyFrom (source.midi);
+
+        measureAudioFunction (source.audio);
+    }
+
+private:
+    std::unique_ptr<Node> input;
+    std::function<void(choc::buffer::ChannelArrayView<float>)> measureAudioFunction;
+};
