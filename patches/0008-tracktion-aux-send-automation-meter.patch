+    bool hasLabels() const override                   { return true; }
+    juce::String getLabelForValue (float value) const override
+    {
+        return muted (value) ? TRANS("Muted") : TRANS("Open");
+    }
+    juce::StringArray getAllLabels() const override
+    {
+        return { TRANS("Open"), TRANS("Muted") };
+    }
+    juce::String valueToString (float value) override
+    {
+        return getLabelForValue (value);
+    }
+};
