+    }
+
+    ~AuxSendMuteParameter() override
+    {
+        notifyListenersOfDeletion();
+    }
+
+    static bool muted (float value) noexcept          { return value >= 0.5f; }
+    bool isDiscrete() const override                  { return true; }
+    int getNumberOfStates() const override            { return 2; }
+    float getValueForState (int state) const override { return state <= 0 ? 0.0f : 1.0f; }
+    int getStateForValue (float value) const override { return muted (value) ? 1 : 0; }
