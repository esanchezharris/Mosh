(version 1)
(deny default)
(import "system.sb")
(allow process*)
(allow signal (target same-sandbox))
(allow file-read-metadata file-test-existence
  (path-ancestors (param "WORKTREE"))
  (path-ancestors (param "GATE_HOME"))
  (path-ancestors (param "TEMP_ROOT"))
  (path-ancestors (param "DEPS_ROOT"))
  (path-ancestors (param "PLAYWRIGHT_CACHE"))
  (path-ancestors (param "BREW_BIN"))
  (path-ancestors (param "BREW_CELLAR"))
  (path-ancestors (param "BREW_OPT"))
  (path-ancestors (param "BREW_NODE_MODULES"))
  (path-ancestors (param "BREW_OPENSSL_CONFIG"))
  (path-ancestors (param "TOOLS_ROOT"))
  (path-ancestors "/private/var/select/sh"))
(allow file-read*
  (subpath (param "WORKTREE"))
  (subpath (param "GATE_HOME"))
  (subpath (param "TEMP_ROOT"))
  (subpath (param "DEPS_ROOT"))
  (subpath (param "PLAYWRIGHT_CACHE"))
  (subpath (param "BREW_BIN"))
  (subpath (param "BREW_CELLAR"))
  (subpath (param "BREW_OPT"))
  (subpath (param "BREW_NODE_MODULES"))
  (subpath (param "BREW_OPENSSL_CONFIG"))
  (subpath (param "TOOLS_ROOT"))
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/Library/Fonts")
  (literal "/private/var/select/sh")
  (literal "/private/etc/hosts"))
(allow file-write*
  (subpath (param "GATE_HOME"))
  (subpath (param "TEMP_ROOT")))
(deny file-write* (literal (param "GIT_POINTER")))
(deny file-write*
  (literal (param "LANE_UI"))
  (subpath (param "LANE_UI"))
  (literal (param "LANE_DEPS"))
  (subpath (param "LANE_DEPS")))
(deny network*)
(allow network-bind (local tcp "localhost:5173"))
(allow network-inbound (local tcp "localhost:5173"))
(allow network-outbound (remote tcp "localhost:5173"))
