{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosh.invalid/schemas/first-stranger/gate-worker-receipt-v1.json",
  "title": "First-Stranger secret-free gate worker receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "reasons",
    "job_id",
    "nonce",
    "lane_id",
    "manifest_sha256",
    "started_at",
    "finished_at",
    "duration_ms",
    "producer",
    "worker",
    "source",
    "gate",
    "repository",
    "isolation",
    "limits",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "outcome": {"enum": ["passed", "needs-human"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "job_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "lane_id": {"type": "string", "pattern": "^FS-[A-Z][A-Z0-9-]*$"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol", "guest_writable"],
      "properties": {
        "kind": {"const": "controller"},
        "protocol": {"const": "mosh-gate-controller-v1"},
        "guest_writable": {"const": false}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "image_sha256", "toolchain_manifest_sha256", "dependency_manifest_sha256", "architecture"],
      "properties": {
        "image_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:+-]{0,127}$"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "architecture": {"const": "arm64"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "bundle_sha256"],
      "properties": {
        "base_sha": {"$ref": "#/$defs/git_sha"},
        "head_sha": {"$ref": "#/$defs/git_sha"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_oid",
        "sha256",
        "class",
        "selftest_baseline",
        "exit_status",
        "stdout_sha256",
        "stderr_sha256",
        "result"
      ],
      "properties": {
        "path": {"const": "scripts/auto-loop/gate.sh"},
        "blob_oid": {"$ref": "#/$defs/git_sha"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "class": {"enum": ["cheap", "native"]},
        "selftest_baseline": {"type": "integer", "minimum": 0},
        "exit_status": {"type": "integer", "minimum": 0, "maximum": 255},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"$ref": "#/$defs/gate_result"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detached_head_sha", "tracked_clean", "tracked_status", "tracked_status_sha256", "verification_source"],
      "properties": {
        "detached_head_sha": {"$ref": "#/$defs/git_sha"},
        "tracked_clean": {"type": "boolean"},
        "tracked_status": {"type": "string"},
        "tracked_status_sha256": {"$ref": "#/$defs/sha256"},
        "verification_source": {"const": "controller-readonly-disk"}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_adapter_enabled", "network_probe", "account_admin", "owner_home_mounted", "credentials_present", "evidence_source"],
      "properties": {
        "network_adapter_enabled": {"const": false},
        "network_probe": {"const": "disabled"},
        "account_admin": {"const": false},
        "owner_home_mounted": {"const": false},
        "credentials_present": {"const": false},
        "evidence_source": {"const": "controller-hypervisor"}
      }
    },
    "limits": {
      "allOf": [
        {"$ref": "#/$defs/limits"},
        {
          "type": "object",
          "required": ["timeout_triggered"],
          "properties": {"timeout_triggered": {"type": "boolean"}}
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"properties": {"path": {"const": "gate.stdout"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"properties": {"path": {"const": "gate.stderr"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"properties": {"path": {"const": "tracked-status.txt"}}}
          ]
        }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "passed"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "reasons": {"maxItems": 0},
          "gate": {
            "properties": {
              "exit_status": {"const": 0},
              "result": {
                "properties": {
                  "pass": {"const": true},
                  "selftest_failed": {"const": 0},
                  "asserts": {"const": 0},
                  "steps": {
                    "minItems": 1,
                    "items": {"properties": {"ok": {"const": true}}}
                  }
                }
              }
            }
          },
          "repository": {
            "properties": {
              "tracked_clean": {"const": true},
              "tracked_status": {"const": ""},
              "tracked_status_sha256": {
                "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
              }
            }
          },
          "limits": {
            "properties": {"timeout_triggered": {"const": false}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "needs-human"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {"reasons": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "cpu_count", "memory_bytes", "disk_bytes", "output_bytes", "process_count", "timeout_triggered"],
      "properties": {
        "wall_clock_seconds": {"type": "integer", "minimum": 60, "maximum": 7200},
        "cpu_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "memory_bytes": {"type": "integer", "minimum": 4294967296, "maximum": 68719476736},
        "disk_bytes": {"type": "integer", "minimum": 21474836480, "maximum": 214748364800},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "process_count": {"type": "integer", "minimum": 64, "maximum": 4096},
        "timeout_triggered": {"type": "boolean"}
      }
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "class", "session", "port", "selftest", "selftest_failed", "asserts", "steps"],
      "properties": {
        "pass": {"type": "boolean"},
        "class": {"enum": ["cheap", "native"]},
        "session": {"type": "string"},
        "port": {"type": "string", "pattern": "^[0-9]+$"},
        "selftest": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "selftest_failed": {"type": "integer", "minimum": 0},
        "asserts": {"type": "integer", "minimum": 0},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ok", "detail"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "ok": {"type": "boolean"},
              "detail": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
