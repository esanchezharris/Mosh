{
  "name": "@mosh/agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "test:integration": "npm run bundle && node dist/agent-host-integration.mjs",
    "test:startup": "node test/startup-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openai/agents": "0.14.1",
    "@openai/agents-core": "0.14.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
