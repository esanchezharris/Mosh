  "additionalProperties": false,
  "properties": {
    "arrangement": {
      "$ref": "#/$defs/Arrangement"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/Element"
      },
      "title": "Elements",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "reconstruction_class": {
      "$ref": "#/$defs/ReconstructionClass",
      "default": "partial"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/Unresolved"
      },
      "title": "Unresolved",
      "type": "array"
    },
    "yield": {
      "$ref": "#/$defs/YieldBlock"
    }
  },
  "title": "Recipe",
  "type": "object"
}
