    "SynthStatus": {
      "enum": [
        "params_visible",
        "matched",
        "substituted",
        "unavailable",
        "unknown"
      ],
      "title": "SynthStatus",
      "type": "string"
    },
    "Unresolved": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "issue": {
          "default": "",
          "title": "Issue",
          "type": "string"
        },
        "suggested_action": {
          "default": "",
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "title": "Unresolved",
      "type": "object"
    },
    "YieldBlock": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "$ref": "#/$defs/YieldScores"
        },
        "predicted": {
          "$ref": "#/$defs/YieldScores"
        }
      },
      "title": "YieldBlock",
      "type": "object"
    },
    "YieldScores": {
      "additionalProperties": false,
      "properties": {
        "arrangement": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Arrangement",
          "type": "number"
        },
        "drums": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Drums",
          "type": "number"
        },
        "midi": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Midi",
          "type": "number"
        },
        "overall": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overall",
          "type": "number"
        },
        "synth": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Synth",
          "type": "number"
        }
      },
      "title": "YieldScores",
      "type": "object"
    }
