{
  "schemaVersion": 1,
  "id": "sft-02-add-midi-clip",
  "name": "add-midi-clip",
  "description": "Place a MIDI clip on a track; an omitted note list leaves the clip empty.",
  "examples": [
    "put a midi clip on Piste 1",
    "Create a MIDI clip for the Piste 1 track.",
    "pop a midi clip on the Bass lane",
    "Can you drop a MIDI clip onto the VEC3 Synths 012 C 1 track for me, please?",
    "add a MIDI clip to the \"Caprice No. 6\" track",
    "I’d like a MIDI clip added to the Track 1 track, if that’s okay.",
    "put a midi clip on Carta ao Tom",
    "add a midi clip to PAN FLUTE",
    "add a MIDI clip to the \"Track-1\" track",
    "pop a midi clip on the Track-1 lane"
  ],
  "slots": [
    {
      "name": "step1_length",
      "type": "number",
      "required": true,
      "description": "How many seconds should the clip last?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "How many seconds should the clip last?",
        "unit": "seconds",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 1.5225694444444446,
          "median": 159.0087470728502,
          "max": 1881.25
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.cpp",
          "line": 1847
        },
        "notes": "The handler does not declare a numeric range. This is seconds; note lengths inside the clip use beats."
      }
    },
    {
      "name": "step1_start",
      "type": "number",
      "required": true,
      "description": "Where should the clip begin in seconds?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "Where should the clip begin in seconds?",
        "unit": "seconds",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 0,
          "median": 0,
          "max": 0
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.cpp",
          "line": 1846
        },
        "notes": "The handler does not declare a numeric range."
      }
    },
    {
      "name": "step1_trackId",
      "type": "string",
      "required": true,
      "description": "Which track should hold the MIDI clip?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which track should hold the MIDI clip?",
        "selector": "tracks[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.cpp",
          "line": 1824
        },
        "notes": "An absent or unresolved track creates a new audio track. Native may add a default instrument in the same transaction."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "add_midi_clip",
        "args": {
          "length": "{step1_length}",
          "start": "{step1_start}",
          "trackId": "{step1_trackId}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_trackId",
      "selector": "tracks[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "add_midi_clip"
    }
  ],
