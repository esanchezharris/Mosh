{
  "schemaVersion": 1,
  "id": "sft-05-split-clip",
  "name": "split-clip",
  "description": "Divide a clip into two clips at a point strictly inside its bounds.",
  "examples": [
    "Split the Piano clip at 2 bars.",
    "Cut the bass clip at 4 seconds.",
    "Can you split 1016 at beat 8?",
    "Please divide the Piano part right at 1.5s.",
    "Split the bass clip in two at 0:03.",
    "Take the clip on Bass and split it at bar 2.",
    "Chop the Piano clip at 6 seconds.",
    "Slice the bass clip at 5.5s.",
    "Split 1016 at 4.0 seconds exactly.",
    "I want the Piano clip split at the halfway point of Verse."
  ],
  "slots": [
    {
      "name": "step1_clipId",
      "type": "string",
      "required": true,
      "description": "Which clip should be split?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which clip should be split?",
        "selector": "tracks[].clips[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 448
        },
        "notes": ""
      }
    },
    {
      "name": "step1_time",
      "type": "number",
      "required": true,
      "description": "At what time in seconds should the clip split?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "At what time in seconds should the clip split?",
        "unit": "seconds",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 1,
          "median": 5.5,
          "max": 14
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 460
        },
        "notes": "Must resolve strictly inside the current clip, excluding a 0.000001-second edge margin. Native tries absolute time first, then clip-relative time. Omission reads zero, which is not a usable split default."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "split_clip",
        "args": {
          "clipId": "{step1_clipId}",
          "time": "{step1_time}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_clipId",
      "selector": "tracks[].clips[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "split_clip"
    }
  ],
