{
  "schemaVersion": 1,
  "id": "sft-06-remove-note",
  "name": "remove-note",
  "description": "Delete a chosen note from an existing MIDI clip while keeping the rest of the phrase.",
  "examples": [
    "Delete the first note in the Piano clip.",
    "Remove note 0 from the Piano part.",
    "Can you take out the third note in the Piano clip?",
    "Get rid of the second note in the Piano clip.",
    "Take the first note out of the Piano clip.",
    "On Piano, delete note number 2.",
    "Cut the third MIDI note from the Piano clip.",
    "Delete the fourth note in the Piano MIDI.",
    "Could you remove the note at index 1 from Piano?",
    "Remove note 3 from the Piano clip."
  ],
  "slots": [
    {
      "name": "step1_clipId",
      "type": "string",
      "required": true,
      "description": "Which MIDI clip contains the note?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which MIDI clip contains the note?",
        "selector": "tracks[].clips[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.cpp",
          "line": 2513
        },
        "notes": "Requires a MIDI clip."
      }
    },
    {
      "name": "step1_noteIndex",
      "type": "number",
      "required": true,
      "description": "Which note in that MIDI clip should be removed?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which note in that MIDI clip should be removed?",
        "selector": "tracks[].clips[].notes[].i",
        "min": 0,
        "integer": true,
        "defaultPolicy": "required",
        "statistics": {
          "min": 0,
          "median": 1,
          "max": 3
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.cpp",
          "line": 2516
        },
        "notes": "Use the current snapshot note.i. The maximum depends on the current sequence length; omission reads -1 and is invalid."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "remove_note",
        "args": {
          "clipId": "{step1_clipId}",
          "noteIndex": "{step1_noteIndex}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_clipId",
      "selector": "tracks[].clips[].id"
    },
    {
      "type": "snapshot_choice",
      "slot": "step1_noteIndex",
      "selector": "tracks[].clips[].notes[].i"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "remove_note"
    }
  ],
