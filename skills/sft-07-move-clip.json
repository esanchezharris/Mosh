{
  "schemaVersion": 1,
  "id": "sft-07-move-clip",
  "name": "move-clip",
  "description": "Reposition a clip while keeping its length, optionally moving it to another track.",
  "examples": [
    "Move the piano clip to start at 4 bars.",
    "Shift the bass clip later so it starts at 8 seconds.",
    "Put the piano part on the drums track at 0 seconds.",
    "Move the bass clip onto the piano track and start it at 2 bars.",
    "Slide the piano clip forward to beat 9.",
    "Can you move the bass clip to the vocal track at the beginning of the verse?",
    "Nudge the piano MIDI clip so it starts at 6 seconds.",
    "Place the bass clip on track 1012 starting at 0 seconds.",
    "Take the piano clip and move it to the bass track at 12 seconds.",
    "Shift the bass audio clip earlier to start at 1 second."
  ],
  "slots": [
    {
      "name": "step1_clipId",
      "type": "string",
      "required": true,
      "description": "Which clip should move?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which clip should move?",
        "selector": "tracks[].clips[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 340
        },
        "notes": ""
      }
    },
    {
      "name": "step1_start",
      "type": "number",
      "required": true,
      "description": "Where should the clip begin in seconds?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "Where should the clip begin in seconds?",
        "unit": "seconds",
        "min": 0,
        "defaultPolicy": "owner",
        "statistics": {
          "min": 0,
          "median": 4,
          "max": 16
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 374
        },
        "notes": "Omission retains the current clip start. Active clip-group members move together."
      }
    },
    {
      "name": "step1_trackId",
      "type": "string",
      "required": false,
      "description": "Which track should receive the clip?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which track should receive the clip?",
        "presenceQuestion": "Did the user say anything about this: Which track should receive the clip?",
        "selector": "tracks[].id",
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 390
        },
        "notes": "Omission keeps the current track. A cross-track move cannot use ripple or move a multitrack clip group. Absence omits the argument; any documented native default is informational, never injected."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "move_clip",
        "args": {
          "clipId": "{step1_clipId}",
          "start": "{step1_start}",
          "trackId": "{step1_trackId}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_clipId",
      "selector": "tracks[].clips[].id"
    },
    {
      "type": "snapshot_choice",
      "slot": "step1_trackId",
      "selector": "tracks[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "move_clip"
    }
  ],
