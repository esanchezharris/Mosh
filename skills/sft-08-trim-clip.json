{
  "schemaVersion": 1,
  "id": "sft-08-trim-clip",
  "name": "trim-clip",
  "description": "Change a clip’s start, duration, or source offset, with optional movement of later clips.",
  "examples": [
    "Trim the Piano clip 1016 to start at bar 1 and make it 8 bars long.",
    "Shorten 1018 so it starts later and only plays for 4 bars.",
    "Please cut the Piano clip 1016 down to a 2-bar loop starting right at the beginning.",
    "Make the Bass clip 1018 start at 2s and last 6 seconds.",
    "Trim clip 1016 so it only covers the first half of the Verse.",
    "I want the Piano clip 1016 tighter, starting on beat 3 and running for 12 beats.",
    "Set 1018 to begin at 1 bar and end after 3 bars.",
    "Trim the Piano part 1016 so it doesn’t play the full Verse, just the first 4 bars.",
    "Crop 1016 to a clean 16-beat phrase from the start.",
    "Please set 1018 to start at 0.5s and be 4s long."
  ],
  "slots": [
    {
      "name": "step1_clipId",
      "type": "string",
      "required": true,
      "description": "Which clip should be trimmed?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which clip should be trimmed?",
        "selector": "tracks[].clips[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 410
        },
        "notes": ""
      }
    },
    {
      "name": "step1_length",
      "type": "number",
      "required": true,
      "description": "How many seconds should the trimmed clip last?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "How many seconds should the trimmed clip last?",
        "unit": "seconds",
        "min": 0.01,
        "defaultPolicy": "owner",
        "statistics": {
          "min": 1,
          "median": 5,
          "max": 24
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 416
        },
        "notes": "Omission retains the current length."
      }
    },
    {
      "name": "step1_start",
      "type": "number",
      "required": true,
      "description": "Where should the trimmed clip begin in seconds?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "Where should the trimmed clip begin in seconds?",
        "unit": "seconds",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 0,
          "median": 1,
          "max": 12
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 415
        },
        "notes": "Omission retains the current start; the handler declares no numeric range."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "trim_clip",
        "args": {
          "clipId": "{step1_clipId}",
          "length": "{step1_length}",
          "start": "{step1_start}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_clipId",
      "selector": "tracks[].clips[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "trim_clip"
    }
  ],
