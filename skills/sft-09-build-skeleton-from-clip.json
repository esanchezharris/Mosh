{
  "schemaVersion": 1,
  "id": "sft-09-build-skeleton-from-clip",
  "name": "build-skeleton-from-clip",
  "description": "Extract a proposed lyric structure from an audio take onto its track; a successful result lands in one undo transaction.",
  "examples": [
    "Turn the Bass take at the start into a rhythm skeleton so I can map the syllables.",
    "Use that Bass audio and give me a sparse syllable grid first, then I’ll fill the gaps.",
    "Make a vocal-style skeleton from the Bass clip on track 1013, starting at bar 1.",
    "Please turn the wave on Bass into a rough rhythmic guide with stress markers only.",
    "Build me a skeleton from the Bass take, and pause before any words get written in.",
    "Please make the Bass take readable as a rhythm outline, not actual vocal text.",
    "I need the Bass clip broken into stressed and unstressed slots on the grid.",
    "Turn the Bass recording into a placeholder vocal rhythm on track 1013.",
    "Make a blank lyric skeleton from the Bass wave so I can finish it later.",
    "Can you map the Bass mumble into syllable positions across the Verse section?"
  ],
  "slots": [
    {
      "name": "step1_clipId",
      "type": "string",
      "required": true,
      "description": "Which audio take should supply the lyric structure?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which audio take should supply the lyric structure?",
        "selector": "tracks[].clips[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Lyrics.cpp",
          "line": 774
        },
        "notes": "Requires readable source audio and a track without an existing lyric sheet. Undo begins when the result lands, at line 816, not when asynchronous work starts."
      }
    },
    {
      "name": "step1_grid",
      "type": "string",
      "required": false,
      "description": "What rhythmic grid should guide the lyric structure?",
      "source": "user",
      "default": "1/16",
      "input": {
        "kind": "text",
        "question": "What rhythmic grid should guide the lyric structure?",
        "presenceQuestion": "Did the user say anything about this: What rhythmic grid should guide the lyric structure?",
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Lyrics.cpp",
          "line": 775
        },
        "notes": "Native forwards the grid to the skeleton service without declaring a finite domain. Absence omits the argument; any documented native default is informational, never injected."
      }
    },
    {
      "name": "step1_wait",
      "type": "boolean",
      "required": false,
      "description": "Should this call wait for the lyric structure to finish?",
      "source": "user",
      "default": false,
      "input": {
        "kind": "flag",
        "question": "Should this call wait for the lyric structure to finish?",
        "presenceQuestion": "Did the user say anything about this: Should this call wait for the lyric structure to finish?",
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Lyrics.cpp",
          "line": 894
        },
        "notes": "Absence omits the argument; any documented native default is informational, never injected."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "build_skeleton_from_clip",
        "args": {
          "clipId": "{step1_clipId}",
          "grid": "{step1_grid}",
          "wait": "{step1_wait}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_clipId",
      "selector": "tracks[].clips[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "build_skeleton_from_clip"
    }
  ],
