{
  "schemaVersion": 1,
  "id": "sft-11-move-section",
  "name": "move-section",
  "description": "Set the beginning and end of a section marker without moving its clips.",
  "examples": [
    "Resize Verse to cover beats 0 through 8 only.",
    "Make the Verse longer and put it from 0 to 32 beats.",
    "Pull the Verse back to begin at beat 2 and finish at 18.",
    "Change the Verse section to 12-28 beats.",
    "Set the Verse from beat 0 to beat 12.",
    "Extend the Verse so it goes all the way to beat 24.",
    "Move the Verse so it sits between beats 8 and 16.",
    "I want the Verse starting on beat 6 and ending on beat 22.",
    "Trim the Verse down to a 10-beat section, from 0 to 10.",
    "Make Verse take up beats 4 to 12."
  ],
  "slots": [
    {
      "name": "step1_endBeat",
      "type": "number",
      "required": true,
      "description": "At which beat should the section end?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "At which beat should the section end?",
        "unit": "beats",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 4,
          "median": 24,
          "max": 48
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 161
        },
        "notes": "Omission writes zero; it does not retain the existing end. The handler declares no numeric range or ordering constraint."
      }
    },
    {
      "name": "step1_sectionId",
      "type": "string",
      "required": true,
      "description": "Which song section should change range?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which song section should change range?",
        "selector": "sections[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 159
        },
        "notes": ""
      }
    },
    {
      "name": "step1_startBeat",
      "type": "number",
      "required": true,
      "description": "At which beat should the section begin?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "At which beat should the section begin?",
        "unit": "beats",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 0,
          "median": 5,
          "max": 32
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 160
        },
        "notes": "Omission writes zero; it does not retain the existing start. The handler declares no numeric range."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "move_section",
        "args": {
          "endBeat": "{step1_endBeat}",
          "sectionId": "{step1_sectionId}",
          "startBeat": "{step1_startBeat}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_sectionId",
      "selector": "sections[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "move_section"
    }
  ],
