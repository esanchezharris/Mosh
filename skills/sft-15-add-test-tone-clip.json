{
  "schemaVersion": 1,
  "id": "sft-15-add-test-tone-clip",
  "name": "add-test-tone-clip",
  "description": "Generate a stereo sine-wave test tone and import it at the start of the arrangement.",
  "examples": [
    "Put a short test tone on Drums.",
    "Add a 1-second test tone at 440 Hz to the Drums track.",
    "Drop a test-tone clip on Piano.",
