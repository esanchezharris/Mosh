{
  "schemaVersion": 1,
  "id": "sft-17-rename-clip",
  "name": "rename-clip",
  "description": "Give an existing clip a new name.",
  "examples": [
    "Rename the piano clip to Intro Piano.",
    "Change clip 1016 name to Verse Keys.",
    "Please rename the clip on Piano to \"Chords\".",
    "Set 1016’s name to \"Verse Piano\".",
    "Can you rename the piano MIDI clip to \"Soft Keys\"?",
    "Make the bass clip say \"Bassline\".",
    "Rename 1018 to \"Verse Bass\".",
    "Call the bass audio clip \"Low End\".",
    "Change the clip on Bass to \"Sub Groove\".",
    "Please rename the bass clip 1018 to \"Main Bass\"."
  ],
  "slots": [
    {
      "name": "step1_clipId",
      "type": "string",
      "required": true,
      "description": "Which clip should be renamed?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which clip should be renamed?",
        "selector": "tracks[].clips[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 720
        },
        "notes": ""
      }
    },
    {
      "name": "step1_name",
      "type": "string",
      "required": true,
      "description": "What should the clip be called?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "text",
        "question": "What should the clip be called?",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Clips.cpp",
          "line": 723
        },
        "notes": "The handler accepts an empty name and supplies no meaningful name default."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "rename_clip",
        "args": {
          "clipId": "{step1_clipId}",
          "name": "{step1_name}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_clipId",
      "selector": "tracks[].clips[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "rename_clip"
    }
  ],
