{
  "schemaVersion": 1,
  "id": "sft-22-open-plugin-editor",
  "name": "open-plugin-editor",
  "description": "Open the native editor for a plugin already loaded on a track.",
  "examples": [
    "Open the first plugin window on Piano.",
    "Pop out the plugin editor for the Piano track.",
    "I want the plugin window for track 1012 opened.",
    "Bring up the native plugin editor on Piano.",
    "Can you pop out Piano’s plugin editor?",
    "Open the editor for the first plugin on the Piano track.",
    "I need the Piano insert editor open.",
    "Open the first plugin on track 1012.",
    "Pop out the first effect on Piano.",
    "Please bring up Piano’s plugin interface."
  ],
  "slots": [
    {
      "name": "step1_index",
      "type": "number",
      "required": true,
      "description": "Which loaded plugin’s controls should open?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which loaded plugin’s controls should open?",
        "selector": "tracks[].plugins[].index",
        "min": 0,
        "integer": true,
        "defaultPolicy": "required",
        "statistics": {
          "min": 0,
          "median": 0,
          "max": 1
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Plugins.cpp",
          "line": 1454
        },
        "notes": "Use the snapshot plugin.index for the chosen track, not its visible array position. Omission reads -1 and fails plugin lookup; there is no valid static default or maximum."
      }
    },
    {
      "name": "step1_trackId",
      "type": "string",
      "required": true,
      "description": "Which track holds the plugin?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which track holds the plugin?",
        "selector": "tracks[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Plugins.cpp",
          "line": 1452
        },
        "notes": ""
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "open_plugin_editor",
        "args": {
          "index": "{step1_index}",
          "trackId": "{step1_trackId}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_index",
      "selector": "tracks[].plugins[].index"
    },
    {
      "type": "snapshot_choice",
      "slot": "step1_trackId",
      "selector": "tracks[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "open_plugin_editor"
    }
  ],
