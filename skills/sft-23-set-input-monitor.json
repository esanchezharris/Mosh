{
  "schemaVersion": 1,
  "id": "sft-23-set-input-monitor",
  "name": "set-input-monitor",
  "description": "Choose whether the selected track’s input is monitored off, automatically, or on.",
  "examples": [
    "Turn input monitoring on for the Vocal track.",
    "Set the Vocal to input monitor.",
    "Arm the Vocal for input monitoring.",
    "Monitor the Vocal input please.",
    "Let me hear the mic through the Vocal track.",
    "Switch track 1014 to input monitoring on.",
    "Keep the Vocal track live-monitored.",
    "Please turn off input monitoring on the Vocal.",
    "Disable live monitoring for the Vocal track.",
    "Mute the monitoring on track 1014."
  ],
  "slots": [
    {
      "name": "step1_mode",
      "type": "string",
      "required": true,
      "description": "When should the live input be heard?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_static",
        "question": "When should the live input be heard?",
        "options": [
          {
            "value": "off",
            "description": "Disable input monitoring"
          },
          {
            "value": "automatic",
            "description": "Let the native input device manage monitoring automatically"
          },
          {
            "value": "on",
            "description": "Enable input monitoring"
          }
        ],
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 1308
        },
        "notes": "The automatic default applies only when neither mode nor legacy monitor is supplied."
      }
    },
    {
      "name": "step1_trackId",
      "type": "string",
      "required": true,
      "description": "Which track’s input should be monitored?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which track’s input should be monitored?",
        "selector": "tracks[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 1302
        },
        "notes": "Monitoring belongs to the shared physical input device, so other tracks using it share the change. Check data.applied."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "set_input_monitor",
        "args": {
          "mode": "{step1_mode}",
          "trackId": "{step1_trackId}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_trackId",
      "selector": "tracks[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "set_input_monitor"
    }
  ],
