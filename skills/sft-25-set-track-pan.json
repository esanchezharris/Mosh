{
  "schemaVersion": 1,
  "id": "sft-25-set-track-pan",
  "name": "set-track-pan",
  "description": "Set the track’s pan; linked tracks may follow its change.",
  "examples": [
    "Pan the Drums hard left.",
    "Put the Bass slightly left of center.",
    "Center the Drums.",
    "Take the Piano all the way left.",
    "Set the Bass all the way right.",
    "Make the Piano about 25% right.",
    "Nudge the Bass toward the left speaker.",
    "Swing the Drums 50% right.",
    "Keep the Bass dead center.",
    "Pan the Piano just a touch left."
  ],
  "slots": [
    {
      "name": "step1_pan",
      "type": "number",
      "required": true,
      "description": "Where should the track sit between left and right?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "Where should the track sit between left and right?",
        "unit": "pan",
        "min": -1,
        "max": 1,
        "defaultPolicy": "owner",
        "statistics": {
          "min": -1,
          "median": 0,
          "max": 1
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 923
        },
        "notes": "-1 is left, 0 is center, and 1 is right."
      }
    },
    {
      "name": "step1_trackId",
      "type": "string",
      "required": true,
      "description": "Which track should change stereo position?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which track should change stereo position?",
        "selector": "tracks[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 912
        },
        "notes": "Requires an audio track."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "set_track_pan",
        "args": {
          "pan": "{step1_pan}",
          "trackId": "{step1_trackId}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_trackId",
      "selector": "tracks[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "set_track_pan"
    }
  ],
