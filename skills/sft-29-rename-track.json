{
  "schemaVersion": 1,
  "id": "sft-29-rename-track",
  "name": "rename-track",
  "description": "Give an existing audio track or group track a new name.",
  "examples": [
    "Rename track 1010 to Beat",
    "Change 1012 to Keys",
    "Call 1013 Sub Bass",
    "Rename 1014 to Lead Vox",
    "Make 1010 \"Drum Kit\"",
    "Please rename the Piano track to Rhodes",
    "Set track 1013 name to Bassline",
    "Can you change Vocal to Vox",
    "Rename track 1012 to Electric Piano",
    "Call 1010 Percussion"
  ],
  "slots": [
    {
      "name": "step1_name",
      "type": "string",
      "required": true,
      "description": "What should the track be called?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "text",
        "question": "What should the track be called?",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 177
        },
        "notes": "The handler accepts an empty name and supplies no meaningful name default."
      }
    },
    {
      "name": "step1_trackId",
      "type": "string",
      "required": true,
      "description": "Which track should be renamed?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which track should be renamed?",
        "selector": "tracks[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 171
        },
        "notes": "Group tracks are also accepted."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "rename_track",
        "args": {
          "name": "{step1_name}",
          "trackId": "{step1_trackId}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_trackId",
      "selector": "tracks[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "rename_track"
    }
  ],
