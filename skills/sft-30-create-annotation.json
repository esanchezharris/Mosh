{
  "schemaVersion": 1,
  "id": "sft-30-create-annotation",
  "name": "create-annotation",
  "description": "Add a written note at a beat position in the arrangement.",
  "examples": [
    "Drop a comment at beat 4 that says \"tighten the vocal timing here\".",
    "Can you pin a note at beat 8: \"bring the piano down a bit in the verse\"?",
    "Add an annotation on beat 12 for the Bass track section, just saying \"try a busier line here\".",
    "Put a marker at beat 0 that says \"start of verse\".",
    "Please leave a comment at beat 6: \"watch the vocal breath before the line\".",
    "At beat 14, add a note in blue: \"maybe add drums here later\".",
    "Can you flag beat 2 with \"piano intro feels strong, keep this\"?",
    "Drop a comment pin on the Verse at beat 12 saying the piano needs tuning.",
    "Add a note at beat 8 about the bass timing.",
    "Place a comment on the Piano track at beat 4 about the rhythm."
  ],
  "slots": [
    {
      "name": "step1_author",
      "type": "string",
      "required": false,
      "description": "Who should be credited for this arrangement note?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "text",
        "question": "Who should be credited for this arrangement note?",
        "presenceQuestion": "Did the user say anything about this: Who should be credited for this arrangement note?",
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 578
        },
        "notes": "Omission leaves the author empty. Absence omits the argument; any documented native default is informational, never injected."
      }
    },
    {
      "name": "step1_beat",
      "type": "number",
      "required": true,
      "description": "At which beat should the arrangement note appear?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "At which beat should the arrangement note appear?",
        "unit": "beats",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 0,
          "median": 7,
          "max": 15
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 576
        },
        "notes": "The handler declares no numeric range."
      }
    },
    {
      "name": "step1_color",
      "type": "string",
      "required": false,
      "description": "What color should identify the arrangement note?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "text",
        "question": "What color should identify the arrangement note?",
        "presenceQuestion": "Did the user say anything about this: What color should identify the arrangement note?",
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 577
        },
        "notes": "The handler accepts a string without declaring a finite color domain. Absence omits the argument; any documented native default is informational, never injected."
      }
    },
    {
      "name": "step1_text",
      "type": "string",
      "required": true,
      "description": "What should the arrangement note say?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "text",
        "question": "What should the arrangement note say?",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 575
        },
        "notes": "The handler accepts empty text and supplies no meaningful text default."
      }
    }
  ],
