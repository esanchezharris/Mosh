{
  "schemaVersion": 1,
  "id": "sft-31-create-section",
  "name": "create-section",
  "description": "Add a named section such as an intro, verse, or chorus over a beat range.",
  "examples": [
    "Add a Chorus from bar 17 to 33.",
    "Create a new Pre-Chorus that starts at beat 16 and ends at beat 24.",
    "Can you make an Intro section from 0 to 8 beats?",
    "Set up a Bridge between beats 32 and 40.",
    "I need a second Verse from 48 to 64.",
    "Please add an Outro starting at 64 and ending at 80.",
    "Mark bars 8 through 16 as a Pre-Chorus.",
    "Create a Breakdown section from beat 24 to beat 32.",
    "Put in a Hook section from 16 to 24.",
    "Add a Tag section at the end, 80 to 84."
  ],
  "slots": [
    {
      "name": "step1_endBeat",
      "type": "number",
      "required": true,
      "description": "At which beat should the section end?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "At which beat should the section end?",
        "unit": "beats",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 4,
          "median": 32,
          "max": 88
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 122
        },
        "notes": "Omission uses the supplied startBeat plus 16 beats. The handler declares no numeric range or ordering constraint."
      }
    },
    {
      "name": "step1_name",
      "type": "string",
      "required": true,
      "description": "What should the section be called?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "text",
        "question": "What should the section be called?",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 120
        },
        "notes": "The handler accepts an empty name and supplies no meaningful name default."
      }
    },
    {
      "name": "step1_startBeat",
      "type": "number",
      "required": true,
      "description": "At which beat should the section begin?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "At which beat should the section begin?",
        "unit": "beats",
        "defaultPolicy": "owner",
        "statistics": {
          "min": 0,
          "median": 24,
          "max": 80
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Notes.cpp",
          "line": 121
        },
        "notes": "The handler declares no numeric range or ordering constraint."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "create_section",
        "args": {
          "endBeat": "{step1_endBeat}",
          "name": "{step1_name}",
          "startBeat": "{step1_startBeat}"
        }
      }
    ]
  },
  "preconditions": [],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "create_section"
    }
  ],
