{
  "schemaVersion": 1,
  "id": "sft-33-set-track-volume",
  "name": "set-track-volume",
  "description": "Set the track fader in decibels; linked tracks may follow its change.",
  "examples": [
    "Turn the Drums down to -6 dB.",
    "Set track 1010 to -3 dB.",
    "Make the Piano a bit quieter, around -4 dB.",
    "Raise the Bass to +2 dB.",
    "Drop the Vocal track to -inf for now.",
    "Can you set the volume of 1014 to -12 dB?",
    "Bring the Piano down to -2 dB.",
    "Nudge the Bass up to 1 dB.",
    "Mute the Drums by setting them to -60 dB.",
    "Set the Drums track to -8 dB."
  ],
  "slots": [
    {
      "name": "step1_db",
      "type": "number",
      "required": true,
      "description": "What fader level in decibels should the track use?",
      "source": "user",
      "default": "NEEDS_OWNER_VALUE",
      "input": {
        "kind": "number",
        "question": "What fader level in decibels should the track use?",
        "unit": "dB",
        "defaultPolicy": "owner",
        "statistics": {
          "min": -96,
          "median": -4,
          "max": 4
        },
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 892
        },
        "notes": "The selected-track request is passed to the native fader without a handler clamp. Only linked follower values are explicitly clamped to -70..6 dB; that is not an input bound."
      }
    },
    {
      "name": "step1_trackId",
      "type": "string",
      "required": true,
      "description": "Which track should change level?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_snapshot",
        "question": "Which track should change level?",
        "selector": "tracks[].id",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 864
        },
        "notes": "An audio track or a group track with a volume plugin is accepted."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "set_track_volume",
        "args": {
          "db": "{step1_db}",
          "trackId": "{step1_trackId}"
        }
      }
    ]
  },
  "preconditions": [
    {
      "type": "snapshot_choice",
      "slot": "step1_trackId",
      "selector": "tracks[].id"
    }
  ],
  "postconditions": [
    {
      "type": "command_effect",
      "step": 1,
      "command": "set_track_volume"
    }
  ],
