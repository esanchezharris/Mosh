{
  "schemaVersion": 1,
  "id": "sft-35-set-transport",
  "name": "set-transport",
  "description": "Start, stop, continue, or reposition playback and set the transport loop.",
  "examples": [
    "Play it.",
    "Start playback from the top.",
    "Hit play on the verse.",
    "Stop the song.",
    "Pause everything.",
    "Start recording from the beginning.",
    "Set it to loop the whole Verse section.",
    "Go to the start.",
    "Jump back to bar 1.",
    "Seek to the beginning of the song."
  ],
  "slots": [
    {
      "name": "step1_action",
      "type": "string",
      "required": false,
      "description": "What should playback or recording do?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "choice_static",
        "question": "What should playback or recording do?",
        "presenceQuestion": "Did the user say anything about this: What should playback or recording do?",
        "options": [
          {
            "value": "play",
            "description": "Start playback from the current or supplied position"
          },
          {
            "value": "stop",
            "description": "Stop playback or finish recording"
          },
          {
            "value": "toggle",
            "description": "Start or stop playback according to the current state"
          },
          {
            "value": "continue",
            "description": "Continue playback, or stop while retaining the stopped position"
          },
          {
            "value": "record",
            "description": "Begin recording using armed, usable inputs"
          },
          {
            "value": "to_start",
            "description": "Move to the start of the arrangement"
          },
          {
            "value": "to_end",
            "description": "Move to the end of the arrangement"
          }
        ],
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.TempoProject.cpp",
          "line": 42
        },
        "notes": "Omission leaves the action empty, allowing position or loop patches. Playback and recording depend on live audio readiness; headless execution is not proof of playback. Absence omits the argument; any documented native default is informational, never injected."
      }
    },
    {
      "name": "step1_loop",
      "type": "boolean",
      "required": false,
      "description": "Should transport looping be enabled?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "flag",
        "question": "Should transport looping be enabled?",
        "presenceQuestion": "Did the user say anything about this: Should transport looping be enabled?",
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.TempoProject.cpp",
          "line": 163
        },
        "notes": "Omission preserves the current loop setting. Absence omits the argument; any documented native default is informational, never injected."
      }
    },
    {
      "name": "step1_position",
