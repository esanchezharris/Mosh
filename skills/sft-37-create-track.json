{
  "schemaVersion": 1,
  "id": "sft-37-create-track",
  "name": "create-track",
  "description": "Add an audio or drum track to the end of the track list.",
  "examples": [
    "Add a new drum track called Percussion.",
    "Create a drum track for a beat loop.",
    "Make me a new track named Shaker and set it up for drums.",
    "Add a drum track underneath the current drums.",
    "Create a track called Groove and make it a drum track.",
    "Put in a new drum channel named Kit 2.",
    "New drum track please, name it Toms.",
    "Set up a fresh drum track called Top Loop.",
    "I want a second drum track with a sampler loaded.",
    "Add another track for drum hits so I can hear it right away."
  ],
  "slots": [
    {
      "name": "step1_name",
      "type": "string",
      "required": true,
      "description": "What should the new track be called?",
      "source": "user",
      "default": null,
      "input": {
        "kind": "text",
        "question": "What should the new track be called?",
        "defaultPolicy": "required",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 128
        },
        "notes": "Omission leaves the engine-generated track name; see MoshOps.cpp:3031."
      }
    },
    {
      "name": "step1_type",
      "type": "string",
      "required": false,
      "description": "Should this be an audio track or a drum track?",
      "source": "user",
      "default": "audio",
      "input": {
        "kind": "choice_static",
        "question": "Should this be an audio track or a drum track?",
        "presenceQuestion": "Did the user say anything about this: Should this be an audio track or a drum track?",
        "options": [
          {
            "value": "audio",
            "description": "An ordinary track for audio or an instrument"
          },
          {
            "value": "drum",
            "description": "A drum track with a sampler and bundled kit"
          }
        ],
        "defaultPolicy": "omit",
        "nativeSource": {
          "file": "src/moshops/MoshOps.Tracks.cpp",
          "line": 123
        },
        "notes": "Absence omits the argument; any documented native default is informational, never injected."
      }
    }
  ],
  "template": {
    "commands": [
      {
        "command": "create_track",
        "args": {
          "name": "{step1_name}",
          "type": "{step1_type}"
        }
      }
    ]
  },
