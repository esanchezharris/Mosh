# Moshi brain configuration template (safe to commit; no real keys here).
# Copy to .env.local. Distributable builds require the proxy fields below and refuse
# any direct-provider API key; the provider fields remain available for local dev only.
# A Vite dev plugin reads these SERVER-SIDE and forwards to the provider; the
# browser never sees a key. All three providers are OpenAI-compatible chat-completions.
# Any ONE direct provider is enough for local Vite development. Keyless Vite dev/e2e
# uses the demo brain; packaged Moshi requires the proxy and otherwise reports setup
# failure without emitting commands.

MOSH_BRAIN_PROXY_URL=
MOSH_BRAIN_PROXY_APIKEY=

MOSHI_BRAIN_PROVIDER=deepseek   # deepseek | openai | xai

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
XAI_API_KEY=
