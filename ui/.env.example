# Moshi brain — provider config TEMPLATE (safe to commit; no real keys here).
# Copy to .env.local and fill in your key(s). .env.local is gitignored.
# A Vite dev plugin reads these SERVER-SIDE and forwards to the provider; the
# browser never sees a key. Every provider here is OpenAI-compatible chat-completions.
# Any ONE provider is enough — the proxy picks MOSHI_BRAIN_PROVIDER if its key is set,
# else the first configured one. With no keys set, the UI falls back to a demo mock-brain.
# You can also switch between the configured seats live, in the app: the ⋯ menu, or
# Settings ▸ Moshi ▸ Brain. See docs/AGENT_ONBOARDING.md.

MOSHI_BRAIN_PROVIDER=deepseek   # deepseek | openai | xai | local

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
XAI_API_KEY=

# A model running on THIS machine (mlx_lm.server, or any OpenAI-compatible local server).
# No key needed — it's defaulted whenever LOCAL_BASE_URL is set, so these two lines are
# the whole config. LOCAL_MODEL must match the id `curl localhost:8080/v1/models` reports
# EXACTLY: mlx_lm returns empty content rather than an error on a mismatch.
# Fusing and serving a local model: service/sft/EVAL_RUNBOOK.md
# LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL=
