{
  "name": "mosh-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mosh arrangement UI — React/Vite in a JUCE 8 WebView. Swappable frontend (03).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e-report",
    "brain-bench": "tsx scripts/brainBench.mts",
    "harvest": "tsx src/harvest/cli.ts harvest",
    "verify": "tsx src/harvest/cli.ts verify",
    "import": "tsx src/import/cli.ts",
    "gen-turns": "tsx scripts/genTurns.mts",
    "gepa": "tsx scripts/gepa.mts",
    "build-sft": "tsx scripts/buildSft.mts",
    "eval-sft": "tsx scripts/evalSft.mts",
    "drive-local": "tsx scripts/driveLocal.mts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.19.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-xml-parser": "^5.9.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.9"
  }
}
