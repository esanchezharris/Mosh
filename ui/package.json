{
  "name": "mosh-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mosh arrangement UI — React/Vite in a JUCE 8 WebView. Swappable frontend (03).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "brain-eval": "MOSH_BRAIN_EVAL=1 vitest run src/agent/brainEval.test.ts",
    "eval-matrix": "vite-node scripts/evalMatrix.mts",
    "arena": "vite-node scripts/arena.mts",
    "genbench": "vite-node scripts/genbench.mts",
    "flywheel": "vite-node scripts/flywheel.mts",
    "recipe-flywheel": "vite-node scripts/recipeFlywheel.mts",
    "recipe-distill": "vite-node scripts/recipeDistill.mts",
    "eval-ab": "vite-node scripts/evalAB.mts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.9"
  }
}
