{
  "name": "mosh-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mosh arrangement UI — React/Vite in a JUCE 8 WebView. Swappable frontend (03).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && VITE_MOSH_ENABLE_EXPERIMENTAL_AGENT_LOOP=1 vite build --mode e2e",
    "build:companion": "vite build --config vite.companion.config.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e-report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "brain-bench": "tsx scripts/brainBench.mts",
    "harvest": "tsx src/harvest/cli.ts harvest",
    "verify": "tsx src/harvest/cli.ts verify",
    "import": "tsx src/import/cli.ts",
    "gen-turns": "tsx scripts/genTurns.mts",
    "gepa": "tsx scripts/gepa.mts",
    "build-sft": "tsx scripts/buildSft.mts",
    "eval-sft": "tsx scripts/evalSft.mts",
    "drive-local": "tsx scripts/driveLocal.mts",
    "turn-factory": "tsx scripts/turnFactory.mts",
    "agent-bench": "tsx scripts/agentBench.mts",
    "moshi-bench": "tsx scripts/moshiBench.mts",
    "policy-probe": "tsx scripts/policyProbe.mts",
    "synthesize": "tsx scripts/synthesizeDriver.mts",
    "verify:skill-identities": "tsx scripts/verifySkillIdentityUniverse.mts",
    "teach-moshi": "tsx src/skillFoundry/cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@storybook/react-vite": "^10.4.6",
    "@types/node": "^22.19.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-xml-parser": "^5.9.3",
    "jsdom": "^26.1.0",
    "storybook": "^10.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.9"
  }
}
